---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollMeter from "../components/ScrollMeter.astro";
import {
  getLanguageFromPath,
  getLocalizedPath,
  languageCodes,
  languageLocales,
  type Language,
} from "../utils/i18n";
import { getTranslations } from "../utils/translations";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  /** explicit alternate-language versions; undefined → all other languages auto-assumed; null → no alternates */
  alternateHrefs?: { lang: string; href: string }[] | null;
  noIndex?: boolean;
}

const {
  title = "RrSuika Studio",
  description,
  ogImage,
  alternateHrefs,
  noIndex = false,
} = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const isZh = language === "zh";
const t = getTranslations(language);

// Art pages are frozen — exclude them from global heading font changes.
const isArtRoute = ["/art", "/zh/art", "/nl/art"].some(
  (route) =>
    Astro.url.pathname === route ||
    Astro.url.pathname.startsWith(`${route}/`),
);

const metaDescription = description ?? t.meta.description;

const allLanguages: Language[] = ["en", "zh", "nl"];

const alternates: { lang: string; href: string }[] =
  alternateHrefs === null
    ? []
    : alternateHrefs !== undefined
      ? alternateHrefs
      : allLanguages
          .filter((l) => l !== language)
          .map((l) => ({
            lang: languageCodes[l],
            href: getLocalizedPath(Astro.url.pathname, l),
          }));

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : null;

// x-default: the default-language version of this page.
const xDefaultPath =
  language === "en"
    ? Astro.url.pathname
    : getLocalizedPath(Astro.url.pathname, "en");

const xDefaultUrl = Astro.site ? new URL(xDefaultPath, Astro.site).href : null;

// Default share card; detail pages override with their cover image.
const ogImageUrl =
  Astro.site && (ogImage || "/og-card.png")
    ? new URL(ogImage ?? "/og-card.png", Astro.site).href
    : null;

// Structured data — WebSite entity, declared on every page.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "RrSuika Studio",
  url: "https://rrsuika-studio.pages.dev/",
  inLanguage: ["en", "zh", "nl"],
};
---

<!doctype html>
<html lang={getLanguageFromPath(Astro.url.pathname) || "en"}>
  <head>
    <!--
      THEME GUARD — must be the first thing in <head>.
      1. Synchronous script sets data-theme on <html> before any paint.
      2. CSS guard hides <body> until data-theme is present — safety net
         for browsers that paint progressively before scripts execute.
    -->
    <script is:inline>
      (() => {
        var key = "rrsuika-theme", stored;
        try { stored = localStorage.getItem(key); } catch (_) { stored = null; }
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        } else {
          // First visit: default to dark mode
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <style is:global>
      html:not([data-theme]) body { visibility: hidden; }
    </style>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f0ebe0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07070d" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800;900&family=Saira+Condensed:wght@500;600;700;800;900&family=VT323&display=swap"
      rel="stylesheet"
    />

    <!-- 得意黑 Smiley Sans Oblique — self-hosted subsets (OFL, cn-font-split) -->
    <link rel="stylesheet" href="/fonts/dyh/result.css" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

    <title>{title}</title>

    <meta name="description" content={metaDescription} />

    {noIndex && <meta name="robots" content="noindex" />}

    {canonical && <link rel="canonical" href={canonical} />}

    {
      Astro.site &&
        alternates.map((a) => (
          <link
            rel="alternate"
            hreflang={a.lang}
            href={new URL(a.href, Astro.site).href}
          />
        ))
    }

    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}

    <meta property="og:site_name" content="RrSuika Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languageLocales[language]} />
    {
      allLanguages
        .filter((l) => l !== language)
        .map((l) => (
          <meta property="og:locale:alternate" content={languageLocales[l]} />
        ))
    }
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema)}
    />
  </head>

  <body class:list={{ "art-route": isArtRoute }}>
    <!-- =========================================
         SKIP LINK — keyboard navigation
    ========================================== -->

    <a class="skip-link" href="#main-content">SKIP_TO_CONTENT &gt;</a>

    <!-- =========================================
         MOBILE NOTICE — desktop mode recommended
         (mobile only, dismissible)
    ========================================== -->

    <div id="mobile-notice" role="status">
      <span class="notice-dot" aria-hidden="true"></span>
      <span class="notice-text">
        {language === "zh"
          ? "系统提示 // 建议使用电脑访问，桌面模式效果最佳"
          : language === "nl"
            ? "SYSTEEM_MELDING // HET BESTE TE BEKIJKEN IN DESKTOPMODUS"
            : "SYSTEM_NOTICE // BEST VIEWED IN DESKTOP MODE"}
      </span>
      <button class="notice-close" type="button" aria-label={isZh ? "关闭提示" : language === "nl" ? "Sluiten" : "Dismiss"}>
        ×
      </button>
    </div>


      <!-- =========================================
          STARFIELD BACKGROUND (temporarily replaces
          the neural-network canvas; the old canvas is
          kept below, hidden and disabled for easy restore)
      ========================================== -->

      <canvas id="star-canvas" aria-hidden="true"></canvas>

      <canvas id="starfield-canvas" aria-hidden="true"></canvas>
    <!-- =========================================
         NEURAL NETWORK BACKGROUND (weakened)
    ========================================== -->

    <canvas id="neural-canvas" aria-hidden="true"></canvas>

    <!-- =========================================
         GLOBAL CONTENT
    ========================================== -->

    <div class="site-content">
      <header>
        <Navbar />
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>

    <ScrollMeter />

    <!-- =========================================
         CRT OVERLAY
    ========================================== -->

    <div id="crt-overlay"></div>

    <div id="tube-vignette"></div>


      <!-- =========================================
          STARFIELD SCRIPT — colourful drifting stars
          with subtle glow, parallax/drag on mouse.
          Tuning knobs: STAR_COUNT / flow speed /
          mouse.radius / glow strength.
      ========================================== -->

      <script>
        (() => {

          /* Superseded by the 3D starfield below. Set
             <html data-star-version="2d"> to run this version. */
          if (document.documentElement.getAttribute("data-star-version") !== "2d") {
            return;
          }

          const canvas = document.getElementById(
            "star-canvas",
          ) as HTMLCanvasElement;

          const ctx = canvas?.getContext("2d");

          if (!canvas || !ctx) return;
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

          // Real-world stellar spectral colours: blue-white, white,
          // yellow, orange, red — weighted towards cooler stars.
          const STAR_COLORS = [
            "#eaf2ff",
            "#dbe8ff",
            "#ffffff",
            "#f6f7ff",
            "#ffe9c4",
            "#ffdfae",
            "#ffc98f",
            "#ff9d6b",
            "#ff7c5e",
          ];

          const STAR_WEIGHTS = [9, 8, 14, 11, 6, 5, 3, 2, 1];
          const palette: string[] = [];
          STAR_COLORS.forEach((color, index) => {
            const weight = STAR_WEIGHTS[index] ?? 1;
            for (let i = 0; i < weight; i++) palette.push(color);
          });

          const DPR = Math.min(window.devicePixelRatio || 1, 2);
          const FLOW_ANGLE = Math.PI * 0.1; // slow cosmic drift
          let width = 0;
          let height = 0;
          let stars: any[] = [];
          let time = 0;
          let lastFrame = performance.now();

          const mouse = {
            x: -9999,
            y: -9999,
            px: -9999,
            py: -9999,
            vx: 0,
            vy: 0,
            active: false,
          };

           function randomColor() {
            return palette[Math.floor(Math.random() * palette.length)];
          }

           function parseRgb(color: string) {
            const m = color.match(/\d+/g) || [];
            return [Number(m[0]), Number(m[1]), Number(m[2])];
          }

          function initStars() {
            stars = [];
            const area = width * height;
            const count = Math.max(
              70,
              Math.min(
                width < 768 ? 1260 : 5000,
                Math.floor(area / (width < 768 ? 5200 : 3600)),
              ),
            );

            for (let i = 0; i < count; i++) {
              const depth = Math.random();
              const speed = 0.045 + depth * depth * 0.42; // far stars slow, near stars fast
              const jitterX = (Math.random() - 0.5) * 0.018;
              const jitterY = (Math.random() - 0.5) * 0.018;
              const baseVx = Math.cos(FLOW_ANGLE) * speed + jitterX;
              const baseVy = Math.sin(FLOW_ANGLE) * speed + jitterY;
              const bright = Math.random() < 0.075;
              const starColor = randomColor();

              stars.push({
                x: Math.random() * width,
                y: Math.random() * height,
                z: depth,
                vx: baseVx,
                vy: baseVy,
                baseVx,
                baseVy,
                size: 0.35 + depth * depth * 1.7,
                color: starColor,
                rgb: parseRgb(starColor),
                twinkleSpeed: 0.35 + Math.random() * 1.8,
                twinklePhase: Math.random() * Math.PI * 2,
                glow: bright ? 8 + Math.random() * 8 : 2.5 + Math.random() * 4,
                bright,
                phase: Math.random() * Math.PI * 2,
              });
            }
          }

          function resize() {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = Math.floor(width * DPR);
            canvas.height = Math.floor(height * DPR);
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
            initStars();
          }

          function update() {
            if (mouse.active) {
              mouse.vx = (mouse.x - mouse.px) * 0.12;
              mouse.vy = (mouse.y - mouse.py) * 0.12;
            }

            const dragRadius = 150;

            for (const star of stars) {
              // Continuous drift, speeds vary by depth
              star.x += star.vx;
              star.y += star.vy;

              // Gentle wave-like sway so the field never feels static
              const sway = Math.sin(time * 0.35 + star.phase);
              star.x += Math.cos(FLOW_ANGLE + Math.PI / 2) * sway * 0.012;
              star.y += Math.sin(FLOW_ANGLE + Math.PI / 2) * sway * 0.012;

              // Mouse drag: nearby stars are pulled along with the cursor
              // and receive a light swirl, then relax back to their base drift.
              if (mouse.active) {
                const dx = star.x - mouse.x;
                const dy = star.y - mouse.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                const radius = dragRadius + (1 - star.z) * 50;

                if (dist < radius && dist > 0.001) {
                  const falloff = 1 - dist / radius;
                  const strength = star.z * 0.55 + 0.18;

                  star.vx += mouse.vx * strength * falloff;
                  star.vy += mouse.vy * strength * falloff;

                  // gentle pull toward the cursor, like stirring a star map
                  star.vx += (dx / dist) * falloff * 0.035;
                  star.vy += (dy / dist) * falloff * 0.035;

                  // tiny orbital swirl
                  star.vx += -(dy / dist) * falloff * 0.018;
                  star.vy += (dx / dist) * falloff * 0.018;
                }
              }

              // Relax back towards the intrinsic drift
              star.vx += (star.baseVx - star.vx) * 0.02;
              star.vy += (star.baseVy - star.vy) * 0.02;

              // Wrap with a soft margin so stars cross the screen smoothly
              const margin = 24;
              if (star.x < -margin) star.x = width + margin;
              else if (star.x > width + margin) star.x = -margin;
              if (star.y < -margin) star.y = height + margin;
              else if (star.y > height + margin) star.y = -margin;
            }

            mouse.px = mouse.x;
            mouse.py = mouse.y;
          }

          function drawStar(star: any) {
            const twinkle = 0.62 + 0.38 * Math.sin(time * star.twinkleSpeed + star.twinklePhase);
            const alpha = (0.35 + star.z * 0.55) * twinkle;

            // Parallax drag: deeper stars move less with the cursor.
            const dragX = mouse.active ? (mouse.x - width / 2) * star.z * 0.035 : 0;
            const dragY = mouse.active ? (mouse.y - height / 2) * star.z * 0.035 : 0;
            const x = star.x + dragX;
            const y = star.y + dragY;

            ctx.save();
            ctx.globalAlpha = Math.min(1, alpha);
            ctx.fillStyle = star.color;
            ctx.shadowColor = star.color;
            ctx.shadowBlur = star.glow;
            ctx.beginPath();
            ctx.arc(x, y, star.size, 0, Math.PI * 2);
            ctx.fill();

            // Very subtle cross flare on the brightest stars
            if (star.bright) {
              ctx.globalAlpha = alpha * 0.22;
              ctx.shadowBlur = 0;
              ctx.lineWidth = 0.6;
              ctx.strokeStyle = star.color;
              const flare = 2.6 + star.size * 3.2;
              ctx.beginPath();
              ctx.moveTo(x - flare, y);
              ctx.lineTo(x + flare, y);
              ctx.moveTo(x, y - flare);
              ctx.lineTo(x, y + flare);
              ctx.stroke();
            }
            ctx.restore();
          }

          function animate() {
            const now = performance.now();
            const delta = Math.min((now - lastFrame) / 16.667, 2.5);
            lastFrame = now;
            time += 0.014 * delta;

            update();
            ctx.clearRect(0, 0, width, height);
            for (const star of stars) drawStar(star);
            requestAnimationFrame(animate);
          }

          window.addEventListener("mousemove", (event) => {
            mouse.px = mouse.px === -9999 ? event.clientX : mouse.px;
            mouse.py = mouse.py === -9999 ? event.clientY : mouse.py;
            mouse.x = event.clientX;
            mouse.y = event.clientY;
            mouse.active = true;
          });

          window.addEventListener("mouseout", () => {
            mouse.active = false;
            mouse.x = -9999;
            mouse.y = -9999;
            mouse.px = -9999;
            mouse.py = -9999;
            mouse.vx = 0;
            mouse.vy = 0;
          });

          window.addEventListener("resize", resize);

          resize();
          requestAnimationFrame(animate);
        })();
      </script>

      <!-- =========================================
          STARFIELD 3D — celestial-sphere stars with
          realistic spectral colours, proper motion,
          slow camera drift and mouse-controlled drag.
      ========================================== -->

      <script>
        (() => {
          const canvas = document.getElementById(
            "starfield-canvas",
          ) as HTMLCanvasElement;

          const ctx = canvas?.getContext("2d");

          if (!canvas || !ctx) return;
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

          // Real-world stellar spectral colours, weighted towards
          // abundant blue-white / white stars and rarer orange/red stars.
          const STAR_COLORS = [
            "#eaf2ff",
            "#dbe8ff",
            "#ffffff",
            "#f6f7ff",
            "#ffe9c4",
            "#ffdfae",
            "#ffc98f",
            "#ff9d6b",
            "#ff7c5e",
          ];
          const STAR_WEIGHTS = [9, 8, 14, 11, 6, 5, 3, 2, 1];
          const palette: string[] = [];
          STAR_COLORS.forEach((color, index) => {
            const weight = STAR_WEIGHTS[index] ?? 1;
            for (let i = 0; i < weight; i++) palette.push(color);
          });

          const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
          const AUTO_ROTATION = 0.00032; // radians per frame — keeps stars moving slowly
          let width = 0;
          let height = 0;
          let stars: any[] = [];
          let time = 0;
          let lastFrame = performance.now();
          let camYaw = 0;
          let camPitch = 0;
          const mouse = {
            x: -9999,
            y: -9999,
            px: -9999,
            py: -9999,
            vx: 0,
            vy: 0,
            active: false,
          };

           /* function randomColor() {
            return palette[Math.floor(Math.random() * palette.length)];
          } */

            // Override with a higher-contrast real-stellar palette:
            // blue-white, white, yellow, orange and red are clearly separated.
            function randomColor() {
              const colors = [
                "rgb(120, 160, 255)",
                "rgb(170, 200, 255)",
                "rgb(210, 220, 250)",
                "rgb(255, 255, 255)",
                "rgb(255, 230, 185)",
                "rgb(255, 210, 130)",
                "rgb(255, 160, 85)",
                "rgb(255, 110, 70)",
                "rgb(230, 70, 60)",
              ];
              const weights = [12, 12, 8, 3, 8, 12, 14, 10, 5];
              let total = 0;
              for (const w of weights) total += w;
              let roll = Math.random() * total;
              for (let i = 0; i < weights.length; i++) {
                roll -= weights[i];
                if (roll <= 0) return colors[i];
              }
              return colors[colors.length - 1];
            }

          function parseRgb(color: string) {
            const m = color.match(/\d+/g) || [];
            return [Number(m[0]), Number(m[1]), Number(m[2])];
          }

          function initStars() {
            stars = [];
            const area = width * height;
            // Star count: half of the previous density.
            // Tune density here: lower area divisor = more stars.
            const count = Math.max(
              20,
              Math.min(
                width < 768 ? 472 : 1180,
                Math.floor(area / (width < 768 ? 3100 : 2750)),
              ),
            );

            for (let i = 0; i < count; i++) {
              const forward = Math.random() < 0.88;
                const starZ = forward
                  ? 0.35 + Math.random() * 0.65
                  : 0.2 + Math.random() * 0.8;
                const starX = forward
                  ? (Math.random() - 0.5) * starZ * 1.5
                  : Math.random() * 2 - 1;
                const starY = forward
                  ? (Math.random() - 0.5) * starZ * 0.9
                  : Math.random() * 2 - 1;
                const inv = 1 / Math.sqrt(
                  starX * starX + starY * starY + starZ * starZ,
                );
                const theta = Math.atan2(starY, starX);
              const phi = Math.asin(starZ * inv);
               const bright = Math.random() < 0.08;
               const baseDriftVx = (Math.random() - 0.5) * 0.14;
               const baseDriftVy = (Math.random() - 0.5) * 0.14;
               const starColor = randomColor();
              stars.push({
                theta,
                phi,
                driftX: 0,
                 driftY: 0,
                 driftVx: baseDriftVx,
                 driftVy: baseDriftVy,
                 baseDriftVx,
                 baseDriftVy,
                 dragX: 0,
                 dragY: 0,
                 dragVx: 0,
                 dragVy: 0,
                 color: starColor,
                 rgb: parseRgb(starColor),
                 sizeScale:
                   Math.random() < 0.67
                     ? 0.3 + Math.random() * 0.5
                     : 1.0 + Math.random() * 0.6,
                 twinkleSpeed: 0.35 + Math.random() * 2.2,
                 twinklePhase: Math.random() * Math.PI * 2,
                 bright,
                 glow: bright ? 7 + Math.random() * 7 : 2 + Math.random() * 4,
              });
            }
          }

          function resize() {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = Math.floor(width * DPR);
            canvas.height = Math.floor(height * DPR);
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
            initStars();
          }

          function update(dt: number) {

          /* ── STAR / MOUSE TUNING ─────────────────────────────
             These are the main manual knobs:
             STAR_COUNT  → initStars(): count formula above
             STAR_SIZE   → drawStar(): "const size = ..."
             DRAG_RADIUS → update(): dragRadius = 150
             DRAG_STRENGTH → update(): mouse.vx * falloff * 0.03
             MOUSE_SENSITIVITY → mousemove(): mouse.vx = dx * 0.2
             DRAG_DECAY  → update(): mouse.vx *= 0.82
             DAMPING     → update(): (base - drift) * 0.06
             MAX_SPEED   → update(): maxSpd = 0.35
          ──────────────────────────────────────────────────── */
            // No global camera rotation: stars only drift by their own proper motion.
            camYaw = 0;
            camPitch = 0;

            // Mouse velocity decays quickly after movement stops.
            mouse.vx *= 0.9;
            mouse.vy *= 0.9;
            if (Math.abs(mouse.vx) < 0.02) mouse.vx = 0;
            if (Math.abs(mouse.vy) < 0.02) mouse.vy = 0;

            // Independent per-star proper motion
            const dragRadius = 90;
            const focal = Math.max(width, height) * 0.95;
            for (const star of stars) {
              // Project to screen (same math as drawStar) so mouse forces can
              // act on actual visible positions.
              const cp = Math.cos(star.phi);
              const x0 = cp * Math.cos(star.theta);
              const y0 = cp * Math.sin(star.theta);
              const z0 = Math.sin(star.phi);
              const cy = Math.cos(camYaw);
              const sinYaw = Math.sin(camYaw);
              const x1 = x0 * cy - z0 * sinYaw;
              const z1 = x0 * sinYaw + z0 * cy;
              const cx = Math.cos(camPitch);
              const sinPitch = Math.sin(camPitch);
              const y2 = y0 * cx - z1 * sinPitch;
              const z2 = y0 * sinPitch + z1 * cx;
              if (z2 <= 0.08) continue;

              let sx = width / 2 + (x1 / z2) * focal + (star.driftX || 0) + (star.dragX || 0);
              let sy = height / 2 + (y2 / z2) * focal + (star.driftY || 0) + (star.dragY || 0);
              sx = ((sx % width) + width) % width;
              sy = ((sy % height) + height) % height;

              // Only while the cursor is actually moving: drag nearby stars along.
              if (mouse.active && (mouse.vx !== 0 || mouse.vy !== 0)) {
                const dx = sx - mouse.x;
                const dy = sy - mouse.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < dragRadius && dist > 0.001) {
                  const falloff = 1 - dist / dragRadius;
                  star.dragVx += mouse.vx * falloff * 0.12; // DRAG_STRENGTH
                  star.dragVy += mouse.vy * falloff * 0.12;
                }
              }

              // Elastic spring pulls the mouse offset back to zero, giving
              // a visible rebound after the cursor leaves or slows down.
              star.dragVx += -star.dragX * 0.0013;
              star.dragVy += -star.dragY * 0.0013;
              star.dragVx *= 0.88;
              star.dragVy *= 0.88;
              star.dragX += star.dragVx * dt;
              star.dragY += star.dragVy * dt;

              // The base star drift continues independently.
              star.driftX += star.baseDriftVx * dt;
              star.driftY += star.baseDriftVy * dt;
          }
        }

          function drawStar(star: any) {
            const cp = Math.cos(star.phi);
            const x0 = cp * Math.cos(star.theta);
            const y0 = cp * Math.sin(star.theta);
            const z0 = Math.sin(star.phi);

            // Camera yaw (rotate around Y axis)
            const cy = Math.cos(camYaw);
            const sinYaw = Math.sin(camYaw);
            const x1 = x0 * cy - z0 * sinYaw;
            const z1 = x0 * sinYaw + z0 * cy;

            // Camera pitch (rotate around X axis)
            const cx = Math.cos(camPitch);
            const sinPitch = Math.sin(camPitch);
            const y2 = y0 * cx - z1 * sinPitch;
            const z2 = y0 * sinPitch + z1 * cx;

            if (z2 <= 0.08) return;

            const focal = Math.max(width, height) * 0.95;
            let sx = width / 2 + (x1 / z2) * focal;
            let sy = height / 2 + (y2 / z2) * focal;

            // Continuous screen-space drift (no attraction/orbit)
            sx += (star.driftX || 0) + (star.dragX || 0);
            sy += (star.driftY || 0) + (star.dragY || 0);
            sx = ((sx % width) + width) % width;
            sy = ((sy % height) + height) % height;

            const margin = 60;
            if (
              sx < -margin ||
              sx > width + margin ||
              sy < -margin ||
              sy > height + margin
            ) {
              return;
            }

            const near = 1 - z2;
            const size = (0.5 + star.sizeScale * 1.4) * (0.85 + near * 0.2) * 0.75;
            const twinkle =
              0.62 + 0.38 * Math.sin(time * star.twinkleSpeed + star.twinklePhase);
            const alpha = (0.42 + star.sizeScale * 0.28) * twinkle;

            // Smooth radial gradient — no hard circle edge, just a gradual glow.
            const [sr, sg, sb] = star.rgb || [255, 255, 255];
            const glowRadius = Math.max(size * 2.8, 4);
            const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, glowRadius);
            glow.addColorStop(0, `rgba(${sr},${sg},${sb},${Math.min(1, alpha)})`);
            glow.addColorStop(0.35, `rgba(${sr},${sg},${sb},${Math.min(1, alpha * 0.55)})`);
            glow.addColorStop(0.7, `rgba(${sr},${sg},${sb},${Math.min(1, alpha * 0.14)})`);
            glow.addColorStop(1, `rgba(${sr},${sg},${sb},0)`);
            ctx.save();
            ctx.globalAlpha = 1;
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(sx, sy, glowRadius, 0, Math.PI * 2);
            ctx.fill();

            // Tiny bright core — keeps the star a point source, not a disk.
            ctx.fillStyle = star.color;
            ctx.globalAlpha = Math.min(1, alpha);
            ctx.beginPath();
            ctx.arc(sx, sy, Math.max(0.4, size * 0.85), 0, Math.PI * 2);
            ctx.fill();


            // Very subtle diffraction cross on the brightest stars
            if (star.bright) {
              ctx.globalAlpha = alpha * 0.18;
              ctx.shadowBlur = 0;
              ctx.lineWidth = 0.6;
              ctx.strokeStyle = star.color;
              const flare = (2.4 + size * 3.4) * (0.7 + near * 0.5);
              ctx.beginPath();
              ctx.moveTo(sx - flare, sy);
              ctx.lineTo(sx + flare, sy);
              ctx.moveTo(sx, sy - flare);
              ctx.lineTo(sx, sy + flare);
              ctx.stroke();
            }
            ctx.restore();
          }

          function animate() {
            // Light mode uses the retro grid instead of the starfield.
            if (document.documentElement.getAttribute("data-theme") === "light") {
              ctx.clearRect(0, 0, width, height);
              requestAnimationFrame(animate);
              return;
            }
            const now = performance.now();
            const delta = Math.min((now - lastFrame) / 16.667, 2.5);
            lastFrame = now;
            time += 0.016 * delta;

            update(delta);
            ctx.clearRect(0, 0, width, height);
            for (const star of stars) drawStar(star);
            requestAnimationFrame(animate);
          }

          window.addEventListener("mousemove", (event) => {
            const dx = mouse.px === -9999 ? 0 : event.clientX - mouse.px;
            const dy = mouse.py === -9999 ? 0 : event.clientY - mouse.py;
            mouse.px = event.clientX;
            mouse.py = event.clientY;
            mouse.x = event.clientX;
            mouse.y = event.clientY;
            mouse.vx = dx * 0.65; // MOUSE_SENSITIVITY
            mouse.vy = dy * 0.65;
            mouse.active = true;
          });

          window.addEventListener("mouseout", (event) => {
            // Ignore bubbled mouseout events from moving between elements;
            // only reset when the pointer actually leaves the document.
            if (event.relatedTarget !== null) return;

            mouse.active = false;
            mouse.x = -9999;
            mouse.y = -9999;
            mouse.px = -9999;
            mouse.py = -9999;
            mouse.vx = 0;
            mouse.vy = 0;
          });

          window.addEventListener("resize", resize);

          resize();
          requestAnimationFrame(animate);
        })();
      </script>
    <!-- =========================================
         NEURAL NETWORK SCRIPT — weakened version:
         fewer particles, softer glow, gentler
         mouse repulsion, dimmer connections.
         Tuning knobs: density / shadowBlur /
         CONNECTION_DIST / mouse.radius / force.
    ========================================== -->

    <script>
      (() => {

          /* TEMPORARILY DISABLED — replaced by the starfield above.
             Re-enable by setting <html data-neural="enabled">. */
          if (
            document.documentElement.getAttribute("data-neural") !== "enabled"
          ) {
            return;
          }
        const canvas = document.getElementById(
          "neural-canvas",
        ) as HTMLCanvasElement;

        const ctx = canvas.getContext("2d") as CanvasRenderingContext2D;

        if (!canvas || !ctx) return;

        let particles: any[] = [];

        const mouse = {
          x: null as number | null,
          y: null as number | null,
          radius: 140,
        };

        const CONNECTION_DIST = 140;

        let time = 0;

        /* =========================================
           MOUSE
        ========================================== */

        window.addEventListener("mousemove", (event) => {
          mouse.x = event.clientX;
          mouse.y = event.clientY;
        });

        window.addEventListener("mouseout", () => {
          mouse.x = null;
          mouse.y = null;
        });

        /* =========================================
           RESIZE
        ========================================== */

        function resize() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }

        /* =========================================
           PARTICLES
        ========================================== */

        function initParticles() {
          particles = [];

          const density = window.innerWidth < 900 ? 70 : 140;

          for (let i = 0; i < density; i++) {
            particles.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,

              vx: (Math.random() - 0.5) * 0.4,

              vy: (Math.random() - 0.5) * 0.4,

              size: Math.random() * 2.2 + 1,

              color:
                Math.random() > 0.45
                  ? "rgba(255,95,31,0.9)"
                  : "rgba(0,176,255,0.9)",

              phase: Math.random() * Math.PI * 2,

              driftVx: 0,
              driftVy: 0,

              targetDriftVx: 0,
              targetDriftVy: 0,

              driftTimer: Math.random() * 100,
            });
          }
        }

        resize();

        initParticles();

        window.addEventListener("resize", () => {
          resize();
          initParticles();
        });

        /* =========================================
           ANIMATION
        ========================================== */

        function animate() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          time += 0.007;

          particles.forEach((particle, index) => {
            /* ---------------------------------
                 Organic movement
              --------------------------------- */

            particle.vx += Math.sin(time * 3 + particle.phase) * 0.008;

            particle.vy += Math.cos(time * 2.5 + particle.phase) * 0.008;

            /* ---------------------------------
                 Random drift
              --------------------------------- */

            particle.driftTimer--;

            if (particle.driftTimer <= 0) {
              particle.targetDriftVx = (Math.random() - 0.5) * 0.2;

              particle.targetDriftVy = (Math.random() - 0.5) * 0.2;

              particle.driftTimer = 120 + Math.random() * 80;
            }

            particle.driftVx +=
              (particle.targetDriftVx - particle.driftVx) * 0.02;

            particle.driftVy +=
              (particle.targetDriftVy - particle.driftVy) * 0.02;

            particle.vx += particle.driftVx * 0.07;

            particle.vy += particle.driftVy * 0.07;

            /* ---------------------------------
                 Mouse interaction
              --------------------------------- */

            if (mouse.x !== null && mouse.y !== null) {
              const dx = particle.x - mouse.x;

              const dy = particle.y - mouse.y;

              const distance = Math.sqrt(dx * dx + dy * dy);

              if (distance < mouse.radius && distance > 0.1) {
                const force = (1 - distance / mouse.radius) * 0.08;

                particle.vx += (dx / distance) * force;

                particle.vy += (dy / distance) * force;
              }
            }

            /* ---------------------------------
                 Damping
              --------------------------------- */

            particle.vx *= 0.992;
            particle.vy *= 0.992;

            /* ---------------------------------
                 Prevent stopping
              --------------------------------- */

            const speed = Math.sqrt(
              particle.vx * particle.vx + particle.vy * particle.vy,
            );

            if (speed < 0.15) {
              particle.vx += (Math.random() - 0.5) * 0.04;

              particle.vy += (Math.random() - 0.5) * 0.04;
            }

            /* ---------------------------------
                 Position
              --------------------------------- */

            particle.x += particle.vx;

            particle.y += particle.vy;

            /* ---------------------------------
                 Boundaries
              --------------------------------- */

            if (particle.x < 0) {
              particle.x = 0;

              particle.vx *= -0.7;
            }

            if (particle.x > canvas.width) {
              particle.x = canvas.width;

              particle.vx *= -0.7;
            }

            if (particle.y < 0) {
              particle.y = 0;

              particle.vy *= -0.7;
            }

            if (particle.y > canvas.height) {
              particle.y = canvas.height;

              particle.vy *= -0.7;
            }

            /* ---------------------------------
                 Draw particle
              --------------------------------- */

            ctx.fillStyle = particle.color;

            ctx.shadowColor = particle.color;

            ctx.shadowBlur = 8;

            ctx.beginPath();

            ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);

            ctx.fill();

            ctx.shadowBlur = 0;

            /* ---------------------------------
                 Connections
              --------------------------------- */

            for (let j = index + 1; j < particles.length; j++) {
              const other = particles[j];

              const dx = particle.x - other.x;

              const dy = particle.y - other.y;

              const distance = Math.sqrt(dx * dx + dy * dy);

              if (distance < CONNECTION_DIST) {
                ctx.beginPath();

                ctx.strokeStyle = `rgba(255,255,255,${0.22 - distance / 500})`;

                ctx.lineWidth = 1;

                ctx.moveTo(particle.x, particle.y);

                ctx.lineTo(other.x, other.y);

                ctx.stroke();
              }
            }
          });

          requestAnimationFrame(animate);
        }

        animate();
      })();
    </script>

    <!-- ── CRT power-on boot for project cards ──
         Plays once per page load, then removes itself. ── -->
    <script>
      (() => {
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          return;
        }

        const cards = document.querySelectorAll<HTMLElement>(".card");

        if (!cards.length) return;

        cards.forEach((card, index) => {
          card.classList.add("crt-boot");
          card.style.setProperty("--boot-delay", `${index * 110}ms`);
        });

        const total = 700 + cards.length * 110;

        setTimeout(() => {
          cards.forEach((card) => card.classList.remove("crt-boot"));
        }, total);
      })();
    </script>

    <!-- ── Theme toggle (init is in <head> to prevent flash) ── -->
    <script>
      (() => {
        var KEY = "rrsuika-theme";
        (window as typeof window & { __toggleTheme?: () => void }).__toggleTheme = function () {
          var cur = document.documentElement.getAttribute("data-theme");
          var next = cur === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem(KEY, next); } catch (_) {}
        };
      })();
    </script>
    <!-- ── Mobile notice dismiss: click × (session-scoped) ── -->
    <script>
      (() => {
        var KEY = "rrsuika-mobile-notice";
        const notice = document.getElementById("mobile-notice");
        if (!notice) return;
        try {
          if (sessionStorage.getItem(KEY) === "dismissed") {
            notice.hidden = true;
            return;
          }
        } catch (_) {}

        var dismissed = false;
        function dismissNotice() {
          if (dismissed) return;
          dismissed = true;
          // 淡出动画结束后再移除
          notice?.classList.add("notice-leave");
          setTimeout(() => {
            if (notice) notice.hidden = true;
          }, 450);
          try { sessionStorage.setItem(KEY, "dismissed"); } catch (_) {}
        }

        var close = notice.querySelector(".notice-close");
        close?.addEventListener("click", dismissNotice);
      })();
    </script>
  </body>
</html>
