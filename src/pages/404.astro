---
import Layout from "../layouts/Layout.astro";

// Served statically as /404.html — Cloudflare Pages picks it up for any
// missing route. Content is bilingual so it works under both / and /zh.
---

<Layout title="404 // SIGNAL_LOST" noIndex alternateHrefs={null}>
  <div class="err-404">
    <div class="panel">
      <div class="code-line">
        ERR_404 // <span class="dim">SIGNAL_LOST</span>
      </div>

      <div class="code-line dim">
        信号丢失 // 页面不存在
      </div>

      <!-- PM5544 test card — the classic Philips pattern -->
      <div class="pm5544" aria-hidden="true">
        <svg viewBox="0 0 320 240" width="320" height="240" role="presentation">
          <rect x="0" y="0" width="320" height="240" fill="#0a0a0a" />
          <!-- 75% colour bars -->
          <rect x="8" y="8" width="43.4" height="52" fill="#b8b8b8" />
          <rect x="51.4" y="8" width="43.4" height="52" fill="#b8b800" />
          <rect x="94.8" y="8" width="43.4" height="52" fill="#00b8b8" />
          <rect x="138.2" y="8" width="43.4" height="52" fill="#00b800" />
          <rect x="181.6" y="8" width="43.4" height="52" fill="#b800b8" />
          <rect x="225" y="8" width="43.4" height="52" fill="#b80000" />
          <rect x="268.4" y="8" width="43.4" height="52" fill="#0000b8" />
          <!-- big circle -->
          <circle cx="160" cy="132" r="86" fill="#1a1a1a" stroke="#666" stroke-width="1.5" />
          <circle cx="160" cy="132" r="58" fill="#0f0f0f" stroke="#555" stroke-width="1" />
          <!-- centre grid -->
          <g stroke="#3a3a3a" stroke-width="0.8">
            <line x1="160" y1="48" x2="160" y2="216" />
            <line x1="76" y1="132" x2="244" y2="132" />
          </g>
          <!-- centre circle + crosshair -->
          <circle cx="160" cy="132" r="22" fill="#101010" stroke="#888" stroke-width="1" />
          <g stroke="#bbb" stroke-width="1">
            <line x1="160" y1="118" x2="160" y2="146" />
            <line x1="146" y1="132" x2="174" y2="132" />
          </g>
          <!-- black/white patches -->
          <rect x="84" y="60" width="24" height="24" fill="#ddd" />
          <rect x="212" y="60" width="24" height="24" fill="#000" />
          <rect x="84" y="180" width="24" height="24" fill="#000" />
          <rect x="212" y="180" width="24" height="24" fill="#ddd" />
          <!-- bottom black strip -->
          <rect x="0" y="196" width="320" height="12" fill="#000" />
          <rect x="0" y="210" width="320" height="12" fill="#0d0d0d" />
        </svg>
      </div>

      <div class="divider" />

      <div class="code-line small">
        &gt; SEARCH_TERMINATED // PM5544 // NO_SIGNAL
      </div>

      <div class="actions">
        <a class="btn" href="/">[ RETURN_TO_HOME ]</a>

        <a class="btn" href="/zh/">[ 返回首页 ]</a>

        <a class="btn" href="/nl/">[ TERUG_NAAR_HUIS ]</a>

        <a class="btn" href="/projects/">[ PROJECTS ]</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .err-404 {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
  }

  .panel {
    width: min(560px, 100%);
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 32px;
  }

  .code-line {
    font-family: var(--font-mono);
    font-size: var(--text-scale-body);
    color: var(--text-bright);
    letter-spacing: var(--tracking-label);
    line-height: 1.8;
  }

  .code-line.small {
    font-size: var(--text-scale-xs);
    color: var(--text-tertiary);
  }

  .dim {
    color: var(--text-dim);
  }

  /* ── PM5544 test card ── */
  .pm5544 {
    margin: 24px auto 4px;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    line-height: 0;
  }

  .pm5544 svg {
    display: block;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .divider {
    border-top: 1px dashed var(--border-divider);
    margin: 20px 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .btn {
    font-family: var(--font-mono);
    font-size: var(--text-scale-xs);
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    border: 1px solid var(--border-accent);
    padding: 10px 16px;
    transition:
      background 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
