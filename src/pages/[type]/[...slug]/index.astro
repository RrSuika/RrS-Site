---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import {
  findTranslation,
  getLocalizedPath,
  languageCodes,
  type Language,
} from "../../../utils/i18n";
import { getProjectImage } from "../../../utils/images";

export async function getStaticPaths() {
  const entries = await getCollection("entries");

  const englishEntries = entries.filter((entry) => entry.data.lang === "en" && entry.data.type !== "art");

  return englishEntries.map((entry) => {
    const projectSlug = entry.id.split("/")[0];

    const translation = findTranslation(entries, entry, "zh");

    return {
      params: {
        type: entry.data.type,
        slug: projectSlug,
      },

      props: {
        project: entry,
        projectId: projectSlug,
        translation,
        translations: entries.filter(
          (e) =>
            e.data.translationKey === entry.data.translationKey &&
            e.data.lang !== "en" &&
            e.data.type !== "art",
        ),
      },
    };
  });
}

const { project, projectId, translation, translations } = Astro.props;

const { Content } = await render(project);

// getProjectImage returns a URL string, or an ImageMetadata object
// (Astro image globs) whose .src holds the final URL.
const coverRaw = project.data.cover
  ? (getProjectImage(projectId, project.data.cover) as
      | string
      | { src: unknown }
      | null)
  : null;

const coverImage =
  typeof coverRaw === "string"
    ? coverRaw
    : coverRaw && "src" in coverRaw
      ? String(coverRaw.src)
      : null;

const coverImageUrl =
  coverImage && Astro.site ? new URL(coverImage, Astro.site).href : null;

const alternateHrefs = (translations as { data: { lang: Language } }[]).map(
  (tr) => ({
    lang: languageCodes[tr.data.lang],
    href: getLocalizedPath(Astro.url.pathname, tr.data.lang),
  }),
);

const authorRef = {
  "@type": "Person",
  name: "RrSuika Studio",
  url: "https://rrsuika-studio.pages.dev/about/",
};

/** Resolve a cover reference to a URL string, or undefined. */
function resolveCoverUrl(entryId: string, cover?: string): string | undefined {
  if (!cover) return undefined;
  const raw = getProjectImage(entryId, cover) as
    | string
    | { src: unknown }
    | null;
  const url =
    typeof raw === "string"
      ? raw
      : raw && "src" in raw
        ? String(raw.src)
        : null;
  if (!url) return undefined;
  // Schema.org expects an absolute image URL, not a root-relative path.
  return Astro.site ? new URL(url, Astro.site).href : url;
}

// Structured data — TechArticle entity for detail pages.
// Dates are full ISO-8601 datetimes (schema.org requires timezone info).
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: project.data.title,
  description: project.data.description ?? undefined,
  image: coverImageUrl ?? undefined,
  datePublished: project.data.date.toISOString(),
  // 无独立修改日期数据，回退为发布日期
  dateModified: project.data.date.toISOString(),
  inLanguage: languageCodes[project.data.lang],
  author: authorRef,
  mainEntityOfPage: Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined,
  translationOfWork: (translations as { id: string; data: { lang: Language; title: string; description?: string; cover?: string; date: Date } }[]).map(
    (tr) => ({
      "@type": "TechArticle",
      headline: tr.data.title,
      description: tr.data.description ?? undefined,
      image: resolveCoverUrl(tr.id.split("/")[0], tr.data.cover),
      datePublished: tr.data.date.toISOString(),
      dateModified: tr.data.date.toISOString(),
      inLanguage: languageCodes[tr.data.lang],
      author: authorRef,
      url: Astro.site
        ? new URL(
            getLocalizedPath(Astro.url.pathname, tr.data.lang),
            Astro.site,
          ).href
        : undefined,
    }),
  ),
};
---

<Layout
  title={`${project.data.title} | RrSuika Studio`}
  description={project.data.description}
  ogImage={coverImage}
  alternateHrefs={alternateHrefs}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleSchema)}
  />

  <ProjectDetail
    project={project}
    projectId={projectId}
    Content={Content}
    translation={translation}
  />
</Layout>
