---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CassetteShelf from "../../../components/CassetteShelf.astro";
import { getLanguageFromPath } from "../../../utils/i18n";
import { getTranslations } from "../../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const entries = await getCollection("entries");
const labEntries = entries
  .filter((e) => e.data.type === "lab" && e.data.lang === language)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Curated filter tags — narrowed inside CassetteShelf to the ones that exist
const filterTags = [
  "ESP32",
  "Arduino",
  "WiFi",
  "NeoPixel",
  "Web Server",
  "步进电机",
  "3D打印",
  "电气安全",
];
---

<Layout
  title={`${t.sections.lab.title} | RrSuika Studio`}
  description={t.sections.lab.description}
>
  <CassetteShelf
    entries={labEntries}
    kind="lab"
    filterTags={filterTags}
    title={t.sections.lab.title}
    description={t.sections.lab.description}
  />
</Layout>
