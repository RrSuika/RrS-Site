---
import Layout from "../../../layouts/Layout.astro";
import FanCta from "../../../components/FanCta.astro";
import { getLanguageFromPath } from "../../../utils/i18n";
import { getTranslations } from "../../../utils/translations";
import { getArtImages } from "../../../utils/artImages";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);


interface ArtImage {
  src: string;
  title: string;
  folder: string;
}

interface Category {
  folder: string;
  titles: Record<string, string>;
  images: ArtImage[];
}

const CATEGORIES: { folder: string; titles: Record<string, string> }[] = [
  { folder: "illustrations", titles: { en: "Illustrations", zh: "插画" } },
  { folder: "product-posters", titles: { en: "Product Posters", zh: "产品海报" } },
  { folder: "fashion-design", titles: { en: "Fashion Design", zh: "服装设计" } },
  { folder: "food-art", titles: { en: "Food Art", zh: "美食艺术" } },
];

const TITLE_MAP: Record<string, Record<string, string>> = {
  illustrations: {
    "01-xiaoke": "小刻",
    "02-palasi": "帕拉斯",
    "03-taojinniang": "桃金娘",
    "04-gua": "伊吹萃香",
    "05-aiyafala": "纯烬艾雅法拉",
    "06-susuluo": "苏苏洛",
    "07-mofazhumi": "魔法猪咪",
    "08-pepe": "佩佩",
    "09-rossi": "洛茜",
  },
  "food-art": {
    "01-seven-color-yokan": "七色羊羹",
    "02-niten-ichiryu": "二天一流",
    "03-wellington-steak": "惠灵顿牛排",
    "04-unconscious-mousse": "无意识妖怪慕斯",
    "05-tricolor-icecream": "毛玉三色冰激凌",
    "06-burnt-pudding": "燃尽布丁",
  },
};

function titleFromFilename(folder: string, filename: string): string {
  const key = filename.replace(/\.[^.]+$/, "");
  if (TITLE_MAP[folder]?.[key]) {
    return TITLE_MAP[folder][key];
  }
  let name = filename.replace(/^.*[\\/]/, "").replace(/\.(png|jpe?g|webp)$/i, "");
  name = name.replace(/^\d+[-_]/, "");
  name = name.replace(/[-_]/g, " ");
  return name.replace(/\b\w/g, (c) => c.toUpperCase());
}

const categories: Category[] = CATEGORIES.map((cat) => ({
  ...cat,
  images: getArtImages()
    .filter((image) => image.folder === cat.folder)
    .map((image) => ({
      src: image.src,
      title: titleFromFilename(cat.folder, image.filename),
      folder: image.folder,
    })),
}));

const hasContent = categories.some((c) => c.images.length > 0);
---

<Layout title={`${t.sections.art.title} | RrSuika Studio`} description={t.sections.art.description}>
  <main class="art-page">
    <section class="art-hero">
      <p class="hero-tag">{t.explore.art.header}</p>
      <h1>{t.sections.art.title}</h1>
      <p class="hero-sub">{t.sections.art.description}</p>
      <p class="hero-hint">← 滚动浏览 → 拖拽加速 &nbsp;|&nbsp; 点击查看大图</p>

      <FanCta />
    </section>

    {
      !hasContent && (
        <div class="empty">
          <p>将图片放入 <code>src/content/entries/&#123;illustrations,product-posters,fashion-design,food-art&#125;/</code></p>
          <p>它们将自动出现在这里。</p>
        </div>
      )
    }

    <div class="rows" id="art-rows">
      {categories.filter((c) => c.images.length > 0).map((cat, rowIndex) => (
        <section class="art-row" data-row={rowIndex}>
          <div class="row-header">
            <span class="row-idx">{(rowIndex + 1).toString().padStart(2, "0")}</span>
            <h2>{cat.titles[language] || cat.titles.en}</h2>
            <span class="row-count">{cat.images.length} 张</span>
          </div>

          <div class="row-viewport" id={`row-${rowIndex}`}>
            {(() => {
              const unique = cat.images.length;
              const copies = Math.max(3, Math.ceil(12 / unique));
              const frames = Array.from({ length: copies }, () => cat.images).flat();
              return (
                <div class="row-track" data-track={rowIndex} data-copies={copies} data-unique={unique}>
                  {frames.map((img, i) => (
                    <div
                      class="frame"
                      data-row={rowIndex}
                      data-idx={i % unique}
                      data-src={img.src}
                      data-title={img.title}
                    >
                      <div class="frame-media">
                        <img
                          src={img.src}
                          alt={img.title}
                          loading={i < 8 ? "eager" : "lazy"}
                          draggable="false"
                        />
                      </div>
                      <span class="frame-caption">{img.title}</span>
                    </div>
                  ))}
                </div>
              );
            })()}
          </div>
        </section>
      ))}
    </div>

    <aside class="lightbox" id="lightbox" aria-hidden="true">
      <div class="lightbox-bg"></div>
      <button class="lightbox-close" aria-label="关闭">&times;</button>
      <button class="lightbox-prev" aria-label="上一张">&lsaquo;</button>
      <button class="lightbox-next" aria-label="下一张">&rsaquo;</button>
      <div class="lightbox-body">
        <img src="" alt="" id="lb-img" draggable="false" />
        <p class="lb-caption" id="lb-caption"></p>
      </div>
    </aside>
  </main>
</Layout>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".row-viewport");

  interface RowState {
    el: HTMLElement;
    track: HTMLElement;
    speed: number;
    position: number;
    isHovering: boolean;
    isDragging: boolean;
    dragStartX: number;
    dragStartScroll: number;
    direction: number;
  }

  const states: RowState[] = [];

  rows.forEach((el, i) => {
    const track = el.querySelector<HTMLElement>("[data-track]")!;
    const dir = i % 2 === 0 ? 1 : -1;
    const state: RowState = {
      el,
      track,
      speed: 0.3 + Math.random() * 0.2,
      position: 0,
      isHovering: false,
      isDragging: false,
      dragStartX: 0,
      dragStartScroll: 0,
      direction: dir,
    };

    track.style.transform = `translateX(${-state.position}px)`;
    states.push(state);

    el.addEventListener("mouseenter", () => { state.isHovering = true; });
    el.addEventListener("mouseleave", () => {
      state.isHovering = false;
      state.isDragging = false;
      el.style.cursor = "grab";
    });

    el.addEventListener("mousedown", (e) => {
      state.isDragging = true;
      state.dragStartX = e.clientX;
      state.dragStartScroll = state.position;
      el.style.cursor = "grabbing";
      e.preventDefault();
    });

    window.addEventListener("mousemove", (e) => {
      if (!state.isDragging) return;
      const dx = (state.dragStartX - e.clientX) * 1.5;
      state.position = state.dragStartScroll + dx;
    });

    window.addEventListener("mouseup", () => {
      if (state.isDragging) {
        state.isDragging = false;
        el.style.cursor = state.isHovering ? "grab" : "default";
      }
    });

    el.addEventListener("touchstart", (e: Event) => {
      const te = e as TouchEvent;
      state.isDragging = true;
      state.dragStartX = te.touches[0].clientX;
      state.dragStartScroll = state.position;
    });

    el.addEventListener("touchmove", (e: Event) => {
      if (!state.isDragging) return;
      const te = e as TouchEvent;
      const dx = (state.dragStartX - te.touches[0].clientX) * 1.5;
      state.position = state.dragStartScroll + dx;
    });

    el.addEventListener("touchend", () => { state.isDragging = false; });
  });

  function animate() {
    for (const state of states) {
      if (!state.isDragging && !state.isHovering) {
        state.position += state.speed * state.direction;
      }

      const copies = Number(state.track.dataset.copies) || 2;
      const setWidth = state.track.scrollWidth / copies;
      state.position = ((state.position % setWidth) + setWidth) % setWidth;

      state.track.style.transform = `translateX(${-state.position}px)`;
    }

    if (document.hidden) {
      setTimeout(() => requestAnimationFrame(animate), 200);
    } else {
      requestAnimationFrame(animate);
    }
  }

  requestAnimationFrame(animate);

  const lightbox = document.getElementById("lightbox")!;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbCaption = document.getElementById("lb-caption")!;
  const btnClose = document.querySelector(".lightbox-close")!;
  const btnPrev = document.querySelector(".lightbox-prev")!;
  const btnNext = document.querySelector(".lightbox-next")!;
  const lbBg = document.querySelector(".lightbox-bg")!;

  const allFrames = document.querySelectorAll<HTMLElement>(".frame");

  let currentRow = 0;
  let currentIdx = 0;

  function getRowFrames(row: number): HTMLElement[] {
    return Array.from(allFrames).filter(
      (f) => Number(f.dataset.row) === row,
    );
  }

  function openLightbox(row: number, idx: number) {
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }
    currentRow = row;
    currentIdx = idx;
    updateLightbox();
    lightbox.setAttribute("aria-hidden", "false");
    lightbox.classList.add("active");
    const scrollY = window.scrollY;
    document.body.style.position = "fixed";
    document.body.style.top = `-${scrollY}px`;
    document.body.style.width = "100%";
  }

  function closeLightbox() {
    lightbox.setAttribute("aria-hidden", "true");
    lightbox.classList.remove("active");
    const scrollY = document.body.style.top;
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.width = "";
    window.scrollTo(0, parseInt(scrollY || "0") * -1);
  }

  function getUniqueCount(row: number): number {
    const track = document.querySelector(`[data-track="${row}"]`) as HTMLElement;
    return Number(track?.dataset.unique) || getRowFrames(row).length / 2;
  }

  function prevImage() {
    const unique = getUniqueCount(currentRow);
    currentIdx = (currentIdx - 1 + unique) % unique;
    updateLightbox();
  }

  function nextImage() {
    const unique = getUniqueCount(currentRow);
    currentIdx = (currentIdx + 1) % unique;
    updateLightbox();
  }

  function updateLightbox() {
    const frames = getRowFrames(currentRow);
    const frame = frames[currentIdx];
    const nextSrc = frame.dataset.src || "";
    if (lbImg.src === nextSrc) return;
    lbImg.classList.add("crossfade");
    const preload = new Image();
    preload.onload = () => {
      lbImg.src = nextSrc;
      lbImg.classList.remove("crossfade");
    };
    preload.src = nextSrc;
    lbCaption.textContent = frame.dataset.title || "";
  }

  let clickStartX = 0;
  let clickStartY = 0;

  allFrames.forEach((frame) => {
    frame.addEventListener("mousedown", (e) => {
      clickStartX = e.clientX;
      clickStartY = e.clientY;
    });

    frame.addEventListener("click", (e) => {
      const dx = Math.abs(e.clientX - clickStartX);
      const dy = Math.abs(e.clientY - clickStartY);
      if (dx < 4 && dy < 4) {
        const row = Number(frame.dataset.row);
        const idx = Number(frame.dataset.idx);
        openLightbox(row, idx);
      }
    });
  });

  btnClose.addEventListener("click", closeLightbox);
  lbBg.addEventListener("click", closeLightbox);
  btnPrev.addEventListener("click", (e) => { e.stopPropagation(); prevImage(); });
  btnNext.addEventListener("click", (e) => { e.stopPropagation(); nextImage(); });

  document.addEventListener("keydown", (e) => {
    if (!lightbox.classList.contains("active")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") prevImage();
    if (e.key === "ArrowRight") nextImage();
  });

  let touchStart = 0;
  lightbox.addEventListener("touchstart", (e) => {
    touchStart = (e as TouchEvent).touches[0].clientX;
  });
  lightbox.addEventListener("touchend", (e) => {
    const diff = touchStart - (e as TouchEvent).changedTouches[0].clientX;
    if (Math.abs(diff) > 50) diff > 0 ? nextImage() : prevImage();
  });
</script>

<style>
  .art-page {
    padding: 0 0 60px;
  }

  .art-hero {
    text-align: center;
    padding: 50px 20px 30px;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--accent);
    margin-bottom: 16px;
    opacity: 0.8;
  }

  .art-hero h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .hero-sub {
    font-size: 16px;
    color: #666;
    max-width: 480px;
    margin: 0 auto 14px;
  }

  .hero-hint {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #555;
    letter-spacing: 1px;
  }

  .empty {
    text-align: center;
    padding: 80px 20px;
    color: #666;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 2;
  }

  .empty code {
    background: rgba(255,255,255,0.06);
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--accent);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .art-row {
    position: relative;
  }

  .row-header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 16px 28px 10px;
    font-family: var(--font-mono);
  }

  .row-idx {
    font-size: 12px;
    color: var(--accent);
    opacity: 0.6;
    letter-spacing: 1px;
  }

  .row-header h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 0;
    flex: 1;
  }

  .row-count {
    font-size: 11px;
    color: #555;
    letter-spacing: 1px;
  }

  .row-viewport {
    overflow-x: clip;
    overflow-y: visible;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    position: relative;
    height: 320px;
  }

  .row-track {
    display: flex;
    gap: 12px;
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    padding: 0 28px;
    align-items: center;
    will-change: transform;
  }

  .frame {
    flex-shrink: 0;
    height: 280px;
    position: relative;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .frame-media {
    height: 100%;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: transparent;
    transition: border-color 0.3s ease;
  }

  .frame:hover {
    transform: translateY(-4px);
    filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.5));
    z-index: 2;
  }

  .frame:hover .frame-media {
    border-color: rgba(255, 255, 255, 0.25);
  }

  .frame img {
    height: 100%;
    width: auto;
    display: block;
    pointer-events: none;
  }

  .frame-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 12px 10px;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
    border-radius: 0 0 6px 6px;
    overflow: hidden;
    color: #ccc;
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.5px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    text-align: center;
  }

  .frame:hover .frame-caption {
    opacity: 1;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-bg {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 10, 0.96);
  }

  .lightbox-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 92vw;
    max-height: 92vh;
    z-index: 1;
  }

  .lightbox-body img {
    max-width: 90vw;
    max-height: 82vh;
    object-fit: contain;
    transition: opacity 0.15s ease;
  }
  .lightbox-body img.crossfade {
    opacity: 0;
  }
    border-radius: 4px;
    box-shadow: 0 4px 60px rgba(0,0,0,0.5);
  }

  .lb-caption {
    color: #aaa;
    font-size: 14px;
    margin-top: 14px;
    font-family: var(--font-mono);
    letter-spacing: 0.5px;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 28px;
    z-index: 2;
    font-size: 42px;
    color: #888;
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
  }

  .lightbox-close:hover { color: #fff; }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    font-size: 52px;
    color: #888;
    background: none;
    border: none;
    cursor: pointer;
    padding: 20px 14px;
    transition: color 0.2s;
    user-select: none;
  }

  .lightbox-prev { left: 10px; }
  .lightbox-next { right: 10px; }
  .lightbox-prev:hover,
  .lightbox-next:hover { color: #fff; }

  @media (max-width: 900px) {
    .row-viewport {
      height: 240px;
    }
    .frame {
      height: 210px;
    }
    .row-header {
      padding: 10px 16px 6px;
    }
  }

  @media (max-width: 600px) {
    .row-viewport {
      height: 200px;
    }
    .frame {
      height: 175px;
    }
    .art-hero {
      padding: 30px 16px 20px;
    }
    .row-header {
      padding: 8px 12px 4px;
    }
    .row-header h2 {
      font-size: 13px;
    }
    .lightbox-prev,
    .lightbox-next {
      font-size: 36px;
      padding: 10px 6px;
    }
    .lightbox-close {
      font-size: 32px;
      top: 10px;
      right: 14px;
    }
  }
</style>
