  }

  .capability-display {
    display: flex;
    flex-direction: column;
    min-height: 560px;
  }

  .display-header,
  .display-footer {
    display: flex;
    justify-content: space-between;
    padding: 15px 20px;
    color: #666;
    font-size: var(--text-scale-5xs);
    letter-spacing: var(--tracking-tag);
  }

  .display-header {
    border-bottom: 1px dashed var(--border);
  }

  .display-light {
    color: var(--terminal-green);
  }

  .display-visual {
