  }

  .skill-tree-label {
    position: absolute;
    top: 18px;
    left: 22px;
    right: 22px;
    display: flex;
    justify-content: space-between;
    color: #4b4b50;
    font-size: 8px;
    letter-spacing: var(--tracking-tag);
    z-index: 5;
  }

  .skill-main-line {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 51%;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      rgba(232, 160, 64, 0.35) 0,
      rgba(232, 160, 64, 0.35) 8px,
      transparent 8px,
      transparent 16px
    );
    z-index: 1;
  }

  .skill-main-line span {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(232, 160, 64, 0.05),
      rgba(232, 160, 64, 0.55),
      rgba(100, 210, 190, 0.75)
    );
