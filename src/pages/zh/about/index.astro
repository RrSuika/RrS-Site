>
  /* =====================================================
  04 — SEQUENTIAL DESIGN PROCESS
  ====================================================== */

  const processStation = document.querySelector("[data-process-sequence]");
  const processItems = processStation
    ? Array.from(processStation.querySelectorAll("[data-process-step]"))
    : [];
  const processProgress = document.querySelector(".station-track-progress");

  let processIndex = 0;
  let processTimer = null;
  let processStarted = false;
  let processVisible = false;

  function updateProcess(index) {
    if (!processItems.length) return;
    processIndex = index;

    processItems.forEach((item, i) => {
      item.classList.remove("process-active", "process-complete");
      const state = item.querySelector(".station-state");
      if (i < index) {
        item.classList.add("process-complete");
        if (state) state.textContent = "完成";
      } else if (i === index) {
        item.classList.add("process-active");
        if (state) state.textContent = "运行中";
      } else {
        if (state) state.textContent = "等待中";
      }
    });

    if (processProgress) {
      const progress =
        processItems.length <= 1 ? 0 : index / (processItems.length - 1);
      processProgress.style.width = `${progress * 100}%`;
    }
  }

  function nextProcessStation() {
    if (!processStarted || !processVisible) return;
    processIndex = (processIndex + 1) % processItems.length;
    updateProcess(processIndex);
  }

  function startProcessSequence() {
    if (processStarted || !processItems.length) return;
    processStarted = true;
    updateProcess(0);
  }

  function pauseProcess() {
    if (processTimer) {
      clearInterval(processTimer);
      processTimer = null;
    }
  }

  function resumeProcess() {
    if (!processVisible || !processStarted) return;
    if (!processTimer) {
      processTimer = setInterval(nextProcessStation, 1500);
    }
  }

  if (processStation) {
    const processObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          processVisible = entry.isIntersecting;
          if (processVisible) {
            if (!processStarted) {
              startProcessSequence();
            }
            resumeProcess();
          } else {
            pauseProcess();
          }
        });
      },
      { threshold: 0.1 },
    );
    processObserver.observe(processStation);
  }

  /* =====================================================
  05 — CAPABILITY MATRIX
  ====================================================== */

  const modules = {
    industrial,
    mechanical,
    electronics,
    embedded,
    fabrication,
    visual,
    software,
    teaching,
  };

  const buttons = Array.from(document.querySelectorAll(".cap-button"));
  const title = document.querySelector("#cap-title");
  const description = document.querySelector("#cap-description");
  const status = document.querySelector("#cap-status");
  const canvas = document.querySelector("#capabilityCanvas");
  const ctx = canvas?.getContext("2d");

  let activeIndex = 0;
  let animationId = null;
  let moduleTimer = null;
  let canvasVisible = false;

  let mouseX = 0.5;
  let mouseY = 0.5;
  let W = 0;
  let H = 0;
  let time = 0;

  function resizeCanvas() {
    if (!canvas || !ctx) return;
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    W = rect.width;
    H = rect.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function updateMouse(e) {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    mouseX = (e.clientX - rect.left) / rect.width;
    mouseY = (e.clientY - rect.top) / rect.height;
    mouseX = Math.max(0, Math.min(1, mouseX));
    mouseY = Math.max(0, Math.min(1, mouseY));
    manualInteraction = true;
  }

  canvas?.addEventListener("mousemove", updateMouse);
  canvas?.addEventListener("mouseleave", () => {
    mouseX = 0.5;
    mouseY = 0.5;
  });

  function roundedRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  function drawGrid() {
    ctx.strokeStyle = "rgba(255,255,255,0.035)";
    ctx.lineWidth = 0.5;
    const spacing = 38;
    for (let x = 0; x < W; x += spacing) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, H);
      ctx.stroke();
    }
    for (let y = 0; y < H; y += spacing) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }
  }

  /* =====================================================
  DRAW: 工业及产品设计 — 3D 环面模型
  ====================================================== */
  function draw3DModel() {
    const cx = W / 2;
    const cy = H / 2;
    const R = Math.min(W, H) * 0.28;
    const r = R * 0.4;

    const rotX = time * 0.6;
    const rotY = time * 0.9;

    ctx.strokeStyle = "rgba(232,160,64,0.55)";
    ctx.lineWidth = 1.2;
    ctx.shadowColor = "rgba(232,160,64,0.25)";
    ctx.shadowBlur = 6;

    const stepU = (Math.PI * 2) / 16;
    const stepV = (Math.PI * 2) / 20;

    // 横向环线
    for (let v = 0; v < Math.PI * 2; v += stepV) {
      ctx.beginPath();
      for (let u = 0; u <= Math.PI * 2; u += 0.1) {
        const px = (R + r * Math.cos(v)) * Math.cos(u);
        const py = (R + r * Math.cos(v)) * Math.sin(u);
        const pz = r * Math.sin(v);
        const x1 = px * Math.cos(rotY) - pz * Math.sin(rotY);
        const z1 = px * Math.sin(rotY) + pz * Math.cos(rotY);
        const y1 = py * Math.cos(rotX) - z1 * Math.sin(rotX);
        const z2 = py * Math.sin(rotX) + z1 * Math.cos(rotX);
        const scale = 400 / (400 + z2);
        const sx = cx + x1 * scale;
        const sy = cy - y1 * scale;
        if (u === 0) ctx.moveTo(sx, sy);
        else ctx.lineTo(sx, sy);
      }
      ctx.stroke();
    }

    // 纵向环线
    for (let u = 0; u < Math.PI * 2; u += stepU) {
      ctx.beginPath();
      for (let v = 0; v <= Math.PI * 2; v += 0.1) {
        const px = (R + r * Math.cos(v)) * Math.cos(u);
        const py = (R + r * Math.cos(v)) * Math.sin(u);
        const pz = r * Math.sin(v);
        const x1 = px * Math.cos(rotY) - pz * Math.sin(rotY);
        const z1 = px * Math.sin(rotY) + pz * Math.cos(rotY);
        const y1 = py * Math.cos(rotX) - z1 * Math.sin(rotX);
        const z2 = py * Math.sin(rotX) + z1 * Math.cos(rotX);
        const scale = 400 / (400 + z2);
        const sx = cx + x1 * scale;
        const sy = cy - y1 * scale;
        if (v === 0) ctx.moveTo(sx, sy);
        else ctx.lineTo(sx, sy);
      }
      ctx.stroke();
    }

    ctx.shadowBlur = 0;
  }

  /* =====================================================
  DRAW: 机械设计 (CMF) — 巨大旋转方块色环
  ====================================================== */
  function drawCMF() {
    const cols = 8;
    const rows = 6;
    const pad = 6;
    const cellW = (W - pad * (cols + 1)) / cols;
    const cellH = (H - pad * (rows + 1)) / rows;
    const totalW = cellW * cols + pad * (cols - 1);
    const totalH = cellH * rows + pad * (rows - 1);
    const startX = (W - totalW) / 2;
    const startY = (H - totalH) / 2;

    // 材质绘制函数
    function drawGlossy(cx, cy, w, h, hue, sat, light) {
      const grad = ctx.createLinearGradient(cx, cy - h / 2, cx, cy + h / 2);
      grad.addColorStop(0, `hsl(${hue},${sat}%,${light + 20}%)`);
      grad.addColorStop(0.3, `hsl(${hue},${sat}%,${light}%)`);
      grad.addColorStop(1, `hsl(${hue},${sat * 0.8}%,${light - 10}%)`);
      ctx.fillStyle = grad;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 4);
      ctx.fill();

      ctx.fillStyle = `rgba(255,255,255,0.55)`;
      ctx.beginPath();
      roundedRect(cx - w / 2 + 2, cy - h / 2 + 2, w - 4, h * 0.28, 4);
      ctx.fill();
    }

    function drawMatte(cx, cy, w, h, hue, sat, light) {
      ctx.fillStyle = `hsl(${hue},${sat * 0.6}%,${light * 0.9}%)`;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 4);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 4);
      ctx.clip();
      const dotCount = Math.floor(w * h * 0.25);
      for (let i = 0; i < dotCount; i++) {
        const dx = cx - w / 2 + Math.random() * w;
        const dy = cy - h / 2 + Math.random() * h;
        const alpha = 0.05 + Math.random() * 0.08;
        ctx.fillStyle = `rgba(255,255,255,${alpha})`;
        ctx.beginPath();
        ctx.arc(dx, dy, 0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(0,0,0,${alpha * 0.8})`;
        ctx.beginPath();
        ctx.arc(dx + 0.5, dy + 0.5, 0.5, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    function drawMetallic(cx, cy, w, h, hue, sat, light) {
      const grad = ctx.createLinearGradient(
        cx - w / 2,
        cy - h / 2,
        cx + w / 2,
        cy + h / 2,
      );
      grad.addColorStop(0, `hsl(${hue},${sat}%,${light + 25}%)`);
      grad.addColorStop(0.3, `hsl(${hue},${sat * 0.6}%,${light}%)`);
      grad.addColorStop(0.6, `hsl(${hue},${sat}%,${light - 5}%)`);
      grad.addColorStop(1, `hsl(${hue},${sat * 0.7}%,${light - 18}%)`);
      ctx.fillStyle = grad;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 2);
      ctx.fill();

      ctx.strokeStyle = `hsla(${hue},80%,75%,0.45)`;
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }

    function drawPlastic(cx, cy, w, h, hue, sat, light) {
      ctx.fillStyle = `hsl(${hue},${sat}%,${light}%)`;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 5);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 5);
      ctx.clip();
      ctx.strokeStyle = `rgba(255,255,255,0.6)`;
      ctx.lineWidth = 2;
      ctx.stroke();

      const glowGrad = ctx.createRadialGradient(
        cx - w * 0.2,
        cy - h * 0.25,
        0,
        cx,
        cy,
        w * 0.5,
      );
      glowGrad.addColorStop(0, `rgba(255,255,255,0.4)`);
      glowGrad.addColorStop(1, `rgba(255,255,255,0)`);
      ctx.fillStyle = glowGrad;
      ctx.fillRect(cx - w / 2, cy - h / 2, w, h);
      ctx.restore();
    }

    function drawLeather(cx, cy, w, h, hue, sat, light) {
      const baseColor = `hsl(${hue},${sat * 0.5}%,${light * 0.7}%)`;
      ctx.fillStyle = baseColor;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.clip();
      for (let i = 0; i < 15; i++) {
        const dx = cx - w / 2 + 4 + ((i * 6.7) % (w - 8));
        const dy = cy - h / 2 + 3 + ((i * 8.3) % (h - 6));
        ctx.fillStyle = `rgba(0,0,0,0.15)`;
        ctx.beginPath();
        ctx.arc(dx, dy, 0.6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(255,255,255,0.1)`;
        ctx.beginPath();
        ctx.arc(dx + 1.2, dy - 0.8, 0.4, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    function drawTextured(cx, cy, w, h, hue, sat, light) {
      ctx.fillStyle = `hsl(${hue},${sat}%,${light}%)`;
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      roundedRect(cx - w / 2, cy - h / 2, w, h, 3);
      ctx.clip();
      ctx.strokeStyle = `rgba(255,255,255,0.18)`;
      ctx.lineWidth = 0.6;
      for (let lx = -w; lx < w; lx += 5) {
        ctx.beginPath();
        ctx.moveTo(cx - w / 2 + lx, cy - h / 2);
        ctx.lineTo(cx - w / 2 + lx + h, cy + h / 2);
        ctx.stroke();
      }
      for (let lx = -w; lx < w; lx += 5) {
        ctx.beginPath();
        ctx.moveTo(cx - w / 2 + lx + h, cy - h / 2);
        ctx.lineTo(cx - w / 2 + lx, cy + h / 2);
        ctx.stroke();
      }
      ctx.restore();
    }

    const materialDraw = [
      drawGlossy,
      drawMatte,
      drawMetallic,
      drawPlastic,
      drawLeather,
      drawTextured,
    ];

    for (let r = 0; r < rows; r++) {
      const drawFn = materialDraw[r];
      for (let c = 0; c < cols; c++) {
        const x = startX + c * (cellW + pad) + cellW / 2;
        const y = startY + r * (cellH + pad) + cellH / 2;
        const hue = ((c / cols) * 360 + (r / rows) * 40 + time * 8) % 360;
        let sat = 55 + 20 * Math.sin(time * 0.5 + r + c);
        // Boost orange (~15-45) and purple (~260-300)
        if ((hue > 15 && hue < 45) || (hue > 260 && hue < 300)) {
          sat = Math.min(100, sat * 1.35);
        }
        const light = 38 + 15 * Math.cos(time * 0.4 + c);
        drawFn(x, y, cellW, cellH, hue, sat, light);
      }
    }
  }

  /* =====================================================
  DRAW: 电子
  ====================================================== */
  function drawElectronics() {
    const mx = mouseX * W;
    const my = mouseY * H;
    const t = time;
    const isLight =
      document.documentElement.getAttribute("data-theme") === "light";

    ctx.fillStyle = isLight ? "#e8e3da" : "#070a08";
    ctx.fillRect(0, 0, W, H);

    // Grid
    ctx.strokeStyle = isLight ? "rgba(0,0,0,0.06)" : "rgba(30,60,45,0.25)";
    ctx.lineWidth = 0.4;
    for (let x = 0; x < W; x += 24) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, H);
      ctx.stroke();
    }
    for (let y = 0; y < H; y += 24) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }

    const amp = H * 0.1;

    const channels = [
      {
        baseY: H * 0.22,
        color: isLight ? "rgba(0,120,60,0.9)" : "rgba(100,220,160,0.85)",
        type: "square",
        freq: 4.5,
        label: "CH1 — SQUARE",
      },
      {
        baseY: H * 0.5,
        color: isLight ? "rgba(30,80,140,0.85)" : "rgba(160,200,230,0.8)",
        type: "sine",
        freq: 3.0,
        label: "CH2 — SINE",
      },
      {
        baseY: H * 0.78,
        color: isLight ? "rgba(120,40,100,0.8)" : "rgba(200,160,220,0.75)",
        type: "triangle",
        freq: 5.5,
        label: "CH3 — TRI",
      },
    ];

    // Dividers
    channels.forEach((ch) => {
      ctx.strokeStyle = isLight ? "rgba(0,0,0,0.08)" : "rgba(60,100,80,0.25)";
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.moveTo(0, ch.baseY);
      ctx.lineTo(W, ch.baseY);
      ctx.stroke();
    });

    function waveVal(ch, prog) {
      const arg = prog * Math.PI * 2 * ch.freq + t * 1.67;
      if (ch.type === "square") return Math.sin(arg) >= 0 ? 1 : -1;
      if (ch.type === "sine") return Math.sin(arg);
      if (ch.type === "triangle") {
        const ph = (((arg / (Math.PI * 2)) % 1) + 1) % 1;
        return ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph;
      }
      return 0;
    }

    // Draw
    channels.forEach((ch) => {
      ctx.strokeStyle = ch.color;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      for (let px = 0; px < W; px += 1.5) {
        const wy = ch.baseY - waveVal(ch, px / W) * amp;
        if (px === 0) ctx.moveTo(px, wy);
        else ctx.lineTo(px, wy);
      }
      ctx.stroke();
    });

    // Labels
    channels.forEach((ch) => {
      ctx.fillStyle = ch.color.replace(/[\d.]+\)$/, "0.5)");
      ctx.font = "8px monospace";
      ctx.textAlign = "left";
      ctx.fillText(ch.label, 8, ch.baseY - amp - 8);
    });

    // Mouse highlight
    let nearest = -1,
      nearestDist = Infinity;
    channels.forEach((ch, i) => {
      const wy = ch.baseY - waveVal(ch, mx / W) * amp;
      const d = Math.abs(my - wy);
      if (d < nearestDist && d < 40) {
        nearestDist = d;
        nearest = i;
      }
    });

    if (nearest >= 0) {
      const ch = channels[nearest];
      ctx.strokeStyle = ch.color.replace(/[\d.]+\)$/, "1)");
      ctx.lineWidth = 2.2;
      ctx.shadowColor = ch.color.replace(/[\d.]+\)$/, "0.6)");
      ctx.shadowBlur = 8;
      ctx.beginPath();
      for (let px = 0; px < W; px += 1.5) {
        const wy = ch.baseY - waveVal(ch, px / W) * amp;
        if (px === 0) ctx.moveTo(px, wy);
        else ctx.lineTo(px, wy);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
    }

    ctx.fillStyle = "rgba(160,180,170,0.3)";
    ctx.font = "7px monospace";
    ctx.textAlign = "right";
    ctx.fillText("TRIG:AUTO · 1V/div", W - 8, H * 0.06);
  }
  function drawEmbedded() {
    const isLight =
      document.documentElement.getAttribute("data-theme") === "light";
    for (let i = 0; i < 18; i++) {
      ctx.beginPath();
      const y = H * 0.18 + i * H * 0.035;
      for (let x = 0; x <= W; x += 5) {
        const distance = Math.abs(x - W * 0.5) / W;
        const amplitude = (1 - distance) * 30;
        const wave = Math.sin(x * 0.035 + time * 1.8 + i * 0.35) * amplitude;
        const yy = y + wave;
        if (x === 0) ctx.moveTo(x, yy);
        else ctx.lineTo(x, yy);
      }
      ctx.strokeStyle =
        i === 9
          ? "#e8a040"
          : isLight
            ? `rgba(80,80,80,${0.06 + i * 0.004})`
            : `rgba(220,220,220,${0.08 + i * 0.005})`;
      ctx.stroke();
    }
  }

  /* =====================================================
  DRAW: 制造与加工 — 精致化流水线
  ====================================================== */
  function drawFabrication() {
    const isLight =
      document.documentElement.getAttribute("data-theme") === "light";
    const beltH = 22;
    const gap = 30;
    const beltCount = 3;
    const totalH = beltCount * beltH + (beltCount - 1) * gap;
    const startY = (H - totalH) / 2 + H * 0.04;

    for (let b = 0; b < beltCount; b++) {
      const by = startY + b * (beltH + gap);
      const dir = b % 2 === 0 ? 1 : -1; // alternate directions
      const speed = 8 + b * 2; // much slower

      // ── Belt body with gradient ──
      const beltGrad = ctx.createLinearGradient(0, by, 0, by + beltH);
      if (isLight) {
        beltGrad.addColorStop(0, "#d5d0c8");
        beltGrad.addColorStop(0.5, "#c8c3ba");
        beltGrad.addColorStop(1, "#d5d0c8");
      } else {
        beltGrad.addColorStop(0, "#1a1c1e");
        beltGrad.addColorStop(0.5, "#222528");
        beltGrad.addColorStop(1, "#1a1c1e");
      }
      ctx.fillStyle = beltGrad;
      ctx.fillRect(0, by, W, beltH);

      // ── Belt edge lines ──
      ctx.strokeStyle = isLight
        ? "rgba(150,140,130,0.25)"
        : "rgba(180,190,180,0.15)";
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.moveTo(0, by);
      ctx.lineTo(W, by);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(0, by + beltH);
      ctx.lineTo(W, by + beltH);
      ctx.stroke();

      // ── Moving tread marks (slow) ──
      const treadW = 5;
      const treadGap = 16;
      const shift =
        (((time * speed * dir * 0.6) % (treadW + treadGap)) +
          (treadW + treadGap)) %
        (treadW + treadGap);
      for (let tx = -treadW + shift; tx < W + treadW; tx += treadW + treadGap) {
        ctx.fillStyle = isLight
          ? "rgba(140,130,120,0.18)"
          : "rgba(100,110,100,0.18)";
        ctx.fillRect(tx, by + 1, treadW, beltH - 2);
      }

      // ── Ores ──
      const itemCount = 9 + b;
      for (let p = 0; p < itemCount; p++) {
        const phase = (((time * 0.003 * speed * dir + p * 0.22) % 1) + 1) % 1;
        const ix = phase * W;
        const bob = Math.sin(time * 2.5 + p + b) * 1.5;
        const iy = by + beltH / 2 + bob;

        // Rarity: 60% coal, 30% iron, 9% gold, 1% diamond (deterministic per item)
        // Rarity: 59.9% coal, 30% iron, 9% gold, 1% diamond, 0.1% prismatic
        let seed = (p * 127 + b * 3571) | 0;
        seed = ((seed >> 16) ^ seed) * 0x45d9f3b;
        seed = ((seed >> 16) ^ seed) >>> 0;
        const rarity = (seed % 10000) / 10000;

        let oreType, oreSize, oreColors;
        if (rarity < 0.599) {
          oreType = "coal";
          oreSize = 11;
          oreColors = ["#6a6a72", "#3a3a42"];
        } else if (rarity < 0.899) {
          oreType = "iron";
          oreSize = 10;
          oreColors = ["#d09070", "#8a4030"];
        } else if (rarity < 0.989) {
          oreType = "gold";
          oreSize = 12;
          oreColors = ["#f5d060", "#c08820"];
        } else if (rarity < 0.999) {
          oreType = "diamond";
          oreSize = 10;
          oreColors = ["#e8f4ff", "#a0c8f0"];
        } else {
          oreType = "prismatic";
          oreSize = 9;
          oreColors = ["#ffffff", "#e0d0ff"];
        }

        ctx.save();
        ctx.translate(ix, iy);

        // ── Diamond / Prismatic sparkle aura ──
        if (oreType === "diamond" || oreType === "prismatic") {
          const sparkle = Math.sin(time * 8 + p) * 0.3 + 0.7;
          const halo = ctx.createRadialGradient(0, 0, 0, 0, 0, oreSize * 2.2);
          halo.addColorStop(0, `rgba(200,220,255,${0.5 * sparkle})`);
          halo.addColorStop(0.5, `rgba(180,200,255,${0.2 * sparkle})`);
          halo.addColorStop(1, "rgba(0,0,0,0)");
          ctx.fillStyle = halo;
          ctx.beginPath();
          ctx.arc(0, 0, oreSize * 2.2, 0, Math.PI * 2);
          ctx.fill();
          // Rainbow facets
          for (let f = 0; f < 6; f++) {
            const fa = (f / 6) * Math.PI * 2 + time * 0.8;
            ctx.fillStyle = `hsla(${(f * 60 + time * 40) % 360},70%,75%,${0.12 * sparkle})`;
            ctx.beginPath();
            ctx.arc(
              Math.cos(fa) * oreSize * 0.45,
              Math.sin(fa) * oreSize * 0.45,
              oreSize * 0.4,
              0,
              Math.PI * 2,
            );
            ctx.fill();
          }
        }

        // ── Shadow (offset) ──
        ctx.save();
        ctx.translate(2, 2);
        ctx.fillStyle = "rgba(0,0,0,0.3)";
        ctx.beginPath();

        // ── Ore shapes ──
        if (oreType === "coal") {
          // Coal chunk: irregular rocky blob
          const s = oreSize;
          ctx.moveTo(-s * 0.6, s * 0.5);
          ctx.lineTo(-s, s * 0.1);
          ctx.lineTo(-s * 0.8, -s * 0.4);
          ctx.lineTo(-s * 0.3, -s * 0.7);
          ctx.lineTo(s * 0.2, -s * 0.8);
          ctx.lineTo(s * 0.7, -s * 0.3);
          ctx.lineTo(s * 0.9, s * 0.2);
          ctx.lineTo(s * 0.4, s * 0.6);
          ctx.lineTo(-s * 0.1, s * 0.7);
          ctx.closePath();
        } else if (oreType === "iron") {
          // Raw iron ore: jagged crystalline
          const s = oreSize;
          ctx.moveTo(-s * 0.3, s * 0.6);
          ctx.lineTo(-s * 0.8, s * 0.2);
          ctx.lineTo(-s, -s * 0.3);
          ctx.lineTo(-s * 0.5, -s * 0.6);
          ctx.lineTo(s * 0.1, -s * 0.8);
          ctx.lineTo(s * 0.6, -s * 0.4);
          ctx.lineTo(s * 0.9, s * 0.1);
          ctx.lineTo(s * 0.4, s * 0.5);
          ctx.lineTo(-s * 0.1, s * 0.7);
          ctx.closePath();
        } else if (oreType === "gold") {
          // Gold ingot: rounded trapezoid bar
          const s = oreSize;
          ctx.moveTo(-s * 0.75, s * 0.3);
          ctx.lineTo(-s * 0.85, -s * 0.15);
          ctx.lineTo(-s * 0.65, -s * 0.4);
          ctx.lineTo(s * 0.65, -s * 0.4);
          ctx.lineTo(s * 0.85, -s * 0.15);
          ctx.lineTo(s * 0.75, s * 0.3);
          ctx.lineTo(-s * 0.75, s * 0.3);
          ctx.closePath();
        } else if (oreType === "diamond") {
          // Diamond gem shape
          const s = oreSize;
          ctx.moveTo(0, -s);
          ctx.lineTo(s * 0.4, -s * 0.15);
          ctx.lineTo(s * 0.7, s * 0.1);
          ctx.lineTo(s * 0.3, s * 0.15);
          ctx.lineTo(0, s * 0.7);
          ctx.lineTo(-s * 0.3, s * 0.15);
          ctx.lineTo(-s * 0.7, s * 0.1);
          ctx.lineTo(-s * 0.4, -s * 0.15);
          ctx.closePath();
        } else {
          // Prismatic shard: sharp crystal spike
          const s = oreSize;
          ctx.moveTo(0, -s);
          ctx.lineTo(s * 0.25, -s * 0.2);
          ctx.lineTo(s * 0.9, s * 0.05);
          ctx.lineTo(s * 0.3, s * 0.25);
          ctx.lineTo(s * 0.6, s * 0.8);
          ctx.lineTo(0, s * 0.45);
          ctx.lineTo(-s * 0.6, s * 0.8);
          ctx.lineTo(-s * 0.3, s * 0.25);
          ctx.lineTo(-s * 0.9, s * 0.05);
          ctx.lineTo(-s * 0.25, -s * 0.2);
          ctx.closePath();
        }
        ctx.fill();
        ctx.restore();
        // Body
        const g = ctx.createLinearGradient(
          -oreSize,
          -oreSize,
          oreSize,
          oreSize,
        );
        g.addColorStop(0, oreColors[0]);
        g.addColorStop(1, oreColors[1]);
        ctx.fillStyle = g;
        // Stroke varies by type
        if (oreType === "gold") {
          ctx.strokeStyle = "rgba(255,220,100,0.5)";
          ctx.lineWidth = 1;
        } else if (oreType === "diamond") {
          ctx.strokeStyle = "rgba(200,220,255,0.55)";
          ctx.lineWidth = 0.7;
        } else if (oreType === "prismatic") {
          ctx.strokeStyle = "rgba(255,200,255,0.55)";
          ctx.lineWidth = 0.7;
        } else {
          ctx.strokeStyle = "rgba(255,255,255,0.12)";
          ctx.lineWidth = 0.5;
        }
        ctx.stroke();
        ctx.fill();

        // ── Specular ──
        if (oreType === "diamond") {
          ctx.fillStyle = "rgba(255,255,255,0.7)";
          ctx.beginPath();
          ctx.arc(0, -oreSize * 0.4, oreSize * 0.15, 0, Math.PI * 2);
          ctx.fill();
        } else if (oreType === "prismatic") {
          ctx.fillStyle = "rgba(255,255,255,0.8)";
          ctx.beginPath();
          ctx.arc(0, -oreSize * 0.3, oreSize * 0.13, 0, Math.PI * 2);
          ctx.fill();
          // Extra rainbow sparkle
          for (let rf = 0; rf < 3; rf++) {
            const ra = (rf / 3) * Math.PI * 2 + time * 1.2;
            ctx.fillStyle = `hsla(${(rf * 120 + time * 60) % 360},80%,70%,0.6)`;
            ctx.beginPath();
            ctx.arc(
              Math.cos(ra) * oreSize * 0.35,
              Math.sin(ra) * oreSize * 0.35,
              oreSize * 0.12,
              0,
              Math.PI * 2,
            );
            ctx.fill();
          }
        } else if (oreType === "gold") {
          ctx.fillStyle = "rgba(255,255,220,0.5)";
          ctx.beginPath();
          ctx.arc(
            -oreSize * 0.15,
            -oreSize * 0.2,
            oreSize * 0.18,
            0,
            Math.PI * 2,
          );
          ctx.fill();
          // Second bar highlight
          ctx.fillStyle = "rgba(255,255,255,0.2)";
          ctx.fillRect(
            -oreSize * 0.5,
            -oreSize * 0.35,
            oreSize,
            oreSize * 0.12,
          );
        }

        ctx.restore();
      }
    }
  }

  /* =====================================================
  DRAW: Illustration & Visual Design
  ====================================================== */
  function drawVisual() {
    const cols = 10;
    const rows = 6;
    const cw = W / cols;
    const ch = H / rows;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const nx = (c + 0.5) / cols;
        const ny = (r + 0.5) / rows;
        const dx = nx - mouseX;
        const dy = ny - mouseY;
        const dist = Math.hypot(dx, dy);
        const hue =
          (330 +
            nx * 70 +
            ny * 95 +
            time * 12 +
            Math.sin(dist * 12 - time) * 35) %
          360;
        const sat = 55 + 35 * (1 - Math.min(1, dist * 1.8));
        const light = 32 + 28 * (1 - Math.min(1, dist * 1.5));
        const pad = 4 + 6 * (1 - Math.min(1, dist * 1.6));
        const x = c * cw + pad;
        const y = r * ch + pad;
        const w = cw - pad * 2;
        const h = ch - pad * 2;
        ctx.fillStyle = `hsla(${hue},${sat}%,${light}%,0.82)`;
        ctx.shadowColor = `hsla(${hue},80%,60%,0.18)`;
        ctx.shadowBlur = 12;
        roundedRect(x, y, w, h, 4);
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.fillStyle = "rgba(255,255,255,0.035)";
        ctx.fillRect(x + w * 0.22, y + h * 0.34, w * 0.56, h * 0.2);
        ctx.fillStyle = "rgba(255,190,100,0.18)";
        ctx.beginPath();
        ctx.arc(x + w * 0.18, y + h * 0.78, 1.4, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    const glow = ctx.createRadialGradient(
      mouseX * W,
      mouseY * H,
      0,
      mouseX * W,
      mouseY * H,
      100,
    );
    glow.addColorStop(0, "rgba(232,160,64,0.13)");
    glow.addColorStop(1, "rgba(232,160,64,0)");
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(mouseX * W, mouseY * H, 100, 0, Math.PI * 2);
    ctx.fill();
  }

  /* =====================================================
  DRAW: 数字工具
  ====================================================== */
  function drawSoftware() {
    ctx.font = "10px monospace";
    ctx.textAlign = "left";
    const isLight =
      document.documentElement.getAttribute("data-theme") === "light";
    const lines = [
      "> 初始化_rrsuika();",
      "> 加载_设计系统();",
      "> 编译_几何();",
      "> 构建.原型();",
      "> 测试();",
      "> 迭代();",
      "> 系统就绪_",
    ];
    lines.forEach((line, i) => {
      const alpha = 0.15 + 0.1 * Math.sin(time * 2 - i);
      ctx.fillStyle =
        i === 6
          ? "#e8a040"
          : isLight
            ? `rgba(60,60,60,${alpha + 0.25})`
            : `rgba(220,220,220,${alpha})`;
      ctx.fillText(line, W * 0.2, H * 0.22 + i * 25);
    });
    ctx.strokeStyle = "rgba(232,160,64,0.35)";
    ctx.beginPath();
    ctx.moveTo(W * 0.18, H * 0.82);
    ctx.lineTo(W * 0.82, H * 0.82);
    ctx.stroke();
    const progress = (Math.sin(time) + 1) / 2;
    ctx.fillStyle = "#e8a040";
    ctx.fillRect(W * 0.18, H * 0.82 - 2, W * 0.64 * progress, 4);
  }

  /* =====================================================
  DRAW: 绘画教学 — 双DNA螺旋
  ====================================================== */
  function drawTeaching() {
    const cx = W / 2,
      cy = H / 2;
    const helixR = Math.min(W, H) * 0.18;
    const helixH = H * 0.64;
    const turns = 5;
    const steps = 400;
    const phaseShift = time * 0.5;

    // Strand 1
    ctx.strokeStyle = "rgba(100,220,180,0.8)";
    ctx.lineWidth = 1.6;
    ctx.shadowColor = "rgba(100,220,180,0.35)";
    ctx.shadowBlur = 4;
    ctx.beginPath();
    for (let i = 0; i <= steps; i++) {
      const prog = i / steps;
      const py = cy - helixH / 2 + prog * helixH;
      const theta = prog * turns * Math.PI * 2 + phaseShift;
      if (i === 0) ctx.moveTo(cx + Math.cos(theta) * helixR, py);
      else ctx.lineTo(cx + Math.cos(theta) * helixR, py);
    }
    ctx.stroke();

    // Strand 2
    ctx.strokeStyle = "rgba(232,160,64,0.8)";
    ctx.lineWidth = 1.6;
    ctx.shadowColor = "rgba(232,160,64,0.35)";
    ctx.shadowBlur = 4;
    ctx.beginPath();
    for (let i = 0; i <= steps; i++) {
      const prog = i / steps;
      const py = cy - helixH / 2 + prog * helixH;
      const theta = prog * turns * Math.PI * 2 + Math.PI + phaseShift;
      if (i === 0) ctx.moveTo(cx + Math.cos(theta) * helixR, py);
      else ctx.lineTo(cx + Math.cos(theta) * helixR, py);
    }
    ctx.stroke();
    ctx.shadowBlur = 0;

    // Base-pair rungs
    for (let i = 0; i <= steps; i += 12) {
      const prog = i / steps;
      const py = cy - helixH / 2 + prog * helixH;
      const theta = prog * turns * Math.PI * 2 + phaseShift;
      const x1 = cx + Math.cos(theta) * helixR;
      const x2 = cx + Math.cos(theta + Math.PI) * helixR;
      ctx.strokeStyle = "rgba(180,200,220,0.35)";
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      ctx.moveTo(x1, py);
      ctx.lineTo(x2, py);
      ctx.stroke();
    }
  }

  /* =====================================================
  CAPABILITY DISPATCH
  ====================================================== */
  function drawCapability() {
    if (!ctx || !canvasVisible) return;
    ctx.clearRect(0, 0, W, H);
    const isLight =
      document.documentElement.getAttribute("data-theme") === "light";
    ctx.fillStyle = isLight ? "#e8e3da" : "#09090b";
    ctx.fillRect(0, 0, W, H);
    if (!isLight) drawGrid();

    const key = buttons[activeIndex]?.dataset.cap;
    switch (key) {
      case "industrial":
        draw3DModel();
        break;
      case "mechanical":
        drawCMF();
        break;
      case "electronics":
        drawElectronics();
        break;
      case "embedded":
        drawEmbedded();
        break;
      case "fabrication":
        drawFabrication();
        break;
      case "visual":
        drawVisual();
        break;
      case "software":
        drawSoftware();
        break;
      case "teaching":
        drawTeaching();
        break;
    }

    time += 0.016;
    animationId = requestAnimationFrame(drawCapability);
  }

  function activateModule(index, manual = false) {
    if (index < 0 || index >= buttons.length) return;
    activeIndex = index;
    const button = buttons[index];
    const key = button.dataset.cap;
    if (!key || !modules[key]) return;

    buttons.forEach((item) => item.classList.remove("active"));
    button.classList.add("active");
    title.textContent = modules[key].title;
    description.textContent = modules[key].description;
    status.textContent = `模块_${String(index + 1).padStart(2, "0")}`;

    if (manual) {
      manualInteraction = true;
    }
  }

  buttons.forEach((button, index) => {
    button.addEventListener("click", () => {
      activateModule(index, true);
      clearInterval(moduleTimer);
      moduleTimer = setInterval(nextModule, 4200);
    });
  });

  function nextModule() {
    activeIndex = (activeIndex + 1) % buttons.length;
    activateModule(activeIndex);
  }

  function startModuleAutoRotate() {
    if (moduleTimer) return;
    moduleTimer = setInterval(nextModule, 4200);
  }

  function stopModuleAutoRotate() {
    clearInterval(moduleTimer);
    moduleTimer = null;
  }

  function startCanvas() {
    if (!canvasVisible || animationId) return;
    resizeCanvas();
    drawCapability();
    startModuleAutoRotate();
  }

  function stopCanvas() {
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
    stopModuleAutoRotate();
  }

  const displayVisual = document.querySelector(".display-visual");
  if (displayVisual && canvas) {
    const canvasObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          canvasVisible = entry.isIntersecting;
          if (canvasVisible) {
            startCanvas();
          } else {
            stopCanvas();
          }
        });
      },
      { threshold: 0.1 },
    );
    canvasObserver.observe(displayVisual);
  }

  window.addEventListener("resize", () => {
    resizeCanvas();
  });

  activateModule(0);
</script>

<script>
  /* =====================================================
  09 — STYLE GENEALOGY ANNEX (easter egg)
  独立脚本：与页面主脚本隔离，主脚本出错也不会影响彩蛋
  ====================================================== */

  const annexPanel = document.getElementById("style-annex-panel");
  const enterKey = document.querySelector(".enter-key");

  // 打字机引擎 ; 逐字符输出，结束后恢复原始 HTML 结构
  function typeAnnexBlock(
    el: HTMLElement,
    original: string,
    speed: number,
  ): Promise<void> {
    return new Promise<void>((resolve) => {
      const temp = document.createElement("div");
      temp.innerHTML = original;
      const text = temp.textContent || "";
      let i = 0;
      const timer = setInterval(() => {
        if (i < text.length) {
          el.textContent = text.slice(0, i + 1);
          i++;
        } else {
          clearInterval(timer);
          el.innerHTML = original;
          el.classList.remove("typing");
          resolve();
        }
      }, speed);
    });
  }

  // 每类区块的输出速度（毫秒/字符）：2026-08 提速（用户要求打字更快）
  function annexSpeed(el: HTMLElement): number {
    if (el.classList.contains("annex-intro")) return 2;
    if (el.classList.contains("annex-style-index")) return 1;
    if (el.classList.contains("annex-refs")) return 1;
    return 2;
  }

  let annexTyped = false;

  if (annexPanel && enterKey) {
    enterKey.addEventListener("click", () => {
      const wasOpen = !annexPanel.hidden;
      if (wasOpen) {
        annexPanel.hidden = true;
        enterKey.setAttribute("aria-expanded", "false");
        return;
      }

      enterKey.setAttribute("aria-expanded", "true");

      if (!annexTyped) {
        annexTyped = true;
        const blocks = annexPanel.querySelectorAll<HTMLElement>(
          ".annex-intro, .annex-style-index, .annex-entry p, .annex-refs, .annex-works-list li",
        );
        // 先同步清空所有区块，再显示面板;避免先闪现全文再打字
        blocks.forEach((el) => {
          el.dataset.annexOriginal = el.innerHTML;
          el.innerHTML = "";
          el.classList.add("typing");
        });
        annexPanel.hidden = false;
        annexPanel.scrollIntoView({ behavior: "smooth", block: "start" });
        (async () => {
          for (const el of blocks) {
            await typeAnnexBlock(
              el,
              el.dataset.annexOriginal || "",
              annexSpeed(el),
            );
          }
        })();
      } else {
        annexPanel.hidden = false;
        annexPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  }
</script>

