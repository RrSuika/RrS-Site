  /* =====================================================
  07 — CURRENT RESEARCH
  ====================================================== */

  .research-terminal {
    border: 1px solid var(--border);
    background: #08080c;
  }

  .terminal-bar {
    display: flex;
    justify-content: space-between;
    padding: 13px 20px;
    border-bottom: 1px dashed var(--border);
    color: var(--text-dim);
    font-size: var(--text-scale-5xs);
    letter-spacing: var(--tracking-tag);
  }

  .research-screen {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .research-column {
    min-height: 180px;
    padding: 30px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .research-column:nth-child(even) {
    border-right: none;
  }

  .research-column span {
    width: 100%;
    height: 560px;
    cursor: grab;
    margin-bottom: 25px;
    color: var(--accent);
    font-size: var(--text-scale-5xs);
    letter-spacing: var(--tracking-tag);
  }

  .research-column strong {
    width: 100%;
    height: 560px;
    cursor: grab;
    margin-bottom: 12px;
    font-size: 17px;
  }

  .research-column p {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--text-scale-3xs);
    line-height: 1.8;
  }

  .research-wide {
    grid-column: span 2;
    min-height: 150px;
    border-right: none;
  }

  /* =====================================================
  08 — FUTURE
  ====================================================== */

  /* ── Skill constellation (L6 Cluster Field grammar) ── */
  .skill-field {
    position: relative;
    margin-bottom: 0;
    border: 1px solid var(--border);
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 42%,
        rgba(255, 255, 255, 0.03),
        transparent 45%
      ),
      radial-gradient(
        circle at 80% 40%,
        rgba(80, 180, 170, 0.035),
        transparent 35%
      ),
      #08080c;
  }

  #skill-field {
    width: 100%;
    height: 560px;
    cursor: grab;
  }

  .journey-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    margin-bottom: 70px;
  }

  @media (max-width: 900px) {
    .journey-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }


  .skill-field .skill-tree-label {
    position: absolute;
  }

  .sk-link {
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 0.9;
    stroke-dasharray: 2 4;
  }

  .sk-spoke {
    stroke: rgba(255, 255, 255, 0.09);
    stroke-width: 0.5;
  }

  .sk-hub {

  }

  .sk-dot {
    fill: #8a8a96;
  }

  .sk-hub-label,
  .sk-skill-label {
    font-family: var(--font-mono);
  }

  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: sk-draw 1s ease forwards;
  }

  .pop {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: sk-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .fade {
    opacity: 0;
    animation: sk-fade 0.5s ease forwards;
  }

  @keyframes sk-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sk-pop {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes sk-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .future-section {
    margin-bottom: 100px;
  }

  .future-panel {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    padding: 45px;
    border: 1px solid var(--border);
  }

  .future-heading > span {
    color: var(--accent);
    font-size: var(--text-scale-4xs);
    letter-spacing: var(--tracking-tag);
  }

  .future-arrow {
    margin-top: 40px;
    color: var(--accent);
    font-size: 110px;
    line-height: 0.7;
  }

  .future-text p {
    margin: 0 0 25px;
    color: #888;
    font-size: var(--text-scale-sm);
    line-height: 1.9;
  }

  .future-text .lead {
    color: var(--text-bright);
    font-size: 20px;
  }

  /* =====================================================
  CLOSING
  ====================================================== */

  .closing-section {
    padding-top: 20px;
  }

  .closing-line {
    width: 100%;
    height: 1px;
    margin-bottom: 40px;
    background: linear-gradient(
      90deg,
      var(--border),
      rgba(232, 160, 64, 0.35),
      var(--border)
    );
  }

  .closing-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 80px;
    align-items: end;
  }

  .closing-copy {
    max-width: 850px;
  }

  .closing-kicker {
    width: 100%;
    height: 560px;
    cursor: grab;
    margin-bottom: 20px;
    color: var(--accent);
    font-size: var(--text-scale-5xs);
    letter-spacing: var(--tracking-tag);
  }

  .closing-section p {
    max-width: 850px;
    margin: 0;
    color: #aaa;
    font-size: clamp(18px, 2.2vw, 27px);
    line-height: 1.65;
    letter-spacing: -0.5px;
  }

  .closing-terminal {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--grid-gap-tight);
  }

  .closing-status {
    color: var(--terminal-green);
    font-size: var(--text-scale-3xs);
    letter-spacing: var(--tracking-tag);
  }

  .enter-key {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 260px;
    padding: 28px 36px;
    border: 1px solid #555;
    border-bottom: 4px solid #222;
    background: linear-gradient(180deg, #1a1a1d, #0b0b0d);
    color: #aaa;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-tag);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .enter-key::before,
  .enter-key::after {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    border: 1px solid #444;
  }

  .enter-key::before {
    top: 6px;
    left: 6px;
  }

  .enter-key::after {
    right: 6px;
    bottom: 7px;
  }

  .enter-key span {
    margin-right: 16px;
    font-size: 19px;
  }

  .enter-key b {
    color: var(--accent);
    font-size: var(--text-scale-h3);
  }

  .enter-key:hover {
    color: var(--text-bright);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(232, 160, 64, 0.08);
  }

  .enter-key:active {
    transform: translateY(3px);
    border-bottom-width: 1px;
  }

  /* ENTER key invitation — breathing glow + bouncing arrow */
  .enter-key {
    animation: enterPulse 2.6s ease-in-out infinite;
  }

  .enter-key b {
    display: inline-block;
    animation: arrowNudge 1.4s ease-in-out infinite;
  }

  .enter-key:hover {
    animation: none;
    box-shadow: 0 0 26px rgba(232, 160, 64, 0.22);
  }

  @keyframes enterPulse {
    0%,
    100% {
      box-shadow: 0 0 0 rgba(232, 160, 64, 0);
      border-color: #555;
    }
    50% {
      box-shadow: 0 0 18px rgba(232, 160, 64, 0.28);
      border-color: rgba(232, 160, 64, 0.65);
    }
  }

  @keyframes arrowNudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  /* =====================================================
  ANNEX 09 — STYLE GENEALOGY (easter egg)
  ====================================================== */

  .style-annex {
    padding-top: 60px;
  }

  .annex-panel {
    padding: 40px 45px;
    border: 1px dashed rgba(232, 160, 64, 0.3);
    background: rgba(232, 160, 64, 0.02);
    font-family: var(--font-mono);
  }

  /* Typewriter cursor while a block is being typed */
  .annex-panel .typing::after {
    content: "_";
    color: var(--terminal-green);
    animation: annexBlink 0.6s infinite;
    font-weight: 400;
  }

  @keyframes annexBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .annex-header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-scale-3xs);
    font-weight: bold;
    letter-spacing: var(--tracking-tag);
    color: var(--accent);
  }

  .annex-status {
    color: #888;
    font-weight: normal;
    letter-spacing: var(--tracking-label);
  }

  .annex-intro {
    margin: 30px 0 0;
    font-size: 16px;
    line-height: 1.8;
    color: #ccc;
  }

  .annex-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gap) 40px;
    margin-top: 15px;
  }

  .annex-entry {
    border-left: 2px solid var(--stripe-red);
    padding-left: 18px;
  }

  .annex-entry:nth-child(3n + 2) {
    border-left-color: var(--stripe-yellow);
  }

  .annex-entry:nth-child(3n) {
    border-left-color: var(--stripe-teal);
  }

  .annex-entry-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .annex-code {
    font-size: var(--text-scale-3xs);
    font-weight: bold;
    letter-spacing: var(--tracking-wider);
    color: var(--text-bright);
  }

  .annex-era {
    font-size: var(--text-scale-4xs);
    letter-spacing: var(--tracking-label);
    color: var(--text-dim);
  }

  .annex-entry p {
    margin: 0;
    font-size: var(--text-scale-xs);
    line-height: 1.9;
    color: #aaa;
  }

  .annex-refs {
    margin-top: 12px;
    font-size: var(--text-scale-4xs);
    letter-spacing: var(--tracking-micro);
    color: var(--terminal-green);
    opacity: 0.7;
  }

  .annex-style-index {
    margin-top: 35px;
    font-size: var(--text-scale-4xs);
    letter-spacing: var(--tracking-tag);
    color: var(--accent);
  }

  .annex-works {
    margin-top: 40px;
    padding-top: 25px;
    border-top: 1px dashed var(--border);
  }

  .annex-works-list {
    margin: 15px 0 0;
    padding: 0;
    list-style: none;
  }

  .annex-works-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-bottom: 10px;
    font-size: var(--text-scale-xs);
    line-height: 1.8;
    color: var(--text-tertiary);
  }

  .annex-work-title {
    color: var(--text-bright);
    font-weight: bold;
    letter-spacing: var(--tracking-micro);
  }

  .annex-work-note {
    color: var(--text-tertiary);
  }

  :root[data-theme="light"] .annex-panel {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(176, 112, 32, 0.3);
  }

  :root[data-theme="light"] .annex-code {
    color: var(--text-bright);
  }

