        rgba(80, 180, 170, 0.035),
        transparent 35%
      ),
      #08080c;
  }

  .skill-grid {
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background:
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
