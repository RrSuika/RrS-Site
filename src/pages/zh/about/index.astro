---
import Layout from "../../../layouts/Layout.astro";
import { getLanguageFromPath } from "../../../utils/i18n";
import { getTranslations } from "../../../utils/translations";

const lang = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(lang);
const skillMap = t.skillMap;

// 结构化数据 — Person 实体：搜索结果中的身份卡片
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "RrSuika Studio",
  alternateName: ["RrS"],
  url: "https://rrsuika-studio.pages.dev/",
  jobTitle: "设计师 / 创客",
  description: t.meta.description,
  email: "mailto:ranrsuika@gmail.com",
  sameAs: [
    "https://github.com/RrSuika",
    "https://www.pixiv.net/users/71884225",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rotterdam",
    addressCountry: "NL",
  },
};
---

<Layout
  title={`${t.sections.about.title} | RrSuika Studio`}
  description={t.sections.about.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />

  <main class="about-page">
    <!-- =====================================================
    HERO
    ====================================================== -->

    <section class="about-hero">
      <div class="hero-meta">
        <span>{t.sections.about.pageTag}</span>
        <span>{t.sections.about.pageStatus}</span>
      </div>

      <div class="hero-content">
        <div class="hero-main">
          <div class="eyebrow">
            {t.sections.about.eyebrow}
          </div>

          <h1>
            {t.sections.about.title}
          </h1>

          <p class="subtitle">
            {t.sections.about.subtitle}
          </p>
        </div>

        <div class="hero-index">
          <span>MODULE</span>
          <strong>01</strong>
        </div>
      </div>
    </section>

    <!-- =====================================================
    01 — INTRODUCTION + IDENTITY
    ====================================================== -->

    <section class="intro-section">
      <div class="section-label">// 01 — 自我介绍 // 身份</div>

      <div class="intro-layout">
        <div class="intro-heading">
          <span class="system-tag"> RrSuika_STUDIO / PROFILE </span>

          <h2>
            {t.sections.about.introTitle}
          </h2>
        </div>

        <div class="intro-content">
          <p class="intro-lead">
            {t.sections.about.description}
          </p>

          <div class="intro-body">
            <p>
              {t.sections.about.introText}
            </p>

            <p>
              {t.sections.about.identity.text}
            </p>

            <div class="intro-statement">
              <span>// 途径</span>

              <strong>
                {t.sections.about.identity.title}
              </strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    02 — PERSONNEL DOSSIER
    ====================================================== -->

    <section class="dossier-section">
      <div class="section-label">// 02 — 个人档案</div>

      <div class="dossier">
        <div class="dossier-header">
          <span>
            {t.sections.about.dossier.header}
          </span>

          <span class="online">
            {t.sections.about.dossier.status}
          </span>
        </div>

        <div class="dossier-body">
          <div class="identity">
            <div class="identity-label">
              {t.sections.about.dossier.operator}
            </div>

            <h2>RrS Stuido</h2>

            <p>
              {t.sections.about.dossier.role}
            </p>

            <div class="identity-rows">
              <div class="mini-row">
                <span class="data-label">
                  {t.sections.about.dossier.locationLabel}
                </span>

                <div class="mini-value">
                  {t.sections.about.dossier.location}
                </div>
              </div>

              <div class="mini-row">
                <span class="data-label">
                  {t.sections.about.dossier.fieldLabel}
                </span>

                <div class="mini-value">
                  {t.sections.about.dossier.field}
                </div>
              </div>

              <div class="mini-row">
                <span class="data-label">
                  {t.sections.about.dossier.interestsLabel}
                </span>

                <div class="chips">
                  {
                    t.sections.about.dossier.interests.map((interest) => (
                      <span class="chip">{interest}</span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <div class="dossier-data">
            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.focusLabel}
              </span>

              <span>
                {t.sections.about.dossier.focus}
              </span>
            </div>

            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.skillsLabel}
              </span>

              <div class="chips">
                {
                  t.sections.about.dossier.skills.map((skill) => (
                    <span class="chip">{skill}</span>
                  ))
                }
              </div>
            </div>

            <div class="data-row">
              <span class="data-label">
                {t.sections.about.dossier.softwareLabel}
              </span>

              <div class="software">
                <img
                  class="soft-icon pol-dark"
                  src="/icons/photoshop.png"
                  width="73"
                  height="41"
                  alt="Photoshop"
                  title="Photoshop"
                />
                <img
                  class="soft-icon pol-dark"
                  src="/icons/solidworks.png"
                  width="39"
                  height="39"
                  alt="SolidWorks"
                  title="SolidWorks"
                />
                <img
                  class="soft-icon pol-light"
                  src="/icons/clip-studio-paint.png"
                  width="39"
                  height="39"
                  alt="Clip Studio Paint"
                  title="Clip Studio Paint"
                />
                <img
                  class="soft-icon pol-light"
                  src="/icons/keyshot.png"
                  width="42"
                  height="41"
                  alt="KeyShot"
                  title="KeyShot"
                />
                <img
                  class="soft-icon pol-mid"
                  src="/icons/blender.png"
                  width="88"
                  height="50"
                  alt="Blender"
                  title="Blender"
                />
                <img
                  class="soft-icon pol-dark"
                  src="/icons/davinci-resolve.png"
                  width="42"
                  height="44"
                  alt="DaVinci Resolve"
                  title="DaVinci Resolve"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    03 — PERSONAL PROTOCOL
    ====================================================== -->

    <section class="philosophy-section">
      <div class="section-label">// 03 — 个人准则</div>

      <div class="philosophy-layout">
        <div class="philosophy-main">
          <span class="system-tag">
            {t.sections.about.philosophy.header}
          </span>

          <h2>
            {t.sections.about.philosophy.title}
          </h2>
        </div>

        <div class="philosophy-copy">
          <p class="lead">
            {t.sections.about.philosophy.text}
          </p>

          <p>
            {t.sections.about.philosophy.second}
          </p>
        </div>
      </div>

      <div class="motto-panel">
        <div class="motto-label">
          {t.sections.about.philosophy.mottoLabel}
        </div>

        <div class="motto-content">
          <strong>
            {t.sections.about.philosophy.motto}
          </strong>

          <p>
            {t.sections.about.philosophy.mottoText}
          </p>
        </div>

        <div class="motto-symbol">→</div>
      </div>
    </section>

    <!-- =====================================================
    04 — DESIGN PROCESS
    ====================================================== -->

    <section class="process-section">
      <div class="section-label">// 04 — 设计流程</div>

      <div class="process-header">
        <div class="process-heading">
          <span class="system-tag"> 创意流水线 </span>

          <h2>
            创意
            <span class="process-arrow" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="100%"
                height="100%"
              >
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <polyline points="14 6 20 12 14 18"></polyline>
              </svg>
            </span>
            实物
          </h2>
        </div>

        <p>
          {t.sections.about.approach.description}
        </p>
      </div>

      <div class="process-station" data-process-sequence>
        <div class="station-track">
          <span class="station-track-progress"></span>
        </div>

        <!-- 01 -->

        <div class="station-item process-active" data-process-step="0">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">01</div>

          <div class="station-content">
            <span class="station-state"> 运行中 </span>

            <div class="station-code">调研</div>

            <h3>
              {t.sections.about.approach.research.title}
            </h3>

            <p>
              {t.sections.about.approach.research.description}
            </p>
          </div>
        </div>

        <!-- 02 -->

        <div class="station-item" data-process-step="1">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">02</div>

          <div class="station-content">
            <span class="station-state"> 等待中 </span>

            <div class="station-code">概念</div>

            <h3>
              {t.sections.about.approach.concept.title}
            </h3>

            <p>
              {t.sections.about.approach.concept.description}
            </p>
          </div>
        </div>

        <!-- 03 -->

        <div class="station-item" data-process-step="2">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">03</div>

          <div class="station-content">
            <span class="station-state"> 等待中 </span>

            <div class="station-code">制造</div>

            <h3>
              {t.sections.about.approach.build.title}
            </h3>

            <p>
              {t.sections.about.approach.build.description}
            </p>
          </div>
        </div>

        <!-- 04 -->

        <div class="station-item" data-process-step="3">
          <div class="station-light">
            <span></span>
          </div>

          <div class="station-number">04</div>

          <div class="station-content">
            <span class="station-state"> 等待中 </span>

            <div class="station-code">迭代</div>

            <h3>
              {t.sections.about.approach.refine.title}
            </h3>

            <p>
              {t.sections.about.approach.refine.description}
            </p>
          </div>
        </div>
      </div>

      <div class="pipeline-progress">
        <div class="pipeline-progress-line">
          <span></span>
        </div>

        <div class="pipeline-progress-label">
          <span>流程序列</span>
          <span>01 → 02 → 03 → 04 → 重复</span>
        </div>
      </div>
    </section>

    <!-- =====================================================
    05 — CAPABILITY MATRIX
    ====================================================== -->

    <section class="capabilities-section">
      <div class="section-label">// 05 — 能力矩阵</div>

      <div class="capability-console">
        <div class="console-top">
          <span> RrSuika_能力矩阵 </span>

          <span>
            输入:
            <b>选择模块</b>
          </span>
        </div>

        <div class="capability-layout">
          <div class="capability-buttons">
            <button class="cap-button active" data-cap="industrial">
              <span>01</span>
              <strong>
                {t.sections.about.capabilities.industrial.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="mechanical">
              <span>02</span>
              <strong>
                {t.sections.about.capabilities.mechanical.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="electronics">
              <span>03</span>
              <strong>
                {t.sections.about.capabilities.electronics.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="embedded">
              <span>04</span>
              <strong>
                {t.sections.about.capabilities.embedded.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="fabrication">
              <span>05</span>
              <strong>
                {t.sections.about.capabilities.fabrication.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="visual">
              <span>06</span>
              <strong>
                {t.sections.about.capabilities.visual.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="software">
              <span>07</span>
              <strong>
                {t.sections.about.capabilities.software.title}
              </strong>
            </button>

            <button class="cap-button" data-cap="teaching">
              <span>08</span>
              <strong>
                {t.sections.about.capabilities.teaching.title}
              </strong>
            </button>
          </div>

          <div class="capability-display">
            <div class="display-header">
              <span id="cap-status"> 模块_01 </span>

              <span class="display-light"> ● 运行中 </span>
            </div>

            <div class="display-visual">
              <canvas id="capabilityCanvas" aria-hidden="true"></canvas>

              <div class="cap-scanlines"></div>

              <div class="cap-corner cap-corner-tl">RrSuika // 视觉遥测</div>

              <div class="cap-corner cap-corner-br">实时</div>
            </div>

            <div class="display-body">
              <span class="display-kicker"> 能力 </span>

              <h3 id="cap-title">
                {t.sections.about.capabilities.industrial.title}
              </h3>

              <p id="cap-description">
                {t.sections.about.capabilities.industrial.description}
              </p>
            </div>

            <div class="display-footer">
              <span> 自动序列 </span>

              <span> 选择其他模块 → </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
    06 — DEVELOPMENT PATH
    ====================================================== -->

    <section class="journey-section">
      <div class="section-label">// 06 — 发展路径</div>

      <div class="journey-header">
        <span class="system-tag"> 过程日志 // 发展路径 </span>

        <h2>
          {t.sections.about.journey.title}
        </h2>
      </div>

      <div class="journey-grid">
      <!-- SKILL CONSTELLATION — B2 big-force grammar -->
      <div class="skill-field">
        <div id="skill-field"></div>
        <div class="skill-tree-label">
          <span>KNOWLEDGE ACCUMULATION</span>
        </div>
      </div>

      <script is:inline defer src="https://cdn.jsdelivr.net/npm/echarts@6/dist/echarts.min.js"></script>
      <script define:vars={{ skillMap }}>
        (() => {
          const chartEl = document.getElementById("skill-field");
          if (!chartEl) return;

          const PAPER = "#d8d8e0";
          const SKILL_FS = /[一-鿿]/.test((skillMap.hubs[0]?.skills[0] || skillMap.hubs[0]?.name || "")) ? 10.5 : 8.5;
          const rnd = (i, k) => ((i * 73856093) ^ (k * 19349663)) % 1000 / 1000;

          // hub importance, index-aligned with skillMap.hubs
          const LINKS = [
            [0, 1], [1, 5], [1, 6], [1, 7], [1, 8],
            [0, 2], [0, 3], [0, 9], [2, 3], [3, 4],
            [9, 10],
          ];

          const nodes = [];
          const links = [];
          const hubs = skillMap.hubs;

          // hub size follows connection count: more links, bigger dot
          const DEG = new Array(hubs.length).fill(0);
          // gray ramp: more connections, brighter dot
          const SHADE = ["", "#6a6a75", "#7e7e8a", "#92929c", "#a6a6b0", "#babac4"];
          LINKS.forEach(([a, b]) => { DEG[a]++; DEG[b]++; });

          hubs.forEach((hub, di) => {
            const hid = hub.name;
            // hub: amber core, label always visible to the right
            nodes.push({
              name: hid,
              value: DEG[di],
              hub: true,
              dom: di,
              symbolSize: 10 + DEG[di] * 2.6,
              itemStyle: { color: SHADE[DEG[di]] },
              label: {
                show: true,
                position: "right",
                distance: 8,
                color: PAPER,
                fontSize: 10,
                fontWeight: 700,
              },
            });
            // satellites: long-tail sizes, a couple of mid-weights per hub
            hub.skills.forEach((sk, i) => {
              const v = i < 3 ? 14 + rnd(di + 2, i + 4) * 18 : 2 + rnd(di + 5, i + 9) * 9;
              nodes.push({
                name: sk,
                value: Math.round(v),
                hub: false,
                dom: di,
                symbolSize: 2.5 + Math.sqrt(v) * 1.5,
                itemStyle: { color: "#8a8a96" },
                label: { show: true, position: "right", distance: 4, color: "#9a9aa6", fontSize: SKILL_FS },
              });
              // satellite → its hub
              links.push({
                source: sk,
                target: hid,
                lineStyle: { width: 0.5 + v * 0.05, color: "#3f3e46", opacity: 0.5 },
              });
            });
          });

          // hub-to-hub backbone
          LINKS.forEach(([a, b]) => {
            links.push({
              source: hubs[a].name,
              target: hubs[b].name,
              lineStyle: {
                width: 1.6 + rnd(a + 2, b + 3) * 2.2,
                color: "#55535f",
                opacity: 0.65,
                curveness: 0.08,
              },
            });
          });

          const option = {
            animationDuration: 300,
            tooltip: {
              backgroundColor: PAPER,
              borderWidth: 0,
              textStyle: { color: "#0a0a10", fontSize: 12 },
              padding: [10, 14],
              formatter: (p) => (p.dataType === "node" ? p.name : ""),
            },
            series: [
              {
                type: "graph",
                layout: "force",
                force: { repulsion: 110, edgeLength: [18, 64], gravity: 0.12, friction: 0.22, layoutAnimation: true },
                roam: true,
                draggable: true,
                left: 30,
                right: 40,
                top: 20,
                bottom: 20,
                data: nodes,
                links,
                emphasis: {
                  focus: "adjacency",
                  lineStyle: { color: PAPER, opacity: 0.9, width: 1.4 },
                  label: { show: true, color: PAPER, position: "right", fontSize: 10 },
                },
                blur: { itemStyle: { opacity: 0.08 }, lineStyle: { opacity: 0.03 } },
              },
            ],
          };

          const play = (g) => {
            g.clear();
            g.setOption(option);
          };

          const boot = () => {
            if (!window.echarts) return false;
            const g = echarts.init(chartEl);
            play(g);
            // click on empty canvas replays; clicks on nodes are for dragging
            g.getZr().on("click", (e) => {
              if (!e.target) { play(g); syncTargets(); }
            });
            window.addEventListener("resize", () => g.resize());
            // gentle drift: every node wanders continuously. Positions are
            // written straight into the item layouts (no setOption, no force
            // re-run), so motion is smooth and local — no global jitter.
            // Labels that would collide push their nodes apart instead.
            const labelW = (name, fs) => {
              let w = 0;
              for (const ch of name) w += /[一-鿿]/.test(ch) ? fs : fs * 0.62;
              return w;
            };
            const sModel = g.getModel().getSeriesByIndex(0);
            const sData = sModel.getData();
            const N = sData.count();
            let targets = [];
            let dragging = false;
            const syncTargets = () => {
              targets = [];
              for (let i = 0; i < N; i++) {
                const p = sData.getItemLayout(i);
                targets.push(p ? [p[0], p[1]] : null);
              }
            };
            const labelRects = () => {
              const out = [];
              for (let i = 0; i < N; i++) {
                const t = targets[i];
                if (!t) { out.push(null); continue; }
                const nd = nodes[i];
                const fs = nd.hub ? 10 : SKILL_FS;
                const off = nd.symbolSize / 2 + (nd.hub ? 8 : 4);
                const w = labelW(nd.name, fs) + 6;
                out.push([t[0] + off, t[1] - fs / 2 - 3, w, fs + 6]);
              }
              return out;
            };
            // random walk + two passes of label-collision pushes, on targets
            const wander = () => {
              for (let i = 0; i < N; i++) {
                if (!targets[i]) continue;
                targets[i][0] += (Math.random() - 0.5) * 14;
                targets[i][1] += (Math.random() - 0.5) * 14;
              }
              for (let pass = 0; pass < 4; pass++) {
                const rects = labelRects();
                for (let i = 0; i < N; i++) {
                  if (!rects[i]) continue;
                  for (let j = i + 1; j < N; j++) {
                    if (!rects[j]) continue;
                    const a = rects[i], b = rects[j];
                    if (a[0] >= b[0] + b[2] || b[0] >= a[0] + a[2]) continue;
                    if (a[1] >= b[1] + b[3] || b[1] >= a[1] + a[3]) continue;
                    const cxa = a[0] + a[2] / 2, cxb = b[0] + b[2] / 2;
                    const cya = a[1] + a[3] / 2, cyb = b[1] + b[3] / 2;
                    const needX = (a[2] + b[2]) / 2 - Math.abs(cxa - cxb) + 2;
                    const needY = (a[3] + b[3]) / 2 - Math.abs(cya - cyb) + 2;
                    // separate along whichever axis needs the smaller move
                    if (needX <= needY) {
                      const push = Math.min(16, needX);
                      const dir = cxa <= cxb ? -1 : 1;
                      if (nodes[i].hub && !nodes[j].hub) targets[j][0] += dir * push;
                      else if (nodes[j].hub && !nodes[i].hub) targets[i][0] -= dir * push;
                      else { targets[i][0] -= (dir * push) / 2; targets[j][0] += (dir * push) / 2; }
                    } else {
                      const push = Math.min(16, needY);
                      const dir = cya <= cyb ? -1 : 1;
                      if (nodes[i].hub && !nodes[j].hub) targets[j][1] += dir * push;
                      else if (nodes[j].hub && !nodes[i].hub) targets[i][1] -= dir * push;
                      else { targets[i][1] -= (dir * push) / 2; targets[j][1] += (dir * push) / 2; }
                    }
                  }
                }
              }
            };
            // ease toward targets every other frame, straight into the layouts
            let lastFrame = 0;
            const float = (ts) => {
              if (ts - lastFrame >= 33) {
                lastFrame = ts;
                if (!dragging) {
                  for (let i = 0; i < N; i++) {
                    if (!targets[i]) continue;
                    const p = sData.getItemLayout(i);
                    if (!p) continue;
                    p[0] += (targets[i][0] - p[0]) * 0.03;
                    p[1] += (targets[i][1] - p[1]) * 0.03;
                    sData.setItemLayout(i, p);
                  }
                  g.getZr().refresh();
                }
              }
              requestAnimationFrame(float);
            };
            g.getZr().on("mousedown", () => { dragging = true; });
            g.getZr().on("mouseup", () => { dragging = false; syncTargets(); });
            setTimeout(() => {
              syncTargets();
              setInterval(wander, 2600);
              requestAnimationFrame(float);
            }, 1500);
            return true;
          };

          if (!boot()) {
            let tries = 0;
            const timer = setInterval(() => {
              if (boot() || ++tries > 200) clearInterval(timer);
            }, 50);
          }
        })();
      </script>

      <div class="journey-copy">
