    background: #08080c;
    transform: translate(-50%, -50%) rotate(45deg);
    box-shadow: 0 0 0 5px #08080c;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .skill-node:hover .skill-node-dot {
    background: var(--accent);
    transform: translate(-50%, -50%) rotate(45deg) scale(1.35);
    box-shadow:
      0 0 0 5px #08080c,
      0 0 18px rgba(232, 160, 64, 0.45);
  }

  .skill-node-content {
    position: absolute;
    width: 170px;
  }

  .skill-index {
    width: 100%;
    height: 560px;
    cursor: grab;
    margin-bottom: 7px;
    color: var(--accent);
    font-size: 7px;
    letter-spacing: var(--tracking-wider);
