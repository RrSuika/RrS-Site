---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CassetteShelf from "../../../components/CassetteShelf.astro";
import { getLanguageFromPath } from "../../../utils/i18n";
import { getTranslations } from "../../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const entries = await getCollection("entries");
const projectEntries = entries
  .filter((e) => e.data.type === "projects" && e.data.lang === language)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Curated filter tags — narrowed inside CassetteShelf to the ones that exist
const filterTags = [
  "工业设计",
  "钣金加工",
  "3D打印",
  "电子",
  "Arduino",
  "ESP32",
  "嵌入式系统",
  "制造",
  "焊接",
  "BOM",
];
---

<Layout
  title={`${t.sections.projects.title} | RrSuika Studio`}
  description={t.sections.projects.description}
>
  <CassetteShelf
    entries={projectEntries}
    kind="projects"
    filterTags={filterTags}
    title={t.sections.projects.title}
    description={t.sections.projects.description}
  />
</Layout>
