---
/**
 * CassetteShelf — the /projects and /lab listing experience.
 *
 * The cards used to be a flat grid. They are now cassettes standing on an
 * archive shelf: they rise into place, the selected one is pulled out toward
 * the viewer and turned 15° so its cover, left spine and bottom edge read in
 * 3D, and the neighbours recede and tilt into an inverted-triangle composition
 * that funnels the eye to the centre.
 *
 * Two references drove this (both in `输入/`, reference only — none of their
 * code is used here):
 *   · 磁带盒主体动画.html — the cassette anatomy, the pull/flip choreography and
 *                           the drag state machine
 *   · 磁带盒启动动画.html — the bookshelf intro (staggered left→right rise from
 *                           below, then the centre pull + rear retreat)
 * The motion *feel* — critically damped release that keeps the pointer's
 * velocity, the layered idle breath, chunky solid affordances and hairline
 * rules — follows RhineLabUI (github.com/LBEILC/RhineLabUI), ported by hand:
 * their scene is three.js, ours is CSS 3D.
 *
 * Implementation is CSS 3D (`transform-style: preserve-3d`), NOT three.js:
 * no new dependency, the cover art keeps flowing through `astro:assets`, the
 * copy stays real DOM (three languages + SEO + a11y), and the whole thing
 * follows the site's theme tokens and frosted-glass language.
 *
 * ⚠️ preserve-3d hygiene: any ancestor of a `.cas-f` face must not gain
 * `overflow:hidden`, `opacity < 1`, `filter`, `clip-path` or a `transform`
 * that is not part of the 3D chain — each of those forces `flat` and the box
 * collapses. Per-tape fades therefore ride on the `--cas-o` variable, which is
 * consumed by the faces (leaves), never by the cassette element itself.
 *
 * ⚠️ The row is a FRACTIONAL-SLOT renderer, and that is what the previous
 * version got wrong. Each tape carries a continuous slot (`pos`, e.g. 1.37)
 * and every painted frame is a pure function of it, so a swap *glides*. Tapes
 * only appear or disappear where they are already off-stage, and a recycled
 * tape is teleported to a park slot that is outside the frame at every window
 * size before it is ever shown. Nothing pops in at the edge; nothing blinks
 * out of it.
 */
import { getImage } from "astro:assets";
import { getProjectImageMeta } from "../utils/images";
import { getLanguageFromPath, languageDateLocales } from "../utils/i18n";
import { buildEntryUrl } from "../utils/routes";
import { getTranslations } from "../utils/translations";

/** Only the entry fields this shelf consumes — structural, like routes.ts. */
interface ShelfEntry {
  id: string;
  data: {
    title: string;
    date: Date;
    dateLabel?: string;
    description?: string;
    cover?: string;
    type: string;
    category?: string;
    collaboration?: string;
    tags?: string[];
    wip?: boolean;
    lang: "en" | "zh" | "nl";
  };
}

interface Props {
  entries: ShelfEntry[];
  kind: "projects" | "lab";
  filterTags: string[];
  title: string;
  description: string;
}

const { entries, kind, filterTags, title, description } = Astro.props as Props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

// Tri-colour identity cycled per cassette — reuses the site stripe tokens
// instead of inventing palette values.
const ACCENTS = ["red", "yellow", "teal"] as const;

const items = await Promise.all(
  entries.map(async (entry, i) => {
    const slug = entry.id.split("/")[0];

    const coverMeta = entry.data.cover
      ? getProjectImageMeta(slug, entry.data.cover)
      : null;

    const optimized =
      coverMeta && typeof coverMeta !== "string"
        ? await getImage({
            src: coverMeta,
            width: 960,
            format: "webp",
            quality: 88,
          })
        : null;

    const image =
      optimized?.src ?? (typeof coverMeta === "string" ? coverMeta : null);

    const date = entry.data.dateLabel ?? entry.data.date.toLocaleDateString(
      languageDateLocales[language],
      { year: "numeric", month: "short" },
    );

    // The shared status strings still carry their legacy glyphs ("— ONLINE" /
    // "— WIP") because ProjectCard.astro prints them verbatim. The shelf draws
    // its own mark, so the glyph is stripped here rather than forking the
    // shared translation table.
    const status = (entry.data.wip ? t.card.wip : t.card.online).replace(
      /^[^\p{L}\p{N}]+/u,
      "",
    );

    return {
      slug,
      url: buildEntryUrl(entry, entry.data.lang),
      title: entry.data.title as string,
      // The short label printed on the spine (falls back to the full title). See
      // `spineTitle` in `content.config.ts` — it is printed matter, not copy.
      // ⚠️ The cast is because the content layer's GENERATED type does not carry
      // this field yet, even after `astro sync` — the schema, the build and the
      // rendered HTML all do (the short titles are in the output). Drop the cast
      // once `astro check` sees it.
      spineTitle: ((entry.data as { spineTitle?: string }).spineTitle ??
        entry.data.title) as string,
      description: (entry.data.description ?? "") as string,
      category: (entry.data.category ?? "") as string,
      type: entry.data.type.toUpperCase() as string,
      tags: (entry.data.tags ?? []) as string[],
      team: Boolean(entry.data.collaboration),
      wip: Boolean(entry.data.wip),
      date,
      status,
      image,
      width: optimized?.attributes.width as number | undefined,
      height: optimized?.attributes.height as number | undefined,
      accent: ACCENTS[i % ACCENTS.length],
      index: String(i + 1).padStart(2, "0"),
    };
  }),
);

// ── Curated filter tag list, narrowed to tags that actually exist ──
const allTags = new Set(items.flatMap((item) => item.tags));
const topTags = filterTags
  .filter((tag) => allTags.has(tag))
  .map(
    (tag) =>
      [tag, items.filter((item) => item.tags.includes(tag)).length] as const,
  );

/**
 * Slots painted either side of the selection. Six reaches the screen edge on
 * both sides, so the row always reads as a full shelf rather than a handful of
 * tapes adrift in the middle; the script recomputes it from the ring length.
 * Declared in the frontmatter (not the client script) because the blank-cassette
 * markup needs the count at build time.
 */
const MAX_SLOT_COUNT = 4;
/** Blanks to author. ⚠️ Sized for the DRAG, not just for the scenery: a release
 *  re-bases `current` by the whole landing, so the ring needs `2·(half + DRAG_MAX)`
 *  of padding or a long drag walks the painting off its end. */
const MAX_FILLERS = MAX_SLOT_COUNT * 6;

const brand = "RrSuika";

/**
 * Cover art to warm on the FIRST page view of a session only.
 *
 * The gate is deliberately client-side. `Astro.session` needs a session-capable
 * adapter and this site is `output: "static"` with none, so there is no server
 * state to consult; sessionStorage is the only thing that actually persists
 * here. The tags are handed to a tiny inline script instead of rendered as
 * `<link rel="preload">` because a preload is a *priority hint* — firing a
 * dozen of them on every navigation would re-fetch the whole shelf for nothing
 * on a repeat visit, while the browser's HTTP cache already has them.
 */
const coverUrls = items
  .map((item) => item.image)
  .filter((src): src is string => Boolean(src))
  .slice(0, 24);
---

<div class="shelf-page" data-mode="3d">
  <div
    class="shelf-warm"
    id="shelf-warm"
    data-covers={JSON.stringify(coverUrls)}
    hidden
  >
  </div>

  <div class="shelf-head">
    <h1>
      <span class="shelf-eyebrow">{t.shelf.eyebrow}</span>
      {title}
    </h1>

    {
      topTags.length > 0 && (
        <div class="tag-bar shelf-tag-bar" id="shelf-tag-bar">
          <button class="tag-chip active" data-tag="">
            ALL
          </button>
          {topTags.map(([tag, count]) => (
            <button class="tag-chip" data-tag={tag}>
              {tag}
              <span class="tag-count">{count}</span>
            </button>
          ))}
        </div>
      )
    }
  </div>

  <section
    class="shelf"
    id="cassette-shelf"
    data-kind={kind}
    data-loaded-label={t.shelf.loaded}
    aria-label={title}
  >
    <div class="shelf-stage" id="shelf-stage">
      <div class="shelf-atmos" aria-hidden="true"></div>
      <div class="shelf-scrim" aria-hidden="true"></div>
      <div class="shelf-floor" aria-hidden="true"></div>

      <div class="shelf-track" id="shelf-track">
        {
          items.map((item) => (
            <a
              class="cas"
              href={item.url}
              data-index={item.index}
              data-title={item.title}
              data-desc={item.description}
              data-category={item.category}
              data-date={item.date}
              data-type={item.type}
              data-tags={JSON.stringify(item.tags)}
              data-status={item.status}
              data-wip={item.wip ? "1" : "0"}
              draggable="false"
              style={`--cas-accent:var(--stripe-${item.accent});--cas-accent-soft:var(--stripe-${item.accent}-soft)`}
              aria-label={item.title}
            >
              {/* ── FRONT: the cover fills the shell; the deck reads on top ── */}
              <div class="cas-f cas-front">
                <div class="cas-label">
                  {item.image ? (
                    <img
                      src={item.image}
                      alt=""
                      width={item.width}
                      height={item.height}
                      loading="eager"
                      decoding="async"
                      draggable="false"
                    />
                  ) : (
                    <div class="cas-label-fallback" aria-hidden="true" />
                  )}

                  <div class="cas-label-scrim" aria-hidden="true" />

                  {/* The moulded band across the top of the face. On a real shell
                      this is where the second window / label strip sits; here it
                      frames the record line. See `.cas-recess`. */}
                  <div class="cas-recess" aria-hidden="true" />

                  <div class="cas-label-head">
                    <span class="cas-node">
                      {t.card.projectNode} {item.type}
                    </span>
                    {/* The date rides the header row, opposite the record node
                        (2026-09-19: "日期则移动到右上角，和 PRJ_NODE // 一样高度"). */}
                    <span class="cas-head-date">{item.date}</span>
                  </div>

                  <h2 class="cas-title">{item.title}</h2>

                  {/* The tape window sits *over* the cover: a real cassette is
                      a clear shell wrapped around a printed J-card, so the
                      artwork keeps filling the whole face and the reels read
                      through the plastic. */}
                  <div class="cas-window" aria-hidden="true">
                    <span class="cas-reel">
                      <span class="cas-reel-spokes" />
                      <span class="cas-reel-ring" />
                      <span class="cas-reel-hub" />
                    </span>

                    {/* Between the hubs, as on the real moulding: a recessed well
                        with the tape's technical mark and, under it, the length
                        scale. One line, generously tracked — a wall of 5px
                        micro-type reads as printed noise at this size, which is
                        what made the first version look cheap. */}
                    <span class="cas-plate">
                      <span class="cas-plate-head">
                        <span class="cas-plate-tick" />
                        <span class="cas-plate-mark">TYPE II · C-90</span>
                      </span>
                      {/* The tape-length scale: 100 at the left down to 0 at the
                          right, the way a real cassette's window label reads. */}
                      <span class="cas-plate-scale">
                        <span class="cas-plate-ticks" />
                        <span class="cas-plate-nums">
                          <span>100</span>
                          <span>50</span>
                          <span>0</span>
                        </span>
                      </span>
                    </span>

                    <span class="cas-reel">
                      <span class="cas-reel-spokes" />
                      <span class="cas-reel-ring" />
                      <span class="cas-reel-hub" />
                    </span>

                    {/* ⚠️ The tape ribbon (`.cas-path`) is GONE too (2026-09-19:
                        "刻度条下方有一个两侧渐变的线去掉"): a 1px rule fading out at
                        both ends, sitting under the plate's 100/50/0 scale, read as
                        a stray underline rather than as the tape path behind the
                        window. Its guide rollers had already been removed for the
                        same reason. Do not bring the line back without a reason
                        visible at 400px. */}
                  </div>

                  {/* Moulded shell mark: embossed, not printed. ⚠️ The brand is
                      gone from it ("RRSUIKA TYPE II 可以去掉 RRSUIKA") — the
                      brand is already on both spines and in the blank tape's
                      header, and a third copy inside a 4px embossed strip is
                      noise. */}
                  <span class="cas-mould" aria-hidden="true">TYPE II</span>

                  <div class="cas-deck-meta" aria-hidden="true">
                    {item.team && (
                      <span class="cas-deck-team">{t.card.team.replace(/\//g, "")}</span>
                    )}
                  </div>

                  <span class="cas-hairline" aria-hidden="true" />
                  <span class="cas-accent-bar" aria-hidden="true" />
                </div>
              </div>

              {/* ── LEFT SPINE ── */}
              <div class="cas-f cas-left">
                <span class="cas-spine-stripe" aria-hidden="true" />
                <span class="cas-spine-brand">{brand}</span>
                <span class="cas-spine-title">{item.spineTitle}</span>
                <span class="cas-spine-idx">{item.index}</span>
              </div>

              {/* ── RIGHT SPINE (mirrored, for the left-hand neighbours) ── */}
              <div class="cas-f cas-right">
                <span class="cas-spine-stripe" aria-hidden="true" />
                <span class="cas-spine-brand">{brand}</span>
                <span class="cas-spine-title">{item.spineTitle}</span>
                <span class="cas-spine-idx">{item.index}</span>
              </div>

              {/* ── SHELL EDGES ── */}
              <div class="cas-f cas-top" />
              <div class="cas-f cas-bottom">
                <span class="cas-bottom-edge" aria-hidden="true" />
              </div>
              <div class="cas-f cas-back" />

              <p class="cas-sr">{item.description}</p>
            </a>
          ))
        }

        {/* ── BLANK CASSETTES ──
            Scenery for a short shelf: when a filter (or a small archive) leaves
            fewer tapes than fill the frame, these pad both ends so the row still
            reaches both screen edges and the selection stays centred. They
            carry no link and no copy, and the walkable range excludes them. */}
        <div class="shelf-fillers" data-fillers hidden>
          {Array.from({ length: MAX_FILLERS }).map(() => (
            <a class="cas cas-blank" aria-hidden="true" tabindex="-1">
              <div class="cas-f cas-front">
                <div class="cas-label">
                  <div class="cas-label-fallback" aria-hidden="true" />
                  <div class="cas-label-scrim" aria-hidden="true" />

                  {/* An unwritten tape still has a printed J-card: brand band,
                      ruled writable label, neutral type code. See
                      `.cas-blank-header` in the stylesheet.
                      ⚠️ The type code is language-neutral on purpose — a blank
                      cassette's print is not translated copy, and adding three
                      strings to `translations.ts` for scenery nobody reads would
                      be the wrong trade. */}
                  <span class="cas-blank-header" aria-hidden="true">
                    <span>{brand}</span>
                    <span>TYPE I</span>
                  </span>
                  <span class="cas-blank-sheet" aria-hidden="true" />
                  <span class="cas-blank-type" aria-hidden="true">
                    LOW NOISE · C-60
                  </span>

                  <span class="cas-window" aria-hidden="true">
                    <span class="cas-reel">
                      <span class="cas-reel-spokes" />
                      <span class="cas-reel-ring" />
                      <span class="cas-reel-hub" />
                    </span>
                    <span class="cas-plate cas-plate-blank" aria-hidden="true" />
                    <span class="cas-reel">
                      <span class="cas-reel-spokes" />
                      <span class="cas-reel-ring" />
                      <span class="cas-reel-hub" />
                    </span>
                  </span>
                </div>
              </div>
              <div class="cas-f cas-left">
                <span class="cas-spine-brand">{brand}</span>
              </div>
              <div class="cas-f cas-right">
                <span class="cas-spine-brand">{brand}</span>
              </div>
              <div class="cas-f cas-top" />
              <div class="cas-f cas-bottom">
                <span class="cas-bottom-edge" aria-hidden="true" />
              </div>
              <div class="cas-f cas-back" />
            </a>
          ))}
        </div>
      </div>

      {/* ── HUD ── */}
      <div class="shelf-hud">
        <div class="shelf-hud-row">
          <div class="shelf-counter">
            <strong id="shelf-current">01</strong>
            <span>/ <span id="shelf-total">{String(items.length).padStart(2, "0")}</span></span>
            <em>{t.shelf.counter}</em>
          </div>

          <span class="shelf-hud-rule" aria-hidden="true"></span>

          <div class="shelf-hud-state">
            <i class="shelf-dot" aria-hidden="true"></i>
            <span id="shelf-hud-state">
              {String(items.length).padStart(2, "0")} {t.shelf.loaded}
            </span>
          </div>
        </div>

        <p class="shelf-hud-desc">{description}</p>
      </div>

      <aside class="shelf-panel" id="shelf-panel" data-wip="0">
        <div class="shelf-panel-kicker">
          <span id="shelf-panel-category">{t.shelf.brief}</span>
          <span class="shelf-panel-status">
            <i class="shelf-status-mark" aria-hidden="true"></i>
            <b id="shelf-panel-status"></b>
          </span>
        </div>

        <h2 class="shelf-panel-title" id="shelf-panel-title"></h2>

        <p class="shelf-panel-desc" id="shelf-panel-desc"></p>

        <div class="shelf-panel-tags" id="shelf-panel-tags"></div>

        <div class="shelf-panel-foot">
          <span id="shelf-panel-date"></span>
        </div>

        {/* The way in. Routing it through the same launcher as a click on the
            tape keeps one transition, whichever affordance is used. */}
        <button class="shelf-open" id="shelf-open" type="button">
          {/* ⚠️ ONE arrow, and it is the one inside the label. The label string is
              `inspect: "INSPECT FILE >"` in all three languages, and this button
              also carried a drawn arrow at its right edge — two chevrons on one
              slab (2026-09-19: "INSPECT 按钮右侧有两个箭头，去掉最右侧的那个箭头").
              The DRAWN one is the one that went. If the `>` should go instead (and
              the animated arrow come back), delete the `>` from the three
              `shelf.inspect` strings in `translations.ts` and restore
              `.shelf-open-arrow` from git history — do not run both. */}
          <span class="shelf-open-label">{t.shelf.inspect}</span>
        </button>
      </aside>

      <button class="shelf-nav left" id="shelf-prev" aria-label={t.shelf.prev}>
        <span class="shelf-arrow">
          <svg viewBox="0 0 14 26" aria-hidden="true" focusable="false">
            <path d="M12 2 L2 13 L12 24" />
          </svg>
        </span>
      </button>

      <button class="shelf-nav right" id="shelf-next" aria-label={t.shelf.next}>
        <span class="shelf-arrow">
          <svg viewBox="0 0 14 26" aria-hidden="true" focusable="false">
            <path d="M2 2 L12 13 L2 24" />
          </svg>
        </span>
      </button>

      <div class="shelf-foot">
        <span class="shelf-hint">{t.shelf.instructions}</span>
      </div>

      <p class="shelf-empty" id="shelf-empty" hidden>{t.shelf.empty}</p>

      <span class="shelf-sr" id="shelf-status" role="status" aria-live="polite"></span>

      <div class="shelf-intro" id="shelf-intro">
        <div class="shelf-intro-mark">
          <span class="shelf-intro-brand">{brand} / {title}</span>
          <span class="shelf-intro-bar" aria-hidden="true"><i></i></span>
          <span class="shelf-intro-state" id="shelf-intro-state">
            {t.shelf.booting}
          </span>
          <span class="shelf-intro-skip">{t.shelf.skip}</span>
        </div>
      </div>

      <div class="shelf-veil" id="shelf-veil" aria-hidden="true"></div>
    </div>
  </section>
</div>

{/* First page view of a session: warm every cover so the first tag-filter
    swap — and the first tape step — never wait on the network. Repeat views
    skip it; the covers are already in the HTTP cache. */}
<script is:inline>
  (() => {
    const el = document.getElementById("shelf-warm");
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem("rrsuika-shelf-warm") === "1";
      sessionStorage.setItem("rrsuika-shelf-warm", "1");
    } catch {
      /* private mode — preload every time, which is the safe direction */
    }
    if (seen) return;

    let urls = [];
    try {
      urls = JSON.parse(el.dataset.covers || "[]");
    } catch {
      urls = [];
    }

    for (const href of urls) {
      const link = document.createElement("link");
      link.rel = "preload";
      link.as = "image";
      link.href = href;
      document.head.appendChild(link);
    }
  })();
</script>

<style>
  /* ══════════════════════════════════════════
     PAGE SHELL — the shelf owns the first screen
     ══════════════════════════════════════════ */

  .shelf-page {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 76px); /* 76px = sticky navbar */
    min-height: calc(100svh - 76px);
    /* No bottom padding: the shelf runs all the way down to the footer rule. */
    /* ⚠️ The whole page is a DRAG SURFACE (2026-09-19: "在 projects 和 labs 容易误触
       导致选中画面文本内容而非拖动，需要在这两个界面禁用鼠标复制或右键"). A pointer
       that starts on a tape and moves has to drag the row; if the browser decides
       the gesture is a text selection instead, the visitor gets a blue smear and
       no drag — and the panel's brief is the biggest target on the page. Nothing
       here is meant to be copied.
       ⚠️ `-webkit-user-select` lives in its OWN rule below: written as a pair the
       build's minifier (lightningcss) folds them and keeps only the last one. */
    user-select: none;
  }

  :global(.shelf-page) {
    /* Safari ≤ 17 needs the prefixed form; one declaration per rule, see above.
       `user-select` propagates to the subtree, so this covers the panel, the
       titles and the footer readout too. */
    -webkit-user-select: none;
  }

  /* The global footer carries a 120px section gap, which on these six pages
     shows up as a band of dead space between the bottom of the shelf and the
     footer rule. The shelf is sized to end exactly at the fold, so zero it and
     the two butt up against each other.
     `!important` is deliberate: Footer.astro styles itself through a scoped
     class selector (0,2,0) that a plain class override cannot beat. */
  :global(.footer) {
    margin-top: 0 !important;
  }

  .shelf-head {
    flex: 0 0 auto;
    width: 100%;
    /* ⚠️ Deliberately NOT `--container-wide` + `margin: 0 auto`: the HUD's
       counter sits at 34px from the viewport edge, and centring a 1400px block
       inside a 1600px window put the eyebrow 100px to the right of it — two
       left edges that visibly disagree on a wide screen. The header uses the
       same gutter as the HUD, the panel and the foot, so there is one left
       edge for the whole page. */
    padding: 18px 34px 0;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .shelf-head h1 {
    flex: 0 0 auto;
    /* ⚠️ Bigger AND opened up (2026-09-19: "针对 projects 和 labs 界面左上角的字体
       进行放大，同时字母和字母之间间隙拉开，目前看起来太挤了"). The tracking was
       `--tracking-tight` = **-2px** — a negative value borrowed from the display
       headings, where it is tuned for a lowercase Latin wordmark. On a short
       all-caps word like PROJECTS or LAB it just packs the glyphs together. This
       is the page's own name, so it now carries positive tracking instead: the
       letterforms get a gap of their own rather than sharing an edge. */
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: 0.075em;
    /* ⚠️ A layout-NEUTRAL nudge, not a margin. The header row is
       `align-items: flex-end`, which aligns the two BOXES — and a line box carries
       the font's descender space below the baseline, so the visible type stopped
       ~7px above the chips (2026-09-19: "让字体的底部贴着右侧几个按钮的底部").
       ⚠️ A negative `margin-bottom` is the wrong tool here even though it looks
       right: it shrinks the h1's MARGIN box, which is what sets the flex line's
       height, so the chips came up by the same 7px and nothing was aligned
       (measured: chip bottom 149 → 141.8 while the box bottom stayed at 153).
       `position: relative` + `top` moves only what is painted, so the row's layout
       is untouched and the two bottoms actually meet. In `em`, so the mobile
       breakpoint's 32px scales with it. */
    position: relative;
    top: 0.18em;
    margin: 0;
  }

  .shelf-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    color: var(--accent);
    margin-bottom: 5px;
  }

  /* Chips share the header row so the shelf below gets the whole fold. */
  .shelf-tag-bar {
    flex: 1 1 auto;
    justify-content: flex-end;
    flex-wrap: nowrap;
    overflow-x: auto;
    margin: 0;
    padding-bottom: 4px;
    border-bottom: none;
    scrollbar-width: none;
  }

  .shelf-tag-bar::-webkit-scrollbar {
    display: none;
  }

  .shelf-tag-bar .tag-chip {
    flex: 0 0 auto;
  }

  /* ══════════════════════════════════════════
     THE SHELF
     ══════════════════════════════════════════ */

  .shelf {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    width: 100%;
    min-height: 0;
    margin-top: 2px;
  }

  .shelf-stage {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    min-height: 420px;

    perspective: calc(var(--S, 100px) * var(--persp, 11.8));
    perspective-origin: 50% 50%;

    overflow: hidden;

    /* The row is a pointer-drag surface: vertical panning stays with the
       browser (the page can still scroll), everything horizontal is ours. */
    touch-action: pan-y;
  }

  .shelf-stage.is-dragging {
    cursor: grabbing;
    touch-action: none;
  }

  .shelf-track {
    position: absolute;
    inset: 0;

    transform-style: preserve-3d;

    /* Drops the whole 3D scene toward the bottom of the stage so the shelf
       sits on the footer rule instead of floating in the middle with dead
       space below it. Percentage of the stage height; tune to taste.
       NOTE: a track transform is safe — it is the 3D context's root child,
       and a pure 2D translate never flattens it. */
    transform: translateY(var(--shelf-drop, 1.5%));
  }

  /* Soft archive light so the cassettes sit in a space, not a void. */
  .shelf-atmos {
    position: absolute;
    inset: 0;
    pointer-events: none;

    background: radial-gradient(
      ellipse 46% 40% at 50% 56%,
      rgba(255, 255, 255, 0.05),
      transparent 70%
    );

    opacity: 0.5;
  }

  :global(:root[data-theme="light"]) .shelf-atmos {
    opacity: 0.28;
  }

  /* Top / bottom scrims: they lift the micro-type off the starfield and give
     the HUD rails somewhere to sit. */
  .shelf-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(4, 4, 7, 0.72) 0%,
        rgba(4, 4, 7, 0.28) 9%,
        transparent 22%
      ),
      linear-gradient(
        0deg,
        rgba(4, 4, 7, 0.7) 0%,
        rgba(4, 4, 7, 0.24) 8%,
        transparent 20%
      );
  }

  :global(:root[data-theme="light"]) .shelf-scrim {
    background:
      linear-gradient(
        180deg,
        rgba(240, 235, 224, 0.8) 0%,
        rgba(240, 235, 224, 0.3) 9%,
        transparent 22%
      ),
      linear-gradient(
        0deg,
        rgba(240, 235, 224, 0.78) 0%,
        rgba(240, 235, 224, 0.26) 8%,
        transparent 20%
      );
  }

  .shelf-floor {
    position: absolute;
    left: 50%;
    bottom: 7%;
    width: min(74vw, 900px);
    height: 76px;
    transform: translateX(-50%);
    pointer-events: none;

    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.58),
      transparent 68%
    );

    filter: blur(6px);
  }

  :global(:root[data-theme="light"]) .shelf-floor {
    /* ⚠️ **There are TWO shadows under a tape, and this is the second one**
       (2026-09-19: "light mode 下磁带盒下方依旧有阴影，也就是选中磁带盒下方有一个椭圆形
       阴影。你只去除了所有磁带盒的下方阴影，但实际上有两种阴影存在"). The first is the
       per-tape cast pair — `--tape-drop-*` / `--wall-drop` on the faces. This
       ellipse is the FLOOR the whole row stands on, centred under the selection,
       and removing only the first pair left it sitting there looking exactly like
       a tape shadow. On a pale page a `min(74vw, 900px)` black ellipse at 0.26
       was also the heaviest thing in the frame — the same "闷" the shell pass was
       fixing.
       ⚠️ The dark theme KEEPS it: against black this ellipse is what stops the row
       from floating, and there is nothing heavy about it there. */
    background: none;
  }

  /* ══════════════════════════════════════════
     CASSETTE
     World units: W 4.85 · H 3.10 · D 0.37
     The shell is deliberately thin (D ≈ 7.6% of W, against the old 14.4%):
     seven of these have to stand in one row without their slabs colliding.
     ══════════════════════════════════════════ */

  /* ══════════════════════════════════════════
     TAPE — the shell as a MATERIAL, in two themes.

     Everything the six faces paint comes from these tokens, so the whole row
     can be re-materialised per theme without touching a face rule. The dark set
     is graphite in a cool key; the light set is a warm ivory/bone shell, because
     a black cassette on a paper-white page reads as a hole punched in the page.
     Values are grouped by where they land: body, spines, moulded edges, metal,
     micro-type, and the relief pair every raised detail is built from.
     ══════════════════════════════════════════ */

  .cas {
    /* Body: the front plate and the plastic around the J-card. */
    --shell-top: #17171c;
    --shell-mid: #0a0a0d;
    --shell-bot: #07070a;

    /* Side walls, seam → outer edge (light comes from the front-right). */
    --shell-spine-a: #05050a;
    --shell-spine-b: #101016;
    --shell-spine-c: #17171f;
    --shell-spine-d: #0a0a10;

    /* Moulded top/bottom walls and the back plate. */
    --shell-edge-a: #1b1b21;
    --shell-edge-b: #0a0a0d;
    --shell-edge-under-a: #06060a;
    --shell-edge-under-b: #12121a;
    --shell-back: #08080b;

    /* Rim: the bright seam where two walls meet, and the dark line inside it. */
    --shell-rim: rgba(255, 255, 255, 0.17);
    --shell-rim-inner: rgba(0, 0, 0, 0.55);
    --shell-hi: rgba(255, 255, 255, 0.14);
    --shell-ao: rgba(0, 0, 0, 0.62);
    --shell-seam: rgba(255, 255, 255, 0.24);

    /* Relief: every raised part gets this light/dark pair, every recessed part
       the inverse. This is the neumorphic half of the shell — one light source
       (top-left) for the whole tape. */
    --relief-hi: rgba(255, 255, 255, 0.34);
    --relief-lo: rgba(0, 0, 0, 0.55);

    /* Metal: the reel hubs and the spine caps. */
    --metal-hi: #ffffff;
    --metal-mid: #d2d2d6;
    --metal-lo: #6b6b74;

    /* Micro-type printed or moulded on the shell. */
    --shell-ink: rgba(233, 227, 214, 0.78);
    --shell-ink-dim: rgba(196, 189, 175, 0.5);

    /* The window: a matte recessed moulding, not a pane of glass. `lip` is the
       shadow the shell casts into its own opening (top edge), `edge` the
       hairline the far wall catches (bottom edge). */
    --glass-lip: rgba(0, 0, 0, 0.55);
    --glass-edge: rgba(226, 218, 202, 0.14);
    --glass-cavity-a: rgba(10, 10, 15, 0.86);
    --glass-cavity-b: rgba(4, 4, 7, 0.94);

    /* Gloss: a corner sheen on the moulding. The dark shell is graphite, so it
       only just catches the light; the light theme is where the sheen reads. */
    --gloss-a: 0.1;
    --gloss-c: rgba(226, 232, 244, 1);

    /* The plate between the hubs. A milky, low-contrast translucent
       fill — no bright edge anywhere, which is what separates frosted plastic
       from a chrome insert. */
    --plate-frost: rgba(176, 172, 164, 0.24);
    --plate-frost-hi: rgba(255, 255, 255, 0.1);
    --plate-frost-lo: rgba(0, 0, 0, 0.16);
    --plate-edge: rgba(255, 255, 255, 0.13);
    --plate-shade: rgba(0, 0, 0, 0.7);
    --plate-ink: rgba(232, 226, 214, 0.82);

    /* The blank J-card: a printed header band, a ruled writable label, and a
       neutral type code. No accent colour — an unused tape is the quietest
       object on the shelf. */
    --blank-head: rgba(12, 12, 16, 0.5);
    --blank-sheet: rgba(255, 252, 244, 0.1);
    --blank-rule: rgba(28, 28, 34, 0.5);
    --blank-ink: rgba(226, 220, 206, 0.8);
    --blank-ink-dim: rgba(206, 200, 186, 0.58);

    /* Neighbours are dimmed with this, never with `opacity`: a see-through tape
       lets the tape behind it show through and the row reads as stacked ghosts
       (worst on the light theme, where the bleed is obvious). */
    --shell-dim-a: rgba(7, 10, 20, 0.68);
    --shell-dim-b: rgba(4, 6, 14, 0.84);

    /* Cast shadow: cold and deep on graphite, warm and shorter on ivory. */
    --tape-drop-far: 0 30px 64px rgba(0, 0, 0, 0.62);
    --tape-drop-near: 0 6px 18px rgba(0, 0, 0, 0.5);
    --wall-drop: 0 20px 44px rgba(0, 0, 0, 0.6);
    /* ⚠️ Ten tapes each casting a 64px-blur shadow is the single most expensive
       thing in a repaint of this row, and only the selection's shadow is ever
       read as depth — the neighbours are dimmed anyway. So they get a short
       one; see `.cas:not(.is-center) .cas-front`. */
    --tape-drop-short: 0 12px 22px rgba(0, 0, 0, 0.45);

    /* The key light that picks the selection out of the row. */
    --key-glow: rgba(255, 178, 102, 0.06);
    --key-edge: rgba(255, 196, 138, 0.22);

    position: absolute;
    left: 50%;
    top: 50%;

    width: var(--cas-w, 400px);
    height: var(--cas-h, 256px);

    margin-left: calc(var(--cas-w, 400px) / -2);
    margin-top: calc(var(--cas-h, 256px) / -2);

    transform-style: preserve-3d;
    transform-origin: 50% 50%;

    font-family: var(--font-mono);
    font-size: calc(var(--cas-w, 400px) / 26);

    text-decoration: none;
    color: var(--text-bright);

    cursor: grab;
    /* Native image / link dragging is the enemy here: without these the
       browser starts its own drag of the cover art or of the anchor as soon as
       the pointer moves, and the row never gets the gesture. */
    -webkit-user-drag: none;
    user-select: none;

    /* ⚠️ `will-change` is deliberately NOT set on every tape. It was, and that
       promotes ten 3D boxes to their own compositor layers for the whole life of
       the page — memory, plus a re-raster of each on the first frame after the
       shelf settles. The hint belongs on the tape that is about to move, so the
       render loop adds it to the selection only (see `.is-center` below). */
    contain: layout style;
  }

  /* Only the tape that is actually travelling gets a layer hint. */
  .cas.is-center {
    will-change: transform;
  }

  .cas.is-hidden {
    visibility: hidden;
    will-change: auto;
  }

  /* ── Warm glossy plastic for the light theme ──
     The era's cassette was not chrome: it was an off-white / pale-buff
     polystyrene moulding with a hard specular sheen, and that is what the user
     asked for (2026-09-19: "冷铬银外壳不是很贴合，那个时代更多是一种偏黄偏白的塑料，带高光感的").
     ⚠️ This DOES NOT repaint the page. The page stays paper-white and cool
     shadows stay cool, so the warm body has something to sit against; an earlier
     all-warm pass collapsed into mud ("像屎黄色") because the shell, its shadows
     and the page were all the same temperature. Read that pass and this one as a
     pair: the fix is not "make it cool", it is "warm body, cool shadow, real
     specular". The gloss itself lives in `.cas-label::before` (`--gloss-*`), and
     it is a corner sheen on the moulding — never a band across the printed
     J-card, which reads as a sticker lying on the artwork.
     ⚠️ **LIGHTENED twice, 2026-09-19.** First pass ("外壳太暗了，导致侧面标题看不清"):
     the shell family sat a full step darker than the page it stands on and the
     neighbour veil took another ~45% of the light off it, so the spine titles —
     dark ink on a mid-tone bed — measured 2.6:1. Second pass ("做的亮一些，现在太暗了，
     给人很闷的感觉"): the body is now a BRIGHT warm neutral near the top of its range
     and the veil is down to 0.18/0.28, which is what a cassette-futurism palette
     does — the object is the lightest thing in the frame and the haze only orders
     the row. ⚠️ `--shell-ink*` must stay dark (it is the printed spine type) and
     `--gloss-a` goes UP with the body: on a bright moulding the specular is what
     reads as plastic instead of paper. */
  :global(:root[data-theme="light"]) .cas {
    --shell-top: #ffffff;
    --shell-mid: #fbf5ea;
    --shell-bot: #e4dbc6;

    --shell-spine-a: #cfc3a8;
    --shell-spine-b: #eee5d2;
    --shell-spine-c: #fdf9f0;
    --shell-spine-d: #dbd0b6;

    --shell-edge-a: #fffdf6;
    --shell-edge-b: #d8ccb2;
    --shell-edge-under-a: #c9bda1;
    --shell-edge-under-b: #f3ecdc;
    --shell-back: #efe7d5;

    --shell-rim: rgba(255, 255, 255, 0.95);
    --shell-rim-inner: rgba(74, 58, 36, 0.3);
    --shell-hi: rgba(255, 252, 240, 0.98);
    --shell-ao: rgba(64, 48, 28, 0.3);
    --shell-seam: rgba(255, 253, 244, 0.9);

    --relief-hi: rgba(255, 252, 240, 0.95);
    --relief-lo: rgba(94, 70, 38, 0.4);

    --metal-hi: #fffdf6;
    --metal-mid: #ece1c7;
    --metal-lo: #a2957a;

    --shell-ink: rgba(38, 29, 14, 0.93);
    --shell-ink-dim: rgba(56, 44, 24, 0.75);

    /* Gloss: a warm-white sheen, present but restrained — the tape is glossy
       plastic, not a mirror. ⚠️ Raised 0.4 → 0.55 → 0.62 with the brighter body:
       on a near-white moulding the sheen is the only thing that separates "glossy
       plastic" from "paper", and at the earlier values it vanished into the new
       highlight. This is also what the cassette-futurism palettes do — bone body,
       ONE hard specular, cool shadow. */
    --gloss-a: 0.62;
    --gloss-c: rgba(255, 247, 224, 1);

    --glass-lip: rgba(52, 40, 22, 0.46);
    --glass-edge: rgba(255, 252, 240, 0.72);
    --glass-cavity-a: rgba(64, 54, 36, 0.92);
    --glass-cavity-b: rgba(38, 32, 20, 0.97);

    --plate-frost: rgba(255, 250, 234, 0.3);
    --plate-frost-hi: rgba(255, 253, 244, 0.34);
    --plate-frost-lo: rgba(86, 66, 36, 0.2);
    --plate-edge: rgba(255, 253, 244, 0.34);
    --plate-shade: rgba(74, 56, 30, 0.62);
    --plate-ink: rgba(255, 252, 242, 0.86);

    /* The blank J-card on a beige shell: the same printed header, but the rules
       and the type code have to be dark to read against warm paper. */
    --blank-head: rgba(96, 78, 48, 0.22);
    --blank-sheet: rgba(255, 252, 242, 0.42);
    --blank-rule: rgba(96, 78, 48, 0.34);
    --blank-ink: rgba(58, 44, 24, 0.82);
    --blank-ink-dim: rgba(76, 60, 34, 0.6);

    --reel-cavity: #46402f;
    --reel-occl: rgba(0, 0, 0, 0.36);
    --reel-far-light: 0.5;

    /* ⚠️ THE LIGHT THEME'S VEIL IS THE PAGE'S OWN PAPER, not a dark tint
       (2026-09-19: "light mode下则是一个贴合背景色的亮色渐变，模拟一种空气透视的效果，越远
       细节越模糊"). It went 0.40/0.54 → 0.26/0.38 → 0.18/0.28 of a COOL BLACK, each
       pass tuned for the spine titles' contrast (dark ink on this shell), and that
       is the wrong knob for the job: a dark veil DARKENS the row, the opposite of
       aerial perspective, where a distant object loses contrast toward the
       background it stands in front of. A paper wash at the same alphas lightens
       the shell instead, which raises the titles' contrast rather than eating it.
       ⚠️ Depth no longer rests on the veil alone: `.cas-f::after`'s opacity is
       scaled by `--cas-depth`, so the veil is LIGHT on the nearest neighbour and
       full at the far end, and `--depth-blur` dissolves the print of the far ones. */
    --shell-dim-a: rgba(240, 235, 224, 0.6);
    --shell-dim-b: rgba(240, 235, 224, 0.82);

    /* ⚠️ NO CAST SHADOW in the light theme (2026-09-19: "light mode 下，去掉磁带盒底部的
       阴影"). A 52px black drop under a bright moulding is what made the row read as
       heavy — the object sits on a pale page, and the shadow was the only dark
       thing left in the frame once the shell was lifted.
       ⚠️ They are `0 0 0 rgba(0,0,0,0)`, NOT `none`: every one of these is used in
       a comma-joined `box-shadow` list, and `none` is only valid as the SOLE value
       of the property — writing it there would drop the whole declaration and take
       the shell's bevel insets with it. */
    --tape-drop-far: 0 0 0 rgba(0, 0, 0, 0);
    --tape-drop-near: 0 0 0 rgba(0, 0, 0, 0);
    --wall-drop: 0 0 0 rgba(0, 0, 0, 0);
    --tape-drop-short: 0 0 0 rgba(0, 0, 0, 0);

    --key-glow: rgba(255, 186, 116, 0.24);
    --key-edge: rgba(190, 118, 44, 0.4);
  }

  .cas:focus-visible {
    outline: none;
  }

  .cas-f {
    position: absolute;
    left: 50%;
    top: 50%;

    opacity: var(--cas-o, 1);

    /* ⚠️ This makes the face its own stacking context, and that is load-bearing
       for the veil below: `::after` needs a z-index above every element printed
       inside the face, and without a stacking context here that z-index would be
       compared against the OTHER FACES of the same tape (which live in `.cas`'s
       context) — the wash would then be able to paint over a spine.
       ⚠️ Safe for the 3D: `.cas` is the element with `transform-style:
       preserve-3d`, and grouping properties only flatten the element that carries
       it. The face is a flat leaf either way. */
    isolation: isolate;

    backface-visibility: hidden;
    pointer-events: none;
  }

  /* The reference fades the printed cover out as a tape turns edge-on
     (`front = 1 − .96·side`). The intent here is INVERTED on purpose: the
     neighbours are dimmed rather than hidden, so keeping the cover ~80%
     visible at full side-turn makes the row read as a fan of artwork instead of
     a rack of blank spines — which is exactly the "make the spine titles
     readable" complaint. */
  /* ⚠️ NOTHING on a tape fades with `opacity` except the ring enter/leave
     (`--cas-o` = `tape.vis`) and the intro. An earlier revision also crossfaded
     the printed cover as a tape turned edge-on (`--cas-front-o`, 0.8 at full
     side). It looked acceptable on the dark theme and wrong on the light one:
     the front plate of every neighbour went see-through, so a tape showed the
     tape behind it, the shell behind that, and the row read as stacked
     translucent volumes. Depth is carried by the opaque dim below, the Z
     separation and the scale — never by alpha. */
  .cas-front,
  .cas-back {
    opacity: var(--cas-o, 1);
  }

  /* Behind the selection the tapes stay SOLID and are veiled instead — and the
     veil is DISTANCE-DRIVEN (2026-09-19: "dark mode下，给距离画面中心越远的磁带盒做整体
     压暗的渐变，模拟距离画面越远越远，拉开空间距离").
     ⚠️ There is no `--cas-beneath` gate any more. The veil used to be a flat 1 for
     every non-selection, flipped in a single frame the moment a tape crossed the
     centre — which is exactly why it needed a 0.5s transition to hide that step.
     `--cas-depth` (0 at the selection, 1 at the far end of the painted band) is
     written per tape by the render loop and drives the opacity continuously:
     `× --dim-rate`, clamped at 1, so the falloff runs smoothly through the centre,
     the nearest neighbour keeps a light veil and the far end reaches the full one.
     Putting a gate back on top would reintroduce the step.
     ⚠️ **`z-index: 8` is what makes it cover the WHOLE tape** (2026-09-19: "深色渐变
     …并没有应用到磁带盒标题字和下面的强调色线，PRJ_NODE // 字和右侧日期字以及他俩底部的
     边框"). The wash was at `z-index: auto`, i.e. UNDER everything printed on the
     card: the title (`z-index: 4`), the colour rail (3), the header row (2), the
     scrim (1) and the moulded top band with its bottom hairline (1). Measured
     A/B on one far tape with `--dim-rate` 0 → 8, sampling that tape's own colour
     rail: it now darkens with the rest of the shell instead of staying lit.
     ⚠️ It must stay above every in-face z-index (7 is the highest inside a face
     today — the blank tape's sheet); `isolation: isolate` on `.cas-f` keeps the
     number scoped to the face. */
  .cas-f::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
    background: linear-gradient(180deg, var(--shell-dim-a), var(--shell-dim-b));
    opacity: min(var(--dim-max, 0.78), var(--cas-depth, 0) * var(--dim-rate, 2.4));
    /* Short on purpose: the depth term is already continuous, so a long transition
       would only make the veil lag behind the row it is describing. */
    transition: opacity 0.2s linear;
  }

  /* ── AERIAL PERSPECTIVE — the farther a tape is, the softer its print ──
     (2026-09-19: "light mode下…模拟一种空气透视的效果，越远细节越模糊的滤镜", then
     "dark mode也按照 light mode一样，距离画面越远的磁带盒越模糊".) Both themes now,
     so the rule is not theme-scoped any more.
     ⚠️ SAFE ONLY BECAUSE THIS IS INSIDE THE FACE. A `filter` on `.cas` — or on any
     other ancestor of a `.cas-f` — forces `transform-style: flat` and collapses the
     whole box into a flat card. `.cas` is the preserve-3d box and the faces are its
     children; everything below a face is a flat leaf with nothing left to flatten.
     ⚠️ Blurring the spine spans matters as much as blurring the label: a distant
     tape is turned ~58° toward edge-on, so its SPINE is most of what you see.
     ⚠️ `.is-far` keeps `filter` off the tapes that do not need it — `blur(0px)` is
     still a filter, which costs a rasterisation pass and switches off subpixel text
     antialiasing, so the hero's title would lose its edge for nothing. */
  .cas.is-far .cas-f > * {
    filter: blur(calc(var(--cas-depth, 0) * var(--depth-blur, 2.4px)));
  }

  /* ── Blank cassette: an UNWRITTEN tape ──
     Same shell, no record on it — but "no record" is not "no design". The first
     version was a dark grid with a hairline cross on it, which read as an empty
     slot with a glitch rather than as a tape (2026-09-19: "给空磁带做一个好看点的
     设计，现在封面什么都没有，可以加入比如磁带盒的默认外观").

     So it is a blank J-card, drawn from the same language as a printed one:
       · a printed brand header band at the top — the same ink and tracking as
         `Sheet`, so the row still reads as one product family;
       · the ruled writable label below it (five hairlines), which is what an
         unrecorded cassette actually carries;
       · a neutral type code, no accent colour, no title.
     ⚠️ NO accent stripe and NO gloss hot-spot: a blank is the tape you have not
     used yet, so it must be the quietest object on the shelf. It keeps the
     window, the wells and the ribbon so it is unmistakably the same moulding. */
  .cas-blank .cas-label-fallback {
    background-color: transparent;
    background-size: 100% 42%;
    background-position: 0 33%;
    background-repeat: no-repeat;
    /* Four writable rules inside the sheet's 42% band (33% → 75%): 12% apart. */
    background-image: linear-gradient(
      180deg,
      transparent 0 23%,
      var(--blank-rule) 23% 24.4%,
      transparent 24.4% 47%,
      var(--blank-rule) 47% 48.4%,
      transparent 48.4% 71%,
      var(--blank-rule) 71% 72.4%,
      transparent 72.4% 95%,
      var(--blank-rule) 95% 96.4%,
      transparent 96.4%
    );
  }

  /* The header band: same construction as a printed label's. */
  .cas-blank-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 17.5%;

    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6%;

    background: var(--blank-head);
    border-bottom: 1px solid var(--blank-rule);

    font-size: 0.44em;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--blank-ink);
  }

  /* The ruled label area: a lighter pocket of paper in the moulding. */
  .cas-blank-sheet {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 33%;
    height: 42%;

    background: var(--blank-sheet);
    box-shadow:
      inset 0 0 0 1px var(--blank-rule),
      inset 0 1px 0 var(--relief-lo);
    border-radius: 1px;
  }

  .cas-blank-type {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 77%;

    font-size: 0.4em;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--blank-ink-dim);
  }

  .cas-blank .cas-label-scrim {
    background: linear-gradient(
      180deg,
      rgba(4, 4, 7, 0.18) 0%,
      transparent 34%,
      transparent 72%,
      rgba(4, 4, 7, 0.26) 100%
    );
  }

  :global(:root[data-theme="light"]) .cas-blank .cas-label-scrim {
    background: linear-gradient(
      180deg,
      rgba(74, 58, 38, 0.1) 0%,
      transparent 34%,
      transparent 72%,
      rgba(74, 58, 38, 0.14) 100%
    );
  }

  /* The wells hold a full pack of tape, so the spokes are hidden — a blank has
     no reel position to read. */
  .cas-blank .cas-reel-spokes {
    display: none;
  }

  /* No accent: a blank carries the neutral ink, not a stripe colour. The models
     are hidden because a printed accent is the one thing an unwritten tape does
     not have. */
  .cas-blank {
    --cas-accent: var(--blank-ink);
    --cas-accent-soft: var(--blank-ink-dim);
  }

  .cas-blank .cas-accent-bar,
  .cas-blank .cas-mould {
    display: none;
  }

  /* A blank is scenery: no cursor affordance, no hover response. */
  .cas-blank {
    cursor: default;
  }

  /* ── FRONT ──
     The shell is a drawn object, not a photo: a moulded plate with a bevelled
     rim, an inner frame (`.cas-label::after`) holding the printed J-card, four
     metal screws and a gloss sweep. */
  .cas-front {
    width: var(--cas-w, 400px);
    height: var(--cas-h, 256px);
    margin-left: calc(var(--cas-w, 400px) / -2);
    margin-top: calc(var(--cas-h, 256px) / -2);

    transform: translateZ(calc(var(--cas-d, 38px) / 2));

    border-radius: 5px;
    overflow: hidden;

    background: linear-gradient(
      168deg,
      var(--shell-top) 0%,
      var(--shell-mid) 58%,
      var(--shell-bot) 100%
    );

    /* Bevel: rim light, inner dark line, top highlight — plus the cast shadow
       that grounds the tape against the row. */
    box-shadow:
      var(--tape-drop-far),
      var(--tape-drop-near),
      inset 0 0 0 1px var(--shell-rim),
      inset 0 0 0 2.5px var(--shell-rim-inner),
      inset 0 1px 0 var(--shell-hi);

    transition: box-shadow 0.5s var(--ease-out);
  }

  /* Shell rim detail: a bright seam where the front turns into the left wall. */
  .cas-front::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--shell-seam);
    z-index: 5;
    pointer-events: none;
  }

  /* ── The cover fills the face inside the BEZEL ──
     ⚠️ `inset: var(--shell-frame)`, not `inset: 0` (2026-09-19: "磁带盒的边框做厚一点，
     比如边框变厚，那其中的图片就缩小"). The face behind the label is the shell's own
     gradient, so the inset *is* the moulding: raise the token and the frame gets
     thicker while the printed cover shrinks — and the whole deck moves with it,
     because the window, the title and the moulding are all positioned as
     percentages of this box. 0 restores the old full-bleed card. */
  .cas-label {
    position: absolute;
    inset: var(--shell-frame, 0);
    overflow: hidden;
    /* ⚠️ The same radius as the J-card lip (`.cas-label::after`), and that is the
       whole point: the lip draws a ROUNDED 1px ring at the label's edge, so with a
       square label the print showed through the four corner arcs as square corners
       poking out of a rounded frame (2026-09-19: "封面的四周会稍微超出边框的范围，在角落
       则会变成直角的封面超出了圆角的边框"). Rounding the label clips the cover — the
       `<img>` is `width/height: 100%` inside this box — to exactly the lip's arc.
       Keep the two numbers equal. */
    border-radius: 5px;
    background: var(--shell-mid);
  }

  /* The moulded frame the J-card sits in: a raised plastic lip around the print,
     lit on the top-left and shadowed on the bottom-right, with the card itself
     recessed behind it. This is the single strongest cue that the artwork is a
     printed insert held by a shell rather than a photo pasted on a card.
     ⚠️ Kept to HARD insets, no blur: this element exists on all ten tapes and
     they all repaint while the row moves. A stack of 10px-blur insets here
     measured -25% frame rate on a tape step (+17ms/frame) for a difference
     nobody can see. */

  /* ── GLOSS ──
     The shell is glossy plastic, and this is the only place the sheen lives.
     ⚠️ It is a CORNER falloff held in the top-left, and it must never become a
     BAND crossing the face: a diagonal specular band over a cover image reads as
     a sticker lying on the artwork, which is why the earlier sweep was deleted
     (2026-09-19). A wide radial anchored outside the corner is the difference —
     it is the same light source as every bevel and every relief on the tape
     (top-left), so it reads as light ON the object rather than a shape over it.
     One gradient, hard-edged box: no blur, so ten tapes can carry it. */
  .cas-label::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;

    background:
      radial-gradient(
        108% 128% at -6% -14%,
        var(--gloss-c) 0%,
        transparent 58%
      ),
      radial-gradient(
        52% 62% at 0% -6%,
        var(--gloss-c) 0%,
        transparent 60%
      );

    opacity: var(--gloss-a, 0.1);
  }

  .cas-label::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;

    border-radius: 5px;

    box-shadow:
      inset 0 0 0 1px var(--shell-rim),
      inset 3px 3px 0 -1px var(--shell-hi),
      inset -3px -3px 0 -1px var(--relief-lo);
  }


  /* Moulded model code, embossed rather than printed: a light edge below and a
     dark edge above is what makes type look pressed into plastic. */
  .cas-mould {
    position: absolute;
    left: 6%;
    bottom: 15.2%;
    z-index: 3;

    font-size: 0.42em;
    letter-spacing: 0.3em;
    text-transform: uppercase;

    color: transparent;
    text-shadow:
      0 1px 0 var(--relief-hi),
      0 -1px 0 var(--relief-lo);
    opacity: 0.7;
    pointer-events: none;
  }

  .cas-label img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.94) contrast(1.04);
    -webkit-user-drag: none;
  }

  .cas-label-fallback {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 26px 26px;
    background-color: #0d0d11;
  }

  /* Two scrims only: the label header and the title have to survive whatever
     cover lands behind them. The middle of the face stays untouched so the
     artwork still reads. */
  .cas-label-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;

    background:
      linear-gradient(
        180deg,
        rgba(4, 4, 7, 0.72) 0%,
        rgba(4, 4, 7, 0.22) 14%,
        transparent 30%
      ),
      linear-gradient(
        0deg,
        rgba(4, 4, 7, 0.9) 0%,
        rgba(4, 4, 7, 0.5) 16%,
        transparent 40%
      );
  }

  .cas-label-head {
    position: absolute;
    left: 4.5%;
    right: 4.5%;
    top: 4.5%;
    z-index: 2;

    display: flex;
    align-items: center;
    /* ⚠️ `line-height: 1.2` is what makes the two labels share a height. With
       `normal`, the node measured 18.31px against the date's 15.35px at the same
       font-size, so `align-items: center` centred two different boxes and the
       date sat 4.5px high (2026-09-19: "日期…和 PRJ_NODE // 一样高度"). An
       explicit line-height gives both children the same box. */
    line-height: 1.2;
    justify-content: space-between;
    gap: 0.5em;

    font-size: 0.55em;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: rgba(233, 227, 214, 0.78);
  }

  .cas-node {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The date, opposite the record node on the header row. Same size and colour
     role as its neighbour, one step quieter. */
  .cas-head-date {
    flex: 0 0 auto;
    white-space: nowrap;
    color: rgba(214, 206, 190, 0.72);
  }

  /* ⚠️ `.cas-deck-idx` (the `05 / 06 / 07` at the top-right of the face) is
     GONE (2026-09-19: "磁带盒右上角的 05 06 07 这样的数字去掉，他在其他地方已经
     重复出现过了") — the record number is already on the panel, on the spine and
     in the footer readout, and a second copy on the artwork was just noise.
     Do not bring it back without removing one of the other three. */

  .cas-deck-team {
    color: rgba(233, 227, 214, 0.72);
  }

  /* ── The moulded band across the top of the face ──
     The second window a real shell carries above the hub window. It is drawn in
     the same material language as `.cas-window` — a smoked cavity, a hard lip at
     the near edge, a hairline of light on the far one — because the two are the
     same part on the real object, and it frames the record line that already sat
     at the top of the card. Height is a token (`--recess-h`) so it can be dialled
     against the title block. */
  .cas-recess {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--recess-h, 1.9em);
    z-index: 1;
    pointer-events: none;

    background: linear-gradient(
      180deg,
      var(--glass-cavity-a),
      var(--glass-cavity-b)
    );

    box-shadow:
      inset 0 0 0 1px var(--shell-rim),
      inset 0 1px 2px var(--glass-lip),
      inset 0 -1px 0 var(--glass-edge);
  }

  /* The title swaps to the display face: JetBrains Mono 900 at this size is a
     wall of rectangles, and a wide condensed face is what makes a long project
     name legible on a 250px tape. */
  /* ⚠️ `bottom: 13%`, and the constraint is the WINDOW, not taste
     (2026-09-19: "磁带盒正面左下方的标题目前和背后的黑框重叠了，我希望他往下移动一点").
     The label is ~254px tall and the title is bottom-anchored and grows UPWARD,
     so a two-line title needs its bottom edge at most
     `window bottom (27.6%) − two lines (~15.4%)` = ~12% to clear the cavity, and
     ~10.5% leaves a visible gap. At the old 25% the block's top landed at 39%,
     i.e. across the window's smoked frame — which is exactly what the user was
     looking at. */
  .cas-title {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 10.5%;
    z-index: 4;

    margin: 0;

    font-family: var(--font-display);
    font-size: 1.02em;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.005em;
    text-transform: uppercase;

    color: #f6f1e6;

    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.9),
      0 4px 16px rgba(0, 0, 0, 0.7);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(html[lang="zh"]) .cas-title {
    font-family: var(--font-zh-display);
    letter-spacing: 0;
    line-height: 1.24;
  }

  /* ── Tape window: reels over the cover, as if seen through the shell ──
     A real cassette's hub window sits just above the colour rail; here it
     straddles the title band so the artwork above it stays clean. It is built
     as a RECESSED, MATTE strip — an unpolished moulding, not a glass pane:
     ⚠️ the 128° "frost" sweep and the bright top rim are gone (2026-09-19,
     "哑光凹陷… 高光渐变会让质感很廉价"): a specular ramp across a window that
     small reads as chrome. What is left is a flat cavity, a dark inner shadow
     where the shell turns in, and a hairline of light on the far edge only. */
  .cas-window {
    position: absolute;
    /* ⚠️ Width by TOKEN, centred by the left offset (2026-09-19: "加一个可调参数，
       能调圆形后方的长方形框的宽度"). `left/right: 6%` was exactly this 88% and
       could not be tuned. Expressed as an offset rather than
       `left: 0 + translateX(-50%)` on purpose: a 2D transform on this element
       would be harmless (it is a leaf inside the face, not an ancestor of one)
       but the offset form has nothing to fall out of step with. */
    left: calc((100% - var(--window-w, 88%)) / 2);
    width: var(--window-w, 88%);
    bottom: 27.6%;
    z-index: 3;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--well-gap, 0.5em);

    /* ⚠️ `--well-inset` pulls BOTH wells toward the centre, and it is not the
       same control as `--well-gap`: the wells are spaced by
       `justify-content: space-between`, so shrinking the gap only closes the
       middle — each well stays pinned to its own edge of the window. Extra inline
       padding is what actually moves them inward, which is what a real cassette
       needs: its two hub centres sit about ±21% of the tape width from the
       middle, against ±35% with the inset at 0 (2026-09-19: "两个圆环距离中心太远
       了，不符合现实的磁带盒的圆环的位置").
       ⚠️ The padding is DERIVED, and that is what makes `--window-w` a
       frame-only control: `(window − wells) / 2` equals the old
       `0.7em + --well-inset` exactly while `--window-w` sits at its default, and
       for every other value it holds the CONTENT box at the fixed `--wells-w`
       span — so the wells and the plate between them do not move, only the smoked
       edges do. `max(0px, …)` is the floor: below ~59% the frame is narrower than
       the wells and the compensation runs out. */
    padding: 0.42em max(0px, calc((var(--window-w, 88%) - var(--wells-w)) / 2)) 0.5em;
    border-radius: 3px;

    background: linear-gradient(
      180deg,
      var(--glass-cavity-a),
      var(--glass-cavity-b)
    );

    box-shadow:
      inset 0 0 0 1px var(--shell-rim),
      inset 0 1px 2px var(--glass-lip),
      inset 0 -1px 0 var(--glass-edge);

    pointer-events: none;
  }

  /* ══════════════════════════════════════════
     THE REELS — one tunable parameter set on :root.

     ⚠️ These live on `:root`, NOT on `.cas`, and that is load-bearing: the
     tuning panel writes them as inline properties on <html>, and a custom
     property declared on `.cas` itself would shadow that inherited value
     completely — which is exactly why the panel's REELS sliders did nothing
     while the HERO sliders worked. Defaults belong at the root of the scope, so
     an override from above can win.

     The recessed lighting is the point: inside a dent the NEAR wall (top-left)
     falls into shadow and the FAR wall (bottom-right) catches the light, the
     inverse of every raised part on the shell. It is carried by two hairlines
     and one occlusion band — NOT by a highlight ramp, which is what made it look
     like chrome.
     ══════════════════════════════════════════ */

  :global(:root) {
    --reel-size: 3.1em;
    --reel-spoke-inset: 25%;
    --reel-spoke-alpha: 0.25;
    --reel-spoke-on: 7deg;
    --reel-spoke-gap: 60deg;
    --reel-cavity: #050505;
    --reel-occl: rgba(0, 0, 0, 0.44);
    --reel-near-shadow: 0.81;
    --reel-far-light: 0.4;
    --reel-rim: 0.21;
    --reel-hub-w: 32%;
    --reel-hub-h: 32%;
    --reel-hub-alpha: 0.97;
    --reel-hub-gloss: 0;
    --reel-hub-grain: 0;
    /* The narrow printed frame BETWEEN the two wells (`.cas-plate`, the strip the
       type code and the 100/50/0 scale sit on). `--plate-w` is a share of the
       tape window, capped in practice by the gap the wells leave (100% = as wide
       as that gap); `--plate-h` is in the plate's own em; `--plate-alpha` scales
       the frost fill only — 0 (what ships) leaves the hairline ring and the print
       with no milky fill at all.
       ⚠️ Not to be confused with `--window-w` below: that one is the OUTER smoked
       frame the wells sit in, and `--well-inset` is how far each well is pulled
       off its own edge of it.
       `--well-gap` is the space between a well and the centre (the window's own
       flex gap), so the two wells can be pulled apart or together. */
    --plate-w: 46%;
    --plate-h: 4.7em;
    --plate-alpha: 0;
    --well-gap: 0.5em;
    /* How far each well is pulled in from its own edge of the window. */
    --well-inset: 2.8em;
    /* The OBSERVATION WINDOW's own width, as a share of the printed J-card.
       ⚠️ This resizes the SMOKED FRAME ONLY — it must not move anything inside it
       (2026-09-19: "调整的时候，其他元素比如圆环，刻度表等位置都会变化，而我只需要调整变化").
       The window's inline padding is therefore DERIVED from this value in
       `.cas-window`, which keeps its CONTENT box — the span the two wells are
       pinned to — at a fixed width. See `--wells-w`. */
    --window-w: 69.5%;
    /* ⚠️ The span the wells + plate are laid out in: a fixed width derived from the
       ORIGINAL 88% window, NOT from `--window-w`. At `--window-w: 88%` the two are
       identical (`(88% - --wells-w) / 2 = 0.7em + --well-inset`, the old padding, to
       the pixel) — so this is a refactor, not a change. It is what stays put when
       only the frame is resized. `--well-inset` is still part of it, i.e. still the
       control that pulls both wells inward. */
    --wells-w: calc(88% - 1.4em - 2 * var(--well-inset, 0em));
    /* ── DEPTH — how the row recedes ──
       `--cas-depth` (0 at the selection, 1 at the far end of the painted band) is
       written per tape by the render loop as pure geometry; these two decide what
       the THEMES do with it, so the same number is a dim on the dark theme and a
       haze on the light one.
       `--dim-near` is the neighbour veil's opacity at the near end: at 1 the veil
       is flat (what it used to be), below it the row gains a continuous
       near→far gradient — the nearest neighbour is the clearest, the far ones go
       all the way to the full veil. `--depth-blur` is how far a far tape's print
       dissolves (both themes now — see `.cas-label`).
       ⚠️ `--dim-max` caps the veil: at 1 the farthest tape is buried under the
       full `--shell-dim-*` gradient, which on the dark theme is nearly black
       (2026-09-19: "目前的随距离压暗太强了，可以稍微弱一点，让最远处的磁带盒能勉强看见
       层次"). 0.78 leaves the far tapes dark but still readable — the layers of the
       object (bezel, card, window) survive instead of merging into one silhouette. */
    --dim-rate: 2.4;
    --dim-max: 0.78;
    --depth-blur: 2.4px;
    /* Bezel: the shell showing around the printed J-card. Raising it thickens the
       frame and shrinks the artwork inside it. */
    --shell-frame: 0.98em;
    /* The moulded band across the top of the face. */
    --recess-h: 1.9em;
  }

  /* ⚠️ MATTE, and recessed by LIGHTING rather than by a bright ring (2026-09-19:
     "磁带盒内部的轮盘和旁边的框则是哑光凹陷，而不是现在这样这么明显的高光渐变。这会让质感很廉价").
     The wells used to carry a three-stop highlight down the cavity wall and a
     lit hub face, which reads as a glossy button — a moulded part inside a
     cassette is unpolished and the key light barely reaches in. The values below
     are the user's own tune: cavity fully opaque, hub highlight at zero, the
     recess carried only by the near dark / far light hairline pair. Do not
     re-introduce a highlight ramp here. */

  .cas-reel {
    position: relative;
    width: var(--reel-size, 3.1em);
    aspect-ratio: 1;
    /* The wells keep their size; the plate between them is the tunable one, and
       it is capped at the gap they leave. */
    flex: 0 0 auto;
    border-radius: 50%;

    /* ⚠️ FLAT cavity fill, not a highlight ramp (2026-09-19). The well used to
       carry a three-stop radial down its inner wall, which reads as a glossy
       pressed button rather than an unpolished moulding. The recess is carried
       by the hairline pair below plus the occlusion ring in `::after`. */
    background: var(--reel-cavity, #050505);

    /* ⚠️ A RECESSED well, not a raised disc. Inside a dent the far wall catches
       the key light and the near wall falls into shadow, so the bright edge is
       the bottom-right and the dark one the top-left — the inverse of every
       raised part on the shell. Contrast is deliberately low: a crisp bright
       ring here reads as a button, which is what made the first version look
       cheap. */
    box-shadow:
      inset 0.5px 0.5px 1px rgba(0, 0, 0, var(--reel-near-shadow, 0.81)),
      inset -0.5px -0.5px 0 rgba(226, 218, 202, var(--reel-far-light, 0.4)),
      0 0 0 0.5px rgba(0, 0, 0, 0.45);
  }

  /* The one material cue the well keeps: a soft occlusion band where the shell
     face turns into the bore. One radial, hard edged, identical on ten tapes. */
  .cas-reel::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;

    background: radial-gradient(
      124% 184% at 50% -20%,
      var(--reel-occl, rgba(0, 0, 0, 0.44)) 0%,
      rgba(0, 0, 0, 0.16) 48%,
      transparent 74%
    );
  }

  .cas-reel-spokes {
    position: absolute;
    inset: var(--reel-spoke-inset, 25%);
    border-radius: 50%;

    /* Fainter than the first pass: the spokes are structure behind glass in a
       dark well, so they are a hint, not a bright gear.
       ⚠️ **The pitch is 60deg — SIX spokes** (2026-09-19: "spoke 目前内圈有 3 个线，
       但外圈也需要 6 个线，也就是每 60 度一根线"). It shipped at 120deg, i.e. three
       arms, and a real cassette's reel flange carries six. The same pitch drives
       the outer ring below, so the two line sets stay in step whatever the
       `spoke pitch` slider is set to. */
    background: repeating-conic-gradient(
      from 0deg,
      rgba(214, 206, 190, var(--reel-spoke-alpha, 0.25)) 0deg
        var(--reel-spoke-on, 7deg),
      transparent var(--reel-spoke-on, 7deg) var(--reel-spoke-gap, 60deg)
    );

    transform: rotate(var(--reel-spin, 0rad));
  }

  /* The hub is a counter-sunk bore: the shadow sits top-left, the lit edge
     bottom-right, and the cut edge is a hairline rather than a rim.
     ⚠️ No highlight on the bore face — it is a hole, and a lit face turned it
     into a silver dot with a halo.
     ⚠️ Three tunable tokens, added 2026-09-19 so the bore can be fitted rather
     than guessed at:
       · `--reel-hub-w` / `--reel-hub-h` — the bore's own width and height as a
         percentage of the well. They are separate because the moulding's bore is
         not obliged to be a circle: `border-radius: 50%` on a box that is wider
         than it is tall gives an ellipse, which is what a slipped hub actually
         looks like. Equal values (the default, 32/32 — the same disc the old
         `inset: 34%` drew) give the circle.
       · `--reel-hub-alpha` — the bore's opacity. Below 1 the spokes read through
         the face, which is the cue for a hub that has lifted off the pack.
       · `--reel-hub-gloss` / `--reel-hub-grain` — the FACE material. Both ship at
         0, i.e. dead flat matte, which is the look the matte pass asked for; they
         exist so the depth of the falloff and a fine machined ring set can be
         dialled in without touching the shape. */
  .cas-reel-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--reel-hub-w, 32%);
    height: var(--reel-hub-h, 32%);
    transform: translate(-50%, -50%);
    border-radius: 50%;

    background: rgb(7 7 10 / var(--reel-hub-alpha, 0.97));

    box-shadow:
      inset 0.5px 0.5px 1px rgba(0, 0, 0, 0.9),
      inset -0.5px -0.5px 0 rgba(226, 218, 202, 0.13),
      0 0 0 0.5px rgba(0, 0, 0, 0.5);
  }

  /* The bore's face. It draws NOTHING at the shipped defaults: a flat fill with
     no falloff and no grain is the whole point of the matte pass, and a knob
     that ships at 0 cannot quietly re-introduce the highlight ramp the user
     rejected. ⚠️ `calc()` inside the alpha is deliberate — it lets one slider
     scale the layer without a second custom property to keep in step. */
  .cas-reel-hub::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;

    background-image:
      /* grain: fine concentric rings, the machining of a turned part */
      repeating-radial-gradient(
        circle at 50% 52%,
        rgba(226, 218, 202, calc(var(--reel-hub-grain, 0) * 0.14)) 0 0.5px,
        transparent 0.5px 2.5px
      ),
      /* gloss: depth of a radial falloff away from the centre */
      radial-gradient(
        circle at 50% 52%,
        rgba(2, 2, 5, calc(var(--reel-hub-gloss, 0) * 0.55)) 0%,
        transparent 70%
      );
  }

  /* The OUTER ring, near the well's edge. It carries the hairline it always had,
     plus the SAME SIX marks as the inner spoke set (2026-09-19: "外圈也需要 6 个线"):
     one repeating-conic-gradient at the shared `--reel-spoke-*` pitch, masked to a
     band at the rim so the lines read as ticks on the ring and not as a second
     gear. ⚠️ Driven by the same tokens as `.cas-reel-spokes`, never by its own
     numbers — two line sets at different pitches is exactly the misalignment the
     user would see.
     ⚠️ Unprefixed `mask-image` only (see §10's note on prefix pairs), and the mask
     is safe here: this element has no descendants to flatten. */
  .cas-reel-ring {
    position: absolute;
    inset: 2%;
    border-radius: 50%;
    border: 1px solid rgba(228, 220, 204, var(--reel-rim, 0.21));

    background: repeating-conic-gradient(
      from 0deg,
      rgba(214, 206, 190, calc(var(--reel-spoke-alpha, 0.25) * 1.25)) 0deg
        var(--reel-spoke-on, 7deg),
      transparent var(--reel-spoke-on, 7deg) var(--reel-spoke-gap, 60deg)
    );

    mask-image: radial-gradient(
      circle at 50% 50%,
      transparent 0 70%,
      #000 80% 100%
    );
  }

  /* ── The plate between the hubs ──
     One honest mark, not a wall of micro-print. The recessed well carries a
     single wide-tracked line with an accent tick; an earlier version stacked
     three 5px lines and a fake barcode here, which at 400px reads as noise and
     is exactly what made the tape look cheap.
     ⚠️ It is FROSTED TRANSLUCENT PLASTIC, not a metal insert (2026-09-19:
     "磁带盒中间的那个长方形长框改成磨砂塑料质感，目前的看起来太金属了"). The
     metallic read came from a near-black fill with a single bright rule along
     its bottom edge plus a glowing tick — a black bezel with a specular line is
     chrome. A frosted strip is the opposite: a *lighter*, milky, low-contrast
     fill whose light comes from the whole face, with no bright edge anywhere and
     a wide soft shadow instead of a hard one. */
  .cas-plate {
    position: relative;
    /* ⚠️ Sized by the TOKENS, not by "whatever is left" (2026-09-19: "我希望调整磁带盒
       那两个环后面的窄长方形框的长宽和透明度"). It used to be `flex: 1 1 auto`,
       which is untunable. Now it is `flex: 0 1 auto` with a width of its own:
       `--plate-w` is a share of the window (100% = "as wide as the gap allows"),
       and because the wells are RIGID (`flex: 0 0 auto`) the plate is the only
       item that can shrink, so the top of the range is capped by the space
       between them — the frame can never crush a well or spill out of the window,
       whatever `--reel-size` is set to.
       ⚠️ Do not try to express that cap in the CSS: `calc(100% - 2 *
       var(--reel-size))` looks right and is not — the `em` inside a `calc()`
       resolves against the PLATE's font-size (0.46em of the tape), so the wells
       would be subtracted at a fifth of their real size and the frame would
       happily overrun them.
       `--plate-h` is in the plate's own em; `--plate-alpha` scales the frost
       fill's opacity without touching the ink, which is why it is not `opacity`
       on the element — that would fade the printed mark too. */
    flex: 0 1 auto;
    min-width: 0;
    width: var(--plate-w, 100%);
    height: var(--plate-h, 4.7em);

    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.5em;

    padding: 0.3em 0.6em;
    border-radius: 2px;

    background: color-mix(
      in srgb,
      var(--plate-frost) calc(var(--plate-alpha, 1) * 100%),
      transparent
    );

    box-shadow:
      inset 0 0 0 1px var(--plate-edge),
      inset 0 3px 6px -4px var(--plate-shade);

    font-size: 0.46em;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--plate-ink);
    white-space: nowrap;
    overflow: hidden;
  }

  /* A frosted part diffuses: one wide, very soft vertical falloff across the
     strip, no band edges. Cheap (a single gradient, hard-edged box). */
  .cas-plate::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;

    background: linear-gradient(
      180deg,
      color-mix(
          in srgb,
          var(--plate-frost-hi) calc(var(--plate-alpha, 1) * 100%),
          transparent
        )
        0%,
      transparent 46%,
      color-mix(
          in srgb,
          var(--plate-frost-lo) calc(var(--plate-alpha, 1) * 100%),
          transparent
        )
        100%
    );
  }

  /* The type code row: the accent tick, then the mark. */
  .cas-plate-head {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-width: 0;
  }

  /* ── The tape-length scale ──
     A row of ticks under the type code with the three numbers a cassette's
     window label carries: 100 at the left, 50 in the middle, 0 at the right.
     ⚠️ The ticks are ONE element with four background layers, not eleven spans:
     twenty-one spans per tape × thirty-six tapes is a lot of DOM for scenery.
     The minor ticks repeat every 10% of the strip, so they always land on the
     three major positions (0 / 50 / 100%) whatever the plate's width is — which
     is the point, since the width is a tunable token. */
  .cas-plate-scale {
    display: grid;
    justify-items: stretch;
    gap: 0.22em;
    width: 100%;
    min-width: 0;
    /* ⚠️ The end numbers are centred on their ticks, so each one overhangs the
       strip by half a glyph. The padding is what keeps that overhang inside the
       plate's `overflow: hidden` — without it "100" loses its first digit. */
    padding-inline: 0.55em;
  }

  .cas-plate-ticks {
    height: 0.55em;

    background-image:
      /* the three majors, drawn as hard 1px rules pinned to 0 / 50 / 100% */
      linear-gradient(currentColor, currentColor),
      linear-gradient(currentColor, currentColor),
      linear-gradient(currentColor, currentColor),
      /* the minors, every 10% of the strip */
      repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 10%);
    background-size:
      1px 100%,
      1px 62%,
      1px 100%,
      100% 34%;
    background-position:
      0 100%,
      50% 100%,
      100% 100%,
      0 100%;
    background-repeat: no-repeat;

    color: var(--plate-ink);
    opacity: 0.7;
  }

  /* ⚠️ The numbers are CENTRED ON their ticks (2026-09-19: "刻线正下方应该是对齐数字
     文本的中间"). `justify-content: space-between` put their *edges* on the ticks
     instead, so 100 sat half a glyph to the right of the left major and 0 half a
     glyph to the left of the right one — measurably off, and worse the wider the
     frame is tuned. Absolute positioning at 0 / 50 / 100% with a `-50%` pull is
     the only arrangement that stays centred whatever the glyphs are. */
  .cas-plate-nums {
    position: relative;
    height: 1em;
    /* ⚠️ The plate's 0.22em tracking is for a word, not for three figures: left
       on, "100" runs into the tick beside it and the row stops reading as a
       scale. */
    letter-spacing: 0;
    line-height: 1;
    font-size: 0.92em;
    opacity: 0.8;
  }

  .cas-plate-nums span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
  }

  .cas-plate-nums span:nth-child(1) {
    left: 0;
  }

  .cas-plate-nums span:nth-child(2) {
    left: 50%;
  }

  .cas-plate-nums span:nth-child(3) {
    left: 100%;
  }

  .cas-plate-mark {
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* A one-pixel accent tick: the only colour on the window, and the only mark
     that needs to be read at a glance. */
  .cas-plate-tick {
    flex: 0 0 auto;
    width: 2px;
    height: 0.9em;
    border-radius: 1px;
    background: var(--cas-accent-soft, var(--accent));
    box-shadow: 0 0 8px var(--cas-accent-soft, var(--accent));
  }

  /* The blank tape's plate is empty — no type code, no scale. Its height comes
     from the shared `--plate-h` token, so the two variants are the same
     moulding. */
  .cas-plate-blank {
    min-height: 1.7em;
  }

  /* ── Index + date on the foot band, above the colour rail ── */
  .cas-deck-meta {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 6.4%;
    z-index: 3;

    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6em;

    font-size: 0.48em;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(214, 206, 190, 0.82);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
  }

  /* The colour rule the brief keeps: a solid rail along the tape's foot. */
  .cas-accent-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.5px;
    z-index: 3;

    background: var(--cas-accent, var(--accent));
    opacity: 0.9;
    box-shadow: 0 0 14px var(--cas-accent, var(--accent));
  }

  .cas-hairline {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 4.6%;
    height: 1px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.22);
  }

  /* Warm key on the pulled-out tape only — the reference lights just the
     selection; everything else sits in the cool ambient. */
  .cas.is-center .cas-front {
    box-shadow:
      var(--tape-drop-far),
      var(--tape-drop-near),
      inset 0 0 0 1px var(--shell-rim),
      inset 0 0 0 2.5px var(--shell-rim-inner),
      inset 0 0 34px var(--key-glow),
      inset 0 1px 0 var(--shell-hi);
  }

  /* ⚠️ The short shadow belongs to the neighbours. Ten 64px-blur casts repaint
     with the row and only the selection's is read as depth. */
  .cas:not(.is-center) .cas-front {
    box-shadow:
      var(--tape-drop-short),
      inset 0 0 0 1px var(--shell-rim),
      inset 0 0 0 2.5px var(--shell-rim-inner),
      inset 0 1px 0 var(--shell-hi);
  }

  /* The lit tape's lip also catches the key light. */
  .cas.is-center .cas-label::after {
    box-shadow:
      inset 0 0 0 1px var(--shell-rim),
      inset 3px 3px 0 -1px var(--relief-hi),
      inset -3px -3px 0 -1px var(--relief-lo),
      inset 0 0 6px var(--shell-ao),
      0 0 0 1px var(--key-edge);
  }

  .cas.is-center .cas-left,
  .cas.is-center .cas-right {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.24),
      inset 0 0 26px rgba(0, 0, 0, 0.55);
  }

  .cas.is-center .cas-accent-bar {
    opacity: 1;
    box-shadow: 0 0 20px var(--cas-accent, var(--accent));
  }

  /* ── SPINES ──
     The narrow walls keep the shell material: a moulding with a metal cap top
     and bottom, fine mould scoring along the length, and the printed spine
     insert between them. */
  .cas-left,
  .cas-right {
    width: var(--cas-d, 38px);
    height: var(--cas-h, 256px);
    margin-top: calc(var(--cas-h, 256px) / -2);
    margin-left: calc(var(--cas-d, 38px) / -2);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    padding: 5% 0;
    overflow: hidden;

    /* Light comes from the front-right, so both side walls fall into shade:
       a dark seam at the join, lifting toward the outer edge, with two mould
       score lines running the full length. */
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 7px,
        rgba(255, 255, 255, 0.035) 7px 8px
      ),
      linear-gradient(
        90deg,
        var(--shell-spine-a) 0%,
        var(--shell-spine-b) 34%,
        var(--shell-spine-c) 66%,
        var(--shell-spine-d) 100%
      );

    box-shadow:
      var(--wall-drop),
      inset 0 0 0 1px var(--shell-rim),
      inset 0 0 26px var(--shell-ao);

    transition: box-shadow 0.5s var(--ease-out);
  }

  /* ⚠️ The "metal cap" that used to sit across the top of each spine is GONE
     (2026-09-19: "dark mode 下的书脊的上方有一个白色渐变，对应 light mode 下有个黑色
     渐变，去掉他"): a `--metal-*` gradient into `rgba(0,0,0,.5)` read as a bright
     white lip in the dark theme and a black one in the light theme — on the two
     faces that carry the printed title, which is the last place a band of pure
     contrast belongs. The spine's own moulding already has its metal cap in
     `--shell-spine-a` (the dark seam end), so nothing is missing. */

  .cas-left {
    transform: rotateY(-90deg) translateZ(calc(var(--cas-w, 400px) / 2));
  }

  .cas-right {
    transform: rotateY(90deg) translateZ(calc(var(--cas-w, 400px) / 2));
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 7px,
        rgba(255, 255, 255, 0.035) 7px 8px
      ),
      linear-gradient(
        270deg,
        var(--shell-spine-a) 0%,
        var(--shell-spine-b) 34%,
        var(--shell-spine-c) 66%,
        var(--shell-spine-d) 100%
      );
  }

  .cas-spine-stripe {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 14%;
    max-width: 4px;

    background: var(--cas-accent, var(--accent));
    box-shadow: 0 0 12px var(--cas-accent, var(--accent));
    opacity: 0.9;
  }

  .cas-left .cas-spine-stripe {
    left: 0;
  }

  .cas-right .cas-spine-stripe {
    right: 0;
  }

  .cas-spine-brand,
  .cas-spine-idx {
    position: relative;
    /* ⚠️ `flex: 0 0 auto`, and that is the whole fix for a long title
       (2026-09-19: "当标题过长时，磁带盒的书脊／侧面会出现 RRSUIKA 和标题，标题和 01, 02
       数字重叠"). As flex items they defaulted to `flex-shrink: 1`, so a long title
       squeezed THEM instead of itself — and because both are `white-space: nowrap`
       with no `overflow: hidden`, their text simply spilled out of the squashed box
       and landed on top of the title. The title is the thing that has to give: it
       is the only one of the three with `overflow: hidden` + `text-overflow:
       ellipsis`, so pin these two and let it clip. */
    flex: 0 0 auto;
    font-size: 0.44em;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--shell-ink-dim);
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  .cas-spine-title {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;

    /* ⚠️ A plain BLOCK, not a flex container (2026-09-19: spine titles were still
       running over the index number even after the brand/idx were pinned). A flex
       container turns its bare text into an ANONYMOUS FLEX ITEM, and
       `text-overflow: ellipsis` only applies to the text of the box that declares
       it — with the text inside a child box no ellipsis is ever produced, so the
       glyphs kept their full length and pushed straight through the number below.
       `text-align: center` gives the same centring along the inline axis (vertical
       here) and leaves the text reachable by the ellipsis and the clip. */
    display: block;
    text-align: center;

    /* Vertical spine text: the only orientation that survives the ~76°
       foreshortening of a spine face. Both spines read top→bottom; CSS 3D
       renders each face unmirrored, so no counter-rotation is needed. */
    writing-mode: vertical-rl;

    font-family: var(--font-display);
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;

    /* ⚠️ The spine is SHELL material, not artwork: its ink has to flip with the
       theme (light type on graphite, warm dark type on ivory) or the light
       theme's titles vanish into the ivory. */
    color: var(--shell-ink);

    max-height: 82%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ── SHELL EDGES ──
     The top and bottom walls are where the moulding's hardware shows: a metal
     screw rail, a tape-path groove and the accent block that marks the model. */
  .cas-top,
  .cas-bottom {
    width: var(--cas-w, 400px);
    height: var(--cas-d, 38px);
    margin-left: calc(var(--cas-w, 400px) / -2);
    margin-top: calc(var(--cas-d, 38px) / -2);

    background: linear-gradient(
      180deg,
      var(--shell-edge-a) 0%,
      var(--shell-edge-b) 100%
    );
    box-shadow: inset 0 0 0 1px var(--shell-rim);
  }

  /* The moulded groove every cassette has along its top and bottom wall. */
  .cas-top::before,
  .cas-bottom::before {
    content: "";
    position: absolute;
    left: 3%;
    right: 3%;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    pointer-events: none;

    background: var(--shell-ao);
    box-shadow: 0 1px 0 var(--relief-hi);
    opacity: 0.7;
  }

  .cas-top {
    transform: rotateX(90deg) translateZ(calc(var(--cas-h, 256px) / 2));
  }

  /* The bottom wall is the second half of the "pulled off the shelf" read,
     so it gets a bright seam where it meets the front face. */
  .cas-bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--cas-h, 256px) / 2));
    background: linear-gradient(
      180deg,
      var(--shell-edge-under-a) 0%,
      var(--shell-edge-under-b) 100%
    );
    box-shadow:
      var(--wall-drop),
      inset 0 0 0 1px var(--shell-rim);
  }

  .cas-bottom-edge {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--shell-seam);
  }

  .cas-bottom-edge::after {
    content: "";
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    height: 1px;
    background: var(--cas-accent, var(--accent));
    opacity: 0.5;
  }

  /* The back plate is moulded, not printed: a rib grid, a recessed label well
     and the screw bosses, so a tape turned away from the viewer still reads as
     an object with two sides. */
  .cas-back {
    width: var(--cas-w, 400px);
    height: var(--cas-h, 256px);
    margin-left: calc(var(--cas-w, 400px) / -2);
    margin-top: calc(var(--cas-h, 256px) / -2);

    transform: translateZ(calc(var(--cas-d, 38px) / -2)) rotateY(180deg);

    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 9px,
        var(--shell-ao) 9px 10px
      ),
      linear-gradient(
        180deg,
        var(--shell-back) 0%,
        var(--shell-edge-under-a) 100%
      );
    box-shadow: inset 0 0 0 1px var(--shell-rim);
  }

  /* Recessed label well: two hard rings, no blur — this face is only seen while
     a tape is turning, and that is exactly when the row is repainting. */
  .cas-back::before {
    content: "";
    position: absolute;
    inset: 12% 14%;
    border-radius: 2px;
    pointer-events: none;

    background: linear-gradient(180deg, var(--shell-ao), transparent 78%);
    box-shadow:
      inset 0 0 0 1px var(--shell-rim),
      0 1px 0 var(--relief-hi);
    opacity: 0.8;
  }

  .cas-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  /* ══════════════════════════════════════════
     HUD
     ══════════════════════════════════════════ */

  .shelf-hud,
  .shelf-scrim,
  .shelf-panel,
  .shelf-foot,
  .shelf-nav,
  .shelf-intro,
  .shelf-veil,
  .shelf-empty {
    position: absolute;
  }

  .shelf-hud {
    top: 22px;
    left: 34px;
    right: 34px;

    display: flex;
    flex-direction: column;
    gap: 11px;

    pointer-events: none;

    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
  }

  .shelf.is-ready .shelf-hud {
    opacity: 1;
    transform: none;
  }

  .shelf-hud-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* The section blurb lives in the stage's top band — that band is empty by
     design (the shelf sits low), so the copy costs no vertical space. */
  .shelf-hud-desc {
    max-width: 58ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  /* Hairline rail: ties the counter to the state readout and gives the top
     band a reason to exist. */
  .shelf-hud-rule {
    flex: 1 1 auto;
    height: 1px;
    min-width: 24px;

    background: linear-gradient(
      90deg,
      var(--accent) 0%,
      var(--accent) 8%,
      var(--border) 24%,
      var(--border) 100%
    );

    opacity: 0.75;
  }

  .shelf-hud-state {
    display: flex;
    align-items: center;
    gap: 8px;

    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .shelf-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--terminal-green);
    box-shadow: 0 0 8px var(--terminal-green);
    animation: shelfPulse 2.4s var(--ease-out) infinite;
  }

  @keyframes shelfPulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.28;
    }
  }

  .shelf-counter {
    display: flex;
    align-items: baseline;
    gap: 7px;

    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    color: var(--text-dim);
  }

  .shelf-counter strong {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: var(--tracking-tight);
    color: var(--text-bright);
    font-variant-numeric: tabular-nums;
  }

  .shelf-counter em {
    font-style: normal;
    font-size: 9px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-dim);
    margin-left: 4px;
  }

  /* ── Selected-record panel (right) ── */
  .shelf-panel {
    top: 50%;
    right: 52px;
    width: min(318px, 25vw);
    transform: translate(46px, -50%);

    padding: 20px 22px;

    border-left: 2px solid var(--cas-accent, var(--accent));
    background: linear-gradient(
      90deg,
      rgba(7, 7, 12, 0.42),
      rgba(7, 7, 12, 0.82)
    );

    /* Chamfered corner + hairline ticks: the Rhine-Lab-adjacent archive look,
       and cheap because the panel is a sibling of the 3D track, never an
       ancestor of a preserve-3d element. */
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 15px),
      calc(100% - 15px) 100%,
      0 100%
    );

    /* Non-3D sibling of the track, so backdrop-filter is safe here. */
    backdrop-filter: blur(14px) saturate(150%);

    opacity: 0;
    pointer-events: none;

    transition:
      opacity 0.6s var(--ease-out),
      transform 0.75s var(--spring-gentle);
  }

  .shelf-panel::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 26px;
    height: 1px;
    background: var(--cas-accent, var(--accent));
    opacity: 0.85;
  }

  /* Safari ≤ 17 needs the prefixed form; keep it out of the rule above — lightningcss folds the pair and keeps only the last one. */
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .shelf-panel {
      -webkit-backdrop-filter: blur(14px) saturate(150%);
    }
  }

  :global(:root[data-theme="light"]) .shelf-panel {
    background: linear-gradient(
      90deg,
      rgba(248, 244, 236, 0.55),
      rgba(248, 244, 236, 0.92)
    );
  }

  .shelf.is-ready .shelf-panel {
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }

  .shelf-panel-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  /* ── Status readout ──
     The mark is a box, the word is the word. The old version put a "●" inside
     the string, which let the line wrap *between* the dot and the word and
     left the dot stranded on its own row on a narrow panel. WIP reads amber,
     not green. */
  .shelf-panel-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    color: var(--terminal-green);
  }

  .shelf-panel-status b {
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
  }

  .shelf-status-mark {
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .shelf-panel[data-wip="1"] .shelf-panel-status {
    color: var(--stripe-yellow);
  }

  .shelf-panel[data-wip="1"] .shelf-status-mark {
    /* Half-filled disc — the tape is still being wound. */
    background: linear-gradient(90deg, currentColor 0 50%, transparent 50%);
  }

  .shelf-panel-title {
    font-family: var(--font-display);
    font-size: clamp(21px, 1.75vw, 29px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    margin: 0 0 12px;

    transition:
      filter 0.36s var(--ease-out),
      transform 0.46s var(--ease-out),
      opacity 0.22s ease;
  }

  :global(html[lang="zh"]) .shelf-panel-title {
    font-family: var(--font-zh-display);
    letter-spacing: 0;
    line-height: 1.26;
  }

  .shelf-panel-desc {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.62;
    color: var(--text-soft);
    margin: 0 0 14px;
    max-height: 9.8em;
    overflow: hidden;

    transition:
      filter 0.36s var(--ease-out),
      transform 0.46s var(--ease-out),
      opacity 0.22s ease;
  }

  /* Reference: `.title-frame.changing .title` blur-slide on swap. */
  .shelf-panel.is-changing .shelf-panel-title,
  .shelf-panel.is-changing .shelf-panel-desc {
    filter: blur(5px);
    opacity: 0.25;
    transform: translateY(13px);
  }

  .shelf-panel-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;

    transition: opacity 0.3s ease;
  }

  .shelf-panel.is-changing .shelf-panel-tags {
    opacity: 0.15;
  }

  /* ⚠️ `:global(...)` is REQUIRED here, and this rule had been silently dead.
     The tags are created by `updateUI` with `document.createElement("span")`, so
     they never carry Astro's `data-astro-cid-…` attribute — and a scoped selector
     is `.shelf-panel-tags[cid] span[cid]`, which matches nothing. The tags have
     therefore been rendering with no rule of their own at all (inheriting the
     panel's text colour, which is exactly why the user found them "不够明确"), and
     the three-colour rotation that used to live here never showed either. */
  :global(.shelf-panel-tags span) {
    padding: 4px 7px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;

    /* ⚠️ ONE accent for every tag, with the `#` doing the separating
       (2026-09-19: "里面的 tags 不够明确，可以做成比如 #Industrial Design #Sheet Metal
       同时改成点缀色"). It used to rotate three stripe colours by `nth-child`, which
       made the row read as a legend of three categories that do not exist — the
       tags are all the same kind of thing, so they all take the accent. */
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    color: var(--accent);
  }

  .shelf-panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    padding-top: 12px;
    border-top: 1px dashed var(--border-divider);

    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* ── The way in. This is the panel's primary action, so it looks like one:
     a filled slab carrying the tape's accent, mirroring the reference's
     `.solid-button`. ── */
  .shelf-open {
    position: relative;
    isolation: isolate;
    /* The hover wipe is a scaled panel inside the button, so the button has to
       clip it. `overflow: hidden` does NOT clip the element's own box-shadow,
       which is why the glow below still reaches outside the slab. */
    overflow: hidden;

    width: 100%;
    margin-top: 12px;
    padding: 12px 14px;

    display: flex;
    align-items: center;
    /* The label is the only child now that the drawn arrow is gone, so the
       `space-between` + `gap` that used to hold it clear of that arrow went with
       it. */

    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;

    color: #0a0a0d;
    background: var(--cas-accent, var(--accent));
    border: 0;
    border-radius: 2px;
    cursor: pointer;

    /* ⚠️ A GLOW, not a cast shadow (2026-09-19: "这个按钮的发光效果有问题").
       It was `0 10px 26px -12px <accent>`: the accent at FULL opacity, pushed 10px
       down behind a −12px spread. That is not light leaving the button, it is a
       saturated ledge of the button's own colour hanging off its bottom edge —
       and the panel's `clip-path` then cuts it off square, which is the visible
       "problem". A halo wants no offset, a small negative spread and an alpha;
       and it has to fit inside the panel's 20/22px padding. `0 0 16px -4px`
       reaches ~12px, so nothing can ever be clipped. */
    box-shadow:
      0 0 16px -4px
        color-mix(in srgb, var(--cas-accent, var(--accent)) 60%, transparent),
      0 6px 14px -12px rgba(0, 0, 0, 0.5);

    transition:
      box-shadow 0.25s var(--ease-out),
      transform 0.25s var(--spring-snappy);
  }

  :global(:root[data-theme="light"]) .shelf-open {
    color: #fdfaf4;
  }

  /* The hover gesture is the one the chips and the hero CTA use — an accent panel
     travelling under the text — but this one advances LEFT → RIGHT (2026-09-19:
     "这个按钮做成从左往右的色彩推进，而不是其他按钮的从下往上").
     ⚠️ The chip's panel can sit at `z-index: -1` because the chip's own background
     is translucent; this button is a solid accent slab, so a `-1` panel would be
     painted UNDER that fill and never seen. It rides at `z-index: auto` (above the
     background, below the `z-index: 1` label), and `scaleX` from a left-hand
     origin is what makes it a wipe — a `translateX` on a full-size panel would
     slide it out of the button instead of revealing it.
     ⚠️ The wipe colour is `--cas-accent-soft`: THE SAME HUE, stepped away from the
     theme's ink. It used to be `76% accent + black` and that mix goes muddy on a
     saturated colour (2026-09-19: "hover 压暗有点丑，你去网上搜搜，改成一个合适的变色
     颜色"). Darkening is also the minority answer — Material 3 brightens a filled
     button with a state layer of the ON-colour (8% hover / 10% press,
     https://m3.material.io/foundations/interaction/states/state-layers) and Ant
     Design steps its primary one shade lighter; Carbon is the outlier that steps
     darker. `--stripe-*-soft` is already this site's token for that step, and it
     happens to be exactly right: it is LIGHTER in the dark theme
     (#e04040 → #ff8888) and DARKER in the light theme (#c03030 → #aa3333),
     because in both themes it moves away from that theme's ink — so the label
     contrast goes UP either way (dark theme's red measured 4.69:1 → 8.6:1;
     light theme's 5.44:1 → 6.24:1). Same token the plate's accent tick uses. */
  .shelf-open::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--cas-accent-soft, var(--accent-glow));
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.45s var(--ease-out);
    pointer-events: none;
  }

  .shelf-open:hover::before,
  .shelf-open:focus-visible::before {
    transform: scaleX(1);
  }

  /* Above the wipe. */
  .shelf-open-label {
    position: relative;
    z-index: 1;
  }

  .shelf-open:hover {
    box-shadow:
      0 0 22px -4px
        color-mix(in srgb, var(--cas-accent, var(--accent)) 78%, transparent),
      0 8px 18px -12px rgba(0, 0, 0, 0.55);
    transform: translateY(-1px);
  }

  .shelf-open:active {
    transform: translateY(0);
  }

  .shelf-open:focus-visible {
    outline: 2px solid var(--text-bright);
    outline-offset: 3px;
  }

  /* ── ARROWS — chunky, Q-bounce, straight from the reference keyframes ── */
  .shelf-nav {
    top: 50%;
    width: 52px;
    height: 104px;
    margin-top: -52px;

    border: 0;
    background: none;
    display: grid;
    place-items: center;
    cursor: pointer;

    opacity: 0.72;
    transition: opacity 0.3s var(--ease-out);
    z-index: 4;
    /* The row is a drag surface: a click that starts on an arrow must not be
       read as a drag. */
    touch-action: none;
  }

  .shelf.is-ready .shelf-nav {
    opacity: 0.92;
  }

  .shelf-nav:hover {
    opacity: 1;
  }

  .shelf-nav[hidden] {
    display: none;
  }

  /* Both arrows are nudged inboard of the screen edge: the right-hand one has
     to clear the record panel to the right of it, or the panel paints over the
     capsule. */
  .shelf-nav.left {
    left: 14px;
  }

  .shelf-nav.right {
    right: 54px;
  }

  /* The arrow IS the affordance — no capsule, no frame.
     It is a single stroked polyline, and each side carries its OWN path.

     ⚠️ **The TIP of a polyline is its MIDDLE point, not its first.** That is
     the mistake that shipped the inverted pair: `M2 2 L12 13 L2 24` reads like
     "start at x=2" but it draws a `>` — the vertex is the second coordinate
     pair, (12,13), so it points RIGHT. Measured, not reasoned: the ink map of
     that path shows one run at its leftmost column and two runs to the right,
     i.e. the point is on the left. So:
       · `M12 2 L2 13 L12 24` → vertex (2,13)  → points LEFT  (the prev arrow)
       · `M2 2 L12 13 L2 24`  → vertex (12,13) → points RIGHT (the next arrow)

     ⚠️ One path, not two bars. Two separate bars — however they are placed —
     cannot make a sharp corner: each bar ends in a rounded cap, and those caps
     cut a notch out of the vertex. The user saw exactly that ("the tip is not a
     right angle but a dented flat"). A polyline with `stroke-linejoin: miter`
     produces a true point from one geometry: the measured apex is 1 run of 2px,
     and the miter overhangs the 14px box by ~1px, which is what `overflow:
     visible` on the svg is for.

     ⚠️ And the direction is written into the path data, not derived from a
     mirror. A `scaleX(-1)` on the wrapper is what made both arrows point the
     wrong way: the mirrored element also carried the bounce animation, so the
     mirror and the animation fought over the same transform. Two explicit paths
     cannot disagree with each other. ⚠️ That is also why the bounce below rides
     the inner `svg` and not `.shelf-arrow`: if a mirror is ever reintroduced, it
     goes on the wrapper with nothing else on it. */
  .shelf-arrow {
    display: block;
    width: 14px;
    height: 26px;
    margin: 0 6px; /* breathing room inside the hit area */
  }

  .shelf-arrow svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .shelf-arrow path {
    fill: none;
    stroke: var(--text-bright);
    stroke-width: 4;
    stroke-linecap: round;
    /* The sharp point. */
    stroke-linejoin: miter;
    miterlimit: 8;
    transition: stroke 0.3s var(--ease-out);
  }

  .shelf-nav:hover .shelf-arrow path {
    stroke: var(--cas-accent, var(--accent));
  }

  /* Both arrows bounce IN PHASE and in the SAME SCREEN direction — out toward
     the frame edges, then back — so the pair reads as one breathing mark rather
     than two independent ones.

     ⚠️ The two keyframe sets are deliberate, and they are NOT
     `animation-direction: reverse` of one another. Each arrow is a different
     path, so there is no shared transform to lean on: `translate` is an ODD
     quantity and has to be negated by hand for the left arrow. `reverse` mirrors
     the animation in TIME instead, and that only coincides with a spatial
     negation when the keyframes are antisymmetric about 50% *and* `scale` is
     symmetric about 50% — and a symmetric scale is precisely what throws away
     the pull-back/push-out contrast (thin on the recoil, fat on the throw).
     So: negate every `translate`, copy the `scale` ladder verbatim. */
  .shelf-arrow svg {
    animation: shelfBounceOut 1240ms var(--ease-out) infinite;
  }

  /* Right arrow — +x is outward. */
  @keyframes shelfBounceOut {
    0%,
    100% {
      translate: 0 0;
      scale: 1 1;
    }

    18% {
      translate: -6px 0;
      scale: 0.84 1;
    }

    40% {
      translate: 8px 0;
      scale: 1.14 1;
    }

    58% {
      translate: -2px 0;
      scale: 0.96 1;
    }

    74% {
      translate: 3px 0;
      scale: 1.03 1;
    }
  }

  .shelf-nav.left .shelf-arrow svg {
    animation-name: shelfBounceOutLeft;
  }

  /* Left arrow — −x is outward, so every `translate` is negated. */
  @keyframes shelfBounceOutLeft {
    0%,
    100% {
      translate: 0 0;
      scale: 1 1;
    }

    18% {
      translate: 6px 0;
      scale: 0.84 1;
    }

    40% {
      translate: -8px 0;
      scale: 1.14 1;
    }

    58% {
      translate: 2px 0;
      scale: 0.96 1;
    }

    74% {
      translate: -3px 0;
      scale: 1.03 1;
    }
  }

  /* ── Footer hint ──
     ⚠️ The REPLAY INTRO button that used to sit opposite this hint is GONE
     (2026-09-19: "右下角的重播开场功能和按钮去掉"). The curtain is a
     first-visit moment (`sessionStorage["rrsuika-shelf-warm"]`) and re-arming it
     from a button was the only way to see it twice — nothing else consumed the
     `startIntro(true)` call, and the footer is now a single left-aligned line. */
  .shelf-foot {
    left: 34px;
    right: 34px;
    bottom: 20px;

    display: flex;
    align-items: center;
    gap: 16px;

    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-dim);

    opacity: 0;
    transition: opacity 0.8s var(--ease-out) 0.1s;
    pointer-events: none;
  }

  .shelf.is-ready .shelf-foot {
    opacity: 1;
  }

  .shelf-hint {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shelf-empty {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    margin: 0;

    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .shelf-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  /* ── Intro curtain ── */
  .shelf-intro {
    inset: 0;
    z-index: 90;
    background: var(--bg);
    pointer-events: none;

    transition:
      opacity 0.9s var(--ease-out),
      visibility 0s linear 0.9s;
  }

  .shelf-intro.is-done {
    opacity: 0;
    visibility: hidden;
  }

  .shelf-intro-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;

    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .shelf-intro-bar {
    display: block;
    width: 168px;
    height: 1px;
    background: var(--border);
    overflow: hidden;
  }

  .shelf-intro-bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
    animation: shelfLoad 2.4s var(--ease-out) infinite;
  }

  @keyframes shelfLoad {
    0% {
      transform: scaleX(0);
    }

    70%,
    100% {
      transform: scaleX(1);
    }
  }

  .shelf-intro-skip {
    font-size: 8px;
    letter-spacing: var(--tracking-wider);
    color: var(--text-tertiary);
    opacity: 0.7;
  }

  /* ── Launch veil (click → detail) ── */
  .shelf-veil {
    inset: 0;
    z-index: 80;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
  }

  .shelf.is-launching .shelf-veil {
    opacity: 1;
    transition: opacity 0.44s var(--ease-out) 0.22s;
  }

  .shelf.is-launching .shelf-panel,
  .shelf.is-launching .shelf-hud,
  .shelf.is-launching .shelf-foot,
  .shelf.is-launching .shelf-nav {
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .shelf.is-launching .cas:not(.is-center) .cas-f {
    opacity: 0;
    transition: opacity 0.34s var(--ease-out);
  }

  /* The shelf is a one-screen experience: the global scroll-telemetry rail has
     nothing to report here and it collides with the right arrow. Scoped to the
     six pages that render this component.
     `!important` is deliberate: ScrollMeter styles itself through a scoped
     class+attribute selector (0,2,0) that a plain class override cannot beat. */
  :global(.scroll-cluster) {
    display: none !important;
  }

  /* ══════════════════════════════════════════
     FLAT MODE — phones / reduced motion / no preserve-3d.
     A plain card switcher: no perspective, no 3D box,
     no rise. Same markup, same state machine.
     ══════════════════════════════════════════ */

  .shelf-page[data-mode="flat"] {
    min-height: 0;
    padding-bottom: 40px;
  }

  .shelf-page[data-mode="flat"] .shelf {
    display: block;
    flex: 0 0 auto;
  }

  .shelf-page[data-mode="flat"] .shelf-stage {
    perspective: none;
    min-height: 0;
    overflow: visible;

    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0 0 4px;
  }

  .shelf-page[data-mode="flat"] .shelf-track {
    order: 1;
    position: relative;
    inset: auto;

    width: min(520px, 100% - 104px);
    aspect-ratio: 4.85 / 3.1;

    margin: 0 auto;
    transform: none; /* the 3D-mode drop does not apply to the flat stack */
    transform-style: flat;
    overflow: hidden; /* clips the off-screen neighbours */
  }

  .shelf-page[data-mode="flat"] .cas {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    transform-style: flat;
    will-change: auto;
  }

  .shelf-page[data-mode="flat"] .cas-f {
    display: none;
  }

  .shelf-page[data-mode="flat"] .cas-front {
    display: block;
    position: relative;
    left: auto;
    top: auto;
    width: 100%;
    height: 100%;
    margin: 0;
    transform: none;
  }

  .shelf-page[data-mode="flat"] .shelf-atmos,
  .shelf-page[data-mode="flat"] .shelf-scrim,
  .shelf-page[data-mode="flat"] .shelf-floor {
    display: none;
  }

  .shelf-page[data-mode="flat"] .shelf-hud {
    order: 2;
    position: static;
    width: 100%;
    max-width: 572px;
    margin: 0 auto;
    padding: 0 52px;
  }

  .shelf-page[data-mode="flat"] .shelf-panel,
  .shelf-page[data-mode="flat"].is-ready .shelf-panel {
    order: 3;
    position: static;
    top: auto;
    right: auto;
    width: min(520px, 100% - 40px);
    margin: 0 auto;
    transform: none;
    transition: none;
  }

  .shelf-page[data-mode="flat"] .shelf-foot {
    order: 4;
    position: static;
    left: auto;
    right: auto;
    bottom: auto;
    width: 100%;
    max-width: 572px;
    margin: 0 auto;
    padding: 0 52px;
  }

  /* Arrows sit on the card, which is the first block in the flat stack:
     card height = width / (4.85 / 3.10). */
  .shelf-page[data-mode="flat"] .shelf-nav {
    height: 62px;
    margin-top: -31px;
    width: 48px;
    top: calc(min(520px, 100vw - 104px) / 3.129);
  }

  @media (max-width: 900px) {
    .shelf-head {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 16px 20px 0;
    }

    .shelf-head h1 {
      /* Scaled with the desktop value (40 → 26 keeps the same ratio as 32 → 21),
         and the positive tracking is inherited from the base rule. */
      font-size: 32px;
    }

    .shelf-tag-bar {
      justify-content: flex-start;
    }

    .shelf-panel {
      right: 20px;
      width: min(300px, 62vw);
    }
  }

  @media (max-width: 640px) {
    .shelf-hud-desc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .shelf-page[data-mode="flat"] .shelf-track {
      width: min(520px, 100% - 88px);
    }

    .shelf-page[data-mode="flat"] .shelf-nav {
      width: 40px;
      top: calc(min(520px, 100vw - 88px) / 3.129);
    }

    .shelf-page[data-mode="flat"] .shelf-hud,
    .shelf-page[data-mode="flat"] .shelf-foot {
      padding: 0 44px;
    }

    .shelf-page[data-mode="flat"] .shelf-panel {
      width: calc(100% - 44px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf-arrow svg,
    .shelf-intro-bar i {
      animation: none !important;
    }

    .shelf-hud,
    .shelf-panel,
    .shelf-foot,
    .shelf-intro {
      transition: none !important;
    }
  }
</style>

<script>
  /* TEMPORARY: the shelf tuning panel. Delete this import (and
     src/scripts/shelf-tuner.ts) once the reels and the hero pose are baked. */
  import { initShelfTuner } from "../scripts/shelf-tuner";

  (() => {
    "use strict";

    const rootEl = document.getElementById("cassette-shelf");
    const stageEl = document.getElementById("shelf-stage");
    const trackEl = document.getElementById("shelf-track");
    if (!rootEl || !stageEl || !trackEl) return;

    // The tuner publishes `window.__shelfTune`; the pose reads it through TUNE().
    initShelfTuner();

    // Re-bind after the guard: the helpers below are hoisted function
    // declarations, so TS cannot carry the narrowing of rootEl/stageEl/trackEl
    // into their bodies.
    const root: HTMLElement = rootEl;
    const stage: HTMLElement = stageEl;
    const track: HTMLElement = trackEl;

    // The mode flag lives on the page root so flat mode can restyle the
    // surrounding page shell (which is outside <section class="shelf">).
    const page: HTMLElement =
      (root.closest(".shelf-page") as HTMLElement | null) ?? root;

    // The record tapes only. The blank cassettes in `[data-fillers]` also carry
    // `.cas` (they share the whole shell), so they have to be excluded by
    // ancestry — selecting `.cas` outright silently made every blank look like a
    // real project.
    const casEls = Array.from(
      root.querySelectorAll<HTMLAnchorElement>(".cas"),
    ).filter((el) => !el.closest("[data-fillers]"));
    if (casEls.length === 0) {
      // An archive with nothing in it has no entrance to play — the ladder, the
      // camera and the drag all need tapes to move — so the world is never
      // built. The curtain, however, is markup, and this script is the only
      // thing that ever lifts it: bailing out silently left the page sitting on
      // `MOUNTING ARCHIVE` forever with no console error to show for it
      // (2026-09-19: a dev server serving an empty collection did exactly that
      // to `/lab`). Lift it here and say what the shelf is actually showing.
      root.classList.add("is-ready");
      document.getElementById("shelf-intro")?.classList.add("is-done");
      const emptyEl = document.getElementById("shelf-empty");
      if (emptyEl) emptyEl.hidden = false;
      return;
    }

    /* ══════════════════════════════════════════
       WORLD CONSTANTS
       Ported from `输入/磁带盒主体动画.html` — layoutPose(),
       with the intro ladder from `输入/磁带盒启动动画.html`.
       ══════════════════════════════════════════ */

    const CAS_W = 4.85;
    const CAS_H = 3.1;
    // Thin shell: 0.37 world units — 7.6% of the card width. The old 0.70 was
    // a VHS-depth slab; seven of those in a row collide.
    const CAS_D = 0.37;
    // Camera framing. The tape row is sized from the window WIDTH, not its
    // height: the frame is a horizontal strip, so the pitch is what has to be
    // guaranteed and the height follows from the stage's own aspect ratio.
    const WORLD_H = 4.3;
    // Visible world width. The reference frames its hero at roughly a third of
    // the frame width, and that is the ratio to hold: lower this and every tape
    // grows (and the outer slots leave the frame), raise it and the spine titles
    // stop being readable.
    const MIN_WORLD_W = 19;
    const PERSPECTIVE = 11.8; // × S, the reference camera distance

    // Slot pitch, in world units. The reference's `layoutPose` uses 3.42 against
    // a 4.85-wide book — 0.71 of their own width — and scaled to this frame that
    // is ~2.2. The RATIO is the point, not the number: tapes this close stand
    // deeply overlapped, so nine of them read as a packed rack and not as a
    // spread of tiles. ⚠️ Pitch and `MIN_WORLD_W` are one decision in two
    // constants — change them together and re-measure.
    const SPREAD_X = 2.2;
    const SPREAD_X2 = 0.12;
    // z of the selected tape, and how hard the rest recede. The reference's
    // selected book sits at z = 0.95 with the rear wall falling to ≈ −7.6, which
    // is a big separation: the row loses itself in depth, and the pull-out reads
    // as the selection coming FORWARD rather than the others sliding sideways.
    const Z_NEAR = 2.6;
    const Z_FALL = 1.55;
    const Z_POW = 1.12;
    const Y_BASE = -0.18;
    const Y_FALL = 0.2;
    const Y_POW = 1.18;
    // Neighbours keep most of the hero's size on top of the perspective shrink.
    const SCALE_FALL = 0.105;
    const RY_CENTER = 0.222; // — the hero rotation, 12.7° (left spine out)
    // The rear wall sits at the reference's 58°, not fully edge-on: a 90° turn
    // projects almost no width, which is what made the outer tapes unreadable.
    const RY_SIDE = 1.01;
    const SIDE_SPAN = 0.72;
    const RX_BASE = -0.13; // — the ROW's pitch; tips every tape's bottom into view
    const RX_SIDE = 0.055;
    /* ⚠️ Hero-only pitch, on top of `RX_BASE`, faded out with the same falloff as
       `LIFT`. The row-wide pitch cannot be used to "look at the bottom of the
       selected tape": it tilts all ten together, which was reported straight
       away. This one moves the selection alone. */
    const RX_HERO = 0;
    const RZ_BASE = 0.074;
    const RZ_SPREAD = 0.06;
    const RZ_SPREAD2 = 0.012;
    const LIFT = 0.21;
    const LIFT_FALL = 7.2;

    /* ── THE PASS — why two tapes used to cross mid-step ──
       Every pose value is a function of `|p|`, so the two tapes straddling the
       centre during a step (p = ±0.5) are MIRROR IMAGES: same |p|, therefore the
       same z, the same y and the same scale. They cannot be separated in depth by
       anything that only reads |p| — measured with a separating-axis test on the
       real boxes, they interpenetrate by **0.95 world units** at progress 0.5, and
       `Z_FALL` makes no difference at all (0.950 at every value from 1.55 to 3.5).
       At REST they are fine, which is why this only shows while switching: at an
       integer slot the neighbours differ by a whole slot of z (1.55).
       The fix is two terms shaped like `4·|p|·(1 − |p|)` — a bump that is exactly
       zero at |p| = 0 and at |p| ≥ 1, so **the shipped rest pose is untouched to
       the last decimal** and only the half-slot positions move:
         · `PASS_TWIST` turns both tapes further out of the way as they pass;
         · `PASS_GAP` slides them apart.
       Together they take the worst penetration from 0.95 to **0** (twist 0.3 rad =
       17.2° extra yaw at the crossing, gap 0.2 world units = 4% of the card width,
       0.2 each side). Either one alone only gets to ~0.24/0.58. */
    const PASS_TWIST = 0.3;
    const PASS_GAP = 0.2;

    /* ── Live overrides for the hero pose ──
       The tuning panel writes numbers into `window.__shelfTune`; every pose read
       goes through `TUNE(name, constant)`, so a slider moves the selected tape
       on the next frame and the shipped constants stay the defaults. ⚠️ The
       window object is read on EVERY call, never cached: the tuner publishes a
       fresh object per change, so a captured reference silently stops tracking
       (that cost one debugging round). Bake the final numbers into the constants
       above and this indirection can go. */
    const TUNE = (name: string, fallback: number): number => {
      const v = (window as typeof window & { __shelfTune?: Record<string, number> })
        .__shelfTune?.[name];
      return typeof v === "number" && Number.isFinite(v) ? v : fallback;
    };

    /**
     * Slots painted per side. Four gives a **nine-tape** row, which is the
     * composition the reference uses: the selection plus four either side, the
     * outer ones overlapping hard and fading off at the frame edge. The
     * neighbours are near edge-on, so the hero is the only face you read.
     */
    const MAX_SLOTS = 4;
    // The slot that is always off-stage. A tape is teleported into it while it
    // is invisible, which is what makes a step seamless.
    const PARK_SLOTS = 1;

    // Bookshelf ladder (intro file `磁带盒启动动画.html`)
    const SHELF_STEP = SPREAD_X;
    const SHELF_Z = -3.42;
    // The reference rises a 2.05-scaled wall up to 2.30 and then lets the rear
    // fall back to 1.30 while the selected tape lands at 1.18 in front of it.
    const RISE_SCALE_FROM = 2.05;
    const RISE_SCALE_TO = 2.3;

    const RISE_START = 260;
    const RISE_STAGGER = 130;
    const RISE_DUR = 1150;
    const PULL_DUR = 1700;
    const CURTAIN_FADE = 320;

    /* ── Drag: the row follows the pointer, and a flick throws it ──
       ⚠️ The gesture is a **position**, not a step count. `dragOffset` is the
       pointer's whole travel, `[SLOT_MIN, SLOT_MAX]` px buys one slot, and
       `progress` is the continuous result — so dragging past five tapes lands on
       the fifth, because that is where the pointer went. Two earlier revisions
       clamped `progress` to about one slot and re-based at most one tape per
       gesture, which is exactly what the user reported twice: "水平移动拖到一定距离就无法继续拖动，而这时才拖动了 2 个磁带盒的距离，并且松开鼠标时画面会回退到 1 个磁带盒，而不是 2 个磁带盒" and "无论我滑动多块，比如从 1 滑动到 5，松开鼠标后又会回退到 2 而不是 5".
       ⚠️ **The re-base is what makes it work**, and it has to happen once, at the
       end: `current` stays fixed for the whole gesture, and `recycle` moves it by
       the WHOLE landing in a single frame, so `ring − current + progress` is
       unchanged for every tape. Normalising `current` mid-drag (or in single
       steps) is what forced the clamp in the first place. */
    const SLOT_MIN = 170; // px of travel that buys one slot, small screens
    const SLOT_MAX = 280; // …and large ones
    const SLOT_DRAG = (): number =>
      Math.min(SLOT_MAX, Math.max(SLOT_MIN, window.innerWidth * 0.17));
    /**
     * How many slots one gesture may travel.
     *
     * ⚠️ It is bounded by the RING, not by taste. A release re-bases `current` by
     * the whole landing, and for that to be picture-preserving the landing has to
     * stay inside the ring: `ring ≥ n + 2·(half + DRAG_MAX)`. Five slots therefore
     * wants a 25-slot ring, which is why `MAX_FILLERS` is `6 × MAX_SLOT_COUNT`.
     * Raising this without raising that walks the painting off the end of the ring.
     */
    const DRAG_MAX = 5;

    // Release springs: critically damped position solvers with a velocity
    // handoff, so a flick keeps going and a slow drag settles where it was let
    // go (RhineLabUI's `damp()`, same solver).
    //  · `SPRING_RATE` — a push against the end of the archive easing back.
    //  · `GLIDE_RATE`  — the release after a drag, and the dial for how long the
    //    hand-off to the selection takes. The damping time constant is `1/rate`:
    //    9.2 (what the archive-end push uses) settles in ~110ms and reads as the
    //    tape being snatched; 5.4 gives ~185ms; **3.8 gives ~265ms**, which is the
    //    slow, soft landing the release wanted (2026-09-19: "从拖动磁带盒状态过渡到
    //    选择磁带盒的动画放慢一点，目前太快了").
    const SPRING_RATE = 9.2;
    const GLIDE_RATE = 3.8;
    const SPRING_STOP = 0.0025;
    const SPRING_STOP_V = 0.02;
    /**
     * ⚠️ A hard cap on how long a spring may run, and it is COUPLED to `1/rate`:
     * the solver leaves `e^(−rate·t)` of its amplitude behind, so the residual at
     * the cut is `amplitude · e^(−rate·cap)`. At the old 5.4/620ms that was 3.5%;
     * keeping the SAME 3.5% at 3.8 needs `620 · 5.4/3.8 ≈ 880`. Letting the cap
     * lag the rate turns the cut into a visible snap — the row would be ~5% of a
     * slot (≈11px) short of its slot when the tween is cut and `recycleFromSpring`
     * zeroes the difference.
     * The cap itself cannot go: the velocity threshold alone does not bound the
     * duration, because waiting for `|v| < 0.02` from a whole-slot glide is
     * several seconds of invisible motion that keeps `lock` set, which makes every
     * later gesture refused and reads as the shelf freezing after each flick.
     */
    const SPRING_MAX_MS = 900;

    /**
     * Release velocity, in slots per second, at which a flick commits a step.
     * Below it a release is judged on POSITION alone (past halfway ⇒ carry on,
     * short of it ⇒ play the tape back) — which is what makes a slow drag feel
     * continuous instead of snapping. Above it the flick has a vote of its own.
     */
    const FLICK_COMMIT = 2.6;

    const VELOCITY_WINDOW = 100; // ms of pointer history used to measure it

    // ── The step tween: the reference's exact numbers ──
    // One eased tween moves the WHOLE row (`progress` shifts every tape's slot
    // together) and the ring steps under it when it lands. That is how the
    // reference navigates, and it is what makes the motion read as one
    // deliberate sweep instead of several tapes each converging on its own.
    const STEP_FROM_REST = 620; // reference: `progress === 0 ? 620 : …`
    const STEP_BASE = 380; //            `380 + distance * 180`
    const STEP_PER_UNIT = 180;
    /** One blank stepped out of the scenery after a release that ran past the end
     *  of the archive. Short: it is a correction, not a navigation. */
    const WALK_BACK_MS = 260;
    const REVEAL_SMOOTH = 12;
    /** A frame gap above this is a RESUME, not animation time (see `renderFrame`). */
    const FRAME_GAP_MS = 200;

    // ── Tag-filter swap ──
    // ⚠️ A filter change used to teleport: `buildRing` re-seated the survivors and
    // pruned the rest in a single frame, reported as the swap being "太僵硬". It is
    // now two beats: the live row rises out through the top of the frame, then the
    // matched row rises in from below — the intro's own ladder, reused, so both
    // directions read as the same motion.
    /** How long the outgoing row takes to clear the top of the stage. */
    const FILTER_OUT_MS = 520;
    /** World units the outgoing row climbs — comfortably past the frame. */
    const FILTER_OUT_Y = 9.5;
    /** Beat between the old row leaving and the new one starting to rise. */
    const FILTER_GAP_MS = 260;

    const CARD_KEY = "rrsuika-shelf-card";
    const WARM_KEY = "rrsuika-shelf-warm";

    /**
     * The record the visitor was on, and whether they have already seen the
     * intro. Read ONCE, at module scope, before any renderer code can write
     * them back — `updateUI` owns `CARD_KEY`, so a later read returns the value
     * the boot itself just wrote.
     */
    const boot = (() => {
      try {
        return {
          warm: sessionStorage.getItem(WARM_KEY) === "1",
          card: Number.parseInt(sessionStorage.getItem(CARD_KEY) ?? "", 10),
        };
      } catch {
        return { warm: false, card: Number.NaN };
      }
    })();
    const warm = boot.warm;
    const restored = Number.isFinite(boot.card) && boot.card >= 0 ? boot.card : -1;
    /* ══════════════════════════════════════════
       MATH
       ══════════════════════════════════════════ */

    /**
     * The walk-home grade (see `recycleFromSpring`). `WALK_BACK_MS` is the cost of
     * a ONE-slot walk; every extra slot adds `WALK_BACK_PER_UNIT`.
     *
     * ⚠️ **The per-unit cost must stay BELOW the base, or the grade inverts.** An
     * earlier revision used `120`, giving 260/380/500/620 ms for 1/2/3/4 slots —
     * which is 3.85e-3, 2.63e-3, 2.00e-3, 1.61e-3 slots per ms, i.e. the FARTHER
     * blank closed the gap MORE SLOWLY per slot. That is the opposite of the ask
     * ("拖的距离…越远…回退速度越快") and the comment claiming otherwise was simply
     * wrong; the arithmetic check is what caught it.
     *
     * With 90 the cost is nearly constant per slot (260/350/440/530 ms ⇒
     * 3.85e-3 → 1.89e-3 per ms over four slots is still a taper, so read the RATE,
     * not the total: a four-slot return covers four slots in 530 ms against a
     * one-slot return's one slot in 260 ms, so it is visibly the faster correction,
     * while the short one keeps the gentle settle that `springOut` gives it).
     *
     * `WALK_BACK_MAX_MS` bounds it so an extreme overrun cannot hold `lock` for long
     * — the same reason `SPRING_MAX_MS` exists.
     */
    const WALK_BACK_PER_UNIT = 90;
    const WALK_BACK_MAX_MS = 900;

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    /** As `clamp`, but the bounds are ALSO pulled in to `from ± DRAG_MAX`, the
     *  furthest a single gesture can travel. A drag may only land on a slot the
     *  gesture could actually have reached: without this the clamp on a short
     *  archive hands back a slot *behind* the start, and a forward drag walks the
     *  row backwards. With it, the far end of the archive is the answer. */
    const clampReach = (v: number, a: number, b: number, from: number) =>
      v < from ? Math.max(v, a, from - DRAG_MAX) : Math.min(v, b, from + DRAG_MAX);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    const smooth = (t: number) => {
      t = clamp(t);
      return t * t * t * (t * (t * 6 - 15) + 10);
    };

    const easeOutCubic = (t: number) => 1 - Math.pow(1 - clamp(t), 3);
    const easeOutQuart = (t: number) => 1 - Math.pow(1 - clamp(t), 4);

    /**
     * A CRITICALLY DAMPED response, as an easing curve: zero slope at BOTH ends.
     *
     * ⚠️ This exists to fix a velocity discontinuity, and the shape of the bug is
     * worth keeping. The release runs on a damped solver (`GLIDE_RATE`), then the
     * solver is CUT at `|Δ| < SPRING_STOP` ≈ 0.0025 slot and a `snap` tween takes
     * over for the last fraction of a slot. That tween used `easeOutQuart`, whose
     * velocity is **maximal at t = 0** and decays: normalised to the same distance
     * the handoff multiplied the speed by about 2× in a single frame. Reported
     * verbatim as "从回正到静止不动…在接近静止不动位置时会突然加速，然后静止不动".
     * Using the same spring response as the curve makes the handoff C¹ — the tail
     * leaves zero velocity, the tween enters at zero velocity, and it eases out of
     * that smoothly instead of snapping.
     *
     * ⚠️ Because the peak velocity of this curve is only ~0.74 of a linear ramp,
     * tween durations that used to ride `easeOutQuart` need the `SMOOTH_SNAP_K`
     * multiplier to keep the same overall pace. */
    const springOut = (t: number) => {
      t = clamp(t);
      return 1 - (1 + 6.2 * t) * Math.exp(-6.2 * t);
    };
    /** Pace compensation for `springOut`, measured against its 0.74 peak. */
    const SMOOTH_SNAP_K = 1.45;

    const easeInOutCubic = (t: number) => {
      t = clamp(t);
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    };

    const wrap = (n: number, len: number) => ((n % len) + len) % len;

    /** Frame-rate independent chase: `1 - e^(-k·dt)` never overshoots. */
    const smoothTo = (value: number, target: number, k: number, dt: number) =>
      value + (target - value) * (1 - Math.exp(-k * dt));

    /* ══════════════════════════════════════════
       STATE
       ══════════════════════════════════════════ */

    interface Tape {
      el: HTMLAnchorElement;
      /** Ring index, or — while the tape is outside the ring (parked). */
      ring: number;
      /** 0— reveal factor. 0 means "off-stage and not drawn". */
      vis: number;
      /** True for the decorative blank cassettes that fill a short shelf. */
      empty: boolean;
      /** Last reel angle written, so the spin only repaints when it changes. */
      reelSpin: number;
      /** True while the element is parked with `visibility: hidden`. */
      hidden: boolean;
      /** Last `--cas-depth` written (quantised), so the veil/blur only repaint
       *  when the tape actually moves a step. -1 = nothing written yet. */
      depth: number;
    }

    let mode: "3d" | "flat" = "3d";
    let S = 100; // px per world unit
    let current = 0;
    /** — — 1 while the row travels to the next slot. Drives EVERY tape. */
    let progress = 0;
    let hoverX = 0;

    let allTapes: Tape[] = [];
    /** The ring being walked: the filtered real tapes, padded with blanks. */
    let list: Tape[] = [];
    /** The decorative blank cassettes that pad a short shelf. */
    let blankTapes: Tape[] = [];
    /** Ring positions the visitor may select: the real tapes, end to end. */
    let walkFrom = 0;
    let walkTo = 0;
    /** Ring positions either side of the selection that are painted. */
    let half = MAX_SLOTS;
    /** `half` plus the off-stage park lane a recycled tape waits in. */
    let span = half + PARK_SLOTS;

    let introT0 = 0;
    let introDuration = 0;
    let introDone = false;

    let lastFrame = 0;

    let pointerDown = false;
    let dragging = false;
    let dragMoved = false;
    /**
     * The pointer's TOTAL travel since `pointerdown`, in px, and `progress` at
     * the moment it went down. The row is the difference between them, which is
     * what makes a long slow drag walk several slots instead of committing one.
     */
    let dragAnchor = 0;
    let dragOffset = 0;
    let dragOffsetStart = 0;
    let lock = false;
    // Recent (x, time) samples. A single frame's delta is far too noisy to
    // decide a flick from a slow drag; the release velocity is measured over a
    // real time window instead.
    let dragSamples: { x: number; t: number }[] = [];

    // Release physics + step tween. Three separate quantities, and mixing any two
    // of them up has produced a bug: `target` is the slot offset the solver runs
    // on, `dir` is the DISTANCE it has left to travel (`target − value`, several
    // slots for a long drag), and `dest` is the RING INDEX the release decided on.
    const spring = {
      value: 0,
      velocity: 0,
      target: 0,
      dest: 0,
      dir: 0,
      rate: SPRING_RATE,
      elapsed: 0,
      active: false,
    };
    const snap = {
      from: 0,
      to: 0,
      t: 0,
      active: false,
      dur: STEP_FROM_REST,
    };

    let launching = false;
    let launchT0 = 0;
    const LAUNCH_DUR = 700;

    /** True while the row is breathing, spinning or travelling. A settled shelf
     *  writes nothing, which is what keeps it from repainting at rest. */
    let rowBusy = true;
    /** `rowBusy`, mirrored where the pose math can read it. */
    let idle = true;

    let lastUiKey = "";
    let uiToken = 0;
    let running = false;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    /** Every cassette element on the page, real and blank. Populated at boot. */
    const realEls = casEls;

    /**
     * A tape's displacement from the selection, in slots, as a float.
     *
     * This is the only position model in the component, and keeping it to one
     * line is the point: an earlier revision tracked a separate ring `offset`
     * and derived the slot from it in three places, the copies drifted, and the
     * selection ring ended up painted on a different tape from the one the
     * panel described. One formula, read everywhere, cannot drift.
     *
     * `progress` is the continuous part: one eased tween on it moves the entire
     * row, which is what makes a step read as a single sweep rather than a
     * handful of tapes each easing toward its own target.
     */
    const slotIndex = (tape: Tape) => tape.ring - current + progress;

    /** How many slots a parked tape sits beyond the row. Deep enough that the
     *  projection keeps it off-stage; perspective pulls a distant tape back
     *  toward the middle, so this scales with the stage. */
    const parkSlots = () =>
      Math.max(
        span + 1,
        Math.ceil(stage.clientWidth / (SPREAD_X * S)) + 1,
      );

    /* ══════════════════════════════════════════
       POSE — hero (selected) composition
       ══════════════════════════════════════════ */

    interface Pose {
      x: number;
      y: number;
      z: number;
      rx: number;
      ry: number;
      rz: number;
      scale: number;
      abs: number;
      /** 0 = facing the viewer, 1 = fully edge-on. Drives the face crossfade. */
      side: number;
    }

    function heroPose(p: number, time: number, seed: number): Pose {
      const abs = Math.abs(p);
      const side = smooth(clamp(abs / SIDE_SPAN));

      // The pass bump: 0 at the selection, 0 from one slot out, 1 at the half
      // slot where the two tapes either side of the centre cross. See `PASS_TWIST`.
      const pass = 4 * abs * Math.max(0, 1 - abs);

      const x =
        p * SPREAD_X +
        p * abs * SPREAD_X2 +
        Math.sign(p) * TUNE("passGap", PASS_GAP) * pass;
      const z = TUNE("zNear", Z_NEAR) - Math.pow(abs, Z_POW) * Z_FALL;

      // A slow breath while the shelf is alive, frozen once it settles. Keeping
      // it running at rest meant every tape was re-composited on every frame
      // forever, which showed up as uneven frame times during a step.
      const breath = idle
        ? Math.sin((time * Math.PI * 2) / 8 + seed * 0.3) * 0.032 +
          Math.sin((time * Math.PI * 2) / 13 - seed * 0.17) * 0.014
        : 0;
      const y = TUNE("yBase", Y_BASE) - Math.pow(abs, Y_POW) * Y_FALL + breath;

      const scale = 1 / (1 + SCALE_FALL * abs);

      // The rotation depends on the SLOT ALONE. The reference's `layoutPose`
      // reads exactly this way, and that is not an accident: adding a
      // progress-fed term (an earlier revision blended the hero toward edge-on
      // while the row travelled) makes the selected tape swing 60° in the middle
      // of a 620ms step, which is what made the transition feel abrupt. The
      // tape now only ever slides and recedes — never turns against the motion.
      const ry =
        lerp(TUNE("ryCenter", RY_CENTER) + hoverX * 0.035, p >= 0 ? -RY_SIDE : RY_SIDE, side) +
        (p >= 0 ? -1 : 1) * TUNE("passTwist", PASS_TWIST) * pass;

      const rz = TUNE("rzBase", RZ_BASE) + p * (RZ_SPREAD + RZ_SPREAD2 * abs);
      const heroMask = Math.exp(-p * p * LIFT_FALL);
      const rx = TUNE("rxBase", RX_BASE) + RX_SIDE * side + TUNE("rxHero", RX_HERO) * heroMask;
      const lift = TUNE("lift", LIFT) * heroMask;

      return { x, y: y + lift, z, rx, ry, rz, scale, abs, side };
    }

    /** Flat, evenly spaced, edge-on row — the shelf before the pull. */
    function shelfPose(slot: number) {
      return {
        x: slot * SHELF_STEP,
        y: 0,
        z: SHELF_Z - Math.abs(slot) * 0.11,
        ry: slot > 0 ? -Math.PI / 2 : Math.PI / 2,
      };
    }

    /* ══════════════════════════════════════════
       MEASURE
       ══════════════════════════════════════════ */

    function measure() {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (w === 0 || h === 0) return;

      S =
        mode === "3d"
          ? Math.min(h / WORLD_H, w / MIN_WORLD_W)
          : Math.min(w / MIN_WORLD_W, 110);

      root.style.setProperty("--S", S.toFixed(3) + "px");
      root.style.setProperty("--persp", PERSPECTIVE.toFixed(2));
      root.style.setProperty("--cas-w", (CAS_W * S).toFixed(2) + "px");
      root.style.setProperty("--cas-h", (CAS_H * S).toFixed(2) + "px");
      root.style.setProperty("--cas-d", (CAS_D * S).toFixed(2) + "px");
    }

    /* ══════════════════════════════════════════
       THE ROW
       ══════════════════════════════════════════ */

    /**
     * Build the ring the row walks: the filtered real tapes, padded at both
     * ends with blank cassettes.
     *
     * The padding is not redundant. `MAX_SLOTS` reaches the screen edge on both
     * sides, so a shelf with five projects in it would otherwise leave empty
     * slots at each end and read as "only five things here" — the blanks make it
     * read as a shelf that continues past the frame. Padding to `2·half + 1`
     * whenever the list is short is also what keeps the selection **centred**:
     * with the padded row always that long, a five-project selection sits in the
     * middle of a full row instead of being dragged off to one side.
     *
     * The blanks are scenery, never destinations: the walkable range runs from
     * the first real tape to the last one, and `navigate` refuses to step past
     * either. Everything outside that range is painted, because the shelf should
     * look continuous, but it cannot be selected.
     */
    function buildRing(filtered: Tape[]) {
      // ── How long does the ring have to be? ──
      //
      // ⚠️ **`ring ≥ n + 2·(span + DRAG_MAX)`, and both terms are load-bearing.**
      //
      //  · `span` is the park lane: `recycle` may only re-base onto a slot the
      //    painted band still fits around, plus the off-stage lane a recycled tape
      //    waits in, so every real tape needs room on BOTH sides or the band runs
      //    off the end of the ring and the shelf silently loses half its tapes.
      //  · `DRAG_MAX` is the drag: a gesture can now travel several slots, and the
      //    landing it re-bases onto has to be inside the ring or the painting walks
      //    off the end of it. With `2·span` alone a three-tape drag had nowhere to
      //    land and the row sprang back — which is what the user saw as "拖到一定距离就无法继续拖动".
      //
      // A short archive is padded to at least the full row (`2·half + 1`); a long
      // one is padded by `slack` at each end, and the extras sit off-stage.
      const slack = Math.max(1, span + DRAG_MAX);
      const floorSize = MAX_SLOTS * 2 + 1;
      const need = Math.max(
        0,
        Math.max(floorSize, filtered.length + slack * 2) - filtered.length,
      );
      const used = blankTapes.slice(0, Math.min(need, blankTapes.length));
      const lead = Math.ceil(used.length / 2);

      list = [
        ...used.slice(0, lead),
        ...filtered,
        ...used.slice(lead),
      ];
      list.forEach((tape, i) => {
        tape.ring = i;
      });

      // Everything outside the ring is parked off-stage. Real tapes the filter
      // removed keep their element — and their decoded cover — for the next swap.
      const inRing = new Set(list);
      for (const tape of allTapes) {
        if (!inRing.has(tape)) {
          tape.ring = -1;
          tape.vis = 0;
        }
      }
      for (const tape of blankTapes) tape.el.hidden = !inRing.has(tape);

      walkFrom = lead;
      walkTo = lead + filtered.length - 1;
      half = MAX_SLOTS;
      span = half + PARK_SLOTS;

      // Seat the hero `half` positions along the ring: that is what puts it at
      // screen centre. Clamped to the real tapes so a short shelf never opens on
      // a blank, and to the ring's own slack so the band always fits.
      const seat = clamp(
        half,
        Math.max(walkFrom, half),
        Math.min(walkTo, Math.max(walkFrom, list.length - 1 - half)),
      );

      // A kept selection survives a filter change.
      const kept = centreEl();
      const keptTape = kept ? list.find((tape) => tape.el === kept) : undefined;
      const keptIdx = keptTape ? list.indexOf(keptTape) : -1;
      current = keptIdx >= walkFrom && keptIdx <= walkTo ? keptIdx : seat;

      reseat(true);
    }

    /**
     * Park every tape that is not currently in the ring, then tell the UI where
     * the selection is.
     *
     * There is deliberately no per-tape easing here. Every tape's painted
     * position is `ring — current + progress`, so the single tween on
     * `progress` moves the whole row in lockstep — which is what reads as one
     * sweep. An earlier revision had each tape chase its own target with an
     * exponential filter, and the row arrived in a mush of slightly different
     * velocities.
     */
    function reseat(snapProgress: boolean) {
      if (snapProgress) {
        progress = 0;
        spring.value = 0;
        spring.velocity = 0;
        spring.active = false;
        snap.active = false;
      }

      // A tape is painted while it is inside `±span`; anything else is pruned by
      // the render loop's fade, so there is nothing to park explicitly. The
      // tapes just outside the row are already off-stage, which is why a step
      // never pops: the tape that leaves has faded out past the frame edge and
      // the one that arrives has faded in from it.

      syncEmptyState(walkTo < walkFrom);
      updateUI(true);
    }

    /**
     * Re-seat the row after a step, or settle it where it is.
     *
     * ⚠️ `step` is a **signed integer, not a direction**, and that is what makes
     * a multi-tape throw possible: a fast flick can land two or three slots along,
     * and the whole row is re-based in ONE frame so every tape's
     * `ring − current + progress` is unchanged. Recycling them one at a time
     * would paint the wrong tape in the middle of the wrap.
     *
     * ⚠️ `step === 0` is NOT a no-op — it means "the row landed on the slot it set
     * off from", which still has to round `progress` to exactly 0 and release the
     * step lock. Returning early here instead left the spring armed for ever with
     * `progress` drifting by hundredths, which is invisible on screen and jams
     * every later gesture (`lock` never clears, so `pointerdown` is refused).
     *
     * The caller has already eased `progress` onto `-step`, so changing `current`
     * by `step` and zeroing `progress` is a no-op for the picture.
     */
    function recycle(step: number, stay = false) {
      if (list.length === 0) return;

      if (stay || step === 0) {
        progress = 0;
        spring.value = 0;
        spring.velocity = 0;
        spring.active = false;
        lock = false;
        return;
      }

      const dir = step > 0 ? 1 : -1;
      let next = current + step;
      // ⚠️ **A blank may not be SELECTED, but it may be RE-BASED onto.** Those are
      // different questions and conflating them broke the walk-back: the range is
      // the walkable band PLUS the one blank past either end, so a release can seat
      // the overshoot (`walkTo + 1`) and the walk-back can then step back in
      // (`walkTo + 1 → walkTo`). Refusing the second one left `current` stranded on
      // the blank with the walk-back re-arming for ever — measured as `lock` never
      // clearing and `progress` cycling 0 → −1.
      const lo = Math.max(0, walkFrom - 1);
      const hi = Math.min(list.length - 1, walkTo + 1);
      if (next < lo || next > hi) {
        const allowedProgress = clamp((current - clamp(next, lo, hi)) * dir, -1, 1);
        // Only the part of the travel the ring cannot hold eases away.
        progress = Math.abs(allowedProgress) < Math.abs(progress) ? allowedProgress : progress;
        spring.value = progress;
        spring.velocity = 0;
        spring.target = 0;
        spring.rate = SPRING_RATE;
        spring.active = true;
        return;
      }

      current = wrap(next, list.length);
      progress = 0;
      spring.value = 0;
      spring.velocity = 0;
      spring.active = false;
      lock = false;
      reseat(false);
    }

    /**
     * Land the release on its tape.
     *
     * The row has glided to the drop point, so `progress` sits on it. Two things
     * then happen, deliberately separately:
     *
     *  1. **Re-base the ring onto the tape**, in ONE `recycle` call carrying the
     *     whole distance. That is what keeps `ring − current + progress` invariant
     *     for every tape — i.e. what lets a five-slot drag land on the fifth tape
     *     without the painting moving under it.
     *  2. **If the drop landed in the scenery, slide home instead of cutting.** The
     *     landing is clamped to a real tape, so such a drop asks `current` to travel
     *     less far than `progress` did; assigning that outright snaps the whole row
     *     sideways in one frame, which is the "空磁带盒直接消失，最近的有内容磁带盒直接刷新闪现出现" report. The
     *     queued `snap` tween runs `progress` from where the drop left it to
     *     `dest − current`, and the `recycle` at the end of it finishes the move —
     *     the blank slides out and the neighbouring tape slides in.
     */
    function recycleFromSpring() {
      const dest = spring.dest;
      const step = dest - current;

      // How far the DROP ended up from where the re-base needs the row, in slots.
      // ⚠️ `recycle` preserves the picture only when its argument is `−progress`,
      // and `step` IS that argument, so the recycle needs the row resting on
      // `−step`; the drop left it on `round(spring.target)` (a progress value).
      // Summing is therefore right and subtracting was the second half of the
      // inverted-landing bug. Zero when the drop was already on a tape (the
      // normal case).
      // ⚠️ **The residual has to be measured from where the row ACTUALLY rests,
      // not from `round(spring.target)`.** The solver is cut at `|Δ| < 0.0025` slot
      // or at `SPRING_MAX_MS`, so `spring.value` can still be a fraction of a slot
      // short of the target, and `progress` is written from it every frame. Sizing
      // the walk-back off the rounded target therefore left that fraction
      // unabsorbed, and the difference was applied INSTANTLY — measured on a real
      // drag (2026-09-20): the row decayed smoothly to ~5px/frame, sat perfectly
      // still for 3-4 frames, then moved 89px and 106px in two frames before
      // stopping. That is the "接近静止不动位置时会突然加速，然后静止不动" report, and it
      // is the same defect whether or not the tween was eased (baseline re-measured
      // at 1614px against 940px here, so it predates the easing change).
      const over = progress + step;

      if (Math.abs(over) > 0.002) {
        // ⚠️ The tween ends on `−step`, because `recycle` reads its argument in the
        // INVERSE sense from `snap.to`: a forward step (a higher ring index) is
        // `progress = −1` but `recycle(+1)`. Ending the tween on `step` therefore
        // left `recycle` to move `current` by `−step` — measured, a 3-slot drag
        // settled at `progress = −2` and then jumped to the wrong end of the
        // archive. `recycle(-snap.to)` then receives `+step`, which is right.
        //
        // ⚠️ **The walk home is GRADED by distance, and `|over|` is that distance.**
        // `over` is how many slots the drop landed away from the tape it has to
        // re-base onto, so a drag that overran the scenery by one slot and one that
        // overran by four used to take the same 260 ms — the short one read as
        // sluggish and the long one as a snap.
        //
        // The grade has to be read as a RATE, not as a total: the point of the
        // linear term is that extra slots come cheaper than the first one, so a
        // distant blank closes its gap at a higher per-slot speed and the
        // neighbouring blank keeps the gentlest walk. ⚠️ See the note on the
        // constants — a per-unit cost ABOVE the base inverts this.
        snap.dur = Math.min(
          WALK_BACK_MAX_MS,
          WALK_BACK_MS + (Math.abs(over) - 1) * WALK_BACK_PER_UNIT,
        );
        snap.from = progress;
        snap.to = -step;
        snap.t = 0;
        snap.active = true;
        lock = true;
        return;
      }

      recycle(step);
    }

    function syncEmptyState(empty: boolean) {
      const emptyEl = document.getElementById("shelf-empty");
      if (emptyEl) emptyEl.hidden = !empty;

      // An arrow is only live while there is somewhere to go.
      const atStart = current <= walkFrom;
      const atEnd = current >= walkTo;
      document.getElementById("shelf-prev")?.toggleAttribute("hidden", atStart);
      document.getElementById("shelf-next")?.toggleAttribute("hidden", atEnd);
    }

    /* ══════════════════════════════════════════
       NAVIGATE / DRAG / RELEASE
       ══════════════════════════════════════════ */

    function navigate(direction: 1 | -1) {
      if (lock || launching || !introDone || walkTo <= walkFrom) return;

      // Refuse to walk onto the blank scenery at either end and ease back
      // instead — the shelf continues past the frame, but the archive stops.
      // ⚠️ The bound is checked against the CONTINUOUS landing, not `current + 1`:
      // a drag can now leave the row resting on a fractional slot, and then
      // `current + 1` is already the slot the spring is on its way to, which made
      // the arrow fire a second step out of the same gesture.
      const landing = current + Math.round(progress) + direction;
      if (landing < walkFrom || landing > walkTo) {
        lock = true;
        spring.value = progress;
        spring.velocity = 0;
        spring.target = 0;
        spring.rate = SPRING_RATE;
        spring.active = true;
        return;
      }

      // ⚠️ **`snap.to` is a PROGRESS value, not a ring step** — `progress`
      // decreases as `current` increases, so a forward step (direction `+1`)
      // targets `−1`. And it is measured from the LIVE `current`, not written as a
      // flat `±1`: when the row is resting on a fractional slot, `−1` would be a
      // step and a half. `progress` is zeroed by every `recycle`, so a settled row
      // gives exactly `±1` anyway. ⚠️ The wheel handler and the arrow share this,
      // and `walkBackToTape` writes `snap.to` the same way — a tween that mixes
      // the two conventions lands the row a whole extra slot along.
      const from = progress;
      const target = -direction;
      const distance = Math.abs(target - from);
      // ⚠️ `SMOOTH_SNAP_K` — this tween now rides `springOut` (zero velocity at
      // both ends), whose peak speed is ~0.74 of a linear ramp, so the durations
      // below are scaled to keep the pace the constants were tuned to.
      snap.dur =
        SMOOTH_SNAP_K *
        (mode === "flat"
          ? 380
          : Math.abs(from) < 0.001
            ? STEP_FROM_REST
            : STEP_BASE + distance * STEP_PER_UNIT);
      snap.from = from;
      snap.to = target;
      snap.t = 0;
      snap.active = true;
    }

    /**
     * The pointer's release velocity, in slots per second.
     *
     * ⚠️ Least-squares slope over the samples in `VELOCITY_WINDOW`, not
     * first-to-last. Two-point differencing over a real 100ms window is fine at
     * 60Hz (six samples), but a pointer that only reports every ~10ms-30ms — or a
     * gesture whose last event lands early in the window — can leave the window
     * holding one or two samples, and then the whole flick decision rides on a
     * single frame's jitter. Fitting the line through every sample in the window
     * costs nothing and is stable at any report rate.
     */
    function sampleVelocity(slot: number): number {
      const now = performance.now();
      const recent = dragSamples.filter((s) => now - s.t <= VELOCITY_WINDOW);
      if (recent.length < 2) return 0;

      const meanT = recent.reduce((sum, s) => sum + s.t, 0) / recent.length;
      const meanX = recent.reduce((sum, s) => sum + s.x, 0) / recent.length;
      let cov = 0;
      let varT = 0;
      for (const s of recent) {
        cov += (s.t - meanT) * (s.x - meanX);
        varT += (s.t - meanT) * (s.t - meanT);
      }
      if (varT < 1) return 0;

      // px per ms → slots per second. A fast leftward flick is a NEGATIVE slope
      // and `progress` decreases as the row moves forward, so the sign carries
      // straight through.
      return (cov / varT) * (1000 / slot);
    }

    /**
     * Let go: the row glides to a slot near where the drag left it.
     *
     * ⚠️ Position decides the landing; velocity only gets a VOTE (2026-09-19:
     * "慢慢拖能慢慢拖动磁带，而快速的拖能快速切换多个磁带"). Adding a projected
     * throw to the position — the obvious "physics" answer — does not survive
     * contact with the numbers: `max(Δ) = v0/(e·rate)` reaches a whole slot at
     * about seven slots per second, so gearing it down makes it too weak to matter
     * and leaving it honest makes an ordinary quick flick overshoot two tapes. The
     * two effects also fight across the rounding boundary, and a hard flick then
     * lands BEHIND where the pointer already put the row.
     *
     * So:
     *   · land on the nearest whole slot — past halfway carries on to the next
     *     tape, short of it plays the tape back where it was. That is the
     *     "slow drag moves slowly" half;
     *   · a release above `FLICK_COMMIT` in either direction commits to the step
     *     it was already leaning toward, permissively: it only has to be moving
     *     that way. That is the "fast flick switches" half — a real flick commits
     *     with a third of a slot of travel, which position alone would never
     *     round up.
     *   · hand the position AND the release velocity to the damped solver, so the
     *     glide keeps the pointer's speed and tapers out on its own.
     */
    function settleDrag() {
      dragging = false;
      pointerDown = false;
      stage.classList.remove("is-dragging");
      lock = true;
      // ⚠️ Samples belong to ONE gesture. Leaving them behind feeds the next
      // gesture's velocity a slope across a gap where the pointer was up, which
      // reads as a very fast flick in whichever direction the two drags happened
      // to differ.
      const velocity = spring.velocity;
      dragSamples = [];

      const maxStep = Math.round(DRAG_MAX);
      // ⚠️ **THE LANDING IS THE TRAVEL.** `progress` is the pointer's whole offset
      // in slots, so the nearest whole slot to it IS the tape the visitor dragged
      // to: five slots of travel lands five tapes along. Two earlier revisions
      // threw the magnitude away and kept only `Math.sign(progress)`, which is
      // exactly the report "无论我滑动多块，比如从 1 滑动到 5，松开鼠标后又会回退到 2 而不是 5".
      //
      // The flick is only a TIE-BREAK on top of that: a quick release that had
      // already carried the row most of the way to the next slot commits to it
      // instead of rounding back. It never adds more than the one slot the round
      // was already deciding about, so a hard flick cannot skip a tape the drag
      // never reached.
      let land = Math.round(progress);
      // ⚠️ The flick may only carry the round to the NEXT WHOLE SLOT in the
      // direction of motion — never a slot beyond it. `progress` grows to the
      // RIGHT, so a rightward flick commits to `ceil(progress)` and a leftward one
      // to `floor(progress)`; `max` / `min` makes that a no-op when the round had
      // already reached it (a 1.5-slot flick lands on 2, not 3). The earlier
      // `land += 1` did not check, so any release above `FLICK_COMMIT` added a
      // whole slot on top of a round that had already committed one — a flick that
      // travelled 0.8 of a slot skipped a tape the drag never reached.
      if (velocity >= FLICK_COMMIT) land = Math.max(land, Math.ceil(progress));
      else if (velocity <= -FLICK_COMMIT) land = Math.min(land, Math.floor(progress));
      land = clamp(land, -maxStep, maxStep);

      // ⚠️ **Two different numbers, and conflating them was a bug.** `travel` is
      // how far the SOLVER has left to run; `drop` is where the row comes to rest
      // (the blank, if the drag ran onto the scenery); `dest` is the RING INDEX the
      // release decided on (always a real tape). `recycleFromSpring` must read
      // `dest` — it read the solver's travel once, which is `land − progress` and
      // therefore **zero** whenever the release happened to land exactly on a whole
      // slot, so every clean drag settled straight back on the tape it started from.
      // ⚠️ **`dest` is `current − land`, NOT `current + land`.** `progress` grows
      // as the pointer moves RIGHT (the row follows the pointer), and while the
      // row is held at `progress = p` the tape under the CENTRE is the one with
      // ring index `current − p` (that is `slotIndex = ring − current + progress
      // = 0`). So a rightward drag of one slot has to move `current` DOWN by one.
      // Summed instead, the release did two wrong things at once: it picked the
      // tape *behind* the pointer and, because `recycle`'s argument has to be
      // `−progress`, it re-based the ring by `+land` against a `progress` of
      // `+land` — moving every tape by `2·land` slots in one frame. Reported as
      // "从左往右拖，比如从 5 拖到 4，松开鼠标后会变成拖到 6"，and mirrored on the
      // way back.
      // ⚠️ Two clamps, and they are different questions:
      //
      //  · `dest` (where the selection ENDS UP) is clamped to the archive. It must
      //    never be pulled toward the drag's start: on a short archive a 3-slot drag
      //    has no third slot to land on, and constraining `dest` to
      //    `current ± DRAG_MAX` made the clamp hand back a slot *behind* the start —
      //    a forward drag that walks the row backwards. The far end of the archive
      //    is the answer, and the row simply travels less than the pointer did.
      //  · `spring.target` (where the row comes to REST) is the raw landing, so the
      //    drop can settle in the scenery and the slide home is what brings it back.
      //    Clamping the travel instead cuts the give short.
      spring.dest = clamp(current - land, walkFrom, walkTo);
      spring.dir = land - progress;

      // A release that goes nowhere has no velocity to spend.
      spring.velocity = spring.dir === 0 ? 0 : velocity;

      spring.value = progress;
      spring.target = land;
      // The hand-off to the selection is the one motion the visitor is waiting
      // for, so its speed is a knob (`MOTION — release glide` in the tuner panel).
      spring.rate = TUNE("glideRate", GLIDE_RATE);
      spring.elapsed = 0;
      spring.active = true;
    }

    /* ══════════════════════════════════════════
       RENDER LOOP
       ══════════════════════════════════════════ */

    /**
     * The tag swap's clock. Runs before the render loop reads the values, and runs
     * in the SAME rAF as every other tween, so the outgoing row and the incoming
     * rise cannot drift apart.
     *
     * Phases:  out (0→1, `FILTER_OUT_MS`)  →  gap (`FILTER_GAP_MS`, new ring built
     * at the start of it)  →  in (owned by `startRiseIn`, i.e. `introDone`).
     */
    function stepFilterSwap(now: number) {
      if (filterHold) {
        if (now - filterGapStart >= FILTER_GAP_MS) {
          filterHold = false;
          startRiseIn();
        }
        return;
      }
      if (!filterOutPending && filterOut <= 0) return;

      const t = clamp((now - filterOutStart) / FILTER_OUT_MS);
      filterOut = springOut(t);
      if (t < 1) return;

      // The old row is out of frame: re-seat the matched tapes while nothing is
      // visible, so the rebuild itself can never be seen as a jump.
      filterOutPending = false;
      filterOut = 0;
      buildRing(filterPendingTapes);
      filterPendingTapes = [];
      filterGapStart = now;
      filterHold = true;
    }

    function stepTweens(dt: number) {
      // ── release spring (critically damped, velocity preserved) ──
      //
      // ⚠️ `wasActive` gates the `progress = spring.value` write. A settled spring
      // has just re-based the ring (`recycleFromSpring` zeroes `progress`, and a
      // multi-slot landing changes `current` under it), so writing `spring.value`
      // unconditionally would immediately re-apply the offset that was just
      // consumed — the row would sit permanently one spring-length off its slot
      // with the spring deactivated, and nothing would ever move it again.
      const wasActive = spring.active;
      if (wasActive) {
        const rate = reduceMotion ? 60 : spring.rate;
        const delta = spring.value - spring.target;
        const impulse = spring.velocity + rate * delta;
        const decay = Math.exp(-rate * dt);
        spring.value = spring.target + (delta + impulse * dt) * decay;
        spring.velocity = (spring.velocity - rate * impulse * dt) * decay;
        spring.elapsed += dt * 1000;

        const settled =
          (Math.abs(spring.value - spring.target) < SPRING_STOP &&
            Math.abs(spring.velocity) < SPRING_STOP_V) ||
          spring.elapsed >= SPRING_MAX_MS;

        if (settled) {
          spring.value = spring.target;
          spring.velocity = 0;
          spring.active = false;
          spring.elapsed = 0;
          // Cut the tween where the solver was heading, which is the slot the row
          // is over: the cap can fire while `value` is still a little short of
          // `target`, and the picture difference is under a hundredth of a slot.
          recycleFromSpring();
        }
      }
      if (wasActive) progress = spring.value;

      // ── the step: ONE eased tween drives the whole row ──
      if (snap.active) {
        snap.t += dt / (snap.dur / 1000);
        const t = clamp(snap.t);
        // ⚠️ `springOut`, not `easeOutQuart`: the release hands this tween a
        // solver tail that has already stopped, so the curve has to start at zero
        // velocity too or the handoff reads as a sudden acceleration (see the note
        // on `springOut`).
        progress = lerp(snap.from, snap.to, springOut(t));
        if (t >= 1) {
          snap.active = false;
          recycle(-snap.to);
        }
      }
    }

    function renderFrame(now: number) {
      const gap = lastFrame ? now - lastFrame : 16;
      lastFrame = now;
      // ⚠️ A LONG GAP IS NOT A LONG STEP.
      //
      // The loop can be parked and restarted (a hidden tab, an observer misfire,
      // any frame the compositor drops badly). Capping `dt` alone does not catch
      // that: `Math.min(0.05, gap)` still applies 50 ms of travel in a single
      // frame, and 50 ms is a visible chunk of a 260–900 ms tween. Measured on a
      // real drag settle (2026-09-20): the row decayed smoothly to ~5 px/frame,
      // then moved 89 px and 106 px in two frames before stopping — reported by
      // the user as "接近静止不动位置时会突然加速，然后静止不动".
      //
      // So a gap above `FRAME_GAP_MS` is treated as a resume, not as elapsed
      // animation time: nothing is stepped this frame, and the next frame picks up
      // with a normal delta. The shelf is never on screen during the gap, so there
      // is nothing to see it skip.
      if (gap > FRAME_GAP_MS) {
        stepFilterSwap(now);
        return;
      }
      const dt = Math.min(0.05, gap / 1000);

      // Reduced motion keeps the static 3D composition but freezes the idle
      // float and the reel spin.
      const time = reduceMotion ? 0 : now / 1000;

      stepFilterSwap(now);
      stepTweens(dt);

      const introElapsed = now - introT0;
      // Is anything moving? Drives the reel spin and the idle float, so a
      // settled shelf costs no repaints at all.
      const rowBusy =
        !introDone ||
        snap.active ||
        spring.active ||
        dragging ||
        launching ||
        filterOutPending ||
        filterHold ||
        filterGap > 0 ||
        Math.abs(progress) > 0.0005;
      idle = rowBusy;

      if (launching) {
        const lt = easeInOutCubic(clamp((now - launchT0) / LAUNCH_DUR));
        if (lt >= 1) return;
      }

      for (const tape of allTapes) {
        const { el } = tape;
        const sink = slotIndex(tape);

        // ── reveal fade: 1 inside the painted row, 0 outside it. ──
        //
        // ⚠️ The band is ASYMMETRIC once the row is offset, and it has to be:
        // `progress` is now a multi-slot travel, so the painted row genuinely moves
        // across the ring rather than pivoting on one slot. The side the row is
        // moving AWAY from keeps the full span (those tapes are sliding out of the
        // park lane and still have to be readable during the move); the side it is
        // moving TOWARD contracts by exactly the offset, so a tape is never painted
        // in the lane it is about to be teleported into. A single symmetric band
        // cannot express both, and clamping `sink` to it instead would compress the
        // whole row as the drag got longer.
        const inRing = tape.ring >= 0;
        const band = span - Math.min(0, progress * Math.sign(sink));
        const within = inRing && Math.abs(sink) <= Math.max(1, band);

        tape.vis = smoothTo(
          tape.vis,
          within ? 1 : 0,
          reduceMotion ? 60 : REVEAL_SMOOTH,
          dt,
        );

        if (tape.vis <= 0.004) {
          tape.vis = 0;
          if (!tape.hidden) {
            tape.hidden = true;
            el.classList.add("is-hidden");
            el.setAttribute("aria-hidden", "true");
            el.style.removeProperty("--cas-o");
            el.style.removeProperty("--reel-spin");
            el.style.removeProperty("--cas-depth");
            el.classList.remove("is-far");
            tape.depth = -1;
          }
          continue;
        }

        if (tape.hidden) {
          tape.hidden = false;
          el.classList.remove("is-hidden");
          if (!tape.empty) el.removeAttribute("aria-hidden");
        }

        // What every tape actually paints from: its own slot, clamped to the
        // last painted position so a tape still on its way into the park lane
        // never shoots off past where it can be seen.
        const pos = clamp(sink, -span, span);
        const isCentre = introDone && Math.abs(pos) < 0.5;
        el.classList.toggle("is-center", isCentre);

        // ── DEPTH — how far this tape sits from the selection ──
        // 0 at the centre, 1 at the far end of the painted band. The veil (and, on
        // the light theme, the print blur) read it, so the row gets ONE continuous
        // near→far falloff instead of a flat "selected or not" dim.
        // ⚠️ Quantised to 1/120 and written only when it moves a step: this value
        // changes every frame while the row travels, and every write is a paint on
        // ten tapes. 120 steps across the band is finer than the eye can place, and
        // a settled shelf still writes nothing at all.
        const depth = span > 0 ? Math.min(1, Math.abs(pos) / span) : 0;
        const dq = Math.round(depth * 120) / 120;
        if (dq !== tape.depth) {
          tape.depth = dq;
          el.style.setProperty("--cas-depth", dq.toFixed(3));
          el.classList.toggle("is-far", dq > 0.02);
        }

        if (mode === "flat") {
          const abs = Math.abs(pos);
          el.style.transform = `translate3d(${(pos * 106).toFixed(2)}%,0,0)`;
          el.style.setProperty(
            "--cas-o",
            (clamp(1 - Math.max(0, abs - 0.5) * 2.4) * tape.vis).toFixed(3),
          );
          // Flat mode is a card switcher, not a shelf: no veil and no aerial blur,
          // which is what the old `--cas-beneath: 0` here did. Clear the 3D pass's
          // leftovers so a mode switch cannot strand either one.
          el.style.removeProperty("--cas-depth");
          el.classList.remove("is-far");
          tape.depth = -1;
          el.style.zIndex = String(Math.round(100 - abs * 10));
          continue;
        }

        const hero = heroPose(pos, time, tape.ring);
        let { x, y, z, rx, ry, rz, scale } = hero;
        let opacity = tape.vis;

        // ── tag-filter exit: the whole row climbs out and fades ──
        // Applied to the POSE rather than the element, because the render loop owns
        // `el.style.transform` outright and a CSS animation on the same element
        // would be overwritten on the next frame. The fade rides `opacity`, which
        // the faces consume through `--cas-o`.
        if (filterOut > 0) {
          y += filterOut * FILTER_OUT_Y;
          opacity *= 1 - filterOut;
        }

        // ⚠️ No per-tape alpha, and no cover crossfade. An earlier revision
        // dimmed the printed cover toward 0.8 as a tape turned edge-on (the
        // reference's `1 − .96·side`, inverted). On the light theme that made
        // every neighbour's front plate see-through, so each tape showed the
        // tape behind it and the row read as stacked translucent volumes. Depth
        // comes from the opaque dim veil, the Z separation and the scale.

        // ── intro: the reference's ladder ──
        // Tapes rise edge-on from below with their X held on the row (the
        // reference never slides them laterally) and then the rear wall
        // retreats while the selection pulls forward out of it.
        if (introElapsed < (introAt.get(tape) ?? 0) + RISE_DUR + 60) {
          const rt = easeOutCubic(
            clamp((introElapsed - (introAt.get(tape) ?? 0)) / RISE_DUR),
          );
          const from = introFrom(tape, pos);

          x = from.x;
          y = lerp(from.y, hero.y, rt);
          z = lerp(from.z, hero.z, rt);
          rx = lerp(0.025, hero.rx, rt);
          ry = lerp(from.ry, hero.ry, rt);
          rz = lerp(0, hero.rz, rt);
          scale = lerp(RISE_SCALE_FROM, hero.scale, rt);
          opacity *= clamp(rt * 1.7);
        }

        // ── launch: the selected tape flies at the viewer ──
        if (launching && isCentre) {
          const lt = easeInOutCubic(clamp((now - launchT0) / LAUNCH_DUR));
          z = lerp(z, 7.6, lt);
          scale = lerp(scale, 1.5, lt);
          ry = lerp(ry, -0.02, lt);
          rx = lerp(rx, 0, lt);
          rz = lerp(rz, 0, lt);
          x = lerp(x, 0, lt);
        }

        el.style.transform =
          `translate3d(${(x * S).toFixed(2)}px,${(-y * S).toFixed(2)}px,${(z * S).toFixed(2)}px) ` +
          `rotateX(${(-rx).toFixed(5)}rad) rotateY(${ry.toFixed(5)}rad) rotateZ(${(-rz).toFixed(5)}rad) ` +
          `scale(${scale.toFixed(4)})`;

        el.style.setProperty("--cas-o", opacity.toFixed(3));

        // Reels: only the SELECTION turns, and it turns all the time. The rule
        // used to be "spin whatever is near the centre, but only while the row
        // is moving", which meant the shelf sat perfectly still at rest and the
        // circles only came alive during a drag — reported as "the rings are
        // frozen until I drag". Everything else keeps a fixed angle, which is
        // also the cheapest state: one tape repaints its reel, nine do not.
        // (`--reel-spin` drives a `repeating-conic-gradient` rotation, i.e. a
        // full repaint of that reel, so it is written only when it changes.)
        if (!reduceMotion && hero.abs < 0.5) {
          const rate = rowBusy ? 0.9 + 0.5 * (1 - hero.abs) : 0.22;
          const spin = time * rate + tape.ring;
          tape.reelSpin = spin;
          el.style.setProperty("--reel-spin", spin.toFixed(4) + "rad");
        }

        el.style.zIndex = String(Math.round(30 - hero.abs * 2));
      }

      // DOM order == row order. A recycled tape keeps its node and its state
      // and is only moved in the tree, which is what lets the 3D stacking and
      // the paint order stay consistent across a step.
      const order = allTapes
        .slice()
        .sort(
          (a, b) =>
            clamp(slotIndex(a), -span, span) - clamp(slotIndex(b), -span, span),
        );
      if (order.some((tape, i) => track.children[i] !== tape.el)) {
        for (const tape of order) track.append(tape.el);
      }
    }

    /** Where a tape's intro rise starts: edge-on, below the frame, on its own
     *  slot's X. The reference holds X fixed for the whole climb. */
    function introFrom(tape: Tape, pos: number) {
      const shelf = shelfPose(pos);
      return {
        x: shelf.x,
        y: -6.25 - Math.abs(pos) * 0.055,
        z: -4.15 - Math.abs(pos) * 0.06,
        ry: pos >= 0 ? -Math.PI / 2 : Math.PI / 2,
      };
    }

    function introEnd() {
      return (
        RISE_START + (half + PARK_SLOTS) * 2 * RISE_STAGGER + RISE_DUR + PULL_DUR
      );
    }

    /* ══════════════════════════════════════════
       UI
       ══════════════════════════════════════════ */

    /** The selected tape's element. The selection is always a real tape —        `buildRing` and `recycle` both refuse to land on a blank. */
    const centreEl = () => (list.length ? list[current % list.length].el : null);

    function updateUI(force = false) {
      const el = centreEl();
      if (!el) return;

      // Count the ARCHIVE, not the scenery: `walkTo — walkFrom + 1` is the
      // filtered set, so a padded shelf still reads "05 tapes loaded".
      const total = walkTo - walkFrom + 1;

      const key = String(el.dataset.index) + "/" + String(total);
      if (!force && key === lastUiKey) return;
      lastUiKey = key;

      const pad = String(Number.parseInt(el.dataset.index ?? "1", 10) || 1);
      const idxEl = document.getElementById("shelf-current");
      if (idxEl) idxEl.textContent = pad;

      const totalEl = document.getElementById("shelf-total");
      if (totalEl) totalEl.textContent = String(total).padStart(2, "0");

      const hudState = document.getElementById("shelf-hud-state");
      if (hudState) {
        hudState.textContent =
          String(total).padStart(2, "0") + " " + (root.dataset.loadedLabel ?? "");
      }

      // Where the visitor is, so a language switch can land on the same record
      // instead of resetting the shelf to the first tape.
      try {
        sessionStorage.setItem(CARD_KEY, String(current - walkFrom));
      } catch {
        /* storage disabled */
      }

      const panel = document.getElementById("shelf-panel");
      const accent = el.style.getPropertyValue("--cas-accent");
      if (accent) panel?.style.setProperty("--cas-accent", accent);
      // ⚠️ The SOFT tint has to travel with it: the panel's INSPECT button wipes
      // to `--cas-accent-soft` on hover, and the panel is not inside the tape, so
      // it would otherwise fall back to `--accent-glow` (the theme amber) and the
      // hover colour would stop matching the record's own stripe.
      const accentSoft = el.style.getPropertyValue("--cas-accent-soft");
      if (accentSoft) panel?.style.setProperty("--cas-accent-soft", accentSoft);

      // The status colour belongs to the record, not to the copy: it flips
      // instantly, while the text waits for the blur swap.
      panel?.setAttribute("data-wip", el.dataset.wip ?? "0");

      const titleEl = document.getElementById("shelf-panel-title");
      const descEl = document.getElementById("shelf-panel-desc");
      const catEl = document.getElementById("shelf-panel-category");
      const statusEl = document.getElementById("shelf-panel-status");
      const dateEl = document.getElementById("shelf-panel-date");
      const tagsEl = document.getElementById("shelf-panel-tags");

      panel?.classList.add("is-changing");
      const token = ++uiToken;

      window.setTimeout(
        () => {
          if (token !== uiToken) return;

          if (titleEl) titleEl.textContent = el.dataset.title ?? "";
          if (descEl) descEl.textContent = el.dataset.desc ?? "";
          if (catEl) catEl.textContent = el.dataset.category || el.dataset.type || "";
          if (statusEl) statusEl.textContent = el.dataset.status ?? "";
          if (dateEl) dateEl.textContent = el.dataset.date ?? "";

          if (tagsEl) {
            let tags: string[] = [];
            try {
              tags = JSON.parse(el.dataset.tags || "[]");
            } catch {
              tags = [];
            }
            tagsEl.replaceChildren(
              ...tags.slice(0, 6).map((tag) => {
                const span = document.createElement("span");
                // ⚠️ The `#` is added HERE, not in the content: the tags are plain
                // data (`Industrial Design`) and are reused as filter values by
                // exact string match, so the decoration must not reach them.
                span.textContent = `#${tag}`;
                return span;
              }),
            );
          }

          panel?.classList.remove("is-changing");
        },
        reduceMotion ? 0 : 170,
      );

      // Only the selected tape is a tab stop; the rest stay crawlable links.
      for (const item of realEls) {
        item.tabIndex = item === el ? 0 : -1;
      }

      const status = document.getElementById("shelf-status");
      if (status && introDone) {
        status.textContent = `${el.dataset.title ?? ""} —{pad}/${total}`;
      }
    }

    /* ══════════════════════════════════════════
       INTRO
       ══════════════════════════════════════════ */

    const introEl = document.getElementById("shelf-intro");

    /** Ring offset at which each tape's rung of the ladder starts. */
    let introAt = new Map<Tape, number>();

    /**
     * Tag-filter blend. `out` is 0→1 while the OLD row climbs away, `gap` is the
     * short beat with the stage empty, `in` is 1→0 while the NEW row rises; the
     * render loop reads the first two and the intro machinery owns the third.
     * ⚠️ They are module state rather than locals because the render loop has to
     * see them for the whole blend, and `rowBusy` has to include them or the loop
     * would go idle mid-transition and strand the row halfway out.
     */
    let filterOut = 0;
    let filterGap = 0;
    let filterOutStart = 0;
    let filterOutPending = false;
    let filterGapStart = 0;
    /** the tape list the next `buildRing` should seat, captured at click time */
    let filterPendingTapes: Tape[] = [];
    /** true while a swap owns the beat, so the intro's own finish is deferred */
    let filterHold = false;

    function startIntro(full: boolean) {
      introDone = false;
      root.classList.remove("is-ready");
      introEl?.classList.remove("is-done");

      // Left — right along the row, so the ladder sweeps in from the left. The
      // stagger is counted from the leftmost painted slot, not from the
      // selection, or the middle of the row would rise before its neighbours.
      introAt = new Map();
      for (const tape of allTapes) {
        const order = clamp(slotIndex(tape), -span, span) + span;
        introAt.set(tape, RISE_START + order * RISE_STAGGER);
      }

      introT0 = performance.now();
      introDuration = introEnd();

      if (!full || reduceMotion) {
        introT0 = performance.now() - introEnd() - CURTAIN_FADE - 400;
      }
    }

    /**
     * The INBOUND half of a tag swap: the intro's rise, without the curtain.
     *
     * ⚠️ Not `startIntro(false)`: that path back-dates `introT0` past the whole
     * sequence so the rise never plays at all (it exists to skip the intro for a
     * reduced-motion or already-warm visitor). The rise is exactly what a filter
     * swap wants, so this stages the same ladder with a fresh `introT0` and leaves
     * `is-done` ON the curtain — an already-hidden element stays hidden, and no
     * black frame is introduced.
     */
    function startRiseIn() {
      introAt = new Map();
      for (const tape of allTapes) {
        const order = clamp(slotIndex(tape), -span, span) + span;
        introAt.set(tape, RISE_START + order * RISE_STAGGER);
      }
      introDone = false;
      root.classList.remove("is-ready");
      introT0 = performance.now();
      introDuration = introEnd();
      introEl?.classList.add("is-done");
    }

    function finishIntro() {
      if (introDone) return;
      introDone = true;
      filterHold = false;
      filterPendingTapes = [];
      root.classList.add("is-ready");
      introEl?.classList.add("is-done");
      try {
        sessionStorage.setItem("rrsuika-shelf-intro-seen", "1");
      } catch {
        /* storage disabled */
      }
      updateUI(true);
    }

    function skipIntro() {
      if (introDone) return;
      introT0 = performance.now() - introEnd() - 4000;
      finishIntro();
    }

    root.addEventListener("pointerdown", () => {
      if (!introDone) skipIntro();
    });

    /* ══════════════════════════════════════════
       POINTER — drag the row
       ══════════════════════════════════════════ */

    stage.addEventListener("dragstart", (event) => event.preventDefault());

    /* ⚠️ Right-click is off for the whole page, not just the stage (2026-09-19:
       "在这两个界面禁用鼠标复制或右键"). These six pages are drag surfaces: a
       context menu that opens mid-gesture strands the pointer and the row, and
       nothing on the page is meant to be copied. Together with `user-select: none`
       on `.shelf-page` this is what stops a slightly-missed drag from turning into
       a text selection. */
    page.addEventListener("contextmenu", (event) => event.preventDefault());

    stage.addEventListener("pointerdown", (event) => {
      if (launching || lock || !introDone) return;
      if (
        (event.target as HTMLElement).closest(
          ".shelf-nav, .shelf-open",
        )
      ) {
        return;
      }

      pointerDown = true;
      dragging = false;
      dragMoved = false;
      dragAnchor = event.clientX;
      dragOffset = 0;
      dragOffsetStart = progress;
      dragSamples = [{ x: event.clientX, t: performance.now() }];

      // Any in-flight motion is cancelled and taken over from where it is.
      spring.active = false;
      snap.active = false;
      spring.velocity = 0;
      spring.value = progress;

      try {
        stage.setPointerCapture?.(event.pointerId);
      } catch {
        /* synthetic or already-released pointer — capture is optional */
      }
    });

    stage.addEventListener("pointermove", (event) => {
      const rect = stage.getBoundingClientRect();
      hoverX = (event.clientX - rect.left) / rect.width - 0.5;

      if (!pointerDown || launching || lock) return;

      // The pointer's TOTAL travel, not its offset from the last frame: the row
      // is a continuous function of it, so a slow drag of three slots' worth of
      // pixels walks three tapes.
      //
      // ⚠️ The sign, stated once so it stops drifting: `dragOffset` grows as the
      // pointer moves RIGHT, `progress` grows with it, and `slotIndex` grows with
      // `progress` — so a rightward drag carries the row rightward, under the
      // pointer, as it should. The tape that arrives at the centre is therefore
      // the one with a LOWER ring index (`current − progress`), which is what
      // `settleDrag` has to land on.
      dragOffset = event.clientX - dragAnchor;
      const distance = dragOffset;

      // ⚠️ The engage threshold is small (4px) on purpose: the row now follows
      // the pointer continuously, so a 9px dead zone would read as the tape
      // sticking before it starts to move.
      if (Math.abs(distance) > 4 && !dragging) {
        dragging = true;
        dragMoved = true;
        stage.classList.add("is-dragging");
      }

      if (!dragging) return;

      const now = performance.now();
      dragSamples.push({ x: event.clientX, t: now });
      dragSamples = dragSamples.filter((s) => now - s.t <= VELOCITY_WINDOW);

      // ⚠️ The whole travel is used, and one slot is a fixed metric distance, so
      // a long slow drag walks the row one tape per `SLOT_DRAG()` px instead of
      // being clamped at a single slot. The clamp is only the archive's edge.
      // ⚠️ The clamp is `±DRAG_MAX` slots, not the archive's edge and not ±1.
      // Clamping at `walkFrom - current` looked right and was not: on the first
      // tape that difference is 0, so the row could not be dragged at all in that
      // direction — the pointer moved and nothing happened. And ±1 is the *base*
      // step only: the throw is added on top, so the drag has to be able to hold
      // the row a little past the next slot for a hard flick to be distinguishable
      // from a gentle one. Beyond `DRAG_MAX` the row stops — that is the archive
      // answering, not a bug.
      const slot = SLOT_DRAG();
      const raw = dragOffsetStart + dragOffset / slot;
      progress = clamp(raw, -DRAG_MAX, DRAG_MAX);
      spring.value = progress;

      // Release velocity for the flick handoff, in slots per second. Same
      // window as before, but divided by the slot metric rather than the old
      // viewport fraction, so the number means the same thing as `progress`.
      spring.velocity = sampleVelocity(slot);
    });

    stage.addEventListener("pointerup", (event) => {
      if (!pointerDown) return;
      pointerDown = false;
      try {
        stage.releasePointerCapture?.(event.pointerId);
      } catch {
        /* nothing captured */
      }

      if (!dragMoved) {
        dragging = false;
        stage.classList.remove("is-dragging");
        return;
      }

      settleDrag();
    });

    stage.addEventListener("pointercancel", () => {
      if (pointerDown) settleDrag();
    });

    /* Suppress the click that ends a drag — without this, releasing on a tape
       navigates to its detail page. Capture phase, so it lands before the link
       logic below. */
    track.addEventListener(
      "click",
      (event) => {
        if (dragMoved) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );

    /* Horizontal wheel / trackpad swipe. Vertical scroll is left alone, and
       the accumulator is locked out while a step is animating so one gesture
       cannot queue several steps. */
    let wheelAcc = 0;
    let wheelReset = 0;
    stage.addEventListener(
      "wheel",
      (event) => {
        if (launching || lock || !introDone) return;
        if (Math.abs(event.deltaX) < 8) return;
        if (Math.abs(event.deltaX) < Math.abs(event.deltaY) * 1.5) return;

        event.preventDefault();

        const now = performance.now();
        if (now - wheelReset > 280) wheelAcc = 0;
        wheelReset = now;
        wheelAcc += event.deltaX;

        if (Math.abs(wheelAcc) > 190) {
          const direction: 1 | -1 = wheelAcc > 0 ? 1 : -1;
          wheelAcc = 0;
          navigate(direction);
        }
      },
      { passive: false },
    );

    /* ══════════════════════════════════════════
       CLICK — detail transition
       ══════════════════════════════════════════ */

    function launch(url: string) {
      if (launching || !introDone) return;

      if (reduceMotion) {
        window.location.href = url;
        return;
      }

      launching = true;
      launchT0 = performance.now();
      root.classList.add("is-launching");

      window.setTimeout(() => {
        window.location.href = url;
      }, LAUNCH_DUR - 130);
    }

    track.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(".cas");
      if (!link) return;

      // Modifier clicks and non-primary buttons keep native behaviour.
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        (event as MouseEvent).button !== 0
      ) {
        return;
      }

      event.preventDefault();
      if (launching || !introDone) return;

      // Clicking a neighbour selects it; clicking the centre opens it; clicking
      // a blank cassette is a no-op — it is scenery.
      if (link !== centreEl()) {
        const tape = allTapes.find((t) => t.el === link);
        if (!tape || tape.empty) return;
        const sink = slotIndex(tape);
        if (sink > 0.05) navigate(1);
        else if (sink < -0.05) navigate(-1);
        return;
      }

      const url = link.getAttribute("href");
      if (url) launch(url);
    });

    document.getElementById("shelf-open")?.addEventListener("click", () => {
      const url = centreEl()?.getAttribute("href");
      if (url) launch(url);
    });

    /* ══════════════════════════════════════════
       CONTROLS
       ══════════════════════════════════════════ */

    document
      .getElementById("shelf-prev")
      ?.addEventListener("click", () => navigate(-1));
    document
      .getElementById("shelf-next")
      ?.addEventListener("click", () => navigate(1));

    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        navigate(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        navigate(1);
      }
    });

    /* ══════════════════════════════════════════
       TAG FILTER — re-slot in place, no curtain
       ══════════════════════════════════════════ */

    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>("#shelf-tag-bar .tag-chip"),
    );

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        if (launching) return;

        const tag = chip.dataset.tag || "";
        for (const c of chips) c.classList.remove("active");
        chip.classList.add("active");

        const previous = centreEl();
        const matched = tag
          ? realEls
              .map((el) => allTapes.find((tape) => tape.el === el))
              .filter((tape): tape is Tape => {
                if (!tape) return false;
                try {
                  return (
                    JSON.parse(tape.el.dataset.tags || "[]") as string[]
                  ).includes(tag);
                } catch {
                  return false;
                }
              })
          : allTapes.filter((tape) => !tape.empty);

        // ⚠️ Two beats, not a teleport. The outgoing row climbs out through the
        // top with `filterOut` driving BOTH the world-Y lift and the row-wide fade,
        // then `buildRing` re-seats the matched tapes and `startRiseIn` runs the
        // intro's ladder on them. Still no curtain and no re-decode: the covers are
        // already in the DOM, so nothing goes black — the row simply leaves and the
        // replacement arrives.
        void previous;
        if (reduceMotion) {
          buildRing(matched);
          return;
        }
        // A filter clicked while a swap is already running lands immediately: the
        // row is either mid-exit (still whole) or already rebuilt, and both are
        // valid states to cut from.
        filterOutPending = true;
        filterPendingTapes = matched;
        filterOutStart = performance.now();
        filterOut = 0;
        filterGap = 0;
        filterHold = false;
        // `lock` blocks a second gesture for the length of the blend; `finishIntro`
        // releases it through `recycle`/`updateUI` on the new ring.
        lock = true;
      });
    }

    /* ══════════════════════════════════════════
       MODE + RESIZE
       ══════════════════════════════════════════ */

    function resolveMode() {
      const supports3d =
        typeof CSS !== "undefined" &&
        CSS.supports?.("transform-style", "preserve-3d");
      const narrow = window.matchMedia("(max-width: 860px)").matches;
      return !supports3d || narrow ? "flat" : "3d";
    }

    function applyMode() {
      const next = resolveMode();

      const panel = document.getElementById("shelf-panel");
      if (panel) {
        panel.style.removeProperty("--cas-accent");
        panel.style.removeProperty("--cas-accent-soft");
        const centre = centreEl();
        const accent = centre?.style.getPropertyValue("--cas-accent");
        if (accent) panel.style.setProperty("--cas-accent", accent);
        const accentSoft = centre?.style.getPropertyValue("--cas-accent-soft");
        if (accentSoft) panel.style.setProperty("--cas-accent-soft", accentSoft);
      }

      if (next === mode) return;
      mode = next;
      page.dataset.mode = mode;

      reseat(true);
      measure();
    }

    let resizeRaf = 0;
    function onResize() {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = 0;
        applyMode();
        measure();
      });
    }

    /* ══════════════════════════════════════════
       LOOP — paused off-screen and on hidden tabs
       ══════════════════════════════════════════ */

    let visible = true;

    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries.some((e) => e.isIntersecting);
        if (visible) start();
      },
      { threshold: 0 },
    );
    observer.observe(root);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) start();
    });

    function start() {
      if (running) return;
      running = true;
      requestAnimationFrame(loop);
    }

    /**
     * Restart the loop if it has stopped while the shelf is on screen and the tab
     * is visible. Deliberately dumb: the loop is the only thing that can move the
     * shelf, so a stall is never the desired state, and re-entering it when it was
     * already going to run is a no-op (`start` is guarded by `running`).
     *
     * ⚠️ Uses `setTimeout`, not rAF: an rAF-throttled probe cannot observe a state
     * in which rAF has been taken away. One pending timer at a time.
     */
    let watchDogTimer = 0;
    function watchDog() {
      if (watchDogTimer) return;
      watchDogTimer = window.setTimeout(() => {
        watchDogTimer = 0;
        if (document.hidden) return;
        // Re-derive "on screen" from the element rather than trusting `visible`.
        const r = root.getBoundingClientRect();
        const onScreen = r.bottom > 0 && r.top < window.innerHeight && r.width > 0;
        if (onScreen) {
          visible = true;
          start();
        }
      }, 250);
    }

    function loop(now: number) {
      running = false;
      // ⚠️ Stopping here is only safe because EVERY stop is recoverable: a tab
      // coming back fires `visibilitychange`, and an off-screen shelf coming back
      // fires the IntersectionObserver. What is NOT recoverable is `visible` being
      // wrong while nothing changes — the observer only calls back on a CHANGE of
      // state, so one spurious `isIntersecting: false` (measured in headless during
      // a tag swap, 2026-09-20) parked the loop for good and the swap froze
      // half-way. `watchdog` below is the belt to that pair of braces.
      if (!visible || document.hidden) {
        watchDog();
        return;
      }

      renderFrame(now);

      // ⚠️ `filterHold` defers this: `startRiseIn` stages a fresh intro sequence,
      // and for the length of the gap beat `introDone` is still true from the
      // PREVIOUS intro — letting the normal finish run first would bank a `1` and
      // the incoming row would never be allowed to settle.
      if (!filterHold && !introDone && now - introT0 >= introDuration + CURTAIN_FADE) {
        finishIntro();
      }

      if (launching && now - launchT0 >= LAUNCH_DUR) return;

      running = true;
      requestAnimationFrame(loop);
    }

    /* ══════════════════════════════════════════
       BOOT
       ══════════════════════════════════════════ */

    mode = resolveMode();
    page.dataset.mode = mode;

    // The blank cassettes live in their own store at the end of the track so
    // the real markup stays readable. They are scenery: no link, no copy, and
    // they never enter the walkable range.
    const blankStore = root.querySelector<HTMLElement>("[data-fillers]");
    const blankEls = blankStore
      ? Array.from(blankStore.querySelectorAll<HTMLAnchorElement>(".cas"))
      : [];
    for (const el of blankEls) {
      el.removeAttribute("href");
      el.setAttribute("aria-hidden", "true");
      el.tabIndex = -1;
      el.dataset.empty = "1";
    }

    const makeTape = (
      el: HTMLAnchorElement,
      empty: boolean,
    ): Tape => ({
      el,
      ring: -1,
      vis: 0,
      empty,
      reelSpin: 0,
      hidden: false,
      depth: -1,
    });

    blankTapes = blankEls.map((el) => makeTape(el, true));
    allTapes = [...realEls.map((el) => makeTape(el, false)), ...blankTapes];

    measure();
    buildRing(allTapes.filter((tape) => !tape.empty));

    // A language switch is a full page load that lands on a different URL, so
    // the only thing that carries across is what we store: the record the
    // visitor was looking at. Restoring it keeps the shelf where it was
    // instead of snapping back to the first tape.
    //
    // ⚠️ Read it HERE, before anything else can run. `buildRing` calls
    // `updateUI`, and `updateUI` is what WRITES this key — so a read placed
    // after the ring is built reads back the value the boot itself just wrote,
    // which is always "0". That is a silent reset on every language switch.
    if (restored >= 0 && restored <= walkTo - walkFrom) {
      current = walkFrom + restored;
      reseat(true);
      updateUI(true);
    }

    // The curtain is a first-visit moment only. A return visit — including the
    // one a language switch causes — lifts it on the first frame, so the shelf
    // never flashes black at a visitor who has already seen it. A tag filter
    // does not start an intro at all.
    const fullIntro = !warm && mode === "3d" && !reduceMotion;

    measure();
    startIntro(fullIntro);
    measure();
    start();
    // ⚠️ `startIntro` also arms the *curtain*, which the intro now covers: on a
    // load where the site intro is playing, the shelf's own entrance would run
    // unseen underneath it and be over before the paper opens. Layout exposes
    // `__rrsIntroGate` for exactly this — hold the shelf's entrance until the
    // intro has opened, then play it. With no gate (every other load) this is a
    // resolved promise and nothing changes.
    const introGate = (window as typeof window & { __rrsIntroGate?: Promise<void> }).__rrsIntroGate;
    if (introGate) introGate.then(() => startIntro(fullIntro));

    window.addEventListener("resize", onResize);
    window.addEventListener("orientationchange", onResize);
  })();
</script>