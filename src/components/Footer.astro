---
import { getLanguageFromPath, getLocalizedPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const aboutPath = getLocalizedPath("/about", language);
---

<footer class="footer">
  <div class="footer-line">
    <div class="tri-color">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="system">
      {t.footer.system}
    </div>

    <div class="status">
      {t.footer.status}
      <span>{t.footer.online}</span>
    </div>
  </div>

  <div class="footer-main">
    <div class="identity">
      <h3>RrSuika_STUDIO</h3>

      <p>
        {t.footer.identity}
      </p>

      <div class="meta">
        <div>
          <span class="meta-label">{t.footer.location}</span>
          <strong> ROTTERDAM // NL </strong>
        </div>

        <div>
          <span class="meta-label">{t.footer.statusLabel}</span>
          <strong class="green">
            {t.footer.operational}
          </strong>
        </div>

        <div>
          <span class="meta-label">{t.footer.version}</span>
          <strong> 2026.V8.16 </strong>
        </div>
      </div>
    </div>

    <div class="links">
      <div class="title">
        {t.footer.uplink}
      </div>

      <a
        href="https://github.com/RrSuika"
        target="_blank"
        rel="noopener noreferrer"
      >
        &gt; {t.footer.github}
      </a>

      <a href="mailto:ranrsuika@gmail.com">
        &gt; {t.footer.email}
      </a>

      <a
        href="https://www.pixiv.net/users/71884225"
        target="_blank"
        rel="noopener noreferrer"
      >
        &gt; {t.footer.pixiv}
      </a>

      <div class="qq">&gt; QQ: 2385568240</div>

      <div class="qq">&gt; Discord: rrsuika</div>

      <a href={aboutPath}>
        &gt; {t.footer.about}
      </a>
    </div>

    <div class="barcode"></div>
  </div>

  <div class="copyright">
    <span>
      © {new Date().getFullYear()} RrSuika Studio
    </span>

    <span>
      {t.footer.copyright}
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);

    border-top: 1px solid var(--border);

    background: var(--surface-footer);

    font-family: var(--font-mono);

    color: #aaa;

    transition: background 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }

  :root[data-theme="light"] .footer {
    background: var(--paper);
    box-shadow: var(--shadow-paper);
    color: var(--text-dim);
  }
  :root[data-theme="light"] .footer .system { color: var(--accent-deep); }
  :root[data-theme="light"] .footer .identity h3 { color: var(--text-bright); }
  :root[data-theme="light"] .footer .identity p { color: var(--text-dim); }
  :root[data-theme="light"] .footer .links a { color: var(--text-dim); }
  :root[data-theme="light"] .footer .links a:hover { color: var(--accent); }
  :root[data-theme="light"] .footer .qq { color: var(--text-dim); }
  :root[data-theme="light"] .footer .qq:hover { color: var(--accent); }
  :root[data-theme="light"] .footer .copyright { color: #888; }
  :root[data-theme="light"] .footer .meta strong { color: #333; }
  :root[data-theme="light"] .footer .green { color: #00703c !important; }
  /* barcode light-mode styling lives in global.css §11
     (dark #333 bars) — a component-level invert here would
     flip them back to near-white and make them invisible */

  .footer-line {
    height: 70px;

    border-bottom: 1px solid var(--border);

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 40px;

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-label);
  }

  .tri-color {
    display: flex;

    width: 90px;

    height: 8px;
  }

  .tri-color span {
    flex: 1;
    animation: triBreathe 4s var(--ease-in-out) infinite;
  }

  .tri-color span:nth-child(1) {
    background: var(--stripe-red);
    animation-delay: 0s;
  }

  .tri-color span:nth-child(2) {
    background: var(--stripe-yellow);
    animation-delay: 0.4s;
  }

  .tri-color span:nth-child(3) {
    background: var(--stripe-teal);
    animation-delay: 0.8s;
  }

  @keyframes triBreathe {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; }
  }

  .system {
    color: var(--accent);

    font-weight: bold;
  }

  .status span {
    color: var(--terminal-green);

    font-weight: bold;
  }

  .footer-main {
    position: relative;

    max-width: var(--container-wide);

    margin: auto;

    padding: 60px 40px;

    display: flex;

    justify-content: space-between;

    gap: 60px;
  }

  .identity h3 {
    font-size: 32px;

    font-weight: 900;

    letter-spacing: var(--tracking-slight);

    color: var(--text);

    margin-bottom: 12px;
  }

  .identity p {
    font-size: var(--text-scale-xs);

    color: #888;
  }

  .meta {
    margin-top: 30px;

    display: flex;

    flex-direction: column;

    gap: 10px;

    font-size: var(--text-scale-2xs);
  }

  .meta > div {
    display: grid;
    grid-template-columns: 10ch 1fr;
  }

  .meta-label {
    text-align: right;
    padding-right: 0.5ch;
  }

  .meta strong {
    color: var(--text);
  }

  .green {
    color: var(--terminal-green) !important;
  }

  .links {
    display: flex;

    flex-direction: column;

    gap: 15px;

    min-width: 180px;
  }

  .links .title {
    color: var(--accent);

    font-size: var(--text-scale-2xs);

    font-weight: bold;

    margin-bottom: 10px;
  }

  .links a {
    color: #ccc;

    font-size: var(--text-scale-xs);

    transition:
      color 0.2s var(--ease-out),
      transform 0.3s var(--spring-snappy);
  }

  .links a:hover {
    color: var(--accent);

    transform: translateX(6px);
  }

  .links a:active {
    transform: scale(0.94);
    transition: transform 0.08s var(--spring-snappy);
  }

  .qq {
    color: #ccc;

    font-size: var(--text-scale-xs);

    transition: color 0.2s var(--ease-out);
  }

  .qq:hover {
    color: var(--accent);
  }

  .barcode {
    position: absolute;

    left: 42px;

    bottom: 15px;

    width: 125px;

    height: 45px;

    opacity: 0.3;

    background: repeating-linear-gradient(
      90deg,
      var(--text-bright) 0px,
      var(--text-bright) 1px,
      transparent 1px,
      transparent 4px,
      var(--text-bright) 4px,
      var(--text-bright) 7px,
      transparent 7px,
      transparent 8px,
      var(--text-bright) 8px,
      var(--text-bright) 9px,
      transparent 9px,
      transparent 12px,
      var(--text-bright) 12px,
      var(--text-bright) 15px,
      transparent 15px,
      transparent 17px,
      var(--text-bright) 17px,
      var(--text-bright) 18px,
      transparent 18px,
      transparent 23px,
      var(--text-bright) 23px,
      var(--text-bright) 26px,
      transparent 26px,
      transparent 28px,
      var(--text-bright) 28px,
      var(--text-bright) 30px,
      transparent 30px,
      transparent 35px,
      var(--text-bright) 35px,
      var(--text-bright) 36px,
      transparent 36px,
      transparent 38px,
      var(--text-bright) 38px,
      var(--text-bright) 42px,
      transparent 42px,
      transparent 43px,
      var(--text-bright) 43px,
      var(--text-bright) 46px,
      transparent 46px,
      transparent 50px,
      var(--text-bright) 50px,
      var(--text-bright) 52px,
      transparent 52px,
      transparent 54px,
      var(--text-bright) 54px,
      var(--text-bright) 58px,
      transparent 58px,
      transparent 60px
    );
  }

  .copyright {
    border-top: 1px dashed var(--border);

    max-width: var(--container-wide);

    margin: auto;

    padding: 25px 40px;

    display: flex;

    justify-content: space-between;

    font-size: var(--text-scale-3xs);

    color: #666;

    letter-spacing: var(--tracking-label);
  }

  @media (max-width: 800px) {
    .footer-line {
      padding: 0 20px;

      flex-direction: column;

      height: auto;

      gap: 15px;

      padding-top: 20px;

      padding-bottom: 20px;
    }

    .footer-main {
      padding: 40px 20px;

      flex-direction: column;
    }

    .barcode {
      position: static;
    }

    .copyright {
      padding: 20px;

      flex-direction: column;

      gap: 10px;
    }
  }
</style>
