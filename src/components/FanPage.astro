---
/**
 * FanPage.astro — the standalone `/fan/` single page.
 *
 * A fan-facing page for the studio's artwork, styled after the pink-and-blue
 * print language of a game event board (参考: `Downloads/粉色参考/`). It is its own
 * route with its OWN complete look:
 *
 *   ⚠️ **ONE theme, on purpose.** The visitor asked for a single fixed style
 *   rather than a light/dark pair (「该界面只有一个风格而不是分 light / dark
 *   mode」). The site's theme attribute is still on `<html>` and still drives the
 *   navbar and footer, so the page overrides the theme tokens on `.fan-root`
 *   instead of trying to disable the switch — the site keeps working if the
 *   visitor flips the theme elsewhere and comes back.
 *
 *   ⚠️ **No `--accent*` override.** The amber accent also feeds the skip link and
 *   focus rings, which are not drawn by this page. Overriding the surface and
 *   text tokens is enough, and anything this page draws sets its own colours.
 *
 *   ⚠️ The two colours do different jobs and must not blur: pink is the SURFACE
 *   (backgrounds, cards, the air between things) and blue is the SIGNAL (buttons,
 *   numbers, the one line that points somewhere). The moment both are used for
 *   surfaces the page goes flat and the CTA stops reading as an event.
 */
import Layout from "../layouts/Layout.astro";
import FanMosaic from "./FanMosaic.astro";
import {
  getLanguageFromPath,
  getLocalizedPath,
  type Language,
} from "../utils/i18n";
import { getArtImages } from "../utils/artImages";
import { fanCopy, getFanLanguage } from "../utils/fan";

interface Props {
  /** the route's own language; `/nl/fan/` is served from this component too */
  language?: Language;
}

const urlLanguage = getLanguageFromPath(Astro.url.pathname);
const language = (Astro.props as Props).language ?? urlLanguage;
const ui = getFanLanguage(language);
const c = fanCopy[ui];
const isZh = ui === "zh";

/* ── the gallery: the studio's real artwork, discovered the same way the
      frozen /art pages discover it (shared source, no second manifest) ── */
/**
 * ⚠️ The `code` is printed on every plate, so it has to come from the plate's own
 * category. The first version cycled a fake `DP-EX-1/2/3` per index, which read
 * as a game stage the visitor could go and unlock.
 */
/**
 * ⚠️ "product-posters" is deliberately absent. Those plates are product renders,
 * and this is a fan page for the drawings — asked to come out
 * (「不需要展示 Product Posters 以及他的图片」). Dropping the folder here is the whole
 * change: the row list is built from these keys, so the folder stops getting a
 * row, and no second filter has to be kept in sync with this one.
 *
 * Labels live in the copy file per language (`c.categories`), because a row
 * heading is prose while an archive code is not. This map holds the code.
 */
const CATEGORIES: Record<string, { code: string }> = {
  illustrations: { code: "ILL" },
  "fashion-design": { code: "FSH" },
  "food-art": { code: "FOD" },
};

/**
 * Per-language titles. `cn` is the Chinese name of the subject; the Chinese page
 * reads it and falls back to `en`, so a missing one can never blank a title.
 *
 * ⚠️ `cn` values come from the drawings themselves where they could be checked
 * (Ceobe's hat and axe, Rossi's red fox hood and pigtails) and from the official
 * character names otherwise. Two are marked `guess` in the comment because the
 * filenames and the old titles did not agree — a wrong character name on an
 * artist's own portfolio is worse than leaving the English one.
 */
const TITLE_MAP: Record<string, Record<string, { en: string; cn: string }>> = {
  illustrations: {
    "01-xiaoke": { en: "Ceobe", cn: "刻俄柏" },
    "02-palasi": { en: "Pallas", cn: "帕拉斯" },
    "03-taojinniang": { en: "Myrtle", cn: "桃金娘" },
    "04-gua": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "05-aiyafala": { en: "Eyjafjalla", cn: "艾雅法拉" },
    "06-susuluo": { en: "Sussurro", cn: "苏苏洛" },
    // guess: the filename says Mofazhumi, the old title said Magic Piggy
    "07-mofazhumi": { en: "Magic Piggy", cn: "魔法猪咪" },
    "08-pepe": { en: "Pepe", cn: "佩佩" },
    "09-rossi": { en: "Rossi", cn: "洛茜" },
  },
  // four outfits for one character, so they share a name and the archive code
  // (FSH-01..04) is what tells them apart
  "fashion-design": {
    "01-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "02-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "03-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "04-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
  },
  "food-art": {
    "01-seven-color-yokan": { en: "Seven-Color Yōkan", cn: "七色羊羹" },
    "02-niten-ichiryu": { en: "Niten Ichi-ryū", cn: "二天一流" },
    "03-wellington-steak": { en: "Wellington Steak", cn: "惠灵顿牛排" },
    // guess: a literal reading of the English title
    "04-unconscious-mousse": { en: "Unconscious Monster Mousse", cn: "无意识怪物慕斯" },
    "05-tricolor-icecream": { en: "Kedama Tricolor Ice Cream", cn: "毛玉三色冰淇淋" },
    "06-burnt-pudding": { en: "Burnt Pudding", cn: "焦糖布丁" },
  },
};

function titleFromFilename(folder: string, filename: string): string {
  const key = filename.replace(/\.[^.]+$/, "");
  const mapped = TITLE_MAP[folder]?.[key];
  if (mapped) return ui === "zh" ? mapped.cn : mapped.en;
  let name = filename
    .replace(/^.*[\\/]/, "")
    .replace(/\.(png|jpe?g|webp)$/i, "");
  name = name.replace(/^\d+[-_]/, "");
  name = name.replace(/[-_]/g, " ");
  return name.replace(/\b\w/g, (ch) => ch.toUpperCase());
}

interface Plate {
  src: string;
  title: string;
  folder: string;
  category: string;
  index: string;
  /** the printed archive code, e.g. `ILL-03` */
  code: string;
}

const all = getArtImages();

/** How many plates each folder has contributed so far, for the code's number. */
const emitted: Record<string, number> = {};

const plates: Plate[] = all.map((image, i) => {
  const meta = CATEGORIES[image.folder];
  emitted[image.folder] = (emitted[image.folder] ?? 0) + 1;
  return {
    src: image.src,
    title: titleFromFilename(image.folder, image.filename),
    folder: image.folder,
    category: meta?.[ui] ?? meta?.en ?? image.folder,
    index: String(i + 1).padStart(2, "0"),
    code: `${meta?.code ?? "PLT"}-${String(emitted[image.folder]).padStart(2, "0")}`,
  };
});

/* One row per folder that actually has artwork, so an empty folder leaves no
   空 row behind — same rule as the /art pages. */
/**
 * `copies` is how many times the row's own items are repeated to build one
 * seamless loop, and it is a function of the VIEWPORT, not a fixed number.
 *
 * ⚠️ The /art page uses `max(3, ceil(12 / n))` and that is wrong here: it paints
 * the collection three times over, so the longest row showed the same nine
 * drawings repeated across the whole screen once (measured 27 cards / 5517 px
 * against a 1132 px viewport).
 *
 * The loop works because `trackWidth = copies × (card + gap) − gap`, so one
 * period is exactly `copies × (card + gap)`. That is why the card box, not
 * `clientWidth`, has to appear in the margin below — the slack has to cover the
 * gap that the last copy does not have. */
const ROW_ITEM_W = 216; // plate width + the row gap, in px (see .plate / .row-track)
const ROW_VIEW_W = 1600; // widest viewport the loop has to cover

const rows = Object.keys(CATEGORIES)
  .map((folder) => ({
    folder,
    label: c.categories[folder] ?? folder,
    items: plates.filter((p) => p.folder === folder),
  }))
  .filter((row) => row.items.length > 0)
  .map((row) => ({
    ...row,
    // two copies is the floor: one copy cannot loop at all
    // ⚠️ A floor of THREE, not two. With two copies the track is only one
    // period wider than the viewport, so at the moment the modulo fires there is
    // no room left and the seam is on screen — reported as the right-hand images
    // "flashing to the left to restart". Three copies means the wrap always lands
    // on identical pixels.
    copies: Math.max(3, Math.ceil(ROW_VIEW_W / (row.items.length * ROW_ITEM_W)) + 2),
  }));

/**
 * The decoration set, lifted from the reference deck: a four-point star, a
 * four-point sparkle, a curled flourish, a lightning bolt and a looped wave.
 * Every one is bare path data — no asset to fetch, nothing to block on.
 *
 * ⚠️ These are DECORATION. They never carry text a screen reader needs, they are
 * `aria-hidden` and `pointer-events: none`, and they never use blue as a fill.
 */
/**
 * The motifs, all inside a `0 0 24 24` box. Each entry is `[path, stroke?]` —
 * `stroke: true` means the path is a line to be drawn, not a shape to be filled.
 *
 * ⚠️ EVERY coordinate must stay inside 0..24. The old `curl` ran to 26 and shipped
 * with one side sliced off, which is exactly the kind of bug a viewBox hides.
 */
const ORN_PATHS: Record<string, { d: string; stroke?: boolean }> = {
  // the reference's dominant motif: a four-point sparkle with concave sides
  sparkle: { d: "M12 1 C13 8 16 11 23 12 C16 13 13 16 12 23 C11 16 8 13 1 12 C8 11 11 8 12 1 Z" },
  // the chunky star
  star: { d: "M12 2 L14.6 9.4 L22 12 L14.6 14.6 L12 22 L9.4 14.6 L2 12 L9.4 9.4 Z" },
  // a small round dot, which is what the reference scatters between the sparkles
  dot: { d: "M12 4 a8 8 0 1 1 0 16 a8 8 0 1 1 0 -16 z" },
  // heart
  heart: { d: "M12 21 C4 15 2 11 4 7.5 A5 5 0 0 1 12 5.5 A5 5 0 0 1 20 7.5 C22 11 20 15 12 21 Z" },
  // sun: a disc with eight rays
  sun: { d: "M12 7 a5 5 0 1 1 0 10 a5 5 0 1 1 0 -10 z M12 1 v3 M12 20 v3 M1 12 h3 M20 12 h3 M4.2 4.2 l2.1 2.1 M17.7 17.7 l2.1 2.1 M19.8 4.2 l-2.1 2.1 M6.3 17.7 l-2.1 2.1" },
  // cloud
  cloud: { d: "M6 18 a4 4 0 0 1 0 -8 a5 5 0 0 1 9.5 -1.5 a4.5 4.5 0 0 1 2.5 9.5 z" },
  // rainbow: three nested arcs, drawn as strokes
  rainbow: { d: "M3 19 a9 9 0 0 1 18 0 M6.5 19 a5.5 5.5 0 0 1 11 0 M10 19 a2 2 0 0 1 4 0", stroke: true },
  // bubble: a ring with a highlight
  bubble: { d: "M12 3 a9 9 0 1 1 0 18 a9 9 0 1 1 0 -18 z M8.5 8.5 a5 5 0 0 1 5 -2", stroke: true },
  // the squiggle, kept inside the box this time
  squiggle: { d: "M2 15 C5 8 8 8 11 15 C14 22 17 22 22 12", stroke: true },
  // a curled ribbon, also inside the box
  curl: { d: "M4 19 C4 10 14 10 14 17 C14 21 9 21 9 17.5 C9 15 14 15 17 12 C19 10 21 7 22 5", stroke: true },
};

/**
 * Where the loose ornaments sit in the hero, and in what colour. Hand-placed:
 * random scatter on a symmetrical key visual reads as noise.
 *
 * ⚠️ The colours are the page's OWN palette plus the two accents already approved
 * for it (gold on the crown, mint in the fruit). Pink stays the surface, blue stays
 * the signal; these are small marks, never fields.
 */
const INK = { magenta: "#f5308a", pink: "#ff6fa8", blue: "#1b25d8", gold: "#e0a92a", mint: "#2fb79a" };
const HERO_ORNS: { kind: string; x: string; y: string; size: number; turn: number; op: number; ink: string }[] = [
  // upper left
  { kind: "sparkle", x: "3%", y: "1%", size: 30, turn: -14, op: 1, ink: INK.magenta },
  { kind: "star", x: "11%", y: "11%", size: 16, turn: 10, op: 0.9, ink: INK.gold },
  { kind: "squiggle", x: "1%", y: "6%", size: 34, turn: -6, op: 0.6, ink: INK.magenta },
  { kind: "heart", x: "6%", y: "22%", size: 18, turn: -12, op: 0.85, ink: INK.pink },
  { kind: "rainbow", x: "14%", y: "2%", size: 28, turn: 0, op: 0.8, ink: INK.mint },
  { kind: "dot", x: "9%", y: "15%", size: 6, turn: 0, op: 0.7, ink: INK.blue },
  { kind: "sun", x: "20%", y: "19%", size: 20, turn: 0, op: 0.8, ink: INK.gold },
  { kind: "sparkle", x: "24%", y: "6%", size: 15, turn: 18, op: 0.8, ink: INK.blue },
  // upper middle, clear of the cloud
  { kind: "star", x: "31%", y: "2%", size: 11, turn: -8, op: 0.7, ink: INK.blue },
  { kind: "dot", x: "36%", y: "13%", size: 5, turn: 0, op: 0.6, ink: INK.gold },
  { kind: "sparkle", x: "67%", y: "3%", size: 17, turn: -12, op: 0.85, ink: INK.magenta },
  { kind: "dot", x: "72%", y: "15%", size: 6, turn: 0, op: 0.65, ink: INK.mint },
  // upper right
  { kind: "sparkle", x: "94%", y: "2%", size: 26, turn: 12, op: 0.95, ink: INK.blue },
  { kind: "bubble", x: "88%", y: "13%", size: 17, turn: 0, op: 0.75, ink: INK.blue },
  { kind: "star", x: "82%", y: "5%", size: 14, turn: -10, op: 0.85, ink: INK.magenta },
  { kind: "squiggle", x: "93%", y: "20%", size: 30, turn: 8, op: 0.6, ink: INK.mint },
  { kind: "sun", x: "78%", y: "22%", size: 24, turn: 0, op: 0.9, ink: INK.gold },
  { kind: "cloud", x: "85%", y: "28%", size: 22, turn: 0, op: 0.6, ink: INK.blue },
  { kind: "dot", x: "91%", y: "9%", size: 5, turn: 0, op: 0.6, ink: INK.pink },
  // lower band, flanking the wordmark
  { kind: "dot", x: "2%", y: "30%", size: 7, turn: 0, op: 0.6, ink: INK.mint },
  { kind: "curl", x: "5%", y: "33%", size: 30, turn: 0, op: 0.65, ink: INK.pink },
  { kind: "heart", x: "93%", y: "34%", size: 16, turn: 14, op: 0.75, ink: INK.pink },
  { kind: "sparkle", x: "88%", y: "37%", size: 19, turn: -16, op: 0.85, ink: INK.magenta },
  { kind: "curl", x: "74%", y: "33%", size: 26, turn: -6, op: 0.55, ink: INK.mint },
  { kind: "bubble", x: "13%", y: "35%", size: 14, turn: 0, op: 0.6, ink: INK.blue },
];

const enHref = getLocalizedPath("/fan/", "en");
const zhHref = getLocalizedPath("/fan/", "zh");
const artHref = getLocalizedPath("/art", language);
---

<Layout
  title={`${c.docTitle} | RrSuika Studio`}
  description={c.metaDescription}
  alternateHrefs={[
    { lang: "en", href: enHref },
    { lang: "zh-CN", href: zhHref },
  ]}
  noIndex
>
  <div class="fan-root" data-fan>
    <!-- The animated background. It is a direct child of .fan-root and
         `position: fixed` at z-index -1 — which is why `.fan-root` carries
         `isolation: isolate` and why `.fan-mosaic` is named in the
         `.fan-root > *:not(...)` list below. Both are load-bearing. -->
    <FanMosaic />

    <!-- The hero's pink sky, kept as its OWN layer so it can sit OVER the
         animated background instead of under it. See .fan-sky in the styles:
         the canvas covers .fan-root's background, so anything meant to be
         seen on top of the mosaic has to be a real element. -->
    <div class="fan-sky" aria-hidden="true"></div>

    <!-- ══════════ TOP BAR ══════════ -->
    <div class="fan-top">
      <a class="fan-back" href={artHref}>{c.back}</a>

      <div class="fan-langs" role="group" aria-label={c.langSwitchLabel}>
        <a
          class:list={["fan-lang", ui === "en" && "is-on"]}
          href={enHref}
          hreflang="en"
          aria-current={ui === "en" ? "true" : undefined}>EN</a
        >
        <a
          class:list={["fan-lang", ui === "zh" && "is-on"]}
          href={zhHref}
          hreflang="zh-CN"
          aria-current={ui === "zh" ? "true" : undefined}>中文</a
        >
      </div>
    </div>

    <!-- ══════════ PAGE RAIL ══════════
         The site hides its scrollbar by choice, and this page follows that rule.
         A page this long still needs to say where you are in it, so the position is
         drawn instead: a blue rail on the right, one colour (blue is the SIGNAL on
         this page) with a soft pink halo. It is decorative, so it is aria-hidden and
         it never takes a pointer event. `--fan-read` is the filled fraction. -->
    <div class="fan-rail" aria-hidden="true">
      <span class="fan-rail-fill"></span>
    </div>

    <!-- ══════════ HERO ══════════ -->
    <header class="fan-hero">
      <span class="hero-orn" aria-hidden="true">
        {
          HERO_ORNS.map((o) => (
            <i
              class="orn"
              style={`left:${o.x};top:${o.y};width:${o.size}px;height:${o.size}px;opacity:${o.op};color:${o.ink};transform:rotate(${o.turn}deg)`}
            >
              <svg viewBox="0 0 24 24" focusable="false">
                <path
                  class={ORN_PATHS[o.kind].stroke ? "orn-stroke" : "orn-fill"}
                  d={ORN_PATHS[o.kind].d}
                />
              </svg>
            </i>
          ))
        }
      </span>

      <div class="hero-blob" aria-hidden="true">
        {/* The cloud is ONE path: a scalloped top and a scalloped bottom,
            symmetric about x=120. Both the pink edge and the white inner line
            come from the same outline, which is what makes it read as printed
            rather than as three stacked discs. */}
        {/* ⚠️ ONE closed path, square viewBox, and every arc is `a r r 0 0 1 dx 0`
            so it is a half circle by construction. The previous silhouette was not
            closed: the last sweep ended short of the start point, which left a
            straight chord across the bottom-left — the visitor reported it as
            「他上面这朵云不完整」. `fill-rule: evenodd` on the outer path and the
            inner one in the SAME `d` punches the white centre out, which is also
            what removed the seagull-notch the old bottom arc drew. */}
                {/* ⚠️ Square viewBox, and it must STAY square. The path spans x 22..220 and
            y 47..183, so a tight viewBox (25 50 192 132) looks like the obvious
            tidy-up — and it STRETCHES the cloud badly, because `meet` then fills
            the width and scales the shape to 290x199, i.e. 1.34x wider than tall.
            The empty band under the silhouette is handled by the layout instead
            (`.hero-blob` pulls the following line up over it). */}
        <svg class="cloud" viewBox="0 0 242 242" focusable="false">
          <path
            class="cloud-body"
            d="M36 152 a28 28 0 0 1 6 -54 a32 32 0 0 1 46 -30 a40 40 0 0 1 66 0 a32 32 0 0 1 46 30 a28 28 0 0 1 6 54 a22 22 0 0 1 -30 6 a26 26 0 0 1 -40 0 a26 26 0 0 1 -40 0 a22 22 0 0 1 -30 -6 z"
            fill-rule="evenodd"
          />
        </svg>

        <svg class="crown" viewBox="0 0 120 88" focusable="false">
          {/* one FLAT colour: no gradient, no outline */}
          {/* ⚠️ NO outline. A black edge on a small gold object against bright
              pink reads as a sticker; the gradient's dark bottom stop is what
              defines the form instead. */}
          <path
            d="M18 70 L18 26 L42 44 L60 10 L78 44 L102 26 L102 70 Z"
            fill="var(--fan-gold)"
          />
          <rect x="10" y="66" width="100" height="12" rx="6" fill="var(--fan-gold)" />
        </svg>

        {/* sparkles: four-point stars, drawn not typed */}
        <span class="spark spark-a"></span>
        <span class="spark spark-b"></span>
        <span class="spark spark-c"></span>
        <span class="spark spark-d"></span>
      </div>

      <span class="fan-hero-echo" data-orn aria-hidden="true">{c.hero.cn}</span>

      <h1 class="fan-title">
        <span class="title-en">{c.hero.title}</span>
      </h1>
      <p class="fan-title-cn">{c.hero.cn}</p>
      <p class="fan-sub">{c.hero.sub}</p>

      {/* ⚠️ No hero CTAs. There was a 看画 / 找到我 pair jumping to #gallery
          and #contact; the visitor took them out — the page is short enough that
          scrolling IS the navigation, and two buttons for four modules was noise. */}

      <p class="fan-stamp">{c.hero.stamp}</p>
      <p class="fan-scroll">{c.hero.scroll}</p>
    </header>

    <!-- ══════════ MODULE 01 · INTRODUCTION ══════════ -->
    <section class="fan-block fan-intro" id="intro">
      <div class="block-head">
        <span class="block-tag">{c.intro.tag}</span>
        <h2 class="block-title">{c.intro.title}</h2>
      </div>

      <div class="intro-grid">
        <div class="intro-copy">
          {c.intro.paras.map((para) => <p class="about-para">{para}</p>)}
        </div>

        <dl class="intro-facts">
          {
            c.intro.facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ══════════ MODULE 02 · GALLERY ══════════ -->
    <section class="fan-bleed fan-field" id="gallery">
      <span class="orn orn-dots" data-orn aria-hidden="true"></span>
      <div class="bleed-head">
        <div class="block-head">
          <span class="block-tag">{c.gallery.tag}</span>
          <h2 class="block-title">{c.gallery.title}</h2>
          <p class="block-sub">{c.gallery.sub}</p>
        </div>
      </div>

      {
        rows.length === 0 ? (
          <p class="fan-empty">{c.gallery.sub}</p>
        ) : (
          rows.map((row, rowIndex) => (
            <section class="fan-row" data-row={rowIndex}>
              <div class="row-head">
                <span class="row-idx">
                  {(rowIndex + 1).toString().padStart(2, "0")}
                </span>
                <h3>{row.label}</h3>
                <span class="row-count">
                  {row.items.length} {c.chips.works}
                </span>
              </div>

              <div class="row-view" data-view={rowIndex}>
                <div
                  class="row-track"
                  data-track={rowIndex}
                  data-copies={row.copies}
                  data-unique={row.items.length}
                >
                  {Array.from({ length: row.copies }, () => row.items)
                    .flat()
                    .map((plate, i) => (
                      <button
                        class="plate"
                        type="button"
                        data-row={rowIndex}
                        data-idx={i % row.items.length}
                        data-src={plate.src}
                        data-title={plate.title}
                        aria-label={plate.title}
                      >
                        <span class="plate-media">
                          <img
                            src={plate.src}
                            alt={plate.title}
                            {/* ⚠️ EAGER for the first copy, and the rest are
                                preloaded by the script below. `lazy` past the
                                first six is what made the row stutter: a repeated
                                copy scrolls into view before its image has been
                                decoded, so it arrives a frame late and reads as a
                                sudden refresh. The /art page has no such gap —
                                every image is already in the document. */}
                            loading={i < row.items.length * 2 ? "eager" : "lazy"}
                            draggable="false"
                          />
                        </span>
                        <span class="plate-foot">
                          <span class="plate-title">{plate.title}</span>
                          <span class="plate-cat">{plate.category}</span>
                        </span>
                      </button>
                    ))}
                </div>
              </div>
            </section>
          ))
        )
      }
    </section>

    <!-- ══════════ MODULE 03 · COMMISSIONS ══════════ -->
    <section class="fan-block fan-commission" id="commissions">
      <span class="sect-echo" data-orn aria-hidden="true">COMMISSION</span>
      <div class="commission-card">
        <div class="block-head">
          <span class="block-tag">{c.commissions.tag}</span>
          <h2 class="block-title">{c.commissions.title}</h2>
          {/* The status is a PLATE, not a sentence. It has to read from across
              the page at a glance, which is the whole job of this section. */}
          <span class="commission-status">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <rect x="4" y="9" width="12" height="8" rx="1.5" />
              <path d="M7 9 V6.5 a3 3 0 0 1 6 0 V9" />
            </svg>
            {c.commissions.status}
          </span>
        </div>

        {c.commissions.body.map((para) => <p class="about-para">{para}</p>)}
        <p class="commission-note">{c.commissions.note}</p>

        {/* ── the 催更 button ── */}
        <div class="nudge">
          {/* The visitor's own avatar: one jump per press.
               ⚠️ `Pfp Transparent.gif` in 输入/ is 1700x1700, 28 frames at 25fps and
               4.4 MB. It was transcoded once with ffmpeg to 240px / 183 KB into
               `public/fan/avatar.gif` (see `docs/fan-page.md` §十六), and its
               NETSCAPE loop block was STRIPPED (`输入/_scratch/gif-once.mjs`) so it
               plays once and stops — a looping GIF cannot be "played once per
               press", which is exactly what was asked for. */}
          <img
            class="nudge-pfp"
            data-nudge-pfp
            src="/fan/avatar.gif"
            alt=""
            aria-hidden="true"
            draggable="false"
            width="240"
            height="240"
          />
          <button class="nudge-btn" type="button" data-nudge>
            <span class="nudge-ring" aria-hidden="true"></span>
            <span class="nudge-burst" aria-hidden="true">
              {
                Array.from({ length: 8 }, (_, i) => (
                  <i style={`--a:${i * 45}deg`} class="nudge-spark" />
                ))
              }
            </span>
            <span class="nudge-face">
              <span class="nudge-label">{c.commissions.nudge}</span>
            </span>
          </button>
          <p class="nudge-tally" aria-live="polite">
            <span class="nudge-count" data-nudge-count>0</span>
            <span>{c.commissions.nudgeUnit}</span>
          </p>
          <!-- ⚠️ The POOL travels to the client script as a data attribute.
               The script used to need no copy at all (it only un-hid this
               paragraph), and `define:vars` is not an option here: it implies
               `is:inline`, which would de-bundle the whole 800-line module. -->
          <p
            class="nudge-back"
            data-nudge-back
            data-nudge-replies={JSON.stringify(c.commissions.nudgeThanks)}
            hidden>{c.commissions.nudgeThanks[0]}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ MODULE 04 · CONTACT ══════════ -->
    <section class="fan-block" id="contact">
      <div class="block-head">
        <span class="block-tag">{c.contact.tag}</span>
        <h2 class="block-title">{c.contact.title}</h2>
        <p class="block-sub">{c.contact.sub}</p>
      </div>

      <ul class="contact-list">
        {
          c.contact.links.map((link) =>
            link.href ? (
              <li class="contact-row">
                <a class="contact-link" href={link.href}>
                  {/* ⚠️ The handle is NOT printed. The visitor asked for it out:
                      the pill is clickable, so showing the URL was noise. The label
                      is the only text, and the arrow says where it goes. */}
                  <span class="contact-label">{link.label}</span>
                  <span class="contact-go" aria-hidden="true">↗</span>
                </a>
              </li>
            ) : (
              <li class="contact-row">
                <div class="contact-link" data-nolink="1">
                  <span class="contact-label">{link.label}</span>
                  {/* a handle with no public URL still has to SAY the handle, or
                      there is nothing to act on — so this one keeps its text and
                      shows a copy glyph instead of the arrow */}
                  <span class="contact-handle">{link.handle}</span>
                </div>
              </li>
            ),
          )
        }
      </ul>
    </section>

    <!-- ══════════ FAN FOOTER ══════════ -->
    <div class="fan-mark" data-orn aria-hidden="true">
      <span class="orn orn-tape"></span>
    </div>

    <footer class="fan-foot">
      {/* ⚠️ A real SVG cloud. The old `.foot-cloud` was a 120x44 pill with two
          `box-shadow` discs beside it and no top scallop at all, so its top edge was
          a straight cut — reported as 「云朵的顶部缺失了一块」. Same silhouette as
          the hero, a third of the size. */}
      <svg class="foot-cloud" viewBox="0 0 242 242" aria-hidden="true" focusable="false">
        <path d="M36 152 a28 28 0 0 1 6 -54 a32 32 0 0 1 46 -30 a40 40 0 0 1 66 0 a32 32 0 0 1 46 30 a28 28 0 0 1 6 54 a22 22 0 0 1 -30 6 a26 26 0 0 1 -40 0 a26 26 0 0 1 -40 0 a22 22 0 0 1 -30 -6 z" fill-rule="evenodd" />
      </svg>
      {/* ⚠️ Guarded, not unconditional: the visitor asked for the fan-tribute
          sentence to come out, and an empty string has to remove the line rather
          than leave its margin behind. */}
      {c.footer.note && <p class="foot-note">{c.footer.note}</p>}
      <a class="fan-btn fan-btn-blue" href={artHref}>
        <span>{c.footer.back}</span>
        <svg viewBox="0 0 26 14" aria-hidden="true" focusable="false">
          <path d="M0 7 H22 M16 1 L23 7 L16 13" />
        </svg>
      </a>
    </footer>

    {/* ── the sheep layer ──
        `pointer-events: none` on the layer and back ON per sheep: a full-screen
        layer that accepts hits would swallow every click on the page. */}
    <div class="sheep-layer" aria-hidden="true"></div>

    <!-- ══════════ LIGHTBOX ══════════ -->
    <aside
      class="fan-lightbox"
      id="fan-lightbox"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
    >
      <button class="lb-bg" type="button" data-lb-close aria-label={c.lightbox.close}
      ></button>
      <button class="lb-x" type="button" data-lb-close aria-label={c.lightbox.close}>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M4 4 L16 16 M16 4 L4 16" />
        </svg>
      </button>
      <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label={c.lightbox.prev}>
        <svg viewBox="0 0 16 28" aria-hidden="true" focusable="false">
          <path d="M13 2 L3 14 L13 26" />
        </svg>
      </button>
      <button class="lb-nav lb-next" type="button" data-lb-next aria-label={c.lightbox.next}>
        <svg viewBox="0 0 16 28" aria-hidden="true" focusable="false">
          <path d="M3 2 L13 14 L3 26" />
        </svg>
      </button>
      <figure class="lb-body">
        <img id="fan-lb-img" src="" alt="" draggable="false" />
        <figcaption class="lb-cap" id="fan-lb-cap"></figcaption>
      </figure>
    </aside>
  </div>
</Layout>

<script>
  /* ── the archive rows: drag + idle drift, one rAF for all of them ── */
  interface Row {
    view: HTMLElement;
    track: HTMLElement;
    pos: number;
    dir: number;
    speed: number;
    hovering: boolean;
    dragging: boolean;
    dragX: number;
    dragPos: number;
    /** distance between two cards `unique` apart: exactly one loop, in px */
    period: number;
    /** how many cards `unique` is, for that measurement */
    unique: number;
  }

  const rows: Row[] = [];

  document.querySelectorAll<HTMLElement>("[data-view]").forEach((view, i) => {
    const track = view.querySelector<HTMLElement>("[data-track]");
    if (!track) return;

    const row: Row = {
      view,
      track,
      pos: 0,
      // Rows alternate so the page does not read as one mechanical belt.
      dir: i % 2 === 0 ? 1 : -1,
      speed: 0.22 + (i % 3) * 0.06,
      hovering: false,
      dragging: false,
      dragX: 0,
      dragPos: 0,
      period: 0,
      unique: Number(track.dataset.unique) || 1,
    };
    row.period = measurePeriod(row);
    rows.push(row);

    view.addEventListener("mouseenter", () => {
      row.hovering = true;
    });
    view.addEventListener("mouseleave", () => {
      row.hovering = false;
      row.dragging = false;
      view.style.cursor = "grab";
    });

    view.addEventListener("pointerdown", (e) => {
      row.dragging = true;
      row.dragX = e.clientX;
      row.dragPos = row.pos;
      view.style.cursor = "grabbing";
      try {
        view.setPointerCapture(e.pointerId);
      } catch {
        /* capture is optional */
      }
    });
    view.addEventListener("pointermove", (e) => {
      if (!row.dragging) return;
      row.pos = row.dragPos + (row.dragX - e.clientX) * 1.4;
    });
    const release = () => {
      if (!row.dragging) return;
      row.dragging = false;
      view.style.cursor = row.hovering ? "grab" : "default";
    };
    view.addEventListener("pointerup", release);
    view.addEventListener("pointercancel", release);
  });

  /**
   * One loop, in px: the gap between the first card and the card `unique` places
   * along it. Falls back to the track's own width when there are not yet two
   * cards to compare.
   */
  /**
   * One period, taken the way the /art page takes it:
   *
   *     const copies = Number(track.dataset.copies) || 2;
   *     const setWidth = track.scrollWidth / copies;
   *
   * ⚠️ **This is the fix for the reset the visitor kept seeing.** Measuring card 0
   * to card `unique` is the right period only when the gap between cards is
   * perfectly uniform; with rows of different lengths one sub-pixel of error per
   * period IS the jump at the wrap. `scrollWidth / copies` is one copy of the set BY
   * CONSTRUCTION — the track's own laid-out width over how many times the set was
   * repeated — so the wrap lands on identical pixels whatever the card widths turn
   * out to be. The /art page has shipped this line for months.
   */
  function measurePeriod(row: Row): number {
    const copies = Number(row.track.dataset.copies) || 1;
    const setWidth = row.track.scrollWidth / copies;
    return setWidth > 1 ? setWidth : row.track.scrollWidth || 1;
  }

  window.addEventListener("resize", () => {
    for (const row of rows) row.period = measurePeriod(row);
  });

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function frame() {
    for (const row of rows) {
      if (!row.dragging && !row.hovering && !reduceMotion) {
        row.pos += row.speed * row.dir;
      }
      // Seamless wrap on the MEASURED period (see `measurePeriod`). Every time the
      // position crosses it the picture is identical, so the modulo is invisible by
      // construction — which is the whole requirement for a loop. Written as one
      // `((x % p) + p) % p` so a drag that overshoots into the negative still lands
      // on the same pixels.
      if (row.period > 0) {
        const wrapped = ((row.pos % row.period) + row.period) % row.period;
        if (wrapped !== row.pos) row.pos = wrapped;
      }
      row.track.style.transform = `translate3d(${-row.pos}px,0,0)`;
    }
    requestAnimationFrame(frame);
  }
  if (rows.length > 0) requestAnimationFrame(frame);

  /* ── warm every UNIQUE plate so a repeat can never arrive undecoded ──
     The rows paint 2-3 copies of the same set; only the first copy carries an
     `eager` image, and the copies further along are pure decoration. Decoding
     the unique URLs once is what makes the loop continuous instead of
     stop-start, and it is exactly what the /art page gets for free by putting
     every image in the document. Deferred to `load` so it never competes with
     the first paint. */
  const warmPlates = () => {
    const seen = new Set<string>();
    document.querySelectorAll<HTMLElement>(".plate").forEach((plate) => {
      const src = plate.dataset.src ?? "";
      if (!src || seen.has(src)) return;
      seen.add(src);
      const img = new Image();
      img.decoding = "async";
      img.src = src;
    });
  };
  if (document.readyState === "complete") window.setTimeout(warmPlates, 200);
  else window.addEventListener("load", () => window.setTimeout(warmPlates, 200), { once: true });
  /* ── a click opens the lightbox; a drag does not. Track the press origin so
        a row drag never lands on a plate. ── */
  const lb = document.getElementById("fan-lightbox");
  const lbImg = document.getElementById("fan-lb-img") as HTMLImageElement | null;
  const lbCap = document.getElementById("fan-lb-cap");
  let pressX = 0;
  let pressY = 0;
  let currentRow = 0;
  let currentIdx = 0;

  const platesOf = (row: number) =>
    Array.from(
      document.querySelectorAll<HTMLElement>(`.plate[data-row="${row}"]`),
    );

  function uniqueCount(row: number): number {
    const track = document.querySelector<HTMLElement>(`[data-track="${row}"]`);
    const n = Number(track?.dataset.unique);
    return Number.isFinite(n) && n > 0 ? n : platesOf(row).length;
  }

  function paint() {
    const plates = platesOf(currentRow);
    if (plates.length === 0 || !lbImg) return;
    const plate = plates[currentIdx];
    const src = plate.dataset.src ?? "";
    const title = plate.dataset.title ?? "";
    // Preload, then swap, so the caption never changes over a blank frame.
    const next = new Image();
    next.onload = () => {
      lbImg.src = src;
    };
    next.src = src;
    if (lbCap) lbCap.textContent = title;
  }

  function openLb(row: number, idx: number) {
    if (!lb) return;
    currentRow = row;
    currentIdx = idx;
    paint();
    lb.classList.add("is-on");
    lb.setAttribute("aria-hidden", "false");
    // Keep the page from scrolling behind the overlay without losing its place.
    const y = window.scrollY;
    document.body.style.position = "fixed";
    document.body.style.top = `-${y}px`;
    document.body.style.width = "100%";
  }

  function closeLb() {
    if (!lb) return;
    lb.classList.remove("is-on");
    lb.setAttribute("aria-hidden", "true");
    const top = document.body.style.top;
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.width = "";
    window.scrollTo(0, Number.parseInt(top || "0", 10) * -1);
  }

  document.querySelectorAll<HTMLElement>(".plate").forEach((plate) => {
    plate.addEventListener("pointerdown", (e) => {
      pressX = e.clientX;
      pressY = e.clientY;
    });
    plate.addEventListener("click", (e) => {
      // ⚠️ The row is a drag surface, so a press that travelled is a drag, not a
      // click. 5px in either axis is the threshold.
      if (Math.abs(e.clientX - pressX) > 5 || Math.abs(e.clientY - pressY) > 5) {
        return;
      }
      openLb(Number(plate.dataset.row), Number(plate.dataset.idx));
    });
  });

  document
    .querySelectorAll<HTMLElement>("[data-lb-close]")
    .forEach((el) => el.addEventListener("click", closeLb));
  document.querySelector("[data-lb-prev]")?.addEventListener("click", () => {
    currentIdx = (currentIdx - 1 + uniqueCount(currentRow)) % uniqueCount(currentRow);
    paint();
  });
  document.querySelector("[data-lb-next]")?.addEventListener("click", () => {
    currentIdx = (currentIdx + 1) % uniqueCount(currentRow);
    paint();
  });

  document.addEventListener("keydown", (e) => {
    if (!lb?.classList.contains("is-on")) return;
    if (e.key === "Escape") closeLb();
    if (e.key === "ArrowLeft") {
      currentIdx = (currentIdx - 1 + uniqueCount(currentRow)) % uniqueCount(currentRow);
      paint();
    }
    if (e.key === "ArrowRight") {
      currentIdx = (currentIdx + 1) % uniqueCount(currentRow);
      paint();
    }
  });

  /* ── the 催更 button ──
     Not a link: there is nowhere to send the visitor, so it must not pretend to
     navigate. It counts the press, plays the burst, and then says thank you.
     ⚠️ `offsetWidth` between the class remove/add forces the reflow that lets the
     animation replay; without it the SECOND press is silent and the counter is the
     only thing that moves, which is exactly the flat feedback the visitor asked
     to avoid. */
  /** set by the sheep block below; the nudge button hands its press to it */
  let nudgeSpawn: ((btn: HTMLElement) => void) | null = null;

  const nudgeBtn = document.querySelector<HTMLButtonElement>("[data-nudge]");
  if (nudgeBtn) {
    const countEl = nudgeBtn.parentElement?.querySelector<HTMLElement>("[data-nudge-count]");
    const backEl = nudgeBtn.parentElement?.querySelector<HTMLElement>("[data-nudge-back]");
    let nudges = 0;
    /**
     * The reply pool, read from the paragraph's own `data-` attribute (see the
     * markup). ⚠️ Index-aligned between en and zh (`utils/fan.ts`), so switching
     * language mid-session shows the same joke in the other language.
     * Falls back to whatever text was server-rendered if the attribute is
     * missing or malformed — a broken pool must not take the whole page down.
     */
    const replies = (() => {
      try {
        const list = JSON.parse(backEl?.dataset.nudgeReplies ?? "[]") as string[];
        if (Array.isArray(list) && list.length) return list;
      } catch {
        /* fall through to the rendered line */
      }
      return [backEl?.textContent ?? ""];
    })();
    let replyAt = 0;
    const replay = (el: HTMLElement, cls: string) => {
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
    };
    /**
     * The avatar, restarted from frame 0 on every press — "按一次就播放一次，按的越快
     * 跳的越快".
     *
     * ⚠️ **Assigning the same `src` again does NOT restart a GIF** (no attribute
     * change, no reload), and the frame can only be rewound by making the browser
     * decode the file again. Dropping the attribute, forcing a reflow and putting it
     * back does exactly that, and the second load comes out of the HTTP cache — so
     * a fast presser restarts it with no network at all.
     * ⚠️ The GIF itself has no NETSCAPE loop block any more, so it plays ONCE and
     * parks on its last frame. A looping GIF would ignore the restart entirely.
     */
    const pfpEl = nudgeBtn.parentElement?.querySelector<HTMLImageElement>("[data-nudge-pfp]");
    const pfpSrc = pfpEl?.getAttribute("src") ?? "";
    const jump = () => {
      if (!pfpEl || !pfpSrc) return;
      pfpEl.removeAttribute("src");
      void pfpEl.offsetWidth; // ⚠️ the reflow IS the mechanism; without it the browser coalesces the two writes
      pfpEl.setAttribute("src", pfpSrc);
    };
    nudgeBtn.addEventListener("click", () => {
      nudges += 1;
      if (countEl) {
        countEl.textContent = String(nudges);
        replay(countEl, "is-bump");
      }
      replay(nudgeBtn, "is-hit");
      jump();
      if (backEl) {
        if (backEl.hidden) backEl.hidden = false;
        /* ⚠️ NEVER the same line twice in a row. `Math.random()` alone repeats
           about 1 press in 103, and a repeat reads as the button being broken
           rather than as a joke — the whole point of a pool is that consecutive
           presses differ. */
        if (replies.length > 1) {
          const next = Math.floor(Math.random() * (replies.length - 1));
          replyAt = next >= replyAt ? next + 1 : next;
        }
        backEl.textContent = replies[replyAt];
        // the entrance animation is on `.is-pop`, so it can be replayed per press
        replay(backEl, "is-pop");
      }
      nudgeSpawn?.(nudgeBtn);
    });
  }
  const sheepLayer = document.querySelector<HTMLElement>(".sheep-layer");
  /**
   * ⚠️ NO CAP. The visitor asked for unlimited toys, so the limit that used to
   * recycle the oldest is gone. Two things keep it affordable instead: the
   * separation pass is a sorted sweep that skips far-apart pairs, and a settled
   * toy sleeps out of the loop entirely.
   */
    const SHEEP_MAX_DT = 32;
    /**
     * Contact model. Measured behaviour is what these four numbers are for:
     *   · SOLVER_PASSES 2 — one pass leaves a three-deep stack overlapping, and the
     *     leftover shows up as next frame's jitter.
     *   · REST 0.92 per contact — a landing loses energy instead of passing it on.
     *   · FRICTION 0.12 — the tangential loss that stops a pile sliding apart. Low on
     *     purpose: at 0.4 the fruits stop dead against each other and read as glued.
     */
    const SOLVER_PASSES = 2;
    /**
     * ⚠️ THE FLOOR BOUNCES, and the SIGN is the whole story. This used to be
     * `t.py = t.y - vn * 0.2` — which keeps 20% of the DOWNWARD speed, so a
     * landing clamps, creeps down again, clamps again: a heavy thud with no
     * rebound at all. The visitor: 「水果做的 Q 弹一点，比如落地会弹一下，现在
     * 感觉太重了。参考捏捏乐那种 Q 弹的感觉」. A restitution needs the previous
     * position moved UP past the floor (`t.y + vn * B`) so the implied velocity
     * reverses. 0.42 keeps 42% of the impact speed, i.e. about a sixth of the
     * height, so a drop gives one clear bounce and a small second one.
     */
    const GROUND_BOUNCE = 0.42;
    /**
     * ⚠️ **THE BOUNCE NEEDS A FLOOR OF ITS OWN, or gravity bounces for ever.** A
     * body at rest on the floor penetrates by one frame of gravity every frame
     * (0.72px), and a restitution of 0.42 turns that into a 0.3px rebound, then a
     * 0.3px fall, then again — a permanent buzz. Measured with no threshold: 134.6px
     * of travel per toy over 1.8s on a settled pile (it was 19.7px). Below this
     * impact speed there is no rebound at all and the old dissipation applies,
     * which is what lets a pile sleep.
     */
    const GROUND_BOUNCE_MIN = 4.5;
    /** the sub-threshold dissipation: this is the pre-bounce behaviour, kept for rests */
    const GROUND_REST = 0.2;
    /**
     * The 捏捏乐 part: a squash-and-stretch spring, driven by the impact speed and
     * UNDERDAMPED on purpose — it overshoots into a stretch on the way back, which
     * is what reads as squishy rather than as a jelly that only flattens.
     * ⚠️ **PER-FRAME UNITS, like everything else in this solver** (`G = 0.72` is px per
     * frame²). The first version used 260 / 12 — i.e. per SECOND — and integrated
     * them with dt in frames: ω·dt was 16, far past the stability limit, so the
     * discrete spring oscillated for ever at ±11px and the fruit looked like it was
     * still bouncing 9s after it had landed (measured: 61 direction changes).
     * 0.07 / 0.19 is ω≈0.26 rad/frame (≈2.5Hz) with ζ≈0.37: two visible wobbles
     * and a stop.
     * ⚠️ VISUAL ONLY — it never touches x/y/px/py, so the
     * collision radius and everything measured about the pile are unchanged.
     */
    const SQ_K = 0.07;
    const SQ_C = 0.19;
    /** how much of the impact speed turns into squash (deg of flattening per px/frame) */
    const SQ_GAIN = 0.011;
    /** below this impact speed there is nothing to squash — resting contacts land here */
    const SQ_MIN = 1.6;
    const SQ_MAX = 0.3;
    const WALL_REST = 0.4;
    const GROUND_FRICTION = 0.34;
    const CONTACT_FRICTION = 0.3;
    const CONTACT_REST = 0.72;
    /**
     * ⚠️ A resting contact overlaps by a fraction of a pixel EVERY frame, so
     * `asleep = 0` on any contact meant nothing ever slept and the solver kept
     * re-separating a stack that was already separated. A contact only wakes a body
     * when there is a real overlap or real relative speed.
     */
    const WAKE_OVERLAP = 0.25;
    const WAKE_SPEED = 0.25;
    /**
     * ⚠️ Damping while a body is IN CONTACT, and it is not optional. A solver that
     * only resolves positions leaves a low-level crawl — measured 21.6px of travel
     * per toy over 1.8s with the pile untouched, which never crosses the sleep
     * threshold and so never stops. This is the loss path that lets a stack rest.
     */
    const CONTACT_DAMP = 0.86;
    /**
     * ⚠️ Cap on how far one pair may be pushed apart in one pass. The push is
     * proportional to the overlap, so a fast fruit arriving INSIDE another produced a
     * 20px single-frame shove — which is what launched a settled stack. Capped, a deep
     * overlap resolves over a few frames, which is also what a real body does.
     */
    const CORRECTION_CAP = 2;

    /**
     * Bleed a little TANGENTIAL velocity out of a contact, and a little of the
     * normal component. ⚠️ It rewrites `px`/`py`, which is the only place that is
     * allowed — a correction must not create velocity, but DAMPING is a deliberate
     * velocity change and has to go through `prev` to have any effect at all.
     */
    const applyContactFriction = (t: Sheep, nx: number, ny: number) => {
      const vx = t.x - t.px;
      const vy = t.y - t.py;
      const vn = vx * nx + vy * ny;
      const vtx = vx - vn * nx;
      const vty = vy - vn * ny;
      const nvx = vn * nx * CONTACT_REST + vtx * (1 - CONTACT_FRICTION);
      const nvy = vn * ny * CONTACT_REST + vty * (1 - CONTACT_FRICTION);
      t.px = t.x - nvx;
      t.py = t.y - nvy;
    };
  if (sheepLayer) {
    type Sheep = {
      el: HTMLElement;
      x: number;
      y: number;
      px: number;
      py: number;
      r: number;
      rot: number;
      vrot: number;
      asleep: number;
      held: boolean;
      grabX: number;
      grabY: number;
      /** true while this toy touches the floor or another toy */
      contact: boolean;
      /** squash amount (0 = round, + = flattened, − = stretched) and its velocity */
      sq: number;
      sqv: number;
    };
    /* ── the fruit ──
       ONE ENTRY PER FRUIT, each with its parts.
       ⚠️ The table used to be a flat list of paths, which meant a two-tone fruit was two
       entries — and the spawner picks one entry, so a third of the toys were fruit
       FRAGMENTS: a green star with no strawberry under it, three brown dots with no
       coconut, a red crescent with no rind. Grouping the parts is the fix.
       ⚠️ ELEVEN entries, not twelve: the pineapple was removed on request. Its barrel was
       the narrowest shape in the set and its crown the widest, so in a pile it read as a
       spiky green blur around a small pot. Look at any new fruit ALONE before shipping it
       (`docs/fan-page.md`, round 13).
       No highlight strokes: at 76px a 0.55-alpha white arc reads as a scratch. */
    /**
     * ⚠️ `scale` is applied to the SVG, NOT to the toy's box. The box stays a
     * uniform 76px so the collision radius and the solver are untouched, and a big
     * fruit simply overflows its box — which is what `overflow: visible` on the svg
     * is for. Without this every toy was the same size and the pile read as a grid.
     */
    const FRUIT: { parts: { d: string; fill: string; shade: string }[]; scale: number }[] = [
      {
        // apple
        parts: [
          // ⚠️ `M62 32 c3 -9 …` was a LEAF shape filled in the apple's own red, so it
          // vanished into the body and the apple read as a plain ball. The stem is now
          // its own part in stem brown.
          { d: "M60 34 a32 32 0 0 1 26 50 a32 32 0 0 1 -52 0 a32 32 0 0 1 26 -50 z", fill: "#ff5d5d", shade: "#c62828" },
          { d: "M60 34 c-1 -8 1 -14 6 -18", fill: "none", shade: "#6b4a1f" },
        ],
        scale: 1,
      },
      {
        // pear: a narrow waist, then the stalk
        parts: [
          // ⚠️ `a27 27 0 0 0 54 0` is a HALF CIRCLE, so the old body was a
          // semicircle with a neck on top — a keyhole. This is a real pear profile:
          // narrow at the top, swelling to a round base.
          { d: "M60 26 c11 0 17 9 19 20 c2 11 11 15 15 26 c5 13 -1 26 -15 31 c-9 3 -29 3 -38 0 c-14 -5 -20 -18 -15 -31 c4 -11 13 -15 15 -26 c2 -11 8 -20 19 -20 z", fill: "#c8e05a", shade: "#7f9c1c" },
          { d: "M58 28 c0 -9 5 -14 12 -16 c0 9 -5 14 -12 16 z", fill: "#7f9c1c", shade: "#5f7a12" },
        ],
        scale: 1.06,
      },
      {
        // strawberry: body, then FIVE leaves — the old cap was one lens sitting on
        // the body, which read as a squashed circle rather than as a strawberry
        parts: [
          { d: "M60 32 c24 0 38 14 38 32 c0 22 -19 41 -38 54 c-19 -13 -38 -32 -38 -54 c0 -18 14 -32 38 -32 z", fill: "#ff4d6d", shade: "#b3123a" },
          // ⚠️ The crown used to sit at y=8..32 with the body starting at y=32, so the
          // leaves HOVERED above the fruit. It is now at y=18..40, overlapping the
          // body's shoulder so it reads as a cap.
          { d: "M60 18 L72 30 L88 26 L76 40 L60 34 L44 40 L32 26 L48 30 Z", fill: "#4caf50", shade: "#2e7d32" },
        ],
        scale: 0.96,
      },
      {
        // peach
        parts: [
          { d: "M60 34 a35 35 0 0 0 0 70 a35 35 0 0 0 0 -70 z", fill: "#ffab6b", shade: "#d9741f" },
          { d: "M58 34 c-5 -12 -15 -16 -23 -13 c3 11 11 16 23 13 z", fill: "#4caf50", shade: "#2e7d32" },
        ],
        scale: 1.04,
      },
      {
        // cherries: two fruit and one Y stem
        parts: [
          { d: "M54 48 a17 17 0 1 1 0 34 a17 17 0 1 1 0 -34 z M84 58 a15 15 0 1 1 0 30 a15 15 0 1 1 0 -30 z", fill: "#e0245e", shade: "#8e0f33" },
          // ⚠️ ONE Y, not two stems. The old pair were independent curves that
          // crossed like scissors instead of meeting, so the cherries looked like two
          // loose balls. Both branches now start at the stem's fork (66, 24) and run
          // down to the TOP of each fruit.
          { d: "M66 24 C65 36 60 42 56 48 M66 24 C70 36 78 46 84 58 M66 24 c-2 -8 0 -14 6 -18", fill: "none", shade: "#6d7a2a" },
        ],
        scale: 0.92,
      },
      {
        // banana
        parts: [
          { d: "M22 42 c20 34 50 45 84 31 c-5 21 -30 32 -55 26 c-25 -6 -36 -31 -29 -57 z", fill: "#ffd93d", shade: "#c9a000" },
          { d: "M24 40 l-6 -9 M104 72 l9 -4", fill: "none", shade: "#8a6b08" },
        ],
        scale: 1.02,
      },
      {
        // watermelon slice: the rind is a 10px band, the flesh is the rest. Both arcs
        // share the half-width; two arcs of different half-widths do NOT nest, which
        // is what made the earlier version read as green with a red streak.
        parts: [
          { d: "M10 34 h100 a50 50 0 0 1 -100 0 z", fill: "#2f9e44", shade: "#1b6b2c" },
          { d: "M20 36 h80 a40 40 0 0 1 -80 0 z", fill: "#ff5a7a", shade: "#c9184a" },
          { d: "M44 54 m-3.5 0 a3.5 4.5 0 1 0 7 0 a3.5 4.5 0 1 0 -7 0 M60 62 m-3.5 0 a3.5 4.5 0 1 0 7 0 a3.5 4.5 0 1 0 -7 0 M76 54 m-3.5 0 a3.5 4.5 0 1 0 7 0 a3.5 4.5 0 1 0 -7 0", fill: "#20304f", shade: "#20304f" },
        ],
        scale: 1,
      },
      {
        // grapes: r=13 with 20px between centres, so the berries stay separate
        parts: [
          { d: "M60 32 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z M40 50 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z M80 50 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z M60 68 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z", fill: "#a06cd5", shade: "#5b2d91" },
          // ⚠️ The old stem began at y=32 with the stroke centred on the outline, so
          // half of it was hidden under the top berry and only a floating stub showed.
          // It now starts at the berry's top edge (60, 19) and rises clear of it.
          { d: "M60 20 c1 -7 5 -13 13 -17", fill: "none", shade: "#5b2d91" },
        ],
        scale: 0.9,
      },
      {
        // blueberry: the berry, then the five-point calyx
        parts: [
          { d: "M60 34 a30 30 0 0 1 0 60 a30 30 0 0 1 0 -60 z", fill: "#4c5fd7", shade: "#26309c" },
          { d: "M60 34 l-9 -10 M60 34 l9 -10 M60 34 v-12 M60 34 l-14 -4 M60 34 l14 -4", fill: "none", shade: "#26309c" },
        ],
        scale: 0.82,
      },
      {
        // mango: a fat oval leaning right, plus a stem nub
        parts: [
          // enlarged in the path too: at the old size it was the smallest shape in the set
          { d: "M20 62 a40 34 0 0 1 72 -24 a40 34 0 0 1 -72 24 z", fill: "#ffb340", shade: "#cf7a12" },
          { d: "M84 34 c2 -12 9 -19 18 -21 c-1 12 -7 19 -18 21 z", fill: "#7f9c1c", shade: "#5f7a12" },
        ],
        scale: 1.14,
      },
      {
        // coconut: plain brown with the three eyes — nothing else. The split version
        // put those eyes ON the white flesh, which read as a face.
        parts: [
          { d: "M60 26 a36 36 0 0 1 0 72 a36 36 0 0 1 0 -72 z", fill: "#8a5a33", shade: "#573a1f" },
          { d: "M48 56 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M72 56 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M60 76 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0", fill: "#4a2f19", shade: "#4a2f19" },
        ],
        scale: 0.98,
      },
    ];

    const sheep: Sheep[] = [];
    let sheepRaf = 0;
    let lastT = 0;

    /* ⚠️ These live ABOVE `step`, not in the drag section below it. `step` runs
       from rAF and reads them, so a `let` declared further down is a temporal dead
       zone hazard: the first frame throws, the throw is swallowed by the rAF
       callback, `sheepRaf` is already 0, and the solver never runs again. The
       sheep sat motionless at the floor with no error anywhere. */
    let pointerX = -1;
    let pointerY = -1;

    /** keep a spawn inside the viewport, radius included */
    const clampSheep = (x: number) => Math.max(34, Math.min(window.innerWidth - 34, x));

    const floorY = () => window.innerHeight - 26;

    const wake = (t: Sheep) => {
      t.asleep = 0;
    };

    function spawn(x: number, y: number) {
      // no cap — see SHEEP_MAX_DT
      const el = document.createElement("div");
      el.className = "sheep";
      const item = FRUIT[Math.floor(Math.random() * FRUIT.length)];
      // ⚠️ EVERY part, in one svg. `item.parts` is the whole fruit — a watermelon is
      // rind + flesh + seeds, a strawberry is body + leaves. Emitting one part per toy
      // is what put a green star and three loose dots in the pile.
      const body = item.parts
        .map((p) => `<path d="${p.d}" fill="${p.fill}" stroke="${p.shade}" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/>`)
        .join("");
      // ⚠️ The scale rides the SVG's BOX, not its `transform`. `transform-origin`
      // defaults to `0 0` for SVG rather than to the centre, and the toy's own
      // transform is rewritten by the solver every frame. Sizing the svg past its
      // parent leaves the element's LAYOUT box at 76x76 — so the collision radius
      // and the solver are untouched — and centres the overflow with a negative
      // margin, which is what makes a watermelon bigger than a blueberry.
      const sc = item.scale ?? 1;
      const pct = Math.round(sc * 100);
      el.innerHTML = `<svg viewBox="0 0 120 116" focusable="false" style="width:${pct}%;height:${pct}%;margin-left:${(100 - pct) / 2}%;margin-top:${(100 - pct) / 2}%">${body}</svg>`;
      el.style.setProperty("--r", "0");
      sheepLayer.append(el);
      const t: Sheep = {
        el,
        x,
        y,
        px: x,
        py: y - 2,
        r: 30,
        rot: (Math.random() - 0.5) * 40,
        vrot: (Math.random() - 0.5) * 2.2,
        asleep: 0,
        held: false,
        grabX: 0,
        grabY: 0,
        contact: false,
        sq: 0,
        sqv: 0,
      };
      sheep.push(t);
      startSheep();
      return t;
    }

    function step(now: number) {
      sheepRaf = 0;
      const dt = lastT ? Math.min(32, now - lastT) / 16.67 : 1;
      lastT = now;
      const G = 0.72 * dt;
      const DAMP = 0.994;
      const FLOOR = floorY();
      let awake = 0;

      for (const t of sheep) {
        if (t.held) {
          // the pointer owns the position outright; `prev` follows so a release
          // inherits the throw's velocity for free
          t.px = t.x - (t.x - t.px) * 0.4;
          t.py = t.y - (t.y - t.py) * 0.4;
          t.x = pointerX - t.grabX;
          t.y = pointerY - t.grabY;
          t.px = t.x - (t.x - t.px) * 0.5;
          t.py = t.y - (t.y - t.py) * 0.5;
          t.asleep = 0;
          awake++;
          continue;
        }
        /* ── the squish ──
           ⚠️ Ticked BEFORE the sleep test and counted as awake, or a toy that lands
           and falls asleep on the same frame freezes half-flattened. Underdamped, so
           it springs back through round into a slight stretch before it stops. */
        if (t.sq !== 0 || t.sqv !== 0) {
          t.sqv += (-SQ_K * t.sq - SQ_C * t.sqv) * dt;
          t.sq += t.sqv * dt;
          if (Math.abs(t.sq) < 0.002 && Math.abs(t.sqv) < 0.02) {
            t.sq = 0;
            t.sqv = 0;
          } else {
            awake++;
          }
        }
        if (t.asleep > 40 && t.sq === 0) continue;
        awake++;
        // ⚠️ Contacts are found at the END of the frame, so this flag is one frame
        // old. That is fine for damping, and it keeps the solver to a single pass.
        if (t.contact) {
          t.px = t.x - (t.x - t.px) * CONTACT_DAMP;
          t.py = t.y - (t.y - t.py) * CONTACT_DAMP;
        }
        const vx = (t.x - t.px) * DAMP;
        const vy = (t.y - t.py) * DAMP;
        t.px = t.x;
        t.py = t.y;
        t.x += vx;
        t.y += vy + G;
        t.rot += t.vrot * dt;
        t.vrot *= 0.985;
        // ── the floor ──
        // ⚠️ POSITION ONLY. `t.py = t.y + vy * 0.32` (the old line) INJECTED velocity
        // on every touch, so a fruit resting on the floor was kicked every frame and
        // the whole pile jittered. A contact that only moves the position produces no
        // velocity at all; the small loss of the normal component is what makes a
        // landing settle instead of bounce.
        if (t.y > FLOOR) {
          t.y = FLOOR;
          const vn = t.y - t.py;
          // ⚠️ `+`, not `-`: the previous position goes UP past the floor so the
          // implied velocity reverses. See GROUND_BOUNCE.
          if (vn > 0) {
            if (vn > GROUND_BOUNCE_MIN) {
              // a real landing: reverse it, and squash on the way
              t.py = t.y + vn * GROUND_BOUNCE;
              if (vn > SQ_MIN) t.sqv += Math.min(vn * SQ_GAIN, SQ_MAX);
            } else {
              // resting (or nearly): eat the normal component instead of returning it
              t.py = t.y - vn * GROUND_REST;
            }
          }
          // friction along the floor
          const vt = t.x - t.px;
          t.px = t.x - vt * (1 - GROUND_FRICTION);
          t.vrot *= 0.6;
          t.contact = true;
        }
        // ── the walls, so nothing escapes the viewport ──
        if (t.x < t.r) {
          t.x = t.r;
          const vt = t.x - t.px;
          if (vt < 0) t.px = t.x - vt * WALL_REST;
        }
        if (t.x > window.innerWidth - t.r) {
          t.x = window.innerWidth - t.r;
          const vt = t.x - t.px;
          if (vt > 0) t.px = t.x - vt * WALL_REST;
        }
        // settle: kill the last of the motion so a pile can sleep
        if (Math.abs(t.x - t.px) < 0.02 && Math.abs(t.y - t.py) < 0.02 && t.y >= FLOOR - 0.5) {
          t.px = t.x;
          t.py = t.y;
          t.rot += (Math.round(t.rot / 90) * 90 - t.rot) * 0.2;
          t.asleep++;
        } else {
          t.asleep = 0;
        }
      }

      /* ── separation ──
         Sort by x, then only test pairs whose x distance is inside one diameter. With
         no cap on the population that is what keeps the cost near-linear: a full
         pairwise pass at a hundred toys is 4950 tests per frame, this is ~n·k.

         ⚠️ TWO rules make the pile feel heavy, and both were missing:
         1. **A contact moves POSITION ONLY.** `px`/`py` are the previous position, so
            moving them changes the implied velocity. The old code pushed them along
            with the correction; every overlapping pair therefore traded velocity back
            and forth, and with forty fruits on screen one landing rippled through the
            whole pile — reported as 「都轻飘飘的，没有手感」.
         2. **Contacts apply friction.** Without a tangential loss a pile slides apart
            like it is on ice; with it, a stack stays where it lands.

         Two iterations, because one pass leaves a three-deep stack overlapping and the
         leftover correction is what shows up as the next frame's jitter. */
      // clear last frame's flags, so a body that left a contact stops damping
      for (const t of sheep) t.contact = false;

      for (let pass = 0; pass < SOLVER_PASSES; pass++) {
        const order = sheep.slice().sort((a, b) => a.x - b.x);
        const reach = 62; // the largest possible (r + r) for two toys
        for (let i = 0; i < order.length; i++) {
          const a = order[i];
          for (let j = i + 1; j < order.length; j++) {
            const b = order[j];
            if (b.x - a.x > reach) break;
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const min = a.r + b.r;
            const d2 = dx * dx + dy * dy;
            if (d2 >= min * min || d2 === 0) continue;
            const d = Math.sqrt(d2);
            const overlap = (min - d) / d;
            const nx = dx / d;
            const ny = dy / d;
            const raw = (min - d) * 0.5;
            const amount = Math.min(raw, CORRECTION_CAP);
            const pushX = nx * amount;
            const pushY = ny * amount;
            const wa = a.held ? 0 : b.held ? 1 : 0.5;
            const wb = b.held ? 0 : a.held ? 1 : 0.5;
            /* woken by a REAL overlap or REAL relative speed — never by the
               fraction-of-a-pixel overlap that a resting stack always has */
            const rel = Math.hypot(b.x - b.px - (a.x - a.px), b.y - b.py - (a.y - a.py));
            const wake = min - d > WAKE_OVERLAP || rel > WAKE_SPEED;
            if (wa > 0) {
              a.x -= pushX * (wa * 2);
              a.y -= pushY * (wa * 2);
              if (wake) a.asleep = 0;
              a.contact = true;
              // ⚠️ `px`/`py` are NOT touched by the correction itself — that is
              // the whole point. `applyContactFriction` is the one exception: damping
              // is a DELIBERATE velocity change and has to go through `prev`.
              applyContactFriction(a, nx, ny);
            }
            if (wb > 0) {
              b.x += pushX * (wb * 2);
              b.y += pushY * (wb * 2);
              if (wake) b.asleep = 0;
              b.contact = true;
              applyContactFriction(b, nx, ny);
            }
            a.vrot -= pushX * 0.012;
            b.vrot += pushX * 0.012;
          }
        }
      }
      for (const t of sheep) {
        const at = `translate3d(${(t.x - 50).toFixed(2)}px,${(t.y - 32).toFixed(2)}px,0) rotate(${t.rot.toFixed(2)}deg)`;
        if (t.sq === 0) {
          t.el.style.transform = at;
          if (t.el.style.getPropertyValue("--sq")) t.el.style.removeProperty("--sq");
          continue;
        }
        /* ⚠️ The squash is in SCREEN axes, not in the toy's own. Writing it as a
           plain `scale()` after the rotate would squash along the toy's rotated
           axis, so a fruit lying at 90° would squash sideways. The matrix below is
           exactly `R(−θ) · diag(sx, sy) · R(θ)` — the same squash expressed in the
           rotated frame — and it costs four multiplies. */
        const s = Math.max(-SQ_MAX, Math.min(SQ_MAX, t.sq));
        const sx = 1 + s * 0.55;
        const sy = 1 - s;
        const th = (t.rot * Math.PI) / 180;
        const co = Math.cos(th);
        const si = Math.sin(th);
        const m11 = co * co * sx + si * si * sy;
        const m12 = co * si * (sx - sy);
        const m22 = si * si * sx + co * co * sy;
        t.el.style.transform = `${at} matrix(${m11.toFixed(4)},${m12.toFixed(4)},${m12.toFixed(4)},${m22.toFixed(4)},0,0)`;
        // published for probes: a squashed toy's AABB also changes with its ROTATION,
        // so the rect cannot tell squash from spin. `--sq` can.
        t.el.style.setProperty("--sq", s.toFixed(3));
      }
      if (awake > 0) startSheep();
      else lastT = 0;
    }

    function startSheep() {
      if (sheepRaf) return;
      sheepRaf = requestAnimationFrame(step);
    }

    /* ── the drag ── */
    let held: Sheep | null = null;

    sheepLayer.addEventListener("pointerdown", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>(".sheep");
      if (!el) return;
      const t = sheep.find((x) => x.el === el);
      if (!t) return;
      held = t;
      t.held = true;
      wake(t);
      pointerX = e.clientX;
      pointerY = e.clientY;
      t.grabX = e.clientX - t.x;
      t.grabY = e.clientY - t.y;
      el.classList.add("is-dragged");
      el.classList.remove("is-poked");
      void el.offsetWidth;
      el.classList.add("is-poked");
      try {
        el.setPointerCapture(e.pointerId);
      } catch {
        /* capture is optional */
      }
      startSheep();
      e.preventDefault();
    });

    window.addEventListener("pointermove", (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (held) {
        wake(held);
        startSheep();
      }
    });

    const release = () => {
      if (!held) return;
      held.held = false;
      held.el.classList.remove("is-dragged");
      held.vrot += (Math.random() - 0.5) * 1.4;
      wake(held);
      held = null;
      startSheep();
    };
    window.addEventListener("pointerup", release);
    window.addEventListener("pointercancel", release);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) startSheep();
    });

    /* ⚠️ The spawn point is in VIEWPORT coordinates near the TOP of the screen, not
       at the button. The layer is `position: fixed` and the button can be a whole
       viewport below the fold, so anchoring to it dropped the sheep off-screen:
       measured at y=424 in a 950px viewport, i.e. invisible under the fold while
       the solver happily ran. The visitor pressed a button to see a sheep fall —
       it has to fall into the view they are looking at. */
    nudgeSpawn = (btn: HTMLElement) => {
      const r = btn.getBoundingClientRect();
      const spread = Math.min(360, window.innerWidth * 0.34);
      const x = window.innerWidth / 2 + (Math.random() - 0.5) * spread;
      void r;
      spawn(clampSheep(x), -20);
    };
  }
  /* ── the page rail: how far down the poster you are ──
     ⚠️ Throttled with rAF and written as ONE custom property, so the browser
     does no layout work per scroll event: the fill's height is a `calc()` off
     `--fan-read`, and only the property changes. `scrollHeight - innerHeight` is
     the real scrollable distance, not `scrollHeight`, or the bar would only ever
     reach about half way on a long page. */
  const rail = document.querySelector<HTMLElement>(".fan-rail");
  const railFill = rail?.querySelector<HTMLElement>(".fan-rail-fill") ?? null;
  if (rail) {
    let railQueued = false;
    const paintRail = () => {
      railQueued = false;
      const span = document.documentElement.scrollHeight - window.innerHeight;
      const read = span <= 1 ? 1 : Math.min(1, Math.max(0, window.scrollY / span));
      rail.style.setProperty("--fan-read", read.toFixed(4));
    };
    const queueRail = () => {
      if (railQueued) return;
      railQueued = true;
      requestAnimationFrame(paintRail);
    };
    window.addEventListener("resize", queueRail);
    // the rows and the plates settle after load and change the page height
    window.addEventListener("load", queueRail);
    /* ── the drag ──
       The fill's CENTRE is placed at the pointer: with a proportional fill that is
       what makes a scrollbar feel direct, and it needs no grab offset. */
    let railDragging = false;
    const paintFromPointer = (clientY: number) => {
      const r = rail.getBoundingClientRect();
      if (r.height <= 0) return;
      const frac = Math.min(1, Math.max(0, (clientY - r.top) / r.height));
      const span = document.documentElement.scrollHeight - window.innerHeight;
      // ⚠️ `behavior: "instant"` is REQUIRED here. `global.css` sets
      // `html { scroll-behavior: smooth }`, so a plain `scrollTo` animates —
      // measured, a drag to the middle took ~600ms to converge and every further
      // pointer position restarted it, so the rail felt like it was lagging the
      // hand. Direct manipulation has to be instant; the CSS token stays as it is
      // for every real link and anchor on the site.
      window.scrollTo({ top: frac * Math.max(0, span), behavior: "instant" });
      // ⚠️ And write the FILL from the same fraction. The fill's height is
      // `--fan-read`, which only `paintRail` wrote — and the scroll listener skips
      // `paintRail` while dragging. So the page scrolled but the fill did not move
      // until the pointer was released. Driving both from one number means they
      // cannot disagree.
      rail.style.setProperty("--fan-read", frac.toFixed(4));
    };
    rail.addEventListener("pointerdown", (e) => {
      railDragging = true;
      rail.classList.add("is-dragging");
      try {
        rail.setPointerCapture(e.pointerId);
      } catch {
        /* capture is optional */
      }
      paintFromPointer(e.clientY);
      e.preventDefault();
    });
    rail.addEventListener("pointermove", (e) => {
      if (railDragging) paintFromPointer(e.clientY);
    });
    const railRelease = () => {
      if (!railDragging) return;
      railDragging = false;
      rail.classList.remove("is-dragging");
      queueRail();
    };
    rail.addEventListener("pointerup", railRelease);
    rail.addEventListener("pointercancel", railRelease);
    // ⚠️ while dragging, the scroll listener must not fight the pointer
    window.addEventListener("scroll", () => { if (!railDragging) queueRail(); }, { passive: true });

    // the fill's own height needs `--fan-read`, so publish once at rest
    paintRail();
  }</script>

<style>
  /* ══════════════════════════════════════════════════════════════
     THE PALETTE — one theme, fixed.

     ⚠️ Defined on `.fan-root` and NOT on `:root`: the site's own tokens stay
     untouched for every other page, and `:global` is only needed on the rules
     that have to reach OUTSIDE this component (the site shell).
     ⚠️ `--fan-*` is deliberately a separate namespace from the site's tokens —
     the two palettes are unrelated and reusing the names would invite a stray
     site token to leak in.
     ══════════════════════════════════════════════════════════════ */
  .fan-root {
    /* surfaces */
    --fan-cream: #fff0ec;
    --fan-cream-2: #ffe3e6;
    --fan-peach: #ffcdd4;
    --fan-pink: #ff6fa8;
    --fan-magenta: #f5308a;
    --fan-magenta-deep: #d61f74;
    --fan-pink-soft: #ffd9e6;

    /* the signal colour */
    --fan-blue: #1b25d8;
    --fan-blue-deep: #141cae;
    --fan-blue-bright: #2b3cf0;

    /* ink + print */
    --fan-ink: #12123a;
    --fan-ink-soft: #4a4a72;
    --fan-white: #ffffff;
    --fan-paper: #fffaf8;
    --fan-shadow: 0 18px 40px -22px rgba(27, 37, 216, 0.45);
    --fan-shadow-pink: 0 20px 44px -24px rgba(245, 48, 138, 0.6);
    --fan-dot: rgba(245, 48, 138, 0.16);

    /* ⚠️ The crown's gold, and it is chosen AGAINST `--fan-blue #1B25D8`, not on its
       own. A deep, high-chroma blue wants a WARM gold that is slightly
       DESATURATED: a saturated yellow vibrates against it like a warning sign, and
       a pale cream reads as beige. Two stops and a dark end, so the crown reads as
       METAL — the gradient is doing that work, not the hue. */
    /* ⚠️ ONE flat gold, chosen against `--fan-blue #1B25D8`: a deep, high-chroma
       blue wants a WARM gold that is slightly desaturated. A saturated yellow
       vibrates against it like a warning sign, and a pale cream reads as beige. */
    --fan-gold: #e0a92a;

    /* ── the animated background (`FanMosaic.astro`) ──────────────────────
       ⚠️ Declared HERE, on `.fan-root`, and read by the canvas through
       `getComputedStyle`: the pink world stays in one place, and the shader
       never hard-codes a colour. The three colour stops are deliberately the
       page's OWN pinks — the effect is the page's paper, not a separate
       artwork bolted behind it.
       `--fan-mosaic-bg` is the paper the mosaic sits on (also the colour the
       field's empty areas resolve to), so it must match the page's cream or
       the hero reads as a rectangle. */
    --fan-mosaic-bg: #fff0ec;
    --fan-mosaic-c1: #ff6fa8;
    --fan-mosaic-c2: #f5308a;
    --fan-mosaic-tile: 18;
    --fan-mosaic-gain: 0.2;
    /* contrast is the readability knob: 1 = the shader as written, lower squeezes the field's deviation from the paper, so the paper stays pale behind body text while the frost's texture survives. frost / grain / dot are the glass: `frost` is the blur radius as a
       multiple of the tile, `grain` is the per-pixel refraction in CSS px (the
       thing that makes it frost and not just a blur), `dot` is how much of the
       page's print grain shows through the glass. */
    --fan-mosaic-contrast: 0.6;
    --fan-mosaic-frost: 2;
    --fan-mosaic-grain: 1.4;
    --fan-mosaic-dot: 0.16;
    /* print-grain pitch in CSS px; raise it for bigger, rounder dots */
    --fan-mosaic-dot-pitch: 7;
    --fan-mosaic-reach: 300;
    --fan-mosaic-size: 70;
    --fan-mosaic-angle: 0;
    --fan-mosaic-speed: 100;
    --fan-mosaic-hover: 100;
    --fan-sky-opacity: 0.3;

    /* ⚠️ `--accent` is NOT overridden here — it also paints the skip link and
       the focus rings, which this page does not draw. Everything this page
       draws sets its own colour. */
    --bg: var(--fan-cream);
    --text: var(--fan-ink);
    --text-bright: var(--fan-ink);
    --text-soft: var(--fan-ink);
    --text-dim: var(--fan-ink-soft);
    --text-tertiary: var(--fan-ink-soft);
    --panel: var(--fan-paper);
    --panel-light: var(--fan-white);
    --border: rgba(27, 37, 216, 0.14);
    --border-strong: rgba(27, 37, 216, 0.3);
    --border-divider: rgba(245, 48, 138, 0.3);

    position: relative;
    min-height: 100vh;
    /* ⚠️ LOAD-BEARING for the animated background, not tidiness. `.fan-mosaic`
       is a `position: fixed` child at `z-index: -1`, and a negative-z child
       paints above its parent's own background ONLY if the parent is a stacking
       context. Without this, the canvas escapes to the nearest stacking context
       and paints BEHIND `.fan-root`'s opaque background: a blank cream page,
       a running shader, and no error in the console.
       ⚠️ `isolation: isolate` and NOT `z-index: 0`: `z-index` on a
       `position: relative` box also works, but it would make this element equal
       to a sibling's z-index and pull the whole page into a stacking fight with
       the site shell. `isolation` does the containment and nothing else. */
    isolation: isolate;
    /* This clip is NOT what breaks the sticky module bar — that was the blanket
       `.fan-root > *` rule below, which set `position: relative` on the bar as
       well. See the note there. Measured in Chrome: with the clip present the
       bar still sticks (top 0 after 1200 and 3000 px of scroll). */
    overflow-x: clip;
    /* ⚠️ Only the CREAM lives here now. The three pink washes moved to
       .fan-sky below, because the animated background (a fixed canvas at
       z-index -1) paints OVER this element's own background — a wash left here
       would be invisible the moment WebGL2 comes up. Keeping just the paper on
       .fan-root also means the no-WebGL2 fallback is still a finished-looking
       page: cream + .fan-sky + the grain. */
    background-color: var(--fan-cream);
    color: var(--fan-ink);
    background-image: linear-gradient(
      180deg,
      var(--fan-cream) 0%,
      var(--fan-cream-2) 42%,
      var(--fan-cream) 100%
    );
    font-family: var(--font-body);
  }

  /* ── THE HERO'S PINK SKY ──────────────────────────────────────────────
     The page's key-visual wash, as a real element rather than a background
     layer, for one reason: it has to paint ON TOP of the mosaic. It is a
     sibling of the canvas at the same z-index: -1, and paint order inside
     that layer is DOM order, so this one comes second and wins.
     ⚠️ --fan-sky-opacity is the whole point of the layer existing as a knob:
     at 1 the hero is the flat pink the page had before the mosaic, at 0 the
     mosaic runs uncovered, and in between the pink reads as a tint over live
     linework. Anything ABOVE 0 means the mosaic is at its most legible the
     moment the sky's own gradient fades, ~1360px down.
     ⚠️ height: 1400px is not a layout choice: the old wash was
     ellipse 120% 52% at 50% -6% of the WHOLE PAGE (3973px tall measured),
     whose colour stops run out around 1360px. This box reproduces that
     geometry; changing the height changes where the hero's pink ends. */
  .fan-sky {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1400px;
    z-index: -1;
    pointer-events: none;
    opacity: var(--fan-sky-opacity, 0.5);
    background:
      radial-gradient(
        ellipse 120% 52% at 50% -6%,
        var(--fan-pink) 0%,
        var(--fan-peach) 34%,
        transparent 66%
      ),
      radial-gradient(
        ellipse 90% 40% at 4% 22%,
        rgba(245, 48, 138, 0.3) 0%,
        transparent 62%
      ),
      radial-gradient(
        ellipse 80% 40% at 100% 46%,
        rgba(255, 111, 168, 0.34) 0%,
        transparent 64%
      );
  }

  /* The print grain: one dotted layer for the whole page, so every section
     sits on the same paper rather than each inventing its own texture. */
  .fan-root::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1180px, 96vw);
    height: 900px;
    z-index: 0;
    pointer-events: none;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 62% 46% at 50% 34%,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0) 68%
    );
  }

  /* ⚠️ THE PRINT GRAIN IS DRAWN TWICE, ON PURPOSE, AND ONLY ONE OF THEM SHOWS.
     The shader in `FanMosaic.astro` draws this same dot grid (same 7px pitch)
     INTO the glass, refracted per pixel by the frost, so the grain belongs to
     the surface instead of sitting on top of it. This CSS copy is what the page
     falls back to when there is no WebGL2 (and for the frame or two before the
     shader's first draw), and it is switched off the moment the shader is up —
     two dot grids at slightly different phases moiré, which looks far worse than
     either one alone. The switch is `data-mosaic="on"`, written by the component. */
  .fan-root[data-mosaic="on"]::before {
    opacity: 0;
  }

  .fan-root::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--fan-dot) 1px, transparent 1.2px);
    background-size: 7px 7px;
    opacity: 0.5;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  /* ⚠️ Both exclusions are load-bearing, not tidiness. This rule sets
     `position: relative` on every direct child, and it sits AFTER those rules —
     same specificity (0-2-0), so it wins the cascade. Measured: the sticky module
     bar computed to `relative` and scrolled away, and `.fan-rail` computed to
     `relative` too, which put it at left -14px (off the left edge) instead of
     pinned to the right. Every direct child of .fan-root that positions itself
     MUST be named here.
     ⚠️ THREE times this rule has eaten a position: the sticky module bar, the
     fixed page rail, and the fixed sheep layer (which ended up 758×0 with
     `overflow: hidden`, so every sheep was clipped away). When something on this
     page will not position, look at THIS LIST first.
     ⚠️ `.fan-mosaic` is the fourth and `.fan-sky` the fifth, and both are the
     same trap. `.fan-mosaic` is `position: fixed; z-index: -1`; without the
     exclusion this rule gives it `position: relative; z-index: 1`, turning the
     viewport-fixed background into a 100vh band at the TOP OF THE DOCUMENT that
     scrolls away and covers the content. `.fan-sky` is `position: absolute;
     z-index: -1` and would be forced to `relative`, which would push the hero's
     pink wash into the flow as a 1400px-tall block and shove the whole page
     down. (The `isolation: isolate` note above explains the other half.) */
  .fan-root > *:not(.fan-modules, .fan-rail, .sheep-layer, .fan-mosaic, .fan-sky) {
    position: relative;
    z-index: 1;
  }

  /* ══ NO SITE CHROME ══
     The header and the footer are the studio's own dark surfaces, and the
     footer's scoped rules out-specify anything this page can write — so
     repainting them is a losing fight that ends in a black slab on a pink
     poster. This page is its own standalone thing and carries its own back
     link and language switch, so the site's bars are simply not shown.
     ⚠️ These are the only `:global` rules in this file, and each is scoped
     under `[data-fan]` so nothing can leak to another page.
     ⚠️ `display: none` and not `visibility: hidden`: a hidden-but-present bar
     keeps its height and leaves a dead band at the top of the page.
     ⚠️ `.site-content > header`, NOT a bare `header`. This page's own hero is a
     `<header>` too, so the obvious selector matched it as well and deleted the
     entire hero - top bar, then chips, then straight into module 01, with the
     pink cloud and the wordmark simply gone (caught in a full-page screenshot,
     not by any assertion). Keep this pinned to the site's own bar. */
  :global(body:has([data-fan]) .site-content > header),
  /* the dismissible "best viewed in desktop mode" bar */
  :global(body:has([data-fan]) #mobile-notice),
  :global(body:has([data-fan]) .footer),
  /* the dark scroll-telemetry rail down the right edge */
  :global(body:has([data-fan]) .scroll-cluster),
  /* the site's own dark-mode starfield decoration */
  :global(body:has([data-fan]) #starfield-canvas),
  :global(body:has([data-fan]) #star-canvas),
  :global(body:has([data-fan]) #neural-canvas) {
    display: none !important;
  }

  /* The page background comes from `.fan-root`, which fills the viewport so
     the dark `<html>` underneath can never show through at a short page. */
  :global(body:has([data-fan])) {
    background: var(--fan-cream);
  }
  /* ══════════════════════════════════════════════════════════════
     TOP BAR
     ══════════════════════════════════════════════════════════════ */
  .fan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 24px 0;
