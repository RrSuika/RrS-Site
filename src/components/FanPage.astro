---
/**
 * FanPage.astro — the standalone `/fan/` single page.
 *
 * A fan-facing page for the studio's artwork, styled after the pink-and-blue
 * print language of a game event board (参考: `Downloads/粉色参考/`). It is its own
 * route with its OWN complete look:
 *
 *   ⚠️ **ONE theme, on purpose.** The visitor asked for a single fixed style
 *   rather than a light/dark pair (「该界面只有一个风格而不是分 light / dark
 *   mode」). The site's theme attribute is still on `<html>` and still drives the
 *   navbar and footer, so the page overrides the theme tokens on `.fan-root`
 *   instead of trying to disable the switch — the site keeps working if the
 *   visitor flips the theme elsewhere and comes back.
 *
 *   ⚠️ **No `--accent*` override.** The amber accent also feeds the skip link and
 *   focus rings, which are not drawn by this page. Overriding the surface and
 *   text tokens is enough, and anything this page draws sets its own colours.
 *
 *   ⚠️ The two colours do different jobs and must not blur: pink is the SURFACE
 *   (backgrounds, cards, the air between things) and blue is the SIGNAL (buttons,
 *   numbers, the one line that points somewhere). The moment both are used for
 *   surfaces the page goes flat and the CTA stops reading as an event.
 */
import Layout from "../layouts/Layout.astro";
import FanMosaic from "./FanMosaic.astro";
import FanIntro from "./FanIntro.astro";
import {
  getLanguageFromPath,
  getLocalizedPath,
  type Language,
} from "../utils/i18n";
import { getArtImages } from "../utils/artImages";
import { fanCopy, getFanLanguage } from "../utils/fan";
import { CLOUD_BODY_D, ORN_PATHS } from "../utils/fanOrnaments";

interface Props {
  /** the route's own language; `/nl/fan/` is served from this component too */
  language?: Language;
}

const urlLanguage = getLanguageFromPath(Astro.url.pathname);
const language = (Astro.props as Props).language ?? urlLanguage;
const ui = getFanLanguage(language);
const c = fanCopy[ui];

/**
 * ⚠️ A helper instead of an inline `i < n ? "eager" : "lazy"`.
 *
 * A `<` inside a JSX **attribute expression** makes `astro check` mis-parse the
 * generated TSX: it reports "Unterminated string literal" and "':' expected"
 * pointing INTO the comment above the attribute, plus a boolean-to-string error
 * on a mangled attribute name. Measured: two errors in this file and two more in
 * `CassetteShelf.astro`, all from the same shape. The runtime was never affected
 * (the build and the page were fine) — it was purely diagnostics noise.
 * Moving the comparison into a function removes the `<` from the attribute.
 */
const coverLoading = (total: number, index: number): "eager" | "lazy" =>
  index < total * 2 ? "eager" : "lazy";
const isZh = ui === "zh";

/* ── the gallery: the studio's real artwork, discovered the same way the
      frozen /art pages discover it (shared source, no second manifest) ── */
/**
 * ⚠️ The `code` is printed on every plate, so it has to come from the plate's own
 * category. The first version cycled a fake `DP-EX-1/2/3` per index, which read
 * as a game stage the visitor could go and unlock.
 */
/**
 * ⚠️ "product-posters" is deliberately absent. Those plates are product renders,
 * and this is a fan page for the drawings — asked to come out
 * (「不需要展示 Product Posters 以及他的图片」). Dropping the folder here is the whole
 * change: the row list is built from these keys, so the folder stops getting a
 * row, and no second filter has to be kept in sync with this one.
 *
 * Labels live in the copy file per language (`c.categories`), because a row
 * heading is prose while an archive code is not. This map holds the code.
 */
const CATEGORIES: Record<string, { code: string }> = {
  illustrations: { code: "ILL" },
  "fashion-design": { code: "FSH" },
  "food-art": { code: "FOD" },
};

/**
 * Per-language titles. `cn` is the Chinese name of the subject; the Chinese page
 * reads it and falls back to `en`, so a missing one can never blank a title.
 *
 * ⚠️ `cn` values come from the drawings themselves where they could be checked
 * (Ceobe's hat and axe, Rossi's red fox hood and pigtails) and from the official
 * character names otherwise. Two are marked `guess` in the comment because the
 * filenames and the old titles did not agree — a wrong character name on an
 * artist's own portfolio is worse than leaving the English one.
 */
const TITLE_MAP: Record<string, Record<string, { en: string; cn: string }>> = {
  illustrations: {
    "01-xiaoke": { en: "Ceobe", cn: "刻俄柏" },
    "02-palasi": { en: "Pallas", cn: "帕拉斯" },
    "03-taojinniang": { en: "Myrtle", cn: "桃金娘" },
    "04-gua": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "05-aiyafala": { en: "Eyjafjalla", cn: "艾雅法拉" },
    "06-susuluo": { en: "Sussurro", cn: "苏苏洛" },
    // guess: the filename says Mofazhumi, the old title said Magic Piggy
    "07-mofazhumi": { en: "Magic Piggy", cn: "魔法猪咪" },
    "08-pepe": { en: "Pepe", cn: "佩佩" },
    "09-rossi": { en: "Rossi", cn: "洛茜" },
  },
  // four outfits for one character, so they share a name and the archive code
  // (FSH-01..04) is what tells them apart
  "fashion-design": {
    "01-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "02-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "03-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
    "04-ibuki-suika": { en: "Ibuki Suika", cn: "伊吹萃香" },
  },
  "food-art": {
    "01-seven-color-yokan": { en: "Seven-Color Yōkan", cn: "七色羊羹" },
    "02-niten-ichiryu": { en: "Niten Ichi-ryū", cn: "二天一流" },
    "03-wellington-steak": { en: "Wellington Steak", cn: "惠灵顿牛排" },
    // guess: a literal reading of the English title
    "04-unconscious-mousse": { en: "Unconscious Monster Mousse", cn: "无意识怪物慕斯" },
    "05-tricolor-icecream": { en: "Kedama Tricolor Ice Cream", cn: "毛玉三色冰淇淋" },
    "06-burnt-pudding": { en: "Burnt Pudding", cn: "焦糖布丁" },
  },
};

function titleFromFilename(folder: string, filename: string): string {
  const key = filename.replace(/\.[^.]+$/, "");
  const mapped = TITLE_MAP[folder]?.[key];
  if (mapped) return ui === "zh" ? mapped.cn : mapped.en;
  let name = filename
    .replace(/^.*[\\/]/, "")
    .replace(/\.(png|jpe?g|webp)$/i, "");
  name = name.replace(/^\d+[-_]/, "");
  name = name.replace(/[-_]/g, " ");
  return name.replace(/\b\w/g, (ch) => ch.toUpperCase());
}

interface Plate {
  src: string;
  title: string;
  folder: string;
  category: string;
  index: string;
  /** the printed archive code, e.g. `ILL-03` */
  code: string;
}

const all = getArtImages();

/** How many plates each folder has contributed so far, for the code's number. */
const emitted: Record<string, number> = {};

const plates: Plate[] = all.map((image, i) => {
  const meta = CATEGORIES[image.folder];
  emitted[image.folder] = (emitted[image.folder] ?? 0) + 1;
  return {
    src: image.src,
    title: titleFromFilename(image.folder, image.filename),
    folder: image.folder,
    /* ⚠️ The label comes from the COPY (`c.categories`), not from the folder name.
       It used to be `meta?.[ui] ?? meta?.en ?? image.folder`, where `meta` is the
       `{ code }` entry — so both lookups were always undefined and every plate fell
       back to the raw folder string. On the English page that is invisible
       ("illustrations" → ILLUSTRATIONS), but the Chinese page printed
       「ILLUSTRATIONS」 instead of 「插画」 — a real copy bug hidden behind a wrong
       type annotation, which is why `astro check` was the thing that found it. */
    category: c.categories[image.folder] ?? image.folder,
    index: String(i + 1).padStart(2, "0"),
    code: `${meta?.code ?? "PLT"}-${String(emitted[image.folder]).padStart(2, "0")}`,
  };
});

/* One row per folder that actually has artwork, so an empty folder leaves no
   空 row behind — same rule as the /art pages. */
/**
 * `copies` is how many times the row's own items are repeated to build one
 * seamless loop, and it is a function of the VIEWPORT, not a fixed number.
 *
 * ⚠️ The /art page uses `max(3, ceil(12 / n))` and that is wrong here: it paints
 * the collection three times over, so the longest row showed the same nine
 * drawings repeated across the whole screen once (measured 27 cards / 5517 px
 * against a 1132 px viewport).
 *
 * The loop works because `trackWidth = copies × (card + gap) − gap`, so one
 * period is exactly `copies × (card + gap)`. That is why the card box, not
 * `clientWidth`, has to appear in the margin below — the slack has to cover the
 * gap that the last copy does not have. */
const ROW_ITEM_W = 216; // plate width + the row gap, in px (see .plate / .row-track)
const ROW_VIEW_W = 1600; // widest viewport the loop has to cover

const rows = Object.keys(CATEGORIES)
  .map((folder) => ({
    folder,
    label: c.categories[folder] ?? folder,
    items: plates.filter((p) => p.folder === folder),
  }))
  .filter((row) => row.items.length > 0)
  .map((row) => ({
    ...row,
    // two copies is the floor: one copy cannot loop at all
    // ⚠️ A floor of THREE, not two. With two copies the track is only one
    // period wider than the viewport, so at the moment the modulo fires there is
    // no room left and the seam is on screen — reported as the right-hand images
    // "flashing to the left to restart". Three copies means the wrap always lands
    // on identical pixels.
    copies: Math.max(3, Math.ceil(ROW_VIEW_W / (row.items.length * ROW_ITEM_W)) + 2),
  }));

/* The decoration set: `ORN_PATHS` and the cloud silhouette now live in
   `src/utils/fanOrnaments.ts`, because the arrival animation
   (`FanIntro.astro`) draws from the same sheet. Same paths, one copy.
   ⚠️ These are DECORATION. They never carry text a screen reader needs, they are
   `aria-hidden` and `pointer-events: none`, and they never use blue as a fill. */

/**
 * Where the loose ornaments sit in the hero, and in what colour. Hand-placed:
 * random scatter on a symmetrical key visual reads as noise.
 *
 * ⚠️ The colours are the page's OWN palette plus the two accents already approved
 * for it (gold on the crown, mint in the fruit). Pink stays the surface, blue stays
 * the signal; these are small marks, never fields.
 */
const INK = { magenta: "#f5308a", pink: "#ff6fa8", blue: "#1b25d8", gold: "#e0a92a", mint: "#2fb79a" };
const HERO_ORNS: { kind: string; x: string; y: string; size: number; turn: number; op: number; ink: string }[] = [
  // upper left
  { kind: "sparkle", x: "3%", y: "1%", size: 30, turn: -14, op: 1, ink: INK.magenta },
  { kind: "star", x: "11%", y: "11%", size: 16, turn: 10, op: 0.9, ink: INK.gold },
  { kind: "squiggle", x: "1%", y: "6%", size: 34, turn: -6, op: 0.6, ink: INK.magenta },
  { kind: "heart", x: "6%", y: "22%", size: 18, turn: -12, op: 0.85, ink: INK.pink },
  { kind: "rainbow", x: "14%", y: "2%", size: 28, turn: 0, op: 0.8, ink: INK.mint },
  { kind: "dot", x: "9%", y: "15%", size: 6, turn: 0, op: 0.7, ink: INK.blue },
  { kind: "sun", x: "20%", y: "19%", size: 20, turn: 0, op: 0.8, ink: INK.gold },
  { kind: "sparkle", x: "24%", y: "6%", size: 15, turn: 18, op: 0.8, ink: INK.blue },
  // upper middle, clear of the cloud
  { kind: "star", x: "31%", y: "2%", size: 11, turn: -8, op: 0.7, ink: INK.blue },
  { kind: "dot", x: "36%", y: "13%", size: 5, turn: 0, op: 0.6, ink: INK.gold },
  { kind: "sparkle", x: "67%", y: "3%", size: 17, turn: -12, op: 0.85, ink: INK.magenta },
  { kind: "dot", x: "72%", y: "15%", size: 6, turn: 0, op: 0.65, ink: INK.mint },
  // upper right
  { kind: "sparkle", x: "94%", y: "2%", size: 26, turn: 12, op: 0.95, ink: INK.blue },
  { kind: "bubble", x: "88%", y: "13%", size: 17, turn: 0, op: 0.75, ink: INK.blue },
  { kind: "star", x: "82%", y: "5%", size: 14, turn: -10, op: 0.85, ink: INK.magenta },
  { kind: "squiggle", x: "93%", y: "20%", size: 30, turn: 8, op: 0.6, ink: INK.mint },
  { kind: "sun", x: "78%", y: "22%", size: 24, turn: 0, op: 0.9, ink: INK.gold },
  { kind: "cloud", x: "85%", y: "28%", size: 22, turn: 0, op: 0.6, ink: INK.blue },
  { kind: "dot", x: "91%", y: "9%", size: 5, turn: 0, op: 0.6, ink: INK.pink },
  // lower band, flanking the wordmark
  { kind: "dot", x: "2%", y: "30%", size: 7, turn: 0, op: 0.6, ink: INK.mint },
  { kind: "curl", x: "5%", y: "33%", size: 30, turn: 0, op: 0.65, ink: INK.pink },
  { kind: "heart", x: "93%", y: "34%", size: 16, turn: 14, op: 0.75, ink: INK.pink },
  { kind: "sparkle", x: "88%", y: "37%", size: 19, turn: -16, op: 0.85, ink: INK.magenta },
  { kind: "curl", x: "74%", y: "33%", size: 26, turn: -6, op: 0.55, ink: INK.mint },
  { kind: "bubble", x: "13%", y: "35%", size: 14, turn: 0, op: 0.6, ink: INK.blue },
];

/**
 * Per-letter spacing of the wordmark, in px: ONE ENTRY PER CHARACTER SPAN, in the
 * order the markup below builds them (`RRSUIKA STUDIO` is 14 spans, the space
 * included). The number is the gap to the RIGHT of that character; the last entry is
 * the end of the run, where there is nothing to space against.
 *
 * ⚠️ These are the VISITOR's numbers, tuned on the real page (2026-09-30) with a
 * temporary dev-only slider panel that has since been deleted — Pacifico's own
 * spacing evened out pair by pair, which is the only way to do it: the face's
 * advances differ a lot (`U` wanted +19.5 after it, `D` -3.25). All zeroes is the
 * untouched default; to re-tune, write the numbers here and reload — the values are
 * plain `margin-right` on the spans below, so a devtools edit previews them live.
 */
const TITLE_GAPS: number[] = [2, 3.75, 5, 19.5, 4, 11.25, 0, 14.75, -0.25, -2, 8.5, -3.25, 0, 0];

const enHref = getLocalizedPath("/fan/", "en");
const zhHref = getLocalizedPath("/fan/", "zh");
const artHref = getLocalizedPath("/art", language);
---

<Layout
  title={`${c.docTitle} | RrSuika Studio`}
  description={c.metaDescription}
  alternateHrefs={[
    { lang: "en", href: enHref },
    { lang: "zh-CN", href: zhHref },
  ]}
  noIndex
  ownIntro
  scriptFont
>
  {/* ⚠️ FIRST in the page, and a SIBLING of `.fan-root` rather than a child:
      `.fan-root > *:not(...)` forces `position: relative` on everything it does
      not name, which would turn the fixed overlay into a page-tall block, and
      being first is what gets the cover painted before the page behind it. */}
  <FanIntro language={language} />


  <div class="fan-root" data-fan>
    <!-- The animated background. It is a direct child of .fan-root and
         `position: fixed` at z-index -1 — which is why `.fan-root` carries
         `isolation: isolate` and why `.fan-mosaic` is named in the
         `.fan-root > *:not(...)` list below. Both are load-bearing. -->
    <FanMosaic />

    <!-- The hero's pink sky, kept as its OWN layer so it can sit OVER the
         animated background instead of under it. See .fan-sky in the styles:
         the canvas covers .fan-root's background, so anything meant to be
         seen on top of the mosaic has to be a real element. -->
    <div class="fan-sky" aria-hidden="true"></div>

    <!-- ══════════ TOP BAR ══════════ -->
    <div class="fan-top">
      {/* ⚠️ No back link here any more. The footer carries the same one, and the
          visitor asked for the duplicate to go: 「去掉粉丝页左上角的 与我合作。
          因为页尾已经重复了一次」. The bar keeps the language switch, and the empty
          span keeps it pinned right without touching the flex rule. */}
      <span aria-hidden="true"></span>

      {/* ⚠️ `data-active` is what moves the pill, and it is SERVER-RENDERED: the
          slide is a CSS transform off this one attribute, so it is already in the
          right place on the new page before the first paint, and no script has to
          measure anything. The visitor asked for it to work like the site's
          light/dark switch (「中文的蓝色框水平滑到 EN 上面」). */}
      <div class="fan-langs" role="group" aria-label={c.langSwitchLabel} data-active={ui}>
        <span class="fan-lang-pill" aria-hidden="true"></span>
        <a
          class:list={["fan-lang", ui === "en" && "is-on"]}
          href={enHref}
          hreflang="en"
          aria-current={ui === "en" ? "true" : undefined}>EN</a
        >
        <a
          class:list={["fan-lang", ui === "zh" && "is-on"]}
          href={zhHref}
          hreflang="zh-CN"
          aria-current={ui === "zh" ? "true" : undefined}>中文</a
        >
      </div>
    </div>

    <!-- ══════════ PAGE RAIL ══════════
         The site hides its scrollbar by choice, and this page follows that rule.
         A page this long still needs to say where you are in it, so the position is
         drawn instead: a blue rail on the right, one colour (blue is the SIGNAL on
         this page) with a soft pink halo. It is decorative, so it is aria-hidden and
         it never takes a pointer event. `--fan-read` is the filled fraction. -->
    <div class="fan-rail" aria-hidden="true">
      <span class="fan-rail-fill"></span>
    </div>

    <!-- ══════════ HERO ══════════ -->
    <header class="fan-hero">
      <span class="hero-orn" aria-hidden="true">
        {
          HERO_ORNS.map((o) => (
            <i
              class="orn"
              style={`left:${o.x};top:${o.y};width:${o.size}px;height:${o.size}px;opacity:${o.op};color:${o.ink};transform:rotate(${o.turn}deg)`}
            >
              <svg viewBox="0 0 24 24" focusable="false">
                <path
                  class={ORN_PATHS[o.kind].stroke ? "orn-stroke" : "orn-fill"}
                  d={ORN_PATHS[o.kind].d}
                />
              </svg>
            </i>
          ))
        }
      </span>

      <div class="hero-blob" aria-hidden="true">
        {/* The cloud is ONE path: a scalloped top and a scalloped bottom,
            symmetric about x=120. Both the pink edge and the white inner line
            come from the same outline, which is what makes it read as printed
            rather than as three stacked discs. */}
        {/* ⚠️ ONE closed path, square viewBox, and every arc is `a r r 0 0 1 dx 0`
            so it is a half circle by construction. The previous silhouette was not
            closed: the last sweep ended short of the start point, which left a
            straight chord across the bottom-left — the visitor reported it as
            「他上面这朵云不完整」. `fill-rule: evenodd` on the outer path and the
            inner one in the SAME `d` punches the white centre out, which is also
            what removed the seagull-notch the old bottom arc drew. */}
                {/* ⚠️ Square viewBox, and it must STAY square. The path spans x 22..220 and
            y 47..183, so a tight viewBox (25 50 192 132) looks like the obvious
            tidy-up — and it STRETCHES the cloud badly, because `meet` then fills
            the width and scales the shape to 290x199, i.e. 1.34x wider than tall.
            The empty band under the silhouette is handled by the layout instead
            (`.hero-blob` pulls the following line up over it). */}
        <svg class="cloud" viewBox="0 0 242 242" focusable="false">
          <path
            class="cloud-body"
            d={CLOUD_BODY_D}
            fill-rule="evenodd"
          />
        </svg>

        <svg class="crown" viewBox="0 0 120 88" focusable="false">
          {/* one FLAT colour: no gradient, no outline */}
          {/* ⚠️ NO outline. A black edge on a small gold object against bright
              pink reads as a sticker; the gradient's dark bottom stop is what
              defines the form instead. */}
          <path
            d="M18 70 L18 26 L42 44 L60 10 L78 44 L102 26 L102 70 Z"
            fill="var(--fan-gold)"
          />
          <rect x="10" y="66" width="100" height="12" rx="6" fill="var(--fan-gold)" />
        </svg>

        {/* sparkles: four-point stars, drawn not typed */}
        <span class="spark spark-a"></span>
        <span class="spark spark-b"></span>
        <span class="spark spark-c"></span>
        <span class="spark spark-d"></span>
      </div>

      <span class="fan-hero-echo" data-orn aria-hidden="true">{c.hero.cn}</span>

      {/* ⚠️ Split into ONE SPAN PER CHARACTER. Not decoration: `TITLE_GAPS` is indexed
          by exactly this order, and a single text node could not take per-letter
          margins. The space becomes a non-breaking space so it is a span like any
          other (and can carry its own gap). */}
      <h1 class="fan-title">
        {c.hero.title.split("").map((ch, i) => (
          <span
            class="tl"
            style={TITLE_GAPS[i] ? `margin-right:${TITLE_GAPS[i]}px` : undefined}>{ch === " " ? "\u00A0" : ch}</span>
        ))}
      </h1>
      <p class="fan-title-cn">{c.hero.cn}</p>
      <p class="fan-sub">{c.hero.sub}</p>

      {/* ⚠️ No hero CTAs. There was a 看画 / 找到我 pair jumping to #gallery
          and #contact; the visitor took them out — the page is short enough that
          scrolling IS the navigation, and two buttons for four modules was noise. */}

      <p class="fan-stamp">{c.hero.stamp}</p>
    </header>

    <!-- ══════════ MODULE 01 · INTRODUCTION ══════════ -->
    <section class="fan-block fan-intro" id="intro">
      <div class="block-head">
        <span class="block-tag">{c.intro.tag}</span>
        <h2 class="block-title">{c.intro.title}</h2>
      </div>

      <div class="intro-grid">
        <div class="intro-copy">
          {c.intro.paras.map((para) => <p class="about-para">{para}</p>)}
        </div>

        <dl class="intro-facts">
          {
            c.intro.facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ══════════ MODULE 02 · GALLERY ══════════ -->
    <section class="fan-bleed fan-field" id="gallery">
      {/* ⚠️ The `orn-dots` field was here, and it had to go: it is a HALFTONE
          GRID at an 11px pitch (`.orn-dots`, radius 1.6px, opacity 0.34) laid
          over the page's own print grain at a 7px pitch — two dot lattices at
          different pitches and phases, which beat against each other. The
          visitor: 「画廊那边的点阵图和其他地方的点阵图不一样，画廊那边看起来有
          多个点阵图重叠的问题」. Measured at 3x in the gap between two plates:
          big soft blobs over a fine grid. The page now has ONE texture — the
          shader's grain, fixed to the viewport — and every section inherits it. */}
      <div class="bleed-head">
        <div class="block-head">
          <span class="block-tag">{c.gallery.tag}</span>
          <h2 class="block-title">{c.gallery.title}</h2>
          <p class="block-sub">{c.gallery.sub}</p>
        </div>
      </div>

      {
        rows.length === 0 ? (
          <p class="fan-empty">{c.gallery.sub}</p>
        ) : (
          rows.map((row, rowIndex) => (
            <section class="fan-row" data-row={rowIndex}>
              <div class="row-head">
                <span class="row-idx">
                  {(rowIndex + 1).toString().padStart(2, "0")}
                </span>
                <h3>{row.label}</h3>
                <span class="row-count">
                  {row.items.length} {c.chips.works}
                </span>
              </div>

              <div class="row-view" data-view={rowIndex}>
                <div
                  class="row-track"
                  data-track={rowIndex}
                  data-copies={row.copies}
                  data-unique={row.items.length}
                >
                  {Array.from({ length: row.copies }, () => row.items)
                    .flat()
                    .map((plate, i) => (
                      <button
                        class="plate"
                        type="button"
                        data-row={rowIndex}
                        data-idx={i % row.items.length}
                        data-src={plate.src}
                        data-title={plate.title}
                        aria-label={plate.title}
                      >
                        <span class="plate-media">
                          {/* ⚠️ EAGER for the first copy, and the rest are
                              preloaded by the script below. `lazy` past the first
                              six is what made the row stutter: a repeated copy
                              scrolls into view before its image has been decoded,
                              so it arrives a frame late and reads as a sudden
                              refresh. The /art page has no such gap — every image
                              is already in the document.
                              ⚠️ This comment lives in a CHILD position, above the
                              element, and must never be moved into the attribute
                              list: the JSX comment form is not valid there, and
                              check reports an unterminated string two lines below
                              instead of pointing here. ⚠️ It must also never SPELL
                              that form out — an inner comment terminator would end
                              this block early and the rest of the prose would be
                              rendered as page text (measured 2026-09-29: the tail
                              of this comment printed inside every gallery card). */}
                          {/* ⚠️ `decoding="async"` is not decoration: the rows paint
                              two or three copies of the same set, so ~100 image
                              elements decode during the first second, and a sync
                              decode blocks the main thread. Nothing about the
                              rendered result changes. */}
                          <img
                            src={plate.src}
                            alt={plate.title}
                            loading={coverLoading(row.items.length, i)}
                            decoding="async"
                            draggable="false"
                          />
                        </span>
                        <span class="plate-foot">
                          <span class="plate-title">{plate.title}</span>
                          <span class="plate-cat">{plate.category}</span>
                        </span>
                      </button>
                    ))}
                </div>
              </div>
            </section>
          ))
        )
      }
    </section>

    <!-- ══════════ MODULE 03 · COMMISSIONS ══════════ -->
    <section class="fan-block fan-commission" id="commissions">
      <span class="sect-echo" data-orn aria-hidden="true">COMMISSION</span>
      <div class="commission-card">
        <div class="block-head">
          <span class="block-tag">{c.commissions.tag}</span>
          <h2 class="block-title">{c.commissions.title}</h2>
          {/* The status is a PLATE, not a sentence. It has to read from across
              the page at a glance, which is the whole job of this section. */}
          <span class="commission-status">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <rect x="4" y="9" width="12" height="8" rx="1.5" />
              <path d="M7 9 V6.5 a3 3 0 0 1 6 0 V9" />
            </svg>
            {c.commissions.status}
          </span>
        </div>

        {c.commissions.body.map((para) => <p class="about-para">{para}</p>)}
        <p class="commission-note">{c.commissions.note}</p>

        {/* ── the 催更 button ── */}
        <div class="nudge">
          {/* The visitor's own avatar: one jump per press.
               ⚠️ `Pfp Transparent.gif` in 输入/ is 1700x1700, 28 frames at 25fps and
               4.4 MB. It was transcoded once with ffmpeg to 240px / 183 KB into
               `public/fan/avatar.gif` (see `docs/fan-page.md` §十六).
               ⚠️ Its NETSCAPE loop block is PRESENT (`-loop 0`), and that is the
               SECOND version of this file: stripping the block so the animation
               could be "played once per press" also froze it on its last frame
               forever, and the visitor reported exactly that (「gif不再自己跳动」).
               A GIF carrying a loop block restarts from frame 0 when its `src` is
               re-assigned, which is how a press still restarts it. */}
          <img
            class="nudge-pfp"
            data-nudge-pfp
            src="/fan/avatar.gif"
            alt=""
            aria-hidden="true"
            draggable="false"
            width="240"
            height="240"
          />
          <button class="nudge-btn" type="button" data-nudge>
            <span class="nudge-ring" aria-hidden="true"></span>
            <span class="nudge-burst" aria-hidden="true">
              {
                Array.from({ length: 8 }, (_, i) => (
                  <i style={`--a:${i * 45}deg`} class="nudge-spark" />
                ))
              }
            </span>
            <span class="nudge-face">
              <span class="nudge-label">{c.commissions.nudge}</span>
            </span>
          </button>
          <p class="nudge-tally" aria-live="polite">
            <span class="nudge-count" data-nudge-count>0</span>
            <span>{c.commissions.nudgeUnit}</span>
          </p>
          <!-- ⚠️ The POOL travels to the client script as a data attribute.
               The script used to need no copy at all (it only un-hid this
               paragraph), and `define:vars` is not an option here: it implies
               `is:inline`, which would de-bundle the whole 800-line module. -->
          <p
            class="nudge-back"
            data-nudge-back
            data-nudge-replies={JSON.stringify(c.commissions.nudgeThanks)}
            hidden>{c.commissions.nudgeThanks[0]}</p>
        </div>
      </div>
    </section>

    <!-- ══════════ MODULE 04 · CONTACT ══════════ -->
    <section class="fan-block" id="contact">
      <div class="block-head">
        <span class="block-tag">{c.contact.tag}</span>
        <h2 class="block-title">{c.contact.title}</h2>
        <p class="block-sub">{c.contact.sub}</p>
      </div>

      <ul class="contact-list">
        {
          c.contact.links.map((link) =>
            link.href ? (
              <li class="contact-row">
                <a class="contact-link" href={link.href}>
                  {/* ⚠️ The handle is NOT printed. The visitor asked for it out:
                      the pill is clickable, so showing the URL was noise. The label
                      is the only text, and the arrow says where it goes. */}
                  <span class="contact-label">{link.label}</span>
                  <span class="contact-go" aria-hidden="true">↗</span>
                </a>
              </li>
            ) : (
              <li class="contact-row">
                <div class="contact-link" data-nolink="1">
                  <span class="contact-label">{link.label}</span>
                  {/* a handle with no public URL still has to SAY the handle, or
                      there is nothing to act on — so this one keeps its text and
                      shows a copy glyph instead of the arrow */}
                  <span class="contact-handle">{link.handle}</span>
                </div>
              </li>
            ),
          )
        }
      </ul>
    </section>

    <!-- ══════════ FAN FOOTER ══════════ -->
    <div class="fan-mark" data-orn aria-hidden="true">
      <span class="orn orn-tape"></span>
    </div>

    <footer class="fan-foot">
      {/* ⚠️ A real SVG cloud. The old `.foot-cloud` was a 120x44 pill with two
          `box-shadow` discs beside it and no top scallop at all, so its top edge was
          a straight cut — reported as 「云朵的顶部缺失了一块」. Same silhouette as
          the hero, a third of the size. */}
      <svg class="foot-cloud" viewBox="0 0 242 242" aria-hidden="true" focusable="false">
        <path d="M36 152 a28 28 0 0 1 6 -54 a32 32 0 0 1 46 -30 a40 40 0 0 1 66 0 a32 32 0 0 1 46 30 a28 28 0 0 1 6 54 a22 22 0 0 1 -30 6 a26 26 0 0 1 -40 0 a26 26 0 0 1 -40 0 a22 22 0 0 1 -30 -6 z" fill-rule="evenodd" />
      </svg>
      {/* ⚠️ Guarded, not unconditional: the visitor asked for the fan-tribute
          sentence to come out, and an empty string has to remove the line rather
          than leave its margin behind. */}
      {c.footer.note && <p class="foot-note">{c.footer.note}</p>}
      <a class="fan-btn fan-btn-blue" href={artHref}>
        <span>{c.footer.back}</span>
        <svg viewBox="0 0 26 14" aria-hidden="true" focusable="false">
          <path d="M0 7 H22 M16 1 L23 7 L16 13" />
        </svg>
      </a>
    </footer>

    {/* ── the sheep layer ──
        `pointer-events: none` on the layer and back ON per sheep: a full-screen
        layer that accepts hits would swallow every click on the page. */}
    <div class="sheep-layer" aria-hidden="true"></div>

    <!-- ══════════ LIGHTBOX ══════════ -->
    <aside
      class="fan-lightbox"
      id="fan-lightbox"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
    >
      <button class="lb-bg" type="button" data-lb-close aria-label={c.lightbox.close}
      ></button>
      <button class="lb-x" type="button" data-lb-close aria-label={c.lightbox.close}>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M4 4 L16 16 M16 4 L4 16" />
        </svg>
      </button>
      <button class="lb-nav lb-prev" type="button" data-lb-prev aria-label={c.lightbox.prev}>
        <svg viewBox="0 0 16 28" aria-hidden="true" focusable="false">
          <path d="M13 2 L3 14 L13 26" />
        </svg>
      </button>
      <button class="lb-nav lb-next" type="button" data-lb-next aria-label={c.lightbox.next}>
        <svg viewBox="0 0 16 28" aria-hidden="true" focusable="false">
          <path d="M3 2 L13 14 L3 26" />
        </svg>
      </button>
      <figure class="lb-body">
        <img id="fan-lb-img" src="" alt="" draggable="false" />
        <figcaption class="lb-cap" id="fan-lb-cap"></figcaption>
      </figure>
    </aside>
  </div>
</Layout>

<script>
  /* ── the archive rows: drag + idle drift, one rAF for all of them ── */
  interface Row {
    view: HTMLElement;
    track: HTMLElement;
    pos: number;
    dir: number;
    speed: number;
    hovering: boolean;
    dragging: boolean;
    dragX: number;
    dragPos: number;
    /** distance between two cards `unique` apart: exactly one loop, in px */
    period: number;
    /** how many cards `unique` is, for that measurement */
    unique: number;
  }

  const rows: Row[] = [];

  document.querySelectorAll<HTMLElement>("[data-view]").forEach((view, i) => {
    const track = view.querySelector<HTMLElement>("[data-track]");
    if (!track) return;

    const row: Row = {
      view,
      track,
      pos: 0,
      // Rows alternate so the page does not read as one mechanical belt.
      dir: i % 2 === 0 ? 1 : -1,
      speed: 0.22 + (i % 3) * 0.06,
      hovering: false,
      dragging: false,
      dragX: 0,
      dragPos: 0,
      period: 0,
      unique: Number(track.dataset.unique) || 1,
    };
    row.period = measurePeriod(row);
    rows.push(row);

    view.addEventListener("mouseenter", () => {
      row.hovering = true;
    });
    view.addEventListener("mouseleave", () => {
      row.hovering = false;
      row.dragging = false;
      view.style.cursor = "grab";
    });

    view.addEventListener("pointerdown", (e) => {
      row.dragging = true;
      row.dragX = e.clientX;
      row.dragPos = row.pos;
      view.style.cursor = "grabbing";
      try {
        view.setPointerCapture(e.pointerId);
      } catch {
        /* capture is optional */
      }
    });
    view.addEventListener("pointermove", (e) => {
      if (!row.dragging) return;
      row.pos = row.dragPos + (row.dragX - e.clientX) * 1.4;
    });
    const release = () => {
      if (!row.dragging) return;
      row.dragging = false;
      view.style.cursor = row.hovering ? "grab" : "default";
    };
    view.addEventListener("pointerup", release);
    view.addEventListener("pointercancel", release);
  });

  /**
   * One period, in px: the distance from the first card to the card `unique` places
   * along the track - exactly one repeat of the set, measured on the laid-out cards.
   *
   * ⚠️ **This replaced `track.scrollWidth / copies` (the /art page's line), and the
   * reason is measurable.** A `.row-track` is a flex row with `gap: 16px` and
   * `padding: 0 24px`, so
   *
   *     scrollWidth / copies = period + (2 x 24 - 16) / copies
   *
   * i.e. the padding is counted once per copy and the missing last gap once per copy.
   * Measured on this page at 1440: row 0 stored **2178** against a true **2167.22**
   * (3 copies), row 1 **755** against **746.94**, row 2 **1592** against **1584** - so
   * every wrap teleported the row ~8-11px off where it started. `scrollWidth/copies`
   * is only "one set by construction" when the track has neither padding nor gaps.
   * Rects are sub-pixel and give the cards' own spacing directly.
   *
   * ⚠️ **AND IT HAS TO BE RE-MEASURED.** A plate is exactly as wide as its cover
   * (`.plate-media img { width: auto }` at a fixed 232px height), so the layout this
   * is read from does not exist until the covers have decoded. Read once, at script
   * time, on a cold load, the period is the width of a row of EMPTY boxes - and then
   * every wrap teleports the row by a whole screen, which is the visitor's 「图片拖动
   * 到一定距离后，他会突然消失，从画面的另一边出现」. The ResizeObserver below is
   * what catches the covers arriving; it fires on the track's own box, whatever made
   * it change.
   */
  function measurePeriod(row: Row): number {
    const cards = row.track.children;
    const first = cards[0];
    const next = cards[row.unique];
    if (first instanceof HTMLElement && next instanceof HTMLElement) {
      const period = next.getBoundingClientRect().left - first.getBoundingClientRect().left;
      if (period > 1) return period;
    }
    /* too few cards laid out to compare (not yet, or a row of one) - the track's own
       width is the honest fallback and is what the first frame uses anyway */
    return row.track.scrollWidth || 1;
  }

  window.addEventListener("resize", () => {
    for (const row of rows) row.period = measurePeriod(row);
  });

  /* ⚠️ The track changes size on its own: every cover that decodes widens its plate.
     Re-measuring on those changes is what keeps the wrap seamless - see the note on
     `measurePeriod`. Cheap enough to run per change (two rect reads per row) and it
     reads no layout that it writes. */
  if ("ResizeObserver" in window) {
    const reMeasure = new ResizeObserver(() => {
      for (const row of rows) row.period = measurePeriod(row);
    });
    for (const row of rows) reMeasure.observe(row.track);
  }

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  /**
   * ⚠️ Two reasons this loop can do nothing at all on a frame:
   *   - `html.is-fi` is set by `FanIntro` while the arrival covers the page. The
   *     rows are invisible then and the cover is compositing a dozen moving panels:
   *     a handful of `style.transform` writes per frame is small, but it is not
   *     free, and none of it can be seen.
   *   - a hidden tab. The mosaic already stands down on `document.hidden`
   *     (`FanMosaic.astro`); the marquee kept running, which is pure battery.
   * The position is not advanced either, so the rows resume exactly where they were
   * rather than jumping by the length of the pause.
   */
  function frame() {
    const held =
      document.documentElement.classList.contains("is-fi") || document.hidden;
    if (!held) {
      for (const row of rows) {
        if (!row.dragging && !row.hovering && !reduceMotion) {
          row.pos += row.speed * row.dir;
        }
        // Seamless wrap on the MEASURED period (see `measurePeriod`). Every time the
        // position crosses it the picture is identical, so the modulo is invisible by
        // construction — which is the whole requirement for a loop. Written as one
        // `((x % p) + p) % p` so a drag that overshoots into the negative still lands
        // on the same pixels.
        if (row.period > 0) {
          const wrapped = ((row.pos % row.period) + row.period) % row.period;
          if (wrapped !== row.pos) row.pos = wrapped;
        }
        row.track.style.transform = `translate3d(${-row.pos}px,0,0)`;
      }
    }
    requestAnimationFrame(frame);
  }
  /* ⚠️ A probe handle, like `window.__fanIntro` / `window.__fanMosaic`: the wrap is
     INVISIBLE when the period is right and a visible jump when it is wrong, and the
     only honest way to tell those apart is to read `period` and compare it with the
     cards' own spacing in the DOM (`输入/_scratch/fan-wrap.mjs`). Nothing in the page
     reads it. */
  (window as typeof window & { __fanRows?: unknown }).__fanRows = rows;

  if (rows.length > 0) requestAnimationFrame(frame);

  /* ── the language switch: it plays the page's ARRIVAL, it does not fade ──
     `/fan/` and `/zh/fan/` are two documents, so this is a navigation and the switch
     cannot be animated from here. The visitor asked for the page's own cloud-burst
     arrival to BE the switch — 「切换语言时，我需要直接播放运动入场动画，然后结束后是
     另一个语言」 — so the click does exactly one thing: it leaves a note for the
     ARRIVING document, whose `FanIntro` reads it and plays even though this session
     has already seen the arrival once (see `KEY_SWITCHED` there).

     ⚠️ The navigation is NOT intercepted, faded or delayed any more. Two earlier
     versions animated this side (a text cross-fade, then a screenshot of the whole
     page under `@view-transition`) and both of them fought the same fact: nothing
     here knows when the other document will be ready to paint. Left alone, the
     browser keeps THIS page on screen until the next one has something to show —
     which is now the arrival cover, because the incoming document is held unpainted
     until that cover can cover (the `is-fi-hold` guard in `Layout.astro`).

     ⚠️ Two guards stay: a modified click (cmd/ctrl/shift/middle) means "open it
     somewhere else" and must not arm anything here, and the ALREADY ACTIVE label is
     a no-op rather than a reload — arming the flag for a click that goes nowhere
     would make some LATER navigation play the arrival out of nowhere. */
  (() => {
    const LANGS = document.querySelector<HTMLElement>(".fan-langs");
    if (!LANGS) return;
    /* the same key `FanIntro.astro` reads; it is cleared as it is consumed */
    const KEY = "rrsuika-fan-arrive";

    LANGS.addEventListener("click", (event: MouseEvent) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a.fan-lang");
      if (!link || link.classList.contains("is-on")) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return;
      }
      try {
        sessionStorage.setItem(KEY, "1");
      } catch (_) {}
    });
  })();

  /* ── warm every plate - and do it DURING the arrival when there is one ──
     The rows paint 2-3 copies of the same set; only the first two carry an `eager`
     image, and the copies further along are `lazy`. Decoding the unique URLs once is
     what makes the loop continuous instead of stop-start, and it is exactly what the
     /art page gets for free by putting every image in the document.

     ⚠️ **The arrival is the free window, and the visitor asked for it in as many
     words**: 「云朵加载动画完成后，翻到下面的画廊时，图片依旧要先加载出现，这个等待
     本应该在云朵加载动画时完成」. While the cloud cover is up the page is behind an
     opaque canvas, so nothing that loads now can spoil a frame - and the cover is up
     for 3.5s, which is longer than the whole gallery takes on a warm connection.

     ⚠️ **It flips the LAZY copies to `eager` rather than only pre-fetching into the
     cache.** A pre-fetch (`new Image()`) fills the HTTP cache but leaves the real
     `<img>` elements unfetched, and a plate is exactly as wide as its cover
     (`.plate-media img { width: auto }`), so each cover that arrives later grows its
     plate from a stub to its real width AND SHIFTS EVERY CARD AFTER IT - measured on
     a cold load: 47 of 67 covers ready when the arrival ended, the remaining 20
     arriving whenever the visitor scrolled or dragged them into view, each one
     re-flowing its row. Driving the elements themselves means the layout is final
     before the cover opens. (`warmPlates` still runs as well: it is what the lightbox
     reads, and it is the same URLs, so it costs no extra bytes.)

     Without an arrival (an ordinary navigation inside the session) there is nothing
     to hide the work behind, so the deferred path stays: `load` + 200ms, off the
     first paint. */
  const warmPlates = () => {
    const seen = new Set<string>();
    document.querySelectorAll<HTMLElement>(".plate").forEach((plate) => {
      const src = plate.dataset.src ?? "";
      if (!src || seen.has(src)) return;
      seen.add(src);
      const img = new Image();
      img.decoding = "async";
      img.src = src;
    });
  };

  /* `is-fi` is set by `FanIntro` on `<html>` before the hero is parsed, and cleared
     when the arrival finishes - so this is true exactly when a cover is covering. */
  const arrivalCovering = document.documentElement.classList.contains("is-fi");
  if (arrivalCovering) {
    document
      .querySelectorAll<HTMLImageElement>(".plate img")
      .forEach((img) => {
        img.loading = "eager";
      });
    warmPlates();
  } else if (document.readyState === "complete") {
    window.setTimeout(warmPlates, 200);
  } else {
    window.addEventListener("load", () => window.setTimeout(warmPlates, 200), { once: true });
  }
  /* ── a click opens the lightbox; a drag does not. Track the press origin so
        a row drag never lands on a plate. ── */
  const lb = document.getElementById("fan-lightbox");
  const lbImg = document.getElementById("fan-lb-img") as HTMLImageElement | null;
  const lbCap = document.getElementById("fan-lb-cap");
  let pressX = 0;
  let pressY = 0;
  let currentRow = 0;
  let currentIdx = 0;

  const platesOf = (row: number) =>
    Array.from(
      document.querySelectorAll<HTMLElement>(`.plate[data-row="${row}"]`),
    );

  function uniqueCount(row: number): number {
    const track = document.querySelector<HTMLElement>(`[data-track="${row}"]`);
    const n = Number(track?.dataset.unique);
    return Number.isFinite(n) && n > 0 ? n : platesOf(row).length;
  }

  function paint() {
    const plates = platesOf(currentRow);
    if (plates.length === 0 || !lbImg) return;
    const plate = plates[currentIdx];
    const src = plate.dataset.src ?? "";
    const title = plate.dataset.title ?? "";
    // Preload, then swap, so the caption never changes over a blank frame.
    const next = new Image();
    next.onload = () => {
      lbImg.src = src;
    };
    next.src = src;
    if (lbCap) lbCap.textContent = title;
  }

  function openLb(row: number, idx: number) {
    if (!lb) return;
    currentRow = row;
    currentIdx = idx;
    paint();
    lb.classList.add("is-on");
    lb.setAttribute("aria-hidden", "false");
    // Keep the page from scrolling behind the overlay without losing its place.
    const y = window.scrollY;
    document.body.style.position = "fixed";
    document.body.style.top = `-${y}px`;
    document.body.style.width = "100%";
  }

  function closeLb() {
    if (!lb) return;
    lb.classList.remove("is-on");
    lb.setAttribute("aria-hidden", "true");
    const top = document.body.style.top;
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.width = "";
    window.scrollTo(0, Number.parseInt(top || "0", 10) * -1);
  }

  document.querySelectorAll<HTMLElement>(".plate").forEach((plate) => {
    plate.addEventListener("pointerdown", (e) => {
      pressX = e.clientX;
      pressY = e.clientY;
    });
    plate.addEventListener("click", (e) => {
      // ⚠️ The row is a drag surface, so a press that travelled is a drag, not a
      // click. 5px in either axis is the threshold.
      if (Math.abs(e.clientX - pressX) > 5 || Math.abs(e.clientY - pressY) > 5) {
        return;
      }
      openLb(Number(plate.dataset.row), Number(plate.dataset.idx));
    });
  });

  document
    .querySelectorAll<HTMLElement>("[data-lb-close]")
    .forEach((el) => el.addEventListener("click", closeLb));
  document.querySelector("[data-lb-prev]")?.addEventListener("click", () => {
    currentIdx = (currentIdx - 1 + uniqueCount(currentRow)) % uniqueCount(currentRow);
    paint();
  });
  document.querySelector("[data-lb-next]")?.addEventListener("click", () => {
    currentIdx = (currentIdx + 1) % uniqueCount(currentRow);
    paint();
  });

  document.addEventListener("keydown", (e) => {
    if (!lb?.classList.contains("is-on")) return;
    if (e.key === "Escape") closeLb();
    if (e.key === "ArrowLeft") {
      currentIdx = (currentIdx - 1 + uniqueCount(currentRow)) % uniqueCount(currentRow);
      paint();
    }
    if (e.key === "ArrowRight") {
      currentIdx = (currentIdx + 1) % uniqueCount(currentRow);
      paint();
    }
  });

  /* ── the 催更 button ──
     Not a link: there is nowhere to send the visitor, so it must not pretend to
     navigate. It counts the press, plays the burst, and then says thank you.
     ⚠️ `offsetWidth` between the class remove/add forces the reflow that lets the
     animation replay; without it the SECOND press is silent and the counter is the
     only thing that moves, which is exactly the flat feedback the visitor asked
     to avoid. */
  /** set by the sheep block below; the nudge button hands its press to it */
  let nudgeSpawn: ((btn: HTMLElement) => void) | null = null;

  const nudgeBtn = document.querySelector<HTMLButtonElement>("[data-nudge]");
  if (nudgeBtn) {
    const countEl =
      nudgeBtn.parentElement?.querySelector<HTMLElement>("[data-nudge-count]");

    const backEl =
      nudgeBtn.parentElement?.querySelector<HTMLElement>("[data-nudge-back]");

    /**
     * Local copy of the server count.
     *
     * IMPORTANT:
     * This is no longer the source of truth.
     * The real count lives in Cloudflare D1.
     */
    let nudges = 0;

    /**
     * The reply pool, read from the paragraph's own data attribute.
     */
    const replies = (() => {
      try {
        const list = JSON.parse(
          backEl?.dataset.nudgeReplies ?? "[]",
        ) as string[];
        if (Array.isArray(list) && list.length) {
          return list;
        }
      } catch {
        /* fall through */
      }
      return [backEl?.textContent ?? ""];
    })();
    let replyAt = 0;
    const replay = (el: HTMLElement, cls: string) => {
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
    };
    /**
     * Only ever move the visible counter FORWARD.
     *
     * Multiple clicks can be in flight simultaneously. If responses return
     * in a different order, an older response must not visually overwrite
     * a newer count.
     */
    const applyServerCount = (value: unknown) => {
      const next = Number(value);

      if (!Number.isFinite(next)) return;

      if (next < nudges) return;

      nudges = next;

      if (countEl) {
        countEl.textContent = String(nudges);
        replay(countEl, "is-bump");
      }
    };

    /**
     * Load the real total when the page opens.
     */
    const loadNudgeCount = async () => {
      try {
        const response = await fetch("/api/nudge", {
          method: "GET",
          headers: {
            Accept: "application/json",
          },
        });

        if (!response.ok) {
          throw new Error(`Nudge GET failed: ${response.status}`);
        }

        const data = await response.json();

        if (data.success) {
          applyServerCount(data.count);
        }
      } catch (error) {
        console.error("Failed to load nudge count:", error);
      }
    };

    /**
     * The avatar, restarted from frame 0 on every press.
     */
    const pfpEl =
      nudgeBtn.parentElement?.querySelector<HTMLImageElement>("[data-nudge-pfp]");

    const pfpSrc = pfpEl?.getAttribute("src") ?? "";

    const jump = () => {
      if (!pfpEl || !pfpSrc) return;

      pfpEl.removeAttribute("src");

      void pfpEl.offsetWidth;

      pfpEl.setAttribute("src", pfpSrc);
    };

    /**
     * ── the press ──
     *
     * ⚠️ **THE TOY COMES FIRST, THE COUNTER SECOND.** A first version awaited
     * `POST /api/nudge` and only then ran the press animation, the avatar jump,
     * the reply and the fruit — i.e. every visible result of pressing the button
     * was gated on a network round trip, and skipped entirely when the request
     * failed (which is the normal case on `astro dev`, where `/api/nudge` does
     * not exist and returns 404). Measured: with the endpoint unreachable the
     * button did NOTHING at all, and on a good connection the jump landed
     * 100-250ms after the click, which is exactly the lag the "press faster, jump
     * faster" behaviour cannot have.
     *
     * So the visuals fire synchronously on the click, and the COUNT is the side
     * effect: it is incremented locally right away (optimistic), then reconciled
     * with whatever the server says. `applyServerCount` only ever moves the number
     * forward, so a slow reply cannot walk it backwards, and a failed request
     * leaves the optimistic number on screen with a quiet warning instead of an
     * error.
     */
    nudgeBtn.addEventListener("click", () => {
      // ── instant, local, never gated on the network ──
      nudges += 1;

      if (countEl) {
        countEl.textContent = String(nudges);
        replay(countEl, "is-bump");
      }

      replay(nudgeBtn, "is-hit");
      jump();

      if (backEl) {
        if (backEl.hidden) {
          backEl.hidden = false;
        }

        if (replies.length > 1) {
          const next = Math.floor(Math.random() * (replies.length - 1));
          replyAt = next >= replyAt ? next + 1 : next;
        }

        backEl.textContent = replies[replyAt];
        replay(backEl, "is-pop");
      }

      nudgeSpawn?.(nudgeBtn);

      // ── and the shared counter catches up when it can ──
      void sendNudge();
    });

    /**
     * One press = one POST. Fire and forget: the click handler never awaits it,
     * so a slow or dead endpoint cannot delay the toy.
     *
     * ⚠️ `keepalive` so a press immediately before a navigation or a tab close
     * still reaches the database — without it the request is cancelled with the
     * document, and the last press of every visit would be lost.
     */
    async function sendNudge() {
      try {
        const response = await fetch("/api/nudge", {
          method: "POST",
          headers: { Accept: "application/json" },
          keepalive: true,
        });

        if (!response.ok) {
          throw new Error(`Nudge POST failed: ${response.status}`);
        }

        const data = await response.json();

        if (!data.success) {
          throw new Error(data.error ?? "Unknown nudge error");
        }

        applyServerCount(data.count);
      } catch (error) {
        /**
         * ⚠️ NOT `console.error`, and NOT a rollback of the local count. This
         * fires on every press when the endpoint is missing (`astro dev`) or the
         * visitor is offline, and an error per press is noise that trains people
         * to ignore the console. The number on screen stays optimistic — the
         * global total is a nicety, the toy is the product.
         */
        console.warn("Nudge not recorded (count stays local):", error);
      }
    }

    void loadNudgeCount();
  }
  const sheepLayer = document.querySelector<HTMLElement>(".sheep-layer");
  /**
   * ⚠️ NO CAP. The visitor asked for unlimited toys, so the limit that used to
   * recycle the oldest is gone. Two things keep it affordable instead: the
   * separation pass is a sorted sweep that skips far-apart pairs, and a settled
   * toy sleeps out of the loop entirely.
   */
    const SHEEP_MAX_DT = 32;
    /**
     * Contact model. Measured behaviour is what these four numbers are for:
     *   · SOLVER_PASSES 2 — one pass leaves a three-deep stack overlapping, and the
     *     leftover shows up as next frame's jitter.
     *   · REST 0.92 per contact — a landing loses energy instead of passing it on.
     *   · FRICTION 0.12 — the tangential loss that stops a pile sliding apart. Low on
     *     purpose: at 0.4 the fruits stop dead against each other and read as glued.
     */
    const SOLVER_PASSES = 2;
    /**
     * ⚠️ THE FLOOR BOUNCES, and the SIGN is the whole story. This used to be
     * `t.py = t.y - vn * 0.2` — which keeps 20% of the DOWNWARD speed, so a
     * landing clamps, creeps down again, clamps again: a heavy thud with no
     * rebound at all. The visitor: 「水果做的 Q 弹一点，比如落地会弹一下，现在
     * 感觉太重了。参考捏捏乐那种 Q 弹的感觉」. A restitution needs the previous
     * position moved UP past the floor (`t.y + vn * B`) so the implied velocity
     * reverses.
     * ⚠️ **RAISED 0.42 -> 0.62 (2026-09-30), on the visitor's second pass at this**:
     * 「让水果落下来后弹一下，更 Q 弹，整体更接近抓娃娃机/捏捏乐的手感」. 0.42 measured as
     * an effective 0.27 (the bounce leaves at 8.9px/frame from a 32.7px/frame impact,
     * i.e. a 56px hop off a full-height drop), which read as a thud with a twitch.
     * 0.62 measures 0.41 - 13.5px/frame off the same impact - and `fruit-bounce.mjs`
     * puts the rebound at **169px**: one clear bounce, then a rest.
     */
    const GROUND_BOUNCE = 0.62;
    /**
     * ⚠️ **THE BOUNCE NEEDS A FLOOR OF ITS OWN, or gravity bounces for ever.** A
     * body at rest on the floor penetrates by one frame of gravity every frame
     * (0.72px), and a restitution turns that into a sub-pixel rebound, then a fall,
     * then again — a permanent buzz. Measured with no threshold at 0.42: 134.6px of
     * travel per toy over 1.8s on a settled pile (it was 19.7px). Below this impact
     * speed there is no rebound at all and the old dissipation applies, which is
     * what lets a pile sleep.
     * ⚠️ Raised 4.5 -> 5.5 together with GROUND_BOUNCE: the bar has to clear the
     * resting penetration at the higher restitution too. Verified after the change —
     * `vpile-tail.mjs` decays 596 -> 37 -> 33 -> 22.7 -> 15.8 px per toy and
     * `vpile.mjs` passes all five pile checks, so stacks still go to sleep.
     */
    const GROUND_BOUNCE_MIN = 5.5;
    /** the sub-threshold dissipation: this is the pre-bounce behaviour, kept for rests */
    const GROUND_REST = 0.2;
    /**
     * The 捏捏乐 part: a squash-and-stretch spring, driven by the impact speed and
     * UNDERDAMPED on purpose — it overshoots into a stretch on the way back, which
     * is what reads as squishy rather than as a jelly that only flattens.
     * ⚠️ **PER-FRAME UNITS, like everything else in this solver** (`G = 0.72` is px per
     * frame²). The first version used 260 / 12 — i.e. per SECOND — and integrated
     * them with dt in frames: ω·dt was 16, far past the stability limit, so the
     * discrete spring oscillated for ever at ±11px and the fruit looked like it was
     * still bouncing 9s after it had landed (measured: 61 direction changes).
     * 0.07 / 0.19 was ω≈0.26 rad/frame (≈2.5Hz) with ζ≈0.37 — two visible wobbles
     * and a stop. ⚠️ **SOFTENED to 0.05 / 0.13 (2026-09-30) for the 捏捏乐 pass**:
     * ω≈0.22 with ζ≈0.29, a slower wobble that overshoots further into the stretch.
     * Measured on one drop: the squash saturates at SQ_MAX, crosses zero ~300ms later
     * and reaches **-0.303** of stretch before coming back, against -0.141 before.
     * ⚠️ VISUAL ONLY — it never touches x/y/px/py, so the
     * collision radius and everything measured about the pile are unchanged.
     */
    const SQ_K = 0.05;
    const SQ_C = 0.13;
    /** how much of the impact speed turns into squash (deg of flattening per px/frame) */
    const SQ_GAIN = 0.013;
    /** below this impact speed there is nothing to squash — resting contacts land here */
    const SQ_MIN = 1.2;
    /** ⚠️ 0.30 -> 0.42 with the softer spring: every real landing hit this cap in its
     *  first frame, so the CAP (not the impact) was setting how flat a fruit got. */
    const SQ_MAX = 0.42;
    const WALL_REST = 0.4;
    const GROUND_FRICTION = 0.34;
    const CONTACT_FRICTION = 0.3;
    /** ⚠️ 0.72 -> 0.78 with GROUND_BOUNCE: fruit-on-fruit carries a little of the same
     *  liveliness, or a bouncing toy lands in a pile that reads as sand. */
    const CONTACT_REST = 0.78;
    /**
     * ⚠️ What the SECOND and later contacts of a frame bleed off the normal component.
     * Not 1 (no bleed at all): a body squeezed between two neighbours then keeps its
     * normal velocity for ever and the pile never reaches the sleep threshold - measured
     * as `vpile-tail.mjs` plateauing at ~25px per toy instead of decaying. Not 0.78
     * either: that compounds per contact and ate the rebound (see CONTACT_BOUNCE). 0.92
     * is the measured middle - both checks pass with it.
     */
    const CONTACT_REST_EXTRA = 0.92;
    /**
     * ⚠️ **A REAL IMPACT BETWEEN TWO FRUITS BOUNCES TOO** (2026-09-30). The visitor
     * found the asymmetry from the outside: 「手动拖动水果到空中后松开，下落碰到底部就
     * 会有弹跳；但按催更按钮掉下来的水果没有弹跳」. The floor reverses the normal
     * velocity; a fruit hit another fruit and only LOST 22% of it, so the pile acted
     * as a sandbag - and the button drops its fruits straight onto the pile it has
     * been building, so the one case the visitor kept looking at was the one case that
     * did not bounce.
     * ⚠️ It is THRESHOLDED, exactly like GROUND_BOUNCE_MIN, and for the same reason:
     * a resting stack is full of contacts whose normal speed is a fraction of a
     * pixel, and reversing those would make every pile buzz forever. Below the
     * threshold the old dissipation applies and stacks still go to sleep.
     */
    const CONTACT_BOUNCE = 0.4;
    /*
     * ⚠️ **The bar is HIGH on purpose, and it was measured up from 6.** At 6 the pile
     * never slept: `vpile.mjs` read 102px of travel per toy over 1.8s against its 60px
     * limit (a resting stack churns at a few px/frame, and every one of those contacts
     * was over the bar). At 14 the same pile reads like it did before this change while
     * a landing still clears it by 2x - a fruit dropped from the top of the viewport
     * arrives at ~35px/frame. It is a CONTACT threshold, not a floor one: the floor can
     * afford a low bar because it clamps in a single frame, while two fruits resolve
     * over several frames through CORRECTION_CAP.
     */
    const CONTACT_BOUNCE_MIN = 14;
    /**
     * ⚠️ A resting contact overlaps by a fraction of a pixel EVERY frame, so
     * `asleep = 0` on any contact meant nothing ever slept and the solver kept
     * re-separating a stack that was already separated. A contact only wakes a body
     * when there is a real overlap or real relative speed.
     */
    const WAKE_OVERLAP = 0.25;
    const WAKE_SPEED = 0.25;
    /**
     * ⚠️ Damping while a body is IN CONTACT, and it is not optional. A solver that
     * only resolves positions leaves a low-level crawl — measured 21.6px of travel
     * per toy over 1.8s with the pile untouched, which never crosses the sleep
     * threshold and so never stops. This is the loss path that lets a stack rest.
     */
    const CONTACT_DAMP = 0.86;
    /**
     * ⚠️ Cap on how far one pair may be pushed apart in one pass. The push is
     * proportional to the overlap, so a fast fruit arriving INSIDE another produced a
     * 20px single-frame shove — which is what launched a settled stack. Capped, a deep
     * overlap resolves over a few frames, which is also what a real body does.
     */
    const CORRECTION_CAP = 2;

    /**
     * ⚠️ The type is declared OUT HERE, not inside the `if (sheepLayer)` block
     * below. `applyContactFriction` sits above that block and takes a `Sheep`, so
     * a block-scoped type is invisible to it — `astro check` reported
     * "Cannot find name 'Sheep'" and the whole contact model went untyped.
     */
    type Sheep = {
      el: HTMLElement;
      x: number;
      y: number;
      px: number;
      py: number;
      r: number;
      rot: number;
      vrot: number;
      asleep: number;
      held: boolean;
      grabX: number;
      grabY: number;
      /** true while this toy touches the floor or another toy */
      contact: boolean;
      /** set by the first REAL impact of a frame - see CONTACT_BOUNCE */
      bounced: boolean;
      /** squash amount (0 = round, + = flattened, − = stretched) and its velocity */
      sq: number;
      sqv: number;
    };

    /**
     * Bleed a little TANGENTIAL velocity out of a contact, and a little of the
     * normal component. ⚠️ It rewrites `px`/`py`, which is the only place that is
     * allowed — a correction must not create velocity, but DAMPING is a deliberate
     * velocity change and has to go through `prev` to have any effect at all.
     */
    const applyContactFriction = (t: Sheep, nx: number, ny: number) => {

      const vx = t.x - t.px;
      const vy = t.y - t.py;
      const vn = vx * nx + vy * ny;
      const vtx = vx - vn * nx;
      const vty = vy - vn * ny;
      /* ⚠️ The sign is the whole difference: `+` keeps the approach and reads as
         sand, `-` reverses it and reads as a bounce. Only a real impact reverses -
         see CONTACT_BOUNCE. */
      /* ⚠️ ONCE PER BODY PER FRAME, and this is not an optimisation.
         A fruit sinking into a pile touches TWO OR THREE neighbours in the same
         pass; reversing on each of them flips the velocity back and forth (the
         second contact sees the body moving AWAY - still above the bar - and
         reverses it again, straight back into the pile). Measured with the naive
         version: a fruit landing on six others rose 14px, against 124px off the
         empty floor, i.e. the bounce was cancelled and the pile read as sand.
         The first real impact of the frame is the one that stops the body, so that
         is the only one allowed to bounce it; the rest damp as before. */
      const hit = !t.bounced && Math.abs(vn) > CONTACT_BOUNCE_MIN;
      /* ⚠️ THE NORMAL RESPONSE HAPPENS ONCE PER BODY PER FRAME; the rest of the
         contacts only rub (tangential). A fruit sinking into a pile touches two or
         three neighbours, and applying a normal loss to each of them compounded to
         ~0.78^3 per frame - which ate the rebound in two frames and is why a landing
         on the pile measured 14px against 124px off the empty floor. Whatever the
         first contact of the frame decides (bounce or damp) is the body's normal
         response; the others only bleed a little (CONTACT_REST_EXTRA). */
      const normal = hit ? -CONTACT_BOUNCE : t.bounced ? CONTACT_REST_EXTRA : CONTACT_REST;
      t.bounced = true;
      /* ⚠️ A landing ON A FRUIT has to squash too, or the pile reads as a different
         material from the floor - the floor branch is the only other place that feeds
         the squash spring. Same gain and cap, driven by the same impact speed. */
      if (hit && t.sq !== undefined && t.sqv !== undefined && Math.abs(vn) > SQ_MIN) {
        t.sqv += Math.min(Math.abs(vn) * SQ_GAIN, SQ_MAX);
      }
      const nvx = vn * nx * normal + vtx * (1 - CONTACT_FRICTION);
      const nvy = vn * ny * normal + vty * (1 - CONTACT_FRICTION);
      t.px = t.x - nvx;
      t.py = t.y - nvy;
    };
  if (sheepLayer) {
    /* ⚠️ a NON-NULL binding: `spawn` is a hoisted function declaration, and
       TypeScript drops the guard's narrowing inside those (it reported
       "'sheepLayer' is possibly 'null'"). */
    const layer: HTMLElement = sheepLayer;

    /* ── the fruit ──
       ONE ENTRY PER FRUIT, each with its parts.
       ⚠️ The table used to be a flat list of paths, which meant a two-tone fruit was two
       entries — and the spawner picks one entry, so a third of the toys were fruit
       FRAGMENTS: a green star with no strawberry under it, three brown dots with no
       coconut, a red crescent with no rind. Grouping the parts is the fix.
       ⚠️ ELEVEN entries, not twelve: the pineapple was removed on request. Its barrel was
       the narrowest shape in the set and its crown the widest, so in a pile it read as a
       spiky green blur around a small pot. Look at any new fruit ALONE before shipping it
       (`docs/fan-page.md`, round 13).
       No highlight strokes: at 76px a 0.55-alpha white arc reads as a scratch. */
    /**
     * ⚠️ `scale` is applied to the SVG, NOT to the toy's box. The box stays a
     * uniform 76px so the collision radius and the solver are untouched, and a big
     * fruit simply overflows its box — which is what `overflow: visible` on the svg
     * is for. Without this every toy was the same size and the pile read as a grid.
     */
    const FRUIT: { parts: { d: string; fill: string; shade: string }[]; scale: number }[] = [
      {
        // apple
        parts: [
          // ⚠️ `M62 32 c3 -9 …` was a LEAF shape filled in the apple's own red, so it
          // vanished into the body and the apple read as a plain ball. The stem is now
          // its own part in stem brown.
          { d: "M60 34 a32 32 0 0 1 26 50 a32 32 0 0 1 -52 0 a32 32 0 0 1 26 -50 z", fill: "#ff5d5d", shade: "#c62828" },
          { d: "M60 34 c-1 -8 1 -14 6 -18", fill: "none", shade: "#6b4a1f" },
        ],
        scale: 1,
      },
      {
        // pear: a narrow waist, then the stalk
        parts: [
          // ⚠️ `a27 27 0 0 0 54 0` is a HALF CIRCLE, so the old body was a
          // semicircle with a neck on top — a keyhole. This is a real pear profile:
          // narrow at the top, swelling to a round base.
          { d: "M60 26 c11 0 17 9 19 20 c2 11 11 15 15 26 c5 13 -1 26 -15 31 c-9 3 -29 3 -38 0 c-14 -5 -20 -18 -15 -31 c4 -11 13 -15 15 -26 c2 -11 8 -20 19 -20 z", fill: "#c8e05a", shade: "#7f9c1c" },
          { d: "M58 28 c0 -9 5 -14 12 -16 c0 9 -5 14 -12 16 z", fill: "#7f9c1c", shade: "#5f7a12" },
        ],
        scale: 1.06,
      },
      {
        // strawberry: body, then FIVE leaves — the old cap was one lens sitting on
        // the body, which read as a squashed circle rather than as a strawberry
        parts: [
          { d: "M60 32 c24 0 38 14 38 32 c0 22 -19 41 -38 54 c-19 -13 -38 -32 -38 -54 c0 -18 14 -32 38 -32 z", fill: "#ff4d6d", shade: "#b3123a" },
          // ⚠️ The crown used to sit at y=8..32 with the body starting at y=32, so the
          // leaves HOVERED above the fruit. It is now at y=18..40, overlapping the
          // body's shoulder so it reads as a cap.
          { d: "M60 18 L72 30 L88 26 L76 40 L60 34 L44 40 L32 26 L48 30 Z", fill: "#4caf50", shade: "#2e7d32" },
        ],
        scale: 0.96,
      },
      {
        // peach
        parts: [
          { d: "M60 34 a35 35 0 0 0 0 70 a35 35 0 0 0 0 -70 z", fill: "#ffab6b", shade: "#d9741f" },
          { d: "M58 34 c-5 -12 -15 -16 -23 -13 c3 11 11 16 23 13 z", fill: "#4caf50", shade: "#2e7d32" },
        ],
        scale: 1.04,
      },
      {
        // cherries: two fruit and one Y stem
        parts: [
          { d: "M54 48 a17 17 0 1 1 0 34 a17 17 0 1 1 0 -34 z M84 58 a15 15 0 1 1 0 30 a15 15 0 1 1 0 -30 z", fill: "#e0245e", shade: "#8e0f33" },
          // ⚠️ ONE Y, not two stems. The old pair were independent curves that
          // crossed like scissors instead of meeting, so the cherries looked like two
          // loose balls. Both branches now start at the stem's fork (66, 24) and run
          // down to the TOP of each fruit.
          { d: "M66 24 C65 36 60 42 56 48 M66 24 C70 36 78 46 84 58 M66 24 c-2 -8 0 -14 6 -18", fill: "none", shade: "#6d7a2a" },
        ],
        scale: 0.92,
      },
      {
        // banana
        parts: [
          { d: "M22 42 c20 34 50 45 84 31 c-5 21 -30 32 -55 26 c-25 -6 -36 -31 -29 -57 z", fill: "#ffd93d", shade: "#c9a000" },
          { d: "M24 40 l-6 -9 M104 72 l9 -4", fill: "none", shade: "#8a6b08" },
        ],
        scale: 1.02,
      },
      {
        // watermelon slice: the rind is a 10px band, the flesh is the rest. Both arcs
        // share the half-width; two arcs of different half-widths do NOT nest, which
        // is what made the earlier version read as green with a red streak.
        parts: [
          { d: "M10 34 h100 a50 50 0 0 1 -100 0 z", fill: "#2f9e44", shade: "#1b6b2c" },
          { d: "M20 36 h80 a40 40 0 0 1 -80 0 z", fill: "#ff5a7a", shade: "#c9184a" },
          { d: "M44 54 m-3.5 0 a3.5 4.5 0 1 0 7 0 a3.5 4.5 0 1 0 -7 0 M60 62 m-3.5 0 a3.5 4.5 0 1 0 7 0 a3.5 4.5 0 1 0 -7 0 M76 54 m-3.5 0 a3.5 4.5 0 1 0 7 0 a3.5 4.5 0 1 0 -7 0", fill: "#20304f", shade: "#20304f" },
        ],
        scale: 1,
      },
      {
        // grapes: r=13 with 20px between centres, so the berries stay separate
        parts: [
          { d: "M60 32 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z M40 50 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z M80 50 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z M60 68 a13 13 0 1 1 0 26 a13 13 0 1 1 0 -26 z", fill: "#a06cd5", shade: "#5b2d91" },
          // ⚠️ The old stem began at y=32 with the stroke centred on the outline, so
          // half of it was hidden under the top berry and only a floating stub showed.
          // It now starts at the berry's top edge (60, 19) and rises clear of it.
          { d: "M60 20 c1 -7 5 -13 13 -17", fill: "none", shade: "#5b2d91" },
        ],
        scale: 0.9,
      },
      {
        // blueberry: the berry, then the five-point calyx
        parts: [
          { d: "M60 34 a30 30 0 0 1 0 60 a30 30 0 0 1 0 -60 z", fill: "#4c5fd7", shade: "#26309c" },
          { d: "M60 34 l-9 -10 M60 34 l9 -10 M60 34 v-12 M60 34 l-14 -4 M60 34 l14 -4", fill: "none", shade: "#26309c" },
        ],
        scale: 0.82,
      },
      {
        // mango: a fat oval leaning right, plus a stem nub
        parts: [
          // enlarged in the path too: at the old size it was the smallest shape in the set
          { d: "M20 62 a40 34 0 0 1 72 -24 a40 34 0 0 1 -72 24 z", fill: "#ffb340", shade: "#cf7a12" },
          { d: "M84 34 c2 -12 9 -19 18 -21 c-1 12 -7 19 -18 21 z", fill: "#7f9c1c", shade: "#5f7a12" },
        ],
        scale: 1.14,
      },
      {
        // coconut: plain brown with the three eyes — nothing else. The split version
        // put those eyes ON the white flesh, which read as a face.
        parts: [
          { d: "M60 26 a36 36 0 0 1 0 72 a36 36 0 0 1 0 -72 z", fill: "#8a5a33", shade: "#573a1f" },
          { d: "M48 56 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M72 56 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M60 76 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0", fill: "#4a2f19", shade: "#4a2f19" },
        ],
        scale: 0.98,
      },
    ];

    const sheep: Sheep[] = [];
    /* ⚠️ A probe handle, like `window.__fanRows` / `window.__fanIntro`: the element
       can only ever show the COMPOSED transform, so a question about the solver's own
       state (`rot` vs the angle the eye reads, `sq` vs the residual matrix) cannot be
       answered from the DOM. Nothing in the page reads this. */
    (window as typeof window & { __fanSheep?: unknown }).__fanSheep = sheep;
    let sheepRaf = 0;
    let lastT = 0;

    /* ⚠️ These live ABOVE `step`, not in the drag section below it. `step` runs
       from rAF and reads them, so a `let` declared further down is a temporal dead
       zone hazard: the first frame throws, the throw is swallowed by the rAF
       callback, `sheepRaf` is already 0, and the solver never runs again. The
       sheep sat motionless at the floor with no error anywhere. */
    let pointerX = -1;
    let pointerY = -1;

    /** keep a spawn inside the viewport, radius included */
    const clampSheep = (x: number) => Math.max(34, Math.min(window.innerWidth - 34, x));

    const floorY = () => window.innerHeight - 26;

    const wake = (t: Sheep) => {
      t.asleep = 0;
    };

    function spawn(x: number, y: number) {
      // no cap — see SHEEP_MAX_DT
      const el = document.createElement("div");
      el.className = "sheep";
      const item = FRUIT[Math.floor(Math.random() * FRUIT.length)];
      // ⚠️ EVERY part, in one svg. `item.parts` is the whole fruit — a watermelon is
      // rind + flesh + seeds, a strawberry is body + leaves. Emitting one part per toy
      // is what put a green star and three loose dots in the pile.
      const body = item.parts
        .map((p) => `<path d="${p.d}" fill="${p.fill}" stroke="${p.shade}" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/>`)
        .join("");
      // ⚠️ The scale rides the SVG's BOX, not its `transform`. `transform-origin`
      // defaults to `0 0` for SVG rather than to the centre, and the toy's own
      // transform is rewritten by the solver every frame. Sizing the svg past its
      // parent leaves the element's LAYOUT box at 76x76 — so the collision radius
      // and the solver are untouched — and centres the overflow with a negative
      // margin, which is what makes a watermelon bigger than a blueberry.
      const sc = item.scale ?? 1;
      const pct = Math.round(sc * 100);
      el.innerHTML = `<svg viewBox="0 0 120 116" focusable="false" style="width:${pct}%;height:${pct}%;margin-left:${(100 - pct) / 2}%;margin-top:${(100 - pct) / 2}%">${body}</svg>`;
      el.style.setProperty("--r", "0");
      layer.append(el);
      const t: Sheep = {
        el,
        x,
        y,
        px: x,
        py: y - 2,
        r: 30,
        rot: (Math.random() - 0.5) * 40,
        vrot: (Math.random() - 0.5) * 2.2,
        asleep: 0,
        held: false,
        grabX: 0,
        grabY: 0,
        contact: false,
        bounced: false,
        sq: 0,
        sqv: 0,
      };
      sheep.push(t);
      startSheep();
      return t;
    }

    function step(now: number) {
      sheepRaf = 0;
      const dt = lastT ? Math.min(32, now - lastT) / 16.67 : 1;
      lastT = now;
      const G = 0.72 * dt;
      const DAMP = 0.994;
      const FLOOR = floorY();
      let awake = 0;

      for (const t of sheep) {
        if (t.held) {
          // the pointer owns the position outright; `prev` follows so a release
          // inherits the throw's velocity for free
          t.px = t.x - (t.x - t.px) * 0.4;
          t.py = t.y - (t.y - t.py) * 0.4;
          t.x = pointerX - t.grabX;
          t.y = pointerY - t.grabY;
          t.px = t.x - (t.x - t.px) * 0.5;
          t.py = t.y - (t.y - t.py) * 0.5;
          t.asleep = 0;
          awake++;
          continue;
        }
        /* ── the squish ──
           ⚠️ Ticked BEFORE the sleep test and counted as awake, or a toy that lands
           and falls asleep on the same frame freezes half-flattened. Underdamped, so
           it springs back through round into a slight stretch before it stops. */
        if (t.sq !== 0 || t.sqv !== 0) {
          t.sqv += (-SQ_K * t.sq - SQ_C * t.sqv) * dt;
          t.sq += t.sqv * dt;
          if (Math.abs(t.sq) < 0.002 && Math.abs(t.sqv) < 0.02) {
            t.sq = 0;
            t.sqv = 0;
          } else {
            awake++;
          }
        }
        if (t.asleep > 40 && t.sq === 0) continue;
        awake++;
        // ⚠️ Contacts are found at the END of the frame, so this flag is one frame
        // old. That is fine for damping, and it keeps the solver to a single pass.
        /* ⚠️ `!t.bounced` matters: the frame after a real impact is the frame the
           rebound is travelling in, and damping it there is what made a landing on the
           pile collapse to a 14px jiggle while the same landing on the floor bounced
           124px. A floor-only contact never damps at all (its flag is cleared before the
           separation pass), so this makes the two consistent. */
        if (t.contact && !t.bounced) {
          t.px = t.x - (t.x - t.px) * CONTACT_DAMP;
          t.py = t.y - (t.y - t.py) * CONTACT_DAMP;
        }
        const vx = (t.x - t.px) * DAMP;
        const vy = (t.y - t.py) * DAMP;
        t.px = t.x;
        t.py = t.y;
        t.x += vx;
        t.y += vy + G;
        t.rot += t.vrot * dt;
        t.vrot *= 0.985;
        // ── the floor ──
        // ⚠️ POSITION ONLY. `t.py = t.y + vy * 0.32` (the old line) INJECTED velocity
        // on every touch, so a fruit resting on the floor was kicked every frame and
        // the whole pile jittered. A contact that only moves the position produces no
        // velocity at all; the small loss of the normal component is what makes a
        // landing settle instead of bounce.
        if (t.y > FLOOR) {
          /* ⚠️ **THE IMPACT SPEED IS MEASURED BEFORE THE CLAMP, AND THAT IS THE WHOLE
             FIX.** It used to be `t.y = FLOOR; const vn = t.y - t.py;` - which reads the
             PENETRATION of that one frame, not the speed the fruit arrived at. A fruit
             falling 29px a frame with 10.65px left above the floor got `vn = 10.65`, so
             the restitution acted on 37% of the impact and the rebound came out at 6.6px
             a frame instead of 18. Which fruit bounced and which one landed with a thud
             was decided by where it happened to be the frame before - a random phase, and
             the reason the visitor saw 「第一次落地会弹跳」 come and go while nothing in the
             code changed: measured across runs, the same drop rebounded anywhere from 0 to
             250px, and the deeper the penetration (slow frame, big dt) the WEAKER the
             bounce, because the step is larger and the leftover smaller.
             Reading the step BEFORE the clamp gives the real approach speed, so the same
             drop now bounces the same amount every time. */
          const vn = t.y - t.py;
          t.y = FLOOR;
          // ⚠️ `+`, not `-`: the previous position goes UP past the floor so the
          // implied velocity reverses. See GROUND_BOUNCE.
          if (vn > 0) {
            /* ⚠️ The floor is the FIRST normal response of the frame, so it claims
               the body's one bounce: without this flag a fruit that touches the floor
               AND a neighbour in the same frame got its velocity reversed twice - once
               by each - and the two cancelled (measured: a 124px floor rebound came
               out as 21px). See CONTACT_BOUNCE. */
            t.bounced = true;
            if (vn > GROUND_BOUNCE_MIN) {
              // a real landing: reverse it, and squash on the way
              t.py = t.y + vn * GROUND_BOUNCE;
              if (vn > SQ_MIN) t.sqv += Math.min(vn * SQ_GAIN, SQ_MAX);
            } else {
              // resting (or nearly): eat the normal component instead of returning it
              t.py = t.y - vn * GROUND_REST;
            }
          }
          // friction along the floor
          const vt = t.x - t.px;
          t.px = t.x - vt * (1 - GROUND_FRICTION);
          t.vrot *= 0.6;
          t.contact = true;
        }
        // ── the walls, so nothing escapes the viewport ──
        if (t.x < t.r) {
          t.x = t.r;
          const vt = t.x - t.px;
          if (vt < 0) t.px = t.x - vt * WALL_REST;
        }
        if (t.x > window.innerWidth - t.r) {
          t.x = window.innerWidth - t.r;
          const vt = t.x - t.px;
          if (vt > 0) t.px = t.x - vt * WALL_REST;
        }
        // settle: kill the last of the motion so a pile can sleep
        if (Math.abs(t.x - t.px) < 0.02 && Math.abs(t.y - t.py) < 0.02 && t.y >= FLOOR - 0.5) {
          t.px = t.x;
          t.py = t.y;
          /* ⚠️ THE ANGLE IS NO LONGER TOUCHED HERE, and that line was the visitor's
             「水果会奇怪的进行回正角度，而不是维持应有的随机角度」. It read
             `t.rot += (Math.round(t.rot / 90) * 90 - t.rot) * 0.2` - once a toy settled
             it eased its rotation to the nearest multiple of 90° at 20% a frame, so a
             fruit that landed at 25° visibly righted itself over ~200ms and every toy
             on the floor ended up at 0 / 90 / 180. Measured before removing it: a fruit
             landing at -12.1° was sitting at -0.001° two seconds later, every run.
             A toy keeps the angle it landed on; that is the look the page is after, and
             tidiness was never asked for. (`t.rot` is still only ever written by
             `t.rot += t.vrot * dt`, so nothing else can rotate a resting toy either.) */
          t.asleep++;
        } else {
          t.asleep = 0;
        }
      }

      /* ── separation ──
         Sort by x, then only test pairs whose x distance is inside one diameter. With
         no cap on the population that is what keeps the cost near-linear: a full
         pairwise pass at a hundred toys is 4950 tests per frame, this is ~n·k.

         ⚠️ TWO rules make the pile feel heavy, and both were missing:
         1. **A contact moves POSITION ONLY.** `px`/`py` are the previous position, so
            moving them changes the implied velocity. The old code pushed them along
            with the correction; every overlapping pair therefore traded velocity back
            and forth, and with forty fruits on screen one landing rippled through the
            whole pile — reported as 「都轻飘飘的，没有手感」.
         2. **Contacts apply friction.** Without a tangential loss a pile slides apart
            like it is on ice; with it, a stack stays where it lands.

         Two iterations, because one pass leaves a three-deep stack overlapping and the
         leftover correction is what shows up as the next frame's jitter. */
      // clear last frame's flags, so a body that left a contact stops damping
      for (const t of sheep) {
        t.contact = false;
        t.bounced = false;
      }

      for (let pass = 0; pass < SOLVER_PASSES; pass++) {
        const order = sheep.slice().sort((a, b) => a.x - b.x);
        const reach = 62; // the largest possible (r + r) for two toys
        for (let i = 0; i < order.length; i++) {
          const a = order[i];
          for (let j = i + 1; j < order.length; j++) {
            const b = order[j];
            if (b.x - a.x > reach) break;
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const min = a.r + b.r;
            const d2 = dx * dx + dy * dy;
            if (d2 >= min * min || d2 === 0) continue;
            const d = Math.sqrt(d2);
            const overlap = (min - d) / d;
            const nx = dx / d;
            const ny = dy / d;
            const raw = (min - d) * 0.5;
            const amount = Math.min(raw, CORRECTION_CAP);
            const pushX = nx * amount;
            const pushY = ny * amount;
            const wa = a.held ? 0 : b.held ? 1 : 0.5;
            const wb = b.held ? 0 : a.held ? 1 : 0.5;
            /* woken by a REAL overlap or REAL relative speed — never by the
               fraction-of-a-pixel overlap that a resting stack always has */
            const rel = Math.hypot(b.x - b.px - (a.x - a.px), b.y - b.py - (a.y - a.py));
            const wake = min - d > WAKE_OVERLAP || rel > WAKE_SPEED;
            if (wa > 0) {
              a.x -= pushX * (wa * 2);
              a.y -= pushY * (wa * 2);
              if (wake) a.asleep = 0;
              a.contact = true;
              // ⚠️ `px`/`py` are NOT touched by the correction itself — that is
              // the whole point. `applyContactFriction` is the one exception: damping
              // is a DELIBERATE velocity change and has to go through `prev`.
              applyContactFriction(a, nx, ny);
            }
            if (wb > 0) {
              b.x += pushX * (wb * 2);
              b.y += pushY * (wb * 2);
              if (wake) b.asleep = 0;
              b.contact = true;
              applyContactFriction(b, nx, ny);
            }
            a.vrot -= pushX * 0.012;
            b.vrot += pushX * 0.012;
          }
        }
      }
      for (const t of sheep) {
        const at = `translate3d(${(t.x - 50).toFixed(2)}px,${(t.y - 32).toFixed(2)}px,0) rotate(${t.rot.toFixed(2)}deg)`;
        if (t.sq === 0) {
          t.el.style.transform = at;
          if (t.el.style.getPropertyValue("--sq")) t.el.style.removeProperty("--sq");
          continue;
        }
        /* ── THE SQUASH IS IN THE TOY'S OWN FRAME, AND THAT IS A FIX (2026-09-30) ──
           It used to be written in SCREEN axes — `R(−θ) · diag(sx, sy) · R(θ)` applied
           after the rotate, four multiplies to keep a fruit lying at 90° from
           squashing "sideways". The visitor saw what that costs: 「水果落地后并没有
           看到回弹，相反他们会奇怪的进行回正角度，而不是维持应有的随机角度」.
           ⚠️ **A screen-axis squash ROTATES a rotated shape.** The composed matrix is
           `diag(sx, sy) · R(θ)`, so the angle the eye reads is `atan2(sy·sinθ, sx·cosθ)`
           — measured, at the old SQ_MAX 0.42 a fruit drawn at 45° reads as 25°, and one
           at 20° reads as 10°: a 10-20° swing toward upright for the whole ~300ms
           squash-and-stretch cycle. Every landing looked like the fruit righting
           itself, and the vertical hop (124px, measured) was lost inside it.
           With the diagonal matrix INSIDE the rotate the shape squashes along its OWN
           axes and the drawn angle stays exactly `t.rot` — verified against the solver
           state published on `window.__fanSheep`: implied angle == `rot` to 0.01°
           through the whole bounce, where the old form drifted by up to 20°.
           ⚠️ It is cheaper too: the composed transform is `R(θ) · diag(sx, sy)`, so one
           matrix() literal replaces four multiplies and a cos/sin pair. */
        const s = Math.max(-SQ_MAX, Math.min(SQ_MAX, t.sq));
        const sx = 1 + s * 0.55;
        const sy = 1 - s;
        t.el.style.transform = `${at} matrix(${sx.toFixed(4)},0,0,${sy.toFixed(4)},0,0)`;
        // published for probes: a squashed toy's AABB also changes with its ROTATION,
        // so the rect cannot tell squash from spin. `--sq` can.
        t.el.style.setProperty("--sq", s.toFixed(3));
      }
      if (awake > 0) startSheep();
      else lastT = 0;
    }

    function startSheep() {
      if (sheepRaf) return;
      sheepRaf = requestAnimationFrame(step);
    }

    /* ── the drag ── */
    let held: Sheep | null = null;

    layer.addEventListener("pointerdown", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>(".sheep");
      if (!el) return;
      const t = sheep.find((x) => x.el === el);
      if (!t) return;
      held = t;
      t.held = true;
      wake(t);
      pointerX = e.clientX;
      pointerY = e.clientY;
      t.grabX = e.clientX - t.x;
      t.grabY = e.clientY - t.y;
      el.classList.add("is-dragged");
      el.classList.remove("is-poked");
      void el.offsetWidth;
      el.classList.add("is-poked");
      try {
        el.setPointerCapture(e.pointerId);
      } catch {
        /* capture is optional */
      }
      startSheep();
      e.preventDefault();
    });

    window.addEventListener("pointermove", (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (held) {
        wake(held);
        startSheep();
      }
    });

    const release = () => {
      if (!held) return;
      held.held = false;
      held.el.classList.remove("is-dragged");
      held.vrot += (Math.random() - 0.5) * 1.4;
      wake(held);
      held = null;
      startSheep();
    };
    window.addEventListener("pointerup", release);
    window.addEventListener("pointercancel", release);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) startSheep();
    });

    /* ⚠️ The spawn point is in VIEWPORT coordinates near the TOP of the screen, not
       at the button. The layer is `position: fixed` and the button can be a whole
       viewport below the fold, so anchoring to it dropped the sheep off-screen:
       measured at y=424 in a 950px viewport, i.e. invisible under the fold while
       the solver happily ran. The visitor pressed a button to see a sheep fall —
       it has to fall into the view they are looking at. */
    nudgeSpawn = (btn: HTMLElement) => {
      const r = btn.getBoundingClientRect();
      const spread = Math.min(360, window.innerWidth * 0.34);
      const x = window.innerWidth / 2 + (Math.random() - 0.5) * spread;
      void r;
      spawn(clampSheep(x), -20);
    };
  }
  /* ── the page rail: how far down the poster you are ──
     ⚠️ Throttled with rAF and written as ONE custom property, so the browser
     does no layout work per scroll event: the fill's height is a `calc()` off
     `--fan-read`, and only the property changes. `scrollHeight - innerHeight` is
     the real scrollable distance, not `scrollHeight`, or the bar would only ever
     reach about half way on a long page. */
  const rail = document.querySelector<HTMLElement>(".fan-rail");
  const railFill = rail?.querySelector<HTMLElement>(".fan-rail-fill") ?? null;
  if (rail) {
    let railQueued = false;
    const paintRail = () => {
      railQueued = false;
      const span = document.documentElement.scrollHeight - window.innerHeight;
      const read = span <= 1 ? 1 : Math.min(1, Math.max(0, window.scrollY / span));
      rail.style.setProperty("--fan-read", read.toFixed(4));
    };
    const queueRail = () => {
      if (railQueued) return;
      railQueued = true;
      requestAnimationFrame(paintRail);
    };
    window.addEventListener("resize", queueRail);
    // the rows and the plates settle after load and change the page height
    window.addEventListener("load", queueRail);
    /* ── the drag ──
       The fill's CENTRE is placed at the pointer: with a proportional fill that is
       what makes a scrollbar feel direct, and it needs no grab offset. */
    let railDragging = false;
    const paintFromPointer = (clientY: number) => {
      const r = rail.getBoundingClientRect();
      if (r.height <= 0) return;
      const frac = Math.min(1, Math.max(0, (clientY - r.top) / r.height));
      const span = document.documentElement.scrollHeight - window.innerHeight;
      // ⚠️ `behavior: "instant"` is REQUIRED here. `global.css` sets
      // `html { scroll-behavior: smooth }`, so a plain `scrollTo` animates —
      // measured, a drag to the middle took ~600ms to converge and every further
      // pointer position restarted it, so the rail felt like it was lagging the
      // hand. Direct manipulation has to be instant; the CSS token stays as it is
      // for every real link and anchor on the site.
      window.scrollTo({ top: frac * Math.max(0, span), behavior: "instant" });
      // ⚠️ And write the FILL from the same fraction. The fill's height is
      // `--fan-read`, which only `paintRail` wrote — and the scroll listener skips
      // `paintRail` while dragging. So the page scrolled but the fill did not move
      // until the pointer was released. Driving both from one number means they
      // cannot disagree.
      rail.style.setProperty("--fan-read", frac.toFixed(4));
    };
    rail.addEventListener("pointerdown", (e) => {
      railDragging = true;
      rail.classList.add("is-dragging");
      try {
        rail.setPointerCapture(e.pointerId);
      } catch {
        /* capture is optional */
      }
      paintFromPointer(e.clientY);
      e.preventDefault();
    });
    rail.addEventListener("pointermove", (e) => {
      if (railDragging) paintFromPointer(e.clientY);
    });
    const railRelease = () => {
      if (!railDragging) return;
      railDragging = false;
      rail.classList.remove("is-dragging");
      queueRail();
    };
    rail.addEventListener("pointerup", railRelease);
    rail.addEventListener("pointercancel", railRelease);
    // ⚠️ while dragging, the scroll listener must not fight the pointer
    window.addEventListener("scroll", () => { if (!railDragging) queueRail(); }, { passive: true });

    // the fill's own height needs `--fan-read`, so publish once at rest
    paintRail();
  }</script>

<style>
  /* ══════════════════════════════════════════════════════════════
     THE PALETTE — one theme, fixed.

     ⚠️ Defined on `.fan-root` and NOT on `:root`: the site's own tokens stay
     untouched for every other page, and `:global` is only needed on the rules
     that have to reach OUTSIDE this component (the site shell).
     ⚠️ `--fan-*` is deliberately a separate namespace from the site's tokens —
     the two palettes are unrelated and reusing the names would invite a stray
     site token to leak in.
     ══════════════════════════════════════════════════════════════ */
  .fan-root {
    /* surfaces */
    --fan-cream: #fff0ec;
    --fan-cream-2: #ffe3e6;
    --fan-peach: #ffcdd4;
    --fan-pink: #ff6fa8;
    --fan-magenta: #f5308a;
    --fan-magenta-deep: #d61f74;
    --fan-pink-soft: #ffd9e6;

    /* the signal colour */
    --fan-blue: #1b25d8;
    --fan-blue-deep: #141cae;
    --fan-blue-bright: #2b3cf0;

    /* ink + print */
    --fan-ink: #12123a;
    --fan-ink-soft: #4a4a72;
    --fan-white: #ffffff;
    --fan-paper: #fffaf8;
    --fan-shadow: 0 18px 40px -22px rgba(27, 37, 216, 0.45);
    --fan-shadow-pink: 0 20px 44px -24px rgba(245, 48, 138, 0.6);
    --fan-dot: rgba(245, 48, 138, 0.16);

    /* ⚠️ The crown's gold, and it is chosen AGAINST `--fan-blue #1B25D8`, not on its
       own. A deep, high-chroma blue wants a WARM gold that is slightly
       DESATURATED: a saturated yellow vibrates against it like a warning sign, and
       a pale cream reads as beige. Two stops and a dark end, so the crown reads as
       METAL — the gradient is doing that work, not the hue. */
    /* ⚠️ ONE flat gold, chosen against `--fan-blue #1B25D8`: a deep, high-chroma
       blue wants a WARM gold that is slightly desaturated. A saturated yellow
       vibrates against it like a warning sign, and a pale cream reads as beige. */
    --fan-gold: #e0a92a;

    /* ── the animated background (`FanMosaic.astro`) ──────────────────────
       ⚠️ Declared HERE, on `.fan-root`, and read by the canvas through
       `getComputedStyle`: the pink world stays in one place, and the shader
       never hard-codes a colour. The three colour stops are deliberately the
       page's OWN pinks — the effect is the page's paper, not a separate
       artwork bolted behind it.
       `--fan-mosaic-bg` is the paper the mosaic sits on (also the colour the
       field's empty areas resolve to), so it must match the page's cream or
       the hero reads as a rectangle. */
    --fan-mosaic-bg: #fff0ec;
    --fan-mosaic-c1: #ff6fa8;
    --fan-mosaic-c2: #f5308a;
    --fan-mosaic-tile: 18;
    --fan-mosaic-gain: 0.2;
    /* contrast is the readability knob: 1 = the shader as written, lower squeezes the field's deviation from the paper, so the paper stays pale behind body text while the frost's texture survives. frost / grain / dot are the glass: `frost` is the blur radius as a
       multiple of the tile, `grain` is the per-pixel refraction in CSS px (the
       thing that makes it frost and not just a blur), `dot` is how much of the
       page's print grain shows through the glass. */
    --fan-mosaic-contrast: 0.6;
    --fan-mosaic-frost: 2;
    --fan-mosaic-grain: 1.4;
    --fan-mosaic-dot: 0.16;
    /* print-grain pitch in CSS px; raise it for bigger, rounder dots */
    --fan-mosaic-dot-pitch: 7;
    --fan-mosaic-reach: 300;
    --fan-mosaic-size: 70;
    --fan-mosaic-angle: 0;
    --fan-mosaic-speed: 50;
    --fan-mosaic-hover: 100;
    --fan-sky-opacity: 0.3;

    /* ⚠️ `--accent` is NOT overridden here — it also paints the skip link and
       the focus rings, which this page does not draw. Everything this page
       draws sets its own colour. */
    --bg: var(--fan-cream);
    --text: var(--fan-ink);
    --text-bright: var(--fan-ink);
    --text-soft: var(--fan-ink);
    --text-dim: var(--fan-ink-soft);
    --text-tertiary: var(--fan-ink-soft);
    --panel: var(--fan-paper);
    --panel-light: var(--fan-white);
    --border: rgba(27, 37, 216, 0.14);
    --border-strong: rgba(27, 37, 216, 0.3);
    --border-divider: rgba(245, 48, 138, 0.3);

    /* ── NO TEXT SELECTION ANYWHERE ON THIS PAGE ──
       The visitor: 「给整个界面加一个防止复制，这样和水果互动的时候不会误点变成左键
       拖动选择文本」. Dragging a fruit starts with a left-button press on a page full of
       paragraphs, so the browser also begins a selection and the toy is dragged through a
       blue smear. This is the switch that stops it; the gallery rows already carried their
       own copy of it.
       ⚠️ `user-select: none` only — the `-webkit-` twin lives in its OWN rule further down,
       because this build's minifier collapses a prefixed/unprefixed pair in one rule and
       keeps the last one (CLAUDE.md).
       ⚠️ One thing stays selectable on purpose: `.contact-handle` (see the exception next
       to that rule) is a handle with no URL — the only text here that exists to be copied. */
    user-select: none;
    position: relative;
    min-height: 100vh;
    /* ⚠️ LOAD-BEARING for the animated background, not tidiness. `.fan-mosaic`
       is a `position: fixed` child at `z-index: -1`, and a negative-z child
       paints above its parent's own background ONLY if the parent is a stacking
       context. Without this, the canvas escapes to the nearest stacking context
       and paints BEHIND `.fan-root`'s opaque background: a blank cream page,
       a running shader, and no error in the console.
       ⚠️ `isolation: isolate` and NOT `z-index: 0`: `z-index` on a
       `position: relative` box also works, but it would make this element equal
       to a sibling's z-index and pull the whole page into a stacking fight with
       the site shell. `isolation` does the containment and nothing else. */
    isolation: isolate;
    /* This clip is NOT what breaks the sticky module bar — that was the blanket
       `.fan-root > *` rule below, which set `position: relative` on the bar as
       well. See the note there. Measured in Chrome: with the clip present the
       bar still sticks (top 0 after 1200 and 3000 px of scroll). */
    overflow-x: clip;
    /* ⚠️ Only the CREAM lives here now. The three pink washes moved to
       .fan-sky below, because the animated background (a fixed canvas at
       z-index -1) paints OVER this element's own background — a wash left here
       would be invisible the moment WebGL2 comes up. Keeping just the paper on
       .fan-root also means the no-WebGL2 fallback is still a finished-looking
       page: cream + .fan-sky + the grain. */
    background-color: var(--fan-cream);
    color: var(--fan-ink);
    background-image: linear-gradient(
      180deg,
      var(--fan-cream) 0%,
      var(--fan-cream-2) 42%,
      var(--fan-cream) 100%
    );
    font-family: var(--font-body);
  }

  /* ── THE HERO'S PINK SKY ──────────────────────────────────────────────
     The page's key-visual wash, as a real element rather than a background
     layer, for one reason: it has to paint ON TOP of the mosaic. It is a
     sibling of the canvas at the same z-index: -1, and paint order inside
     that layer is DOM order, so this one comes second and wins.
     ⚠️ --fan-sky-opacity is the whole point of the layer existing as a knob:
     at 1 the hero is the flat pink the page had before the mosaic, at 0 the
     mosaic runs uncovered, and in between the pink reads as a tint over live
     linework. Anything ABOVE 0 means the mosaic is at its most legible the
     moment the sky's own gradient fades, ~1360px down.
     ⚠️ height: 1400px is not a layout choice: the old wash was
     ellipse 120% 52% at 50% -6% of the WHOLE PAGE (3973px tall measured),
     whose colour stops run out around 1360px. This box reproduces that
     geometry; changing the height changes where the hero's pink ends. */
  .fan-sky {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1400px;
    z-index: -1;
    pointer-events: none;
    opacity: var(--fan-sky-opacity, 0.5);
    background:
      radial-gradient(
        ellipse 120% 52% at 50% -6%,
        var(--fan-pink) 0%,
        var(--fan-peach) 34%,
        transparent 66%
      ),
      radial-gradient(
        ellipse 90% 40% at 4% 22%,
        rgba(245, 48, 138, 0.3) 0%,
        transparent 62%
      ),
      radial-gradient(
        ellipse 80% 40% at 100% 46%,
        rgba(255, 111, 168, 0.34) 0%,
        transparent 64%
      );
  }

  /* The print grain: one dotted layer for the whole page, so every section
     sits on the same paper rather than each inventing its own texture. */
  .fan-root::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1180px, 96vw);
    height: 900px;
    z-index: 0;
    pointer-events: none;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 62% 46% at 50% 34%,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0) 68%
    );
  }

  /* ⚠️ THE PRINT GRAIN IS DRAWN TWICE, ON PURPOSE, AND ONLY ONE OF THEM SHOWS.
     The shader in `FanMosaic.astro` draws this same dot grid (same 7px pitch)
     INTO the glass, refracted per pixel by the frost, so the grain belongs to
     the surface instead of sitting on top of it. This CSS copy is what the page
     falls back to when there is no WebGL2 (and for the frame or two before the
     shader's first draw), and it is switched off the moment the shader is up —
     two dot grids at slightly different phases moiré, which looks far worse than
     either one alone. The switch is `data-mosaic="on"`, written by the component. */
  .fan-root[data-mosaic="on"]::before {
    opacity: 0;
  }

  .fan-root::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--fan-dot) 1px, transparent 1.2px);
    background-size: 7px 7px;
    opacity: 0.5;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  /* ⚠️ Both exclusions are load-bearing, not tidiness. This rule sets
     `position: relative` on every direct child, and it sits AFTER those rules —
     same specificity (0-2-0), so it wins the cascade. Measured: the sticky module
     bar computed to `relative` and scrolled away, and `.fan-rail` computed to
     `relative` too, which put it at left -14px (off the left edge) instead of
     pinned to the right. Every direct child of .fan-root that positions itself
     MUST be named here.
     ⚠️ THREE times this rule has eaten a position: the sticky module bar, the
     fixed page rail, and the fixed sheep layer (which ended up 758×0 with
     `overflow: hidden`, so every sheep was clipped away). When something on this
     page will not position, look at THIS LIST first.
     ⚠️ `.fan-mosaic` is the fourth and `.fan-sky` the fifth, and both are the
     same trap. `.fan-mosaic` is `position: fixed; z-index: -1`; without the
     exclusion this rule gives it `position: relative; z-index: 1`, turning the
     viewport-fixed background into a 100vh band at the TOP OF THE DOCUMENT that
     scrolls away and covers the content. `.fan-sky` is `position: absolute;
     z-index: -1` and would be forced to `relative`, which would push the hero's
     pink wash into the flow as a 1400px-tall block and shove the whole page
     down. (The `isolation: isolate` note above explains the other half.) */
  .fan-root > *:not(.fan-modules, .fan-rail, .sheep-layer, .fan-mosaic, .fan-sky) {
    position: relative;
    z-index: 1;
  }

  /* ══ LANGUAGE SWITCH ══
     There is NO transition here any more, and that is the design. `/fan/` and
     `/zh/fan/` are two documents, so the switch is a navigation; it is played by the
     page's own cloud-burst arrival on the ARRIVING document, which the visitor asked
     for in as many words (「切换语言时，我需要直接播放运动入场动画，然后结束后是另一个
     语言」). Everything that used to live in this block - the text cross-fade, and
     before it a `@view-transition` opt-in in `global.css` - was an attempt to animate
     a handover between two documents from THIS side, which cannot know when the other
     one is ready. What replaced it is a hold on the incoming document (see the
     `is-fi-hold` rules in `Layout.astro` and the switch in `FanIntro.astro`).

     ⚠️ Two earlier versions of this block are worth remembering before one is written
     again: fading `.fan-root` faded the BACKGROUND with it (the visitor read that as
     the background flashing), and fading only the copy still left the incoming
     document painting its own bare frames for as long as it took to parse `.fan-root`.
     Text-level animation can never cover a document-level gap. */

  /* ══ NO SITE CHROME ══
     The header and the footer are the studio's own dark surfaces, and the
     footer's scoped rules out-specify anything this page can write — so
     repainting them is a losing fight that ends in a black slab on a pink
     poster. This page is its own standalone thing and carries its own back
     link and language switch, so the site's bars are simply not shown.
     ⚠️ These are the only `:global` rules in this file, and each is scoped
     under `[data-fan]` so nothing can leak to another page.
     ⚠️ `display: none` and not `visibility: hidden`: a hidden-but-present bar
     keeps its height and leaves a dead band at the top of the page.
     ⚠️ `.site-content > header`, NOT a bare `header`. This page's own hero is a
     `<header>` too, so the obvious selector matched it as well and deleted the
     entire hero - top bar, then chips, then straight into module 01, with the
     pink cloud and the wordmark simply gone (caught in a full-page screenshot,
     not by any assertion). Keep this pinned to the site's own bar. */
  :global(body:has([data-fan]) .site-content > header),
  /* the dismissible "best viewed in desktop mode" bar */
  :global(body:has([data-fan]) #mobile-notice),
  :global(body:has([data-fan]) .footer),
  /* the dark scroll-telemetry rail down the right edge */
  :global(body:has([data-fan]) .scroll-cluster),
  /* the site's own dark-mode starfield decoration */
  :global(body:has([data-fan]) #starfield-canvas),
  :global(body:has([data-fan]) #star-canvas),
  :global(body:has([data-fan]) #neural-canvas) {
    display: none !important;
  }

  /* The page background comes from `.fan-root`, which fills the viewport so
     the dark `<html>` underneath can never show through at a short page. */
  :global(body:has([data-fan])) {
    background: var(--fan-cream);
  }
  /* ══════════════════════════════════════════════════════════════
     TOP BAR
     ══════════════════════════════════════════════════════════════ */
  .fan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 24px 0;
  }

  .fan-langs {
    position: relative;
    /* ⚠️ This group carried a `view-transition-name` while the switch was a browser
       cross-document view transition. Both are gone: the switch is the page's own
       arrival now, and a named element would be carried in the TOP LAYER - above the
       arrival cover, floating over the cloud burst. Nothing on this page is named for
       a view transition any more, which is also why `@view-transition` was dropped
       from `global.css`. */
    display: inline-flex;
    gap: 0;
    padding: 3px;
    border: 1.5px solid var(--fan-blue);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
  }

  /* the blue pill itself: one slot wide, slid by the group's `data-active` */
  .fan-lang-pill {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    /* ⚠️ `50%` of the group's PADDING box is one slot plus the 3px padding either
       side, hence the subtraction — with two equal `min-width` slots it lands
       exactly on the second label when translated one slot. */
    width: calc(50% - 3px);
    border-radius: 999px;
    background: var(--fan-blue);
    pointer-events: none;
    transition: transform 0.34s var(--ease-out);
    /* the slide is driven by the group's `data-active`, which is SERVER-RENDERED: on
       the new document the pill is already in its final place before the first paint */
  }

  .fan-langs[data-active="zh"] .fan-lang-pill {
    transform: translateX(100%);
  }

  .fan-lang {
    position: relative;
    z-index: 1;
    /* equal slots, so the pill (50%) always sits under one label whatever the two
       strings measure — EN and 中文 are not the same width */
    min-width: 64px;
    text-align: center;
    padding: 5px 13px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--fan-blue);
    text-decoration: none;
    transition: color 0.24s var(--ease-out);
  }

  .fan-lang:hover {
    color: var(--fan-blue-deep);
  }

  /* ⚠️ No background on the active label any more — the pill paints it, and a fill
     here would show as a second, static blue block under the sliding one. */
  .fan-lang.is-on {
    color: var(--fan-white);
  }

  .fan-lang:active {
    transform: scale(0.94);
  }

  /* ══════════════════════════════════════════════════════════════
     HERO
     ══════════════════════════════════════════════════════════════ */
  .fan-hero {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    /* ⚠️ The three numbers below are one measured stack, not three guesses. At
       1440px the render order down the hero is: 44px of padding, the kicker
       (14px), then the CLOUD — which is absolutely placed, so it does not push
       anything. The title's `margin-top` is therefore the ONLY thing keeping the
       wordmark off the cloud, and it was sized when the cloud sat higher.
       Measured with the old numbers: cloud 61–283, title top 369, kicker top 115
       INSIDE the cloud. Measured after: kicker 99–113, cloud 87–309, title 339.
       Change any one of these three and re-measure all of them. */
    padding: 44px 24px 84px;
    text-align: center;
  }

  .block-tag {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--fan-blue);
  }

  /* ══════════ ART LETTERING (2026-09-29) ══════════
     The visitor asked for the pink display type to become 艺术字, pointing at a
     reference frame of a white brush-script wordmark on hot pink. Everything here
     is one system: a script face (`--font-script`, Pacifico), a MAGENTA face and a
     WHITE edge.

     ⚠️ The colours are the reference's pair, INVERTED, and that is deliberate.
     The reference gets its contrast from a saturated pink field; this page's field
     is pale (`.fan-sky` is `--fan-pink` at 0.3 over a cream mosaic), so white
     letters would have needed a heavy outline just to exist and the wordmark would
     have stopped being pink at all. A/B'd both ways on the real page
     (`输入/_scratch/art-swap.mjs`, `art-swap-1/2-titles.png`): white face + magenta
     edge reads as hollow outline type on cream, magenta face + white edge reads as
     solid art lettering and keeps the page's identity colour. The white edge is
     what separates the letters from the pink sky.

     ⚠️ Three things this treatment needs and will look broken without:
       1. `font-weight: 400`. Pacifico ships one weight; asking for 900 gets a
          browser-synthesised bold, which is wider and blurrier.
       2. `paint-order: stroke fill`. `-webkit-text-stroke` is centred on the
          outline, so half of it lands INSIDE the glyph and eats the fill. This
          paints the fill back on top; the edge you see is the outer half.
       3. An em-scaled stroke width (`-webkit-text-stroke-width: 0.075em`), because
          the stroke does NOT follow `font-size` on its own. */
  .fan-title {
    position: relative;
    z-index: 1;
    /* ── WHY THIS IS `block` + `max-content` + `left/translate`, AND NOT `inline-block` ──
       With `TITLE_GAPS` baked in, the wordmark is 1171px wide at the 108px cap: 39px
       WIDER than the 1132px the hero offers. Every way of centring an over-wide box
       was tried on the real page and measured, and exactly one of them centres it:
         · `inline-block` + the parent's `text-align: center` - a line box that
           overflows is aligned to the START, not centred: ink measured 154..1325 (a
           box centre 19.5px right of the cloud, `Fluffy World` and the sub line).
         · `display: block` + `text-align: center` - the same, and the ink still
           starts at the content edge.
         · `display: block` + `width: max-content` + `margin-inline: auto` - CSS 2.1
           §10.3.3 zeroes BOTH auto margins when the box is over-constrained, so it
           is left-aligned too (the "auto margins centre it" belief is only true
           while it fits).
         · **this** - a block that starts at the content edge, shifted by half the
           containing block and back by half of itself. Correct for every width: it
           is an identity when the wordmark fits, and 19.5px of symmetric overhang
           when it does not.
       ⚠️ `translate`, NOT `transform`. `FanIntro` animates this element's `transform`
       for the hero reveal (`translateY(28px) scale(.96)` -> none); a `transform` here
       would be REPLACED by that rule for the whole arrival and the wordmark would
       jump half its own width sideways at the reveal. `translate` is a separate
       property and composes with it (translate -> rotate -> scale -> transform).
       Measured after: ink centred on the viewport at 1280, 1440 and 1600. */
    display: block;
    width: max-content;
    left: 50%;
    translate: -50% 0;
    /* The cloud is in flow now, so this is only the print gap under it — it no
       longer has to reserve the cloud's height as well. */
    margin: clamp(22px, 2.4vw, 30px) 0 0;
    font-family: var(--font-script);
    /* ⚠️ Sized to FIT, and the numbers come from a measurement: Pacifico sets
       `RRSUIKA STUDIO` at 10.26x its font-size (882px at 86px), against 5.8x for
       the Saira Condensed 900 it replaces. The hero is 1180px wide with 24px
       padding, so the wordmark may not exceed ~110px — the 156px it used to be set
       at would have run ~1600px wide, off both edges. The 108px cap also covers
       wide screens, where `vw` alone would keep growing while the hero stops at
       1180px. Measured after: 1107px wide at 1440. */
    /* ⚠️ ONE LINE, and this pair of numbers is the 9b9a074 lockup — the visitor
       asked for it back by name: 「我需要 commit 版本 9b9a074 的标题尺寸和大小，那个
       版本的 RRSUIKA STUDIO 标题是最好看的」. The TWO-LINE version that followed
       (3960e54, font-size up to 205px) was reverted for a reason that is visible on
       any window: the markup went back to one line while the size stayed at the
       two-line value, so `RRSUIKA STUDIO` — which Pacifico sets at 10.26x its
       font-size — ran ~2100px wide in a 1132px hero and off the right edge. The two
       numbers below only work as a PAIR: 108px is the cap that keeps ONE line inside
       the hero, and 1.1 is the leading that goes with it. Change one, re-measure the
       rendered width (输入/_scratch/hero-geom.mjs prints it). */
    font-size: clamp(26px, 7.6vw, 108px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--art-face, var(--fan-magenta));
    -webkit-text-stroke: 0.075em var(--art-edge, var(--fan-white));
    paint-order: stroke fill;
    text-shadow: 0 0.05em 0 var(--art-shadow, rgba(214, 31, 116, 0.26));
  }

  /* ⚠️ `global.css` §13 sets `html[lang="zh"] h1 { letter-spacing: 0;
     line-height: 1.2 }` at (0,2,1), which BEATS this component's scoped
     `.fan-title[data-astro-cid-…]` at (0,2,0). On the Chinese page the wordmark
     therefore fell back through the font stack and rendered in Smiley Sans instead
     of the display face — measured: `Saira Condensed` vs `Smiley Sans Oblique`, and
     905px vs 878.9px wide, i.e. two visibly different logos for one string.
     `RRSUIKA STUDIO` is Latin in BOTH languages, so it keeps the Latin face, weight
     and tracking in both. The Chinese NAME under it (`.fan-title-cn`) is a different
     element and keeps `--font-zh-display`; that one IS Chinese and should. */
  :global(html[lang="zh"]) .fan-title {
    font-family: var(--font-script);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.1;
  }

  /* ⚠️ There WAS a blue bar under the wordmark. It is gone: the visitor called it
     ugly, and it was fighting the deck's own overhanging-watermark device (the
     reference slides its title over a giant pale `DOLLY'S PLAYGROUND`, they do not
     underline it). The watermark is `.fan-hero-echo` now. */

  /* The deck's loudest typographic device: the wordmark slides over a giant pale
     echo of its own Chinese name, cropped by the hero's overflow. Purely
     decorative, so it is aria-hidden and takes no pointer events. */
  .fan-hero-echo {
    position: absolute;
    left: 50%;
    /* ⚠️ Sized and placed against the MEASURED stack: the cloud's visible bottom
       is ~274 in the hero, the wordmark is 140px tall at 303–443. The echo is set
       only ~1.35x the wordmark's height and offset so it peeks out above and below
       instead of floating in the gap above the wordmark — measured with the first
       numbers (210px tall at 293) it read as a second broken headline, not as a
       watermark. */
    top: clamp(214px, 17vw, 236px);
    z-index: 0;
    font-family: var(--font-zh-display);
    font-size: clamp(74px, 12.4vw, 186px);
    line-height: 0.82;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--fan-white);
    opacity: 0.42;
    transform: translateX(-50%);
    pointer-events: none;
    user-select: none;
  }

  /* ⚠️ `.title-line` was here: one block wrapper per WORD, for the two-line lockup.
     The markup is back to a single run of `.tl` spans, so the rule went with it — a
     `display: block` on a class that no longer exists is dead CSS that reads like a
     live layout rule. */

  .fan-title-cn {
    position: relative;
    z-index: 1;
    margin: 10px 0 0;
    font-family: var(--font-zh-display);
    font-size: clamp(18px, 2.6vw, 30px);
    letter-spacing: 0.42em;
    color: var(--fan-blue);
  }

  .fan-sub {
    position: relative;
    z-index: 1;
    max-width: 54ch;
    margin: 22px auto 0;
    font-size: 16px;
    line-height: 1.75;
    color: var(--fan-ink-soft);
  }



  .fan-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 2px solid var(--fan-blue);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.22s var(--spring-snappy),
      background 0.22s var(--ease-out),
      color 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out);
  }

  .fan-btn svg {
    width: 24px;
    height: 13px;
  }

  .fan-btn svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .fan-btn-blue {
    background: var(--fan-blue);
    color: var(--fan-white);
    box-shadow: var(--fan-shadow);
  }

  .fan-btn-blue:hover {
    background: var(--fan-blue-bright);
    transform: translateY(-2px);
  }

  .fan-btn-blue:hover svg {
    animation: fanNudge 0.6s var(--ease-out);
  }

  .fan-btn-ghost {
    background: transparent;
    color: var(--fan-blue);
  }

  .fan-btn-ghost:hover {
    background: var(--fan-blue);
    color: var(--fan-white);
    transform: translateY(-2px);
  }

  @keyframes fanNudge {
    0% {
      transform: translateX(0);
    }
    45% {
      transform: translateX(4px);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* ── the crowned cloud, rebuilt in CSS ──
     ⚠️ The scalloped edge is a ring of CIRCLES, not a blurred blob: the
     reference's clouds are printed shapes with an outline you can trace, and a
     blur reads as a modern gradient mesh instead. Each `.blob` is one scallop,
     layered back to front. */
  /* The cloud is a BACKDROP behind the kicker and the title. It is drawn, not
     built from rounded boxes: a scalloped outline needs a real path with
     stroke-linejoin: round, and the double line (pink edge, white inner) is
     what reads as printed rather than as a soft gradient blob. */
  /* ⚠️ The cloud is IN FLOW, not absolutely placed. It used to be absolute and the
     kicker sat on top of it, because an absolute box pushes nothing and the
     kicker's own line was the only thing reserving room. Nothing can be laid out
     against an absolute box without hand-tuning a magic offset, so the blob is a
     normal block now and the kicker simply sits above it (measured: kicker
     99–113, cloud 137–359, wordmark 385). */
  /* the loose hero ornaments: absolute against the hero's padding box, so their
     percentages are of the CONTENT column (1180px), not the raw viewport */
  .hero-orn {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-orn .orn {
    position: absolute;
    color: var(--fan-magenta);
  }

  /* ⚠️ No `nth-child` recolouring. Each ornament carries its own ink from the data,
     so the scatter is deliberate rather than "every third one blue". */

  /* the section watermark: the deck slides every heading over a giant pale echo
     of itself. Cropped by the block's own `overflow: hidden`. */
  .sect-echo {
    position: absolute;
    right: -4%;
    top: 6px;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(58px, 11vw, 152px);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--fan-white);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  .fan-commission {
    position: relative;
    overflow: hidden;
  }

  .fan-commission > *:not(.sect-echo) {
    position: relative;
    z-index: 1;
  }

  .fan-mark {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8px 24px 0;
    color: var(--fan-pink);
    opacity: 0.55;
  }

  .hero-blob {
    position: relative;
    z-index: 0;
    width: min(290px, 56vw);
    /* ⚠️ The group is lifted by 44px WITHOUT moving the wordmark under it, and the
       arithmetic is the whole trick: a `margin-top` on its own would carry everything
       below it up by the same amount and the crowding would simply travel with it.
       What shifts the picture is the SUM staying at -96px (the empty band under the
       silhouette) while the split moves: -44 above, -52 below. Measured before:
       cloud bottom 318, wordmark box top 323, i.e. 5px — and the cloud's own
       drop-shadow (20px offset + 34px blur) reaches ~372, straight through the
       ascenders of `RRSUIKA`. After: cloud bottom 274 against the same 323. */
    margin: -44px auto 0;
    pointer-events: none;
    /* ⚠️ The square viewBox carries ~40px of empty band under the silhouette
       (the path's lowest point is y=183 of 242). The box is kept square so the
       cloud is not stretched, and the slack is taken back HERE: measured, the box
       is 290x290 with the cloud occupying the top 175px, so the line below is
       pulled up by the band's own height. */
    margin-bottom: -52px;
  }

  .hero-blob .cloud {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 34px rgba(245, 48, 138, 0.3));
  }

  .cloud-body {
    fill: var(--fan-pink);
    stroke: var(--fan-magenta);
    stroke-width: 6;
    stroke-linejoin: round;
  }

  .cloud-in {
    fill: var(--fan-white);
    stroke: var(--fan-pink-soft);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .hero-blob .crown {
    position: absolute;
    /* Centred on the CLOUD, not on this box: the path's visual centre sits a
       little left of and above the box centre, because the viewBox carries
       slack on the right and below for the scallops. */
    /* the silhouette spans x 22..220, y 47..183 inside the 242 box, so its own
       centre is (121, 115) = 50% / 47.5% of the box — not 50% / 50% */
    left: 50%;
    top: 46%;
    width: 26%;
    transform: translate(-50%, -50%);
    color: var(--fan-ink);
  }

  .spark {
    position: absolute;
    width: 22px;
    height: 22px;
    background: var(--fan-blue);
    clip-path: polygon(
      50% 0%,
      58% 38%,
      100% 50%,
      58% 62%,
      50% 100%,
      42% 62%,
      0% 50%,
      42% 38%
    );
    animation: fanTwinkle 3.4s var(--ease-out) infinite;
  }

  .spark-a {
    left: 4%;
    top: 26%;
  }
  .spark-b {
    right: 6%;
    top: 18%;
    width: 15px;
    height: 15px;
    animation-delay: 0.5s;
  }
  .spark-c {
    right: 14%;
    bottom: 16%;
    width: 12px;
    height: 12px;
    animation-delay: 1.1s;
  }
  .spark-d {
    left: 13%;
    bottom: 22%;
    width: 16px;
    height: 16px;
    animation-delay: 1.7s;
  }

  @keyframes fanTwinkle {
    0%,
    100% {
      transform: scale(0.82) rotate(0deg);
      opacity: 0.75;
    }
    50% {
      transform: scale(1.12) rotate(22deg);
      opacity: 1;
    }
  }

  .fan-stamp {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: 26px;
    padding: 5px 12px;
    border: 1.5px dashed var(--fan-magenta);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fan-magenta);
    transform: rotate(-2deg);
  }


  /* ══════════════════════════════════════════════════════════════
     DECORATION — the vocabulary, and the util
     ══════════════════════════════════════════════════════════════ */
  .orn {
    display: block;
    color: var(--fan-magenta);
    pointer-events: none;
  }

  .orn svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .orn-stroke {
    fill: none;
    stroke: currentColor;
    /* the reference's line work is chunky with round caps, not hairline */
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .orn-fill {
    fill: currentColor;
  }

  /* halftone dots: the deck's cheapest texture, and the one that makes a flat
     pink field read as PRINTED rather than as a CSS background */
  .orn-dots {
    background-image: radial-gradient(currentColor 1.6px, transparent 1.7px);
    background-size: 11px 11px;
    opacity: 0.34;
  }

  /* the ruled tape strip: a solid rule with a row of ticks riding it, exactly
     the device the reference uses to separate its panels */
  .orn-tape {
    position: relative;
    height: 12px;
    border-top: 3px solid currentColor;
  }

  /* ⚠️ The ticks span the WHOLE rule. They used to be pinned to `width: 119px`
     while `.orn-tape` itself is a full-width element with a 3px `border-top` — so
     the ruler was 1132px of solid line with ticks on only the first 119px. The
     visitor reported exactly that as 「条形码一样的，但是被中断了」.
     The period divides the rule evenly: 1132px, 2px on / 6.5px off (8.5px period)
     → 133 whole ticks, the last ending at 1130.5px, i.e. 1.5px clear of the end. */
  .orn-tape::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    height: 8px;
    background-image: repeating-linear-gradient(
      90deg,
      currentColor 0 2px,
      transparent 2px 8.5px
    );
    opacity: 0.55;
  }

  /* the scalloped edge: the deck's panel tops are scalloped, and this is the
     cheapest way to say it without an SVG per section */
  .orn-scallop {
    height: 12px;
    background-image: radial-gradient(
      circle at 50% 100%,
      currentColor 0 5px,
      transparent 5.5px
    );
    background-size: 20px 12px;
    background-repeat: repeat-x;
  }

  .orn-seal {
    border: 3px dashed currentColor;
    border-radius: 50%;
  }

  .orn-reg {
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-bottom-color: transparent;
  }

  .orn-reg-flip {
    transform: rotate(180deg);
  }

  /* ⚠️ FULL BLEED, and the FIRST attempt at it did not work. `margin-inline: -24px`
     only cancels the block's own padding: 1180 (its max-width) + 48 = 1228px
     against a 1440px viewport, so the plates still started 106px inside the edge
     (measured block 130..1310, row 130..1310).
     The shape that works is structural, not a negative margin: the SECTION drops
     its max-width and padding so it spans the viewport, its HEADING gets its own
     centred wrapper, and the rows simply fill the section. Nothing here depends on
     which breakpoint's padding happens to be in force. */
  .fan-bleed {
    max-width: none;
    padding: 54px 0;
  }

  .bleed-head {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* the halftone field that makes the gallery read as printed rather than as a
     flat pink band; it is CLIPPED to the section and never intercepts a drag */
  .fan-field {
    position: relative;
    overflow: hidden;
  }

  .fan-field > .orn-dots {
    position: absolute;
    inset: 0;
    color: var(--fan-magenta);
    opacity: 0.13;
  }

  .fan-field > *:not(.orn-dots) {
    position: relative;
    z-index: 1;
  }

  .fan-bleed .fan-row {
    margin-inline: 0;
  }

  /* ══════════════════════════════════════════════════════════════
     THE SHEEP
     ══════════════════════════════════════════════════════════════ */
  .sheep-layer {
    position: fixed;
    inset: 0;
    z-index: 9000;
    overflow: hidden;
    pointer-events: none;
  }

  /* ⚠️ `:global` because the solver CREATES these nodes. A scoped rule would
     compile to `.sheep[data-astro-cid-…]` and never match. */
  :global(.sheep) {
    position: absolute;
    top: 0;
    left: 0;
    width: 76px;
    height: 64px;
    /* the transform is set every frame from the solver, so nothing here may
       transition: a CSS transition on `transform` would fight it and smear the
       whole simulation */
    will-change: transform;
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(.sheep.is-dragged) {
    cursor: grabbing;
    z-index: 2;
  }

  :global(.sheep svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* the wool: the same scalloped device as the clouds, so a sheep reads as part
     of this page rather than as a sprite dropped onto it */
  :global(.sheep-face) {
    fill: var(--fan-ink);
  }

  :global(.sheep-eye) {
    fill: var(--fan-white);
  }

  :global(.sheep-leg) {
    stroke: var(--fan-ink);
    stroke-width: 7;
    stroke-linecap: round;
  }

  :global(.sheep.is-poked svg) {
    animation: sheepWobble 0.42s var(--spring-bounce);
  }

  @keyframes sheepWobble {
    0% {
      transform: rotate(0) scale(1);
    }
    35% {
      transform: rotate(-9deg) scale(1.08);
    }
    70% {
      transform: rotate(6deg) scale(1.02);
    }
    100% {
      transform: rotate(0) scale(1);
    }
  }

  .nudge-limit {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    color: var(--fan-ink-soft);
  }

  .nudge-limit[hidden] {
    display: none;
  }
  /* ── the sheep ──
     Every press of the 催更 button drops one. Verlet integration, circle
     collision, and a drag that feeds its own velocity back on release so a
     thrown sheep keeps going.
     ⚠️ ONE rAF for the whole population, and it stops itself once everything is
     asleep — a permanent loop over twenty sheep would be a permanent repaint of
     the page for a decoration. */
  /* ══════════════════════════════════════════════════════════════
     PAGE RAIL
     ══════════════════════════════════════════════════════════════ */
  .fan-rail {
    position: fixed;
    /* below the top bar, above the footer */
    top: 76px;
    right: 10px;
    bottom: 66px;
    z-index: 50;
    width: 4px;
    /* the pseudo-element's hit area is positioned against this box */
    isolation: isolate;
    border-radius: 999px;
    background: rgba(27, 37, 216, 0.14);
    /* ⚠️ A CONTROL now, not decoration: it is draggable, so it takes the
       pointer. `touch-action: none` or a phone drag scrolls the page instead. */
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    transition: background-color 0.2s var(--ease-out);
  }

  /* ⚠️ The hit area is widened with a pseudo-element, NOT with padding. Padding
     would widen the box `getBoundingClientRect()` reports, and the drag maps the
     pointer against that rect — measured, an 18px box against a 4px line moved the
     page 4px when dragged to the middle. The rect has to be the line. */
  .fan-rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -8px;
    right: -8px;
  }

  .fan-rail:hover,
  .fan-rail.is-dragging {
    background-color: rgba(27, 37, 216, 0.24);
  }

  .fan-rail.is-dragging {
    cursor: grabbing;
  }

  .fan-rail-fill {
    display: block;
    width: 100%;
    /* proportional on purpose — see the driver. `max()` keeps a grabbable
       minimum so the control does not become a 3px dot on a very long page. */
    height: max(28px, calc(var(--fan-read, 0) * 100%));
    border-radius: 999px;
    /* ⚠️ NO glow. The pink halo was removed on request — the rail is just the
       blue line now, and the track behind it keeps the faint blue tint so it still
       reads as a gauge rather than as a stray mark. */
    background: var(--fan-blue);
  }

  @media (max-width: 640px) {
    .fan-rail {
      right: 7px;
      width: 2px;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     SECTION HEADS
     ══════════════════════════════════════════════════════════════ */
  .fan-block {
    max-width: 1180px;
    margin: 0 auto;
    padding: 54px 24px;
    scroll-margin-top: 90px;
  }

  /* the deck's section heads are a small wide-tracked label riding a TAPE strip
     (a solid rule with a row of ticks), immediately above the big title. This is
     that strip: short, left-aligned, and the same pink as the headings. */
  .block-head {
    position: relative;
    max-width: 62ch;
    margin-bottom: 26px;
  }

  /* same ruler as `.orn-tape`, same two constraints: whole dashes, and the last
     one flush with the end of the rule (17 × 7px + 2px = exactly 119px). */
  .block-head::before {
    content: "";
    display: block;
    width: 121px;
    height: 12px;
    margin-bottom: 14px;
    border-top: 3px solid var(--fan-magenta);
    background-image: repeating-linear-gradient(
      90deg,
      var(--fan-magenta) 0 2px,
      transparent 2px 7px
    );
    background-size: 119px 8px;
    background-repeat: no-repeat;
    background-position: 0 3px;
    opacity: 0.7;
  }

  /* Same art-lettering system as the wordmark, one size down. ⚠️ `text-transform`
     is deliberately NOT uppercase here any more: a script face has no capitals to
     shout with — its whole character is the CONNECTED lowercase, and Pacifico's
     caps-only setting reads as a row of separate swashes. The en titles are title
     case in `src/utils/fan.ts` already ("Who am I?", "Get in touch"), so nothing
     had to change in the copy. */
  .block-title {
    margin: 8px 0 10px;
    font-family: var(--font-script);
    font-size: clamp(34px, 5vw, 62px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: none;
    color: var(--art-face, var(--fan-magenta));
    -webkit-text-stroke: 0.055em var(--art-edge, var(--fan-white));
    paint-order: stroke fill;
    text-shadow: 0 0.05em 0 var(--art-shadow, rgba(214, 31, 116, 0.22));
  }

  /* ⚠️ The Chinese titles are still Chinese, so the script face cannot render them
     — Pacifico has no CJK. They keep `--font-zh-display` (Smiley Sans Oblique,
     already a hand-cut display face) and take the SAME face/edge treatment, which
     is what keeps the two languages looking like one page instead of two. */
  :global(html[lang="zh"]) .block-title {
    font-family: var(--font-zh-display);
    text-transform: none;
    letter-spacing: 0.04em;
    -webkit-text-stroke-width: 0.045em;
  }

  .block-sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--fan-ink-soft);
  }

  .fan-empty {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fan-ink-soft);
  }

  /* ══════════════════════════════════════════════════════════════
     MODULE 01 · INTRODUCTION
     ══════════════════════════════════════════════════════════════ */
  /* the copy is the long side and the facts are the short one, so the reading
     column never stretches past a comfortable measure on a wide screen */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  .intro-facts {
    margin: 0;
    padding: 4px 0 0;
    border-top: 3px solid var(--fan-magenta);
  }

  .fact {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(27, 37, 216, 0.14);
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--fan-blue);
  }

  .fact dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fan-ink);
  }

  /* ══════════════════════════════════════════════════════════════
     MODULE 03 · COMMISSIONS
     ══════════════════════════════════════════════════════════════ */
  /* ⚠️ These two sections read as a centred block. A centred heading over
     left-aligned body copy reads as an accident rather than as a choice, so the
     copy inside gets a centred measure too.
     ⚠️ `.block-head` itself is `max-width: 62ch` PLUS a `::before` tick strip, and
     the head is a flex child of the block, so `margin-inline: auto` alone does not
     centre it — the block has to centre its children. */
  .fan-commission .block-head,
  #contact .block-head {
    max-width: 62ch;
    margin-inline: auto;
    text-align: center;
  }

  .fan-commission .block-head::before,
  #contact .block-head::before {
    margin-inline: auto;
  }

  .fan-commission .about-para,
  .fan-commission .commission-note,
  #contact .block-sub {
    margin-inline: auto;
    text-align: center;
  }

  .fan-commission .commission-card {
    max-width: 760px;
    margin-inline: auto;
  }

  .commission-card {
    max-width: 860px;
    padding: 30px 32px 26px;
    border-top: 5px solid var(--fan-magenta);
    border-radius: 4px 4px 12px 12px;
    background: var(--fan-white);
    box-shadow: 0 0 0 1.5px rgba(27, 37, 216, 0.12);
  }

  /* ⚠️ The status pill is the ONE place on this page where blue fills a shape.
     Pink fills every other surface, so the filled pill is what makes "closed"
     read before the sentence next to it is read at all. */
  .commission-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 7px 15px;
    border-radius: 999px;
    background: var(--fan-blue);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fan-white);
  }

  .commission-status svg {
    width: 14px;
    height: 14px;
  }

  .commission-status svg rect,
  .commission-status svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .fan-commission .about-para {
    margin-top: 16px;
  }

  /* ── the 催更 button ──
     ⚠️ It fills a surface with the magenta gradient, which nothing else on this
     page does. That is the point: it is the one thing in this section the visitor
     is meant to press, and a solid slab is what makes that legible from across
     the page. The reference deck does the same for its claim-all button. */
  .nudge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    /* ⚠️ 22px of margin read as far more than 22px: the GIF's own frame carries
       headroom above the animal (that is where the hop goes), so the visible gap was
       this margin PLUS roughly a third of the 168px box. The margin comes down to
       4px and the box is pulled up 26px on top of that; the hop still happens inside
       the box, it just no longer floats. */
    margin-top: 4px;
  }

  /* ── the avatar above the button ──
     ⚠️ `image-rendering` is left alone and the art is 2x the box, so it stays
     crisp on a retina screen. The GIF's own transparent background is what keeps
     it sitting on the paper rather than in a white square. */
  .nudge-pfp {
    display: block;
    /* ⚠️ The GIF's frame has headroom above the animal — that is where the jump
       goes — so the animal itself is only ~55% of the box: at 168px the animal is
       ~92px and the hop still fits inside the box. (It went 96 → 120 → 168 on the
       visitor's ask; the source art is 240px, so there is room before it softens.) */
    width: 168px;
    height: 168px;
    margin-top: -26px;
    margin-bottom: -10px;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 860px) {
    .nudge-pfp {
      width: 132px;
      height: 132px;
    }
  }

  .nudge-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(360px, 78vw);
    padding: 20px 42px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    color: var(--fan-white);
    background: linear-gradient(
      118deg,
      var(--fan-magenta) 0%,
      var(--fan-pink) 62%,
      var(--fan-magenta) 100%
    );
    background-size: 220% 100%;
    box-shadow:
      0 14px 30px -12px rgba(245, 48, 138, 0.85),
      inset 0 -3px 0 rgba(18, 18, 58, 0.18);
    transition:
      transform 0.22s var(--spring-snappy),
      box-shadow 0.24s var(--ease-out),
      background-position 0.5s var(--ease-out);
  }

  .nudge-btn:hover,
  .nudge-btn:focus-visible {
    transform: translateY(-4px) scale(1.025);
    background-position: 100% 0;
    box-shadow:
      0 22px 44px -14px rgba(245, 48, 138, 0.95),
      inset 0 -3px 0 rgba(18, 18, 58, 0.18);
  }

  .nudge-btn:active {
    transform: translateY(-1px) scale(0.975);
  }

  .nudge-face {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: clamp(22px, 3.4vw, 34px);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 2px 0 rgba(18, 18, 58, 0.2);
  }

  :global(html[lang="zh"]) .nudge-face {
    font-family: var(--font-zh-display);
    letter-spacing: 0.14em;
  }

  /* the shockwave: one ring, restarted by re-adding the class */
  .nudge-ring {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    border: 3px solid var(--fan-pink);
    opacity: 0;
    pointer-events: none;
  }

  .nudge-btn.is-hit .nudge-ring {
    animation: nudgeRing 0.62s var(--ease-out);
  }

  @keyframes nudgeRing {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.34);
    }
  }

  /* the spark burst: eight sparks on a conic ray, each flung on its own angle */
  .nudge-burst {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .nudge-spark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 2px;
    background: var(--fan-magenta);
    opacity: 0;
    transform: rotate(var(--a)) translateY(0);
  }

  .nudge-btn.is-hit .nudge-spark {
    animation: nudgeSpark 0.7s var(--ease-out);
  }

  @keyframes nudgeSpark {
    0% {
      opacity: 1;
      transform: rotate(var(--a)) translateY(-14px) scale(1);
    }
    100% {
      opacity: 0;
      transform: rotate(var(--a)) translateY(-64px) scale(0.2);
    }
  }

  .nudge-tally {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--fan-ink-soft);
  }

  .nudge-count {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 0;
    color: var(--fan-magenta);
  }

  .nudge-count.is-bump {
    animation: nudgeBump 0.44s var(--spring-bounce);
  }

  @keyframes nudgeBump {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.5);
    }
    100% {
      transform: scale(1);
    }
  }

  .nudge-back {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.2px;
    color: var(--fan-blue);
  }

  /* ⚠️ The entrance animation lives on a CLASS, not on `.nudge-back` itself.
     The reply is now drawn from a pool and rewritten on every press, so the
     0.32s fade has to be replayed per press — and re-adding a class is the only
     reliable restart. Removing and re-adding the same class does NOT restart an
     animation declared on the base rule, because the computed value never
     changes. */
  .nudge-back.is-pop {
    animation: nudgeFade 0.32s var(--ease-out);
  }

  .nudge-back[hidden] {
    display: none;
  }

  @keyframes nudgeFade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nudge-btn,
    .nudge-btn:hover,
    .nudge-btn:focus-visible,
    .nudge-btn:active {
      transform: none;
    }

    .nudge-btn.is-hit .nudge-ring,
    .nudge-btn.is-hit .nudge-spark,
    .nudge-count.is-bump,
    .nudge-back.is-pop {
      animation: none;
    }
  }

  .commission-note {
    margin: 4px 0 0;
    padding-top: 14px;
    border-top: 1px dashed rgba(27, 37, 216, 0.22);
    font-size: 14px;
    line-height: 1.75;
    color: var(--fan-ink);
  }

  /* ══════════════════════════════════════════════════════════════
     MODULE 04 · CONTACT
     ══════════════════════════════════════════════════════════════ */
  .contact-list {
    display: grid;
    /* ⚠️ Four on one row inside a 1180px block: 4 × 200 + 3 × 14 = 842 against the
     1132 the block offers. The old 248px minimum needed 1040 AND the cards were
     narrower than their own content, so the fourth pill wrapped to a second row.
     `auto-fit` still collapses to two columns on a phone. */
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    max-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 16px;
    border-radius: 10px;
    background: var(--fan-white);
    box-shadow: 0 0 0 1.5px rgba(27, 37, 216, 0.16);
    text-decoration: none;
    transition:
      transform 0.26s var(--spring-snappy),
      box-shadow 0.26s var(--ease-out);
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 0 0 2px var(--fan-magenta);
  }

  .contact-label {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--fan-magenta);
  }

  :global(html[lang="zh"]) .contact-label {
    font-family: var(--font-zh-display);
    text-transform: none;
  }

  .contact-handle {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.6px;
    color: var(--fan-ink-soft);
    overflow-wrap: anywhere;
  }

  .contact-go {
    font-size: 15px;
    line-height: 1;
    color: var(--fan-blue);
  }

  /* ⚠️ A handle with no public URL is a DIV, not an anchor: Discord and QQ are
     published in the site footer as plain text, and a link that 404s is worse
     than no link. Same card, minus the affordances. */
  .contact-link[data-nolink] {
    cursor: default;
    background: var(--fan-cream-2);
    box-shadow: 0 0 0 1.5px rgba(27, 37, 216, 0.1);
  }

  .contact-link[data-nolink]:hover {
    transform: none;
    box-shadow: 0 0 0 1.5px rgba(27, 37, 216, 0.1);
  }

  /* ══════════════════════════════════════════════════════════════
     ARCHIVE ROWS
     ══════════════════════════════════════════════════════════════ */
  .fan-row {
    margin-bottom: 26px;
  }

  .row-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
  }

  .row-idx {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--fan-blue);
  }

  .row-head h3 {
    flex: 1;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--fan-ink);
  }

  .row-count {
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--fan-ink-soft);
  }

  .row-view {
    position: relative;
    height: 330px;
    /* clip, not hidden: `overflow-x: hidden` would make this a scroll
       container and the drag would fight the browser's own scroll. */
    overflow-x: clip;
    overflow-y: visible;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  :global(.fan-root .row-view) {
    -webkit-user-select: none;
  }

  /* ⚠️ THE PAGE-WIDE SELECTION BLOCK LIVES ON `.fan-root` ITSELF (see that rule).
     Its WebKit twin has to be a SEPARATE rule: the build's minifier treats the
     prefixed and unprefixed properties as aliases, collapses a pair in one rule and
     keeps the LAST one (CLAUDE.md) - which is exactly how the frosted cards once
     shipped WebKit-only frost. Same shape as the `.row-view` pair above. */
  :global(.fan-root) {
    -webkit-user-select: none;
  }

  /* ⚠️ ONE EXCEPTION, and it is deliberate: a handle with no public URL is the only
     text on this page that exists TO BE COPIED (`data-nolink` - Discord, QQ). The
     selection block is about not smearing the hero while dragging a fruit, not about
     hiding a handle from the visitor. */
  :global(.fan-root .contact-handle) {
    user-select: text;
    -webkit-user-select: text;
  }

  .row-track {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
    padding: 0 24px;
    will-change: transform;
  }

  /* ── a plate is a printed card with a pink edge ── */
  .plate {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    height: 300px;
    padding: 8px 8px 0;
    border: 0;
    border-radius: 10px;
    background: var(--fan-white);
    /* ⚠️ The RING stays, the DROP SHADOW does not. Visitor: 「画廊的图片不要有阴影」. A
        `0 0 0 2px` spread is a printed edge, not a shadow — it is what makes a plate
       read as a card, and the blue version of it is the hover state. */
    box-shadow: 0 0 0 2px var(--fan-pink);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      transform 0.35s var(--spring-gentle),
      box-shadow 0.35s var(--ease-out);
  }

  .plate:hover {
    transform: translateY(-8px);
    box-shadow: 0 0 0 2px var(--fan-blue);
  }



  .plate-media {
    display: block;
    height: 232px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--fan-cream-2);
  }

  .plate-media img {
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    pointer-events: none;
  }

  .plate-foot {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 4px 10px;
  }

  .plate-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--fan-magenta);
  }

  :global(html[lang="zh"]) .plate-title {
    font-family: var(--font-zh-display);
    text-transform: none;
  }

  .plate-cat {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--fan-ink-soft);
  }

  /* ══════════════════════════════════════════════════════════════
     SHARED COPY
     ══════════════════════════════════════════════════════════════ */

  .about-para {
    max-width: 62ch;
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.85;
    color: var(--fan-ink-soft);
  }







  /* ══════════════════════════════════════════════════════════════
     FAN FOOTER
     ══════════════════════════════════════════════════════════════ */
  .fan-foot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 24px 70px;
    text-align: center;
  }

  /* ⚠️ The footer cloud is the HERO'S SILHOUETTE, not a pill plus two
     `box-shadow` discs. The old build had no top scallop at all, so its top edge
     was a straight cut — reported as 「云朵的顶部缺失了一块」. `height: auto`
     on an SVG with a square viewBox keeps the aspect ratio; a fixed height would
     stretch it, which is the mistake the hero's cloud already made once. */
  /* ⚠️ WHITE, and the paths are styled here rather than relying on `.cloud-body`.
     The footer sits on the deep-pink band at the bottom of the page, where the
     hero's pink fill reads as a grey smudge against the magenta — the visitor
     asked for white. The stroke goes too, or the silhouette reads as an outline
     drawing rather than a cloud. */
  .foot-cloud {
    width: 104px;
    height: auto;
    opacity: 0.92;
  }

  .foot-cloud path {
    fill: var(--fan-white);
    stroke: none;
  }

  .foot-note {
    max-width: 52ch;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--fan-ink-soft);
  }

  /* ══════════════════════════════════════════════════════════════
     LIGHTBOX
     ══════════════════════════════════════════════════════════════ */
  .fan-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9500;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s var(--ease-out);
  }

  .fan-lightbox.is-on {
    opacity: 1;
    pointer-events: auto;
  }

  .lb-bg {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: rgba(18, 18, 58, 0.92);
    backdrop-filter: blur(6px);
  }

  .lb-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 92vw;
    margin: 0;
    transform: scale(0.94);
    transition: transform 0.4s var(--spring-bounce);
  }

  .fan-lightbox.is-on .lb-body {
    transform: scale(1);
  }

  .lb-body img {
    max-width: 90vw;
    max-height: 78vh;
    object-fit: contain;
    border: 4px solid var(--fan-pink);
    border-radius: 8px;
    background: var(--fan-white);
  }

  .lb-cap {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--fan-white);
  }

  .lb-x,
  .lb-nav {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    border: 0;
    cursor: pointer;
    background: transparent;
    color: var(--fan-white);
    transition: transform 0.2s var(--spring-snappy);
  }

  .lb-x {
    top: 18px;
    right: 22px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--fan-magenta);
  }

  .lb-x svg {
    width: 16px;
    height: 16px;
  }

  .lb-x svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: square;
  }

  .lb-nav {
    top: 50%;
    width: 52px;
    height: 62px;
    transform: translateY(-50%);
  }

  .lb-nav svg {
    width: 17px;
    height: 30px;
  }

  .lb-nav svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .lb-prev {
    left: 12px;
  }
  .lb-next {
    right: 12px;
  }
  .lb-prev:hover {
    transform: translateY(-50%) translateX(-4px);
  }
  .lb-next:hover {
    transform: translateY(-50%) translateX(4px);
  }

  /* ══════════════════════════════════════════════════════════════
     RESPONSIVE
     ══════════════════════════════════════════════════════════════ */
  @media (max-width: 820px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .commission-card {
      padding: 26px 22px 22px;
    }

    .row-view {
      height: 262px;
    }

    .plate {
      height: 238px;
    }

    .plate-media {
      height: 178px;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     MOBILE
     ⚠️ Every rule here answers a measured phone-width problem, not a taste call.
     ══════════════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    /* two pills per row instead of one (248px could not pair inside 354px) */
    .contact-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .contact-link {
      padding: 13px 14px;
      gap: 9px;
    }

    .contact-label {
      font-size: 16px;
    }

    .contact-handle {
      font-size: 11px;
    }

    /* the only tile that has to wrap is the URL one */
    .contact-link[data-nolink] {
      grid-column: span 1;
    }

    /* the 催更 button: `min-width: 78vw` + 84px of padding overflowed a 390px
       viewport, so the box is capped and the padding comes in */
    .nudge-btn {
      min-width: 0;
      width: 100%;
      max-width: 360px;
      padding: 17px 22px;
    }

    .nudge-face {
      font-size: 24px;
      gap: 9px;
    }

    /* the watermark ran off the clipped edge; smaller and further out */
    .sect-echo {
      right: -10%;
      font-size: clamp(46px, 15vw, 92px);
      opacity: 0.4;
    }

    .commission-status {
      letter-spacing: 1.2px;
      font-size: 10px;
      padding: 6px 12px;
    }

    .commission-card {
      padding: 22px 16px 18px;
    }

    /* reading measure: the body copy is 15px on a 354px column, which is fine,
       but the line height needs the room the wider tracking was taking */
    .about-para,
    .block-sub {
      letter-spacing: 0;
    }

    /* smaller plates so a row still shows about two and a half cards */
    .row-view {
      height: 214px;
    }

    .plate {
      width: 168px;
      height: 196px;
    }

    .plate-media {
      height: 138px;
    }

    .plate-title {
      font-size: 11px;
    }

    /* the intro facts stack their label above the value */
    .fact {
      grid-template-columns: 1fr;
      gap: 3px;
    }
  }

  @media (max-width: 560px) {
    .fan-hero {
      padding: 0 18px 54px;
    }

    .hero-blob {
      width: min(216px, 60vw);
      /* the small-screen split of the same -96px sum: less lift, because the top bar
         is closer here (the cloud's ink starts 91px down, the bar ends at ~34px) */
      margin-top: -16px;
      margin-bottom: -80px;
    }

    .fan-title {
      margin-top: clamp(196px, 50vw, 212px);
    }

    .fan-block {
      padding: 38px 18px;
    }

    .fan-bleed {
      padding: 38px 0;
    }

    .bleed-head {
      padding: 0 18px;
    }

    .row-view {
      height: 226px;
    }

    .plate {
