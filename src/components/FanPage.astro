  @keyframes fanNudge {
    0% {
      transform: translateX(0);
    }
    45% {
      transform: translateX(4px);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* ── the crowned cloud, rebuilt in CSS ──
     ⚠️ The scalloped edge is a ring of CIRCLES, not a blurred blob: the
     reference's clouds are printed shapes with an outline you can trace, and a
     blur reads as a modern gradient mesh instead. Each `.blob` is one scallop,
     layered back to front. */
  /* The cloud is a BACKDROP behind the kicker and the title. It is drawn, not
     built from rounded boxes: a scalloped outline needs a real path with
     stroke-linejoin: round, and the double line (pink edge, white inner) is
     what reads as printed rather than as a soft gradient blob. */
  /* ⚠️ The cloud is IN FLOW, not absolutely placed. It used to be absolute and the
     kicker sat on top of it, because an absolute box pushes nothing and the
     kicker's own line was the only thing reserving room. Nothing can be laid out
     against an absolute box without hand-tuning a magic offset, so the blob is a
     normal block now and the kicker simply sits above it (measured: kicker
     99–113, cloud 137–359, wordmark 385). */
  /* the loose hero ornaments: absolute against the hero's padding box, so their
     percentages are of the CONTENT column (1180px), not the raw viewport */
  .hero-orn {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-orn .orn {
    position: absolute;
    color: var(--fan-magenta);
  }

  /* ⚠️ No `nth-child` recolouring. Each ornament carries its own ink from the data,
     so the scatter is deliberate rather than "every third one blue". */

  /* the section watermark: the deck slides every heading over a giant pale echo
     of itself. Cropped by the block's own `overflow: hidden`. */
  .sect-echo {
    position: absolute;
    right: -4%;
    top: 6px;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(58px, 11vw, 152px);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--fan-white);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  .fan-commission {
    position: relative;
    overflow: hidden;
  }

  .fan-commission > *:not(.sect-echo) {
    position: relative;
    z-index: 1;
  }

  .fan-mark {
    max-width: 1180px;
    margin: 0 auto;
    padding: 8px 24px 0;
    color: var(--fan-pink);
    opacity: 0.55;
  }

  .hero-blob {
    position: relative;
    z-index: 0;
    width: min(290px, 56vw);
    margin: 0 auto;
    pointer-events: none;
    /* ⚠️ The square viewBox carries ~40px of empty band under the silhouette
       (the path's lowest point is y=183 of 242). The box is kept square so the
       cloud is not stretched, and the slack is taken back HERE: measured, the box
       is 290x290 with the cloud occupying the top 175px, so the line below is
       pulled up by the band's own height. */
    margin-bottom: -96px;
  }

  .hero-blob .cloud {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 34px rgba(245, 48, 138, 0.3));
  }

  .cloud-body {
    fill: var(--fan-pink);
    stroke: var(--fan-magenta);
    stroke-width: 6;
    stroke-linejoin: round;
  }

  .cloud-in {
    fill: var(--fan-white);
    stroke: var(--fan-pink-soft);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .hero-blob .crown {
    position: absolute;
    /* Centred on the CLOUD, not on this box: the path's visual centre sits a
       little left of and above the box centre, because the viewBox carries
       slack on the right and below for the scallops. */
    /* the silhouette spans x 22..220, y 47..183 inside the 242 box, so its own
       centre is (121, 115) = 50% / 47.5% of the box — not 50% / 50% */
    left: 50%;
    top: 46%;
    width: 26%;
    transform: translate(-50%, -50%);
    color: var(--fan-ink);
  }

  .spark {
    position: absolute;
    width: 22px;
    height: 22px;
    background: var(--fan-blue);
    clip-path: polygon(
      50% 0%,
      58% 38%,
      100% 50%,
      58% 62%,
      50% 100%,
      42% 62%,
      0% 50%,
      42% 38%
    );
    animation: fanTwinkle 3.4s var(--ease-out) infinite;
  }

  .spark-a {
    left: 4%;
    top: 26%;
  }
  .spark-b {
    right: 6%;
    top: 18%;
    width: 15px;
    height: 15px;
    animation-delay: 0.5s;
  }
  .spark-c {
    right: 14%;
    bottom: 16%;
    width: 12px;
    height: 12px;
    animation-delay: 1.1s;
  }
  .spark-d {
    left: 13%;
    bottom: 22%;
    width: 16px;
    height: 16px;
    animation-delay: 1.7s;
  }

  @keyframes fanTwinkle {
    0%,
    100% {
      transform: scale(0.82) rotate(0deg);
      opacity: 0.75;
    }
    50% {
      transform: scale(1.12) rotate(22deg);
      opacity: 1;
    }
  }

  .fan-stamp {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: 26px;
    padding: 5px 12px;
    border: 1.5px dashed var(--fan-magenta);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fan-magenta);
    transform: rotate(-2deg);
  }

  .fan-scroll {
    position: relative;
    z-index: 1;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--fan-ink-soft);
    opacity: 0.7;
  }

  /* ══════════════════════════════════════════════════════════════
     DECORATION — the vocabulary, and the util
     ══════════════════════════════════════════════════════════════ */
  .orn {
    display: block;
    color: var(--fan-magenta);
    pointer-events: none;
  }

  .orn svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .orn-stroke {
    fill: none;
    stroke: currentColor;
    /* the reference's line work is chunky with round caps, not hairline */
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .orn-fill {
    fill: currentColor;
  }

  /* halftone dots: the deck's cheapest texture, and the one that makes a flat
     pink field read as PRINTED rather than as a CSS background */
  .orn-dots {
    background-image: radial-gradient(currentColor 1.6px, transparent 1.7px);
    background-size: 11px 11px;
    opacity: 0.34;
  }

  /* the ruled tape strip: a solid rule with a row of ticks riding it, exactly
     the device the reference uses to separate its panels */
  .orn-tape {
    position: relative;
    height: 12px;
    border-top: 3px solid currentColor;
  }

  /* ⚠️ The ticks span the WHOLE rule. They used to be pinned to `width: 119px`
     while `.orn-tape` itself is a full-width element with a 3px `border-top` — so
     the ruler was 1132px of solid line with ticks on only the first 119px. The
     visitor reported exactly that as 「条形码一样的，但是被中断了」.
     The period divides the rule evenly: 1132px, 2px on / 6.5px off (8.5px period)
     → 133 whole ticks, the last ending at 1130.5px, i.e. 1.5px clear of the end. */
  .orn-tape::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    height: 8px;
    background-image: repeating-linear-gradient(
      90deg,
      currentColor 0 2px,
      transparent 2px 8.5px
    );
    opacity: 0.55;
  }

  /* the scalloped edge: the deck's panel tops are scalloped, and this is the
     cheapest way to say it without an SVG per section */
  .orn-scallop {
    height: 12px;
    background-image: radial-gradient(
      circle at 50% 100%,
      currentColor 0 5px,
      transparent 5.5px
    );
    background-size: 20px 12px;
    background-repeat: repeat-x;
  }

  .orn-seal {
    border: 3px dashed currentColor;
    border-radius: 50%;
  }

  .orn-reg {
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-bottom-color: transparent;
  }

  .orn-reg-flip {
    transform: rotate(180deg);
  }

  /* ⚠️ FULL BLEED, and the FIRST attempt at it did not work. `margin-inline: -24px`
     only cancels the block's own padding: 1180 (its max-width) + 48 = 1228px
     against a 1440px viewport, so the plates still started 106px inside the edge
     (measured block 130..1310, row 130..1310).
     The shape that works is structural, not a negative margin: the SECTION drops
     its max-width and padding so it spans the viewport, its HEADING gets its own
     centred wrapper, and the rows simply fill the section. Nothing here depends on
     which breakpoint's padding happens to be in force. */
  .fan-bleed {
    max-width: none;
    padding: 54px 0;
  }

  .bleed-head {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* the halftone field that makes the gallery read as printed rather than as a
     flat pink band; it is CLIPPED to the section and never intercepts a drag */
  .fan-field {
    position: relative;
    overflow: hidden;
  }

  .fan-field > .orn-dots {
    position: absolute;
    inset: 0;
    color: var(--fan-magenta);
    opacity: 0.13;
  }

  .fan-field > *:not(.orn-dots) {
    position: relative;
    z-index: 1;
  }

  .fan-bleed .fan-row {
    margin-inline: 0;
  }

  /* ══════════════════════════════════════════════════════════════
     THE SHEEP
     ══════════════════════════════════════════════════════════════ */
  .sheep-layer {
    position: fixed;
    inset: 0;
    z-index: 9000;
    overflow: hidden;
    pointer-events: none;
  }

  /* ⚠️ `:global` because the solver CREATES these nodes. A scoped rule would
     compile to `.sheep[data-astro-cid-…]` and never match. */
  :global(.sheep) {
    position: absolute;
    top: 0;
    left: 0;
    width: 76px;
    height: 64px;
    /* the transform is set every frame from the solver, so nothing here may
       transition: a CSS transition on `transform` would fight it and smear the
       whole simulation */
    will-change: transform;
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(.sheep.is-dragged) {
    cursor: grabbing;
    z-index: 2;
  }

  :global(.sheep svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* the wool: the same scalloped device as the clouds, so a sheep reads as part
     of this page rather than as a sprite dropped onto it */
  :global(.sheep-face) {
    fill: var(--fan-ink);
  }

  :global(.sheep-eye) {
    fill: var(--fan-white);
  }

  :global(.sheep-leg) {
    stroke: var(--fan-ink);
    stroke-width: 7;
    stroke-linecap: round;
  }

  :global(.sheep.is-poked svg) {
    animation: sheepWobble 0.42s var(--spring-bounce);
  }

  @keyframes sheepWobble {
    0% {
      transform: rotate(0) scale(1);
    }
    35% {
      transform: rotate(-9deg) scale(1.08);
    }
    70% {
      transform: rotate(6deg) scale(1.02);
    }
    100% {
      transform: rotate(0) scale(1);
    }
  }

  .nudge-limit {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    color: var(--fan-ink-soft);
  }

  .nudge-limit[hidden] {
    display: none;
  }
  /* ── the sheep ──
     Every press of the 催更 button drops one. Verlet integration, circle
     collision, and a drag that feeds its own velocity back on release so a
     thrown sheep keeps going.
     ⚠️ ONE rAF for the whole population, and it stops itself once everything is
     asleep — a permanent loop over twenty sheep would be a permanent repaint of
     the page for a decoration. */
  /* ══════════════════════════════════════════════════════════════
     PAGE RAIL
     ══════════════════════════════════════════════════════════════ */
  .fan-rail {
    position: fixed;
    /* below the top bar, above the footer */
    top: 76px;
    right: 10px;
    bottom: 66px;
    z-index: 50;
    width: 4px;
    /* the pseudo-element's hit area is positioned against this box */
    isolation: isolate;
    border-radius: 999px;
    background: rgba(27, 37, 216, 0.14);
    /* ⚠️ A CONTROL now, not decoration: it is draggable, so it takes the
       pointer. `touch-action: none` or a phone drag scrolls the page instead. */
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    transition: background-color 0.2s var(--ease-out);
  }

  /* ⚠️ The hit area is widened with a pseudo-element, NOT with padding. Padding
     would widen the box `getBoundingClientRect()` reports, and the drag maps the
     pointer against that rect — measured, an 18px box against a 4px line moved the
     page 4px when dragged to the middle. The rect has to be the line. */
  .fan-rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -8px;
    right: -8px;
  }

  .fan-rail:hover,
  .fan-rail.is-dragging {
    background-color: rgba(27, 37, 216, 0.24);
  }

  .fan-rail.is-dragging {
    cursor: grabbing;
  }

  .fan-rail-fill {
    display: block;
    width: 100%;
    /* proportional on purpose — see the driver. `max()` keeps a grabbable
       minimum so the control does not become a 3px dot on a very long page. */
    height: max(28px, calc(var(--fan-read, 0) * 100%));
    border-radius: 999px;
    /* ⚠️ NO glow. The pink halo was removed on request — the rail is just the
       blue line now, and the track behind it keeps the faint blue tint so it still
       reads as a gauge rather than as a stray mark. */
    background: var(--fan-blue);
  }

  @media (max-width: 640px) {
    .fan-rail {
      right: 7px;
      width: 2px;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     SECTION HEADS
     ══════════════════════════════════════════════════════════════ */
  .fan-block {
    max-width: 1180px;
    margin: 0 auto;
    padding: 54px 24px;
    scroll-margin-top: 90px;
  }

  /* the deck's section heads are a small wide-tracked label riding a TAPE strip
     (a solid rule with a row of ticks), immediately above the big title. This is
     that strip: short, left-aligned, and the same pink as the headings. */
  .block-head {
    position: relative;
    max-width: 62ch;
    margin-bottom: 26px;
  }

  /* same ruler as `.orn-tape`, same two constraints: whole dashes, and the last
     one flush with the end of the rule (17 × 7px + 2px = exactly 119px). */
  .block-head::before {
    content: "";
    display: block;
    width: 121px;
    height: 12px;
    margin-bottom: 14px;
    border-top: 3px solid var(--fan-magenta);
    background-image: repeating-linear-gradient(
      90deg,
      var(--fan-magenta) 0 2px,
      transparent 2px 7px
    );
    background-size: 119px 8px;
    background-repeat: no-repeat;
    background-position: 0 3px;
    opacity: 0.7;
  }

  .block-title {
    margin: 8px 0 10px;
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 62px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--fan-magenta);
  }

  :global(html[lang="zh"]) .block-title {
    font-family: var(--font-zh-display);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .block-sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--fan-ink-soft);
  }

  .fan-empty {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fan-ink-soft);
  }

  /* ══════════════════════════════════════════════════════════════
     MODULE 01 · INTRODUCTION
     ══════════════════════════════════════════════════════════════ */
  /* the copy is the long side and the facts are the short one, so the reading
     column never stretches past a comfortable measure on a wide screen */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  .intro-facts {
    margin: 0;
    padding: 4px 0 0;
    border-top: 3px solid var(--fan-magenta);
  }

  .fact {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(27, 37, 216, 0.14);
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--fan-blue);
  }

  .fact dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fan-ink);
  }

  /* ══════════════════════════════════════════════════════════════
     MODULE 03 · COMMISSIONS
     ══════════════════════════════════════════════════════════════ */
  /* ⚠️ These two sections read as a centred block. A centred heading over
     left-aligned body copy reads as an accident rather than as a choice, so the
     copy inside gets a centred measure too.
     ⚠️ `.block-head` itself is `max-width: 62ch` PLUS a `::before` tick strip, and
     the head is a flex child of the block, so `margin-inline: auto` alone does not
     centre it — the block has to centre its children. */
  .fan-commission .block-head,
  #contact .block-head {
    max-width: 62ch;
    margin-inline: auto;
    text-align: center;
  }

  .fan-commission .block-head::before,
  #contact .block-head::before {
    margin-inline: auto;
  }

  .fan-commission .about-para,
  .fan-commission .commission-note,
  #contact .block-sub {
    margin-inline: auto;
    text-align: center;
  }

  .fan-commission .commission-card {
    max-width: 760px;
    margin-inline: auto;
  }

  .commission-card {
    max-width: 860px;
    padding: 30px 32px 26px;
    border-top: 5px solid var(--fan-magenta);
    border-radius: 4px 4px 12px 12px;
    background: var(--fan-white);
    box-shadow: 0 0 0 1.5px rgba(27, 37, 216, 0.12);
  }

  /* ⚠️ The status pill is the ONE place on this page where blue fills a shape.
     Pink fills every other surface, so the filled pill is what makes "closed"
     read before the sentence next to it is read at all. */
  .commission-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 7px 15px;
    border-radius: 999px;
    background: var(--fan-blue);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fan-white);
  }

  .commission-status svg {
    width: 14px;
    height: 14px;
  }

  .commission-status svg rect,
  .commission-status svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .fan-commission .about-para {
    margin-top: 16px;
  }

  /* ── the 催更 button ──
     ⚠️ It fills a surface with the magenta gradient, which nothing else on this
     page does. That is the point: it is the one thing in this section the visitor
     is meant to press, and a solid slab is what makes that legible from across
     the page. The reference deck does the same for its claim-all button. */
  .nudge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
  }

  /* ── the avatar above the button ──
     ⚠️ `image-rendering` is left alone and the art is 2x the box, so it stays
     crisp on a retina screen. The GIF's own transparent background is what keeps
     it sitting on the paper rather than in a white square. */
  .nudge-pfp {
    display: block;
    /* ⚠️ 120, not 96. The GIF's frame has headroom above the animal — that is
       where the jump goes — so the animal itself is only ~55% of the box. At 96px
       it read as a speck; at 120 the animal is ~66px and the hop still fits. */
    width: 120px;
    height: 120px;
    margin-bottom: -6px;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 860px) {
    .nudge-pfp {
      width: 96px;
      height: 96px;
    }
  }

  .nudge-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(360px, 78vw);
    padding: 20px 42px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    color: var(--fan-white);
    background: linear-gradient(
      118deg,
      var(--fan-magenta) 0%,
      var(--fan-pink) 62%,
      var(--fan-magenta) 100%
    );
    background-size: 220% 100%;
    box-shadow:
      0 14px 30px -12px rgba(245, 48, 138, 0.85),
      inset 0 -3px 0 rgba(18, 18, 58, 0.18);
    transition:
      transform 0.22s var(--spring-snappy),
      box-shadow 0.24s var(--ease-out),
      background-position 0.5s var(--ease-out);
  }

  .nudge-btn:hover,
  .nudge-btn:focus-visible {
    transform: translateY(-4px) scale(1.025);
    background-position: 100% 0;
    box-shadow:
      0 22px 44px -14px rgba(245, 48, 138, 0.95),
      inset 0 -3px 0 rgba(18, 18, 58, 0.18);
  }

  .nudge-btn:active {
    transform: translateY(-1px) scale(0.975);
  }

  .nudge-face {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: clamp(22px, 3.4vw, 34px);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 2px 0 rgba(18, 18, 58, 0.2);
  }

  :global(html[lang="zh"]) .nudge-face {
    font-family: var(--font-zh-display);
    letter-spacing: 0.14em;
  }

  /* the shockwave: one ring, restarted by re-adding the class */
  .nudge-ring {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    border: 3px solid var(--fan-pink);
    opacity: 0;
    pointer-events: none;
  }

  .nudge-btn.is-hit .nudge-ring {
    animation: nudgeRing 0.62s var(--ease-out);
  }

  @keyframes nudgeRing {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.34);
    }
  }

  /* the spark burst: eight sparks on a conic ray, each flung on its own angle */
  .nudge-burst {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .nudge-spark {
    position: absolute;
    left: 50%;
    top: 50%;
