      swirl: { prop: "--lens-swirl", step: 0.005, min: -2, max: 2, digits: 3 },
      density: { prop: "--lens-density", step: 0.05, min: 0.1, max: 3, digits: 2 },
      gapBoost: { prop: "--lens-gap-boost", step: 0.25, min: 1, max: 12, digits: 2 },
      photonBand: { prop: "--lens-photon-band", step: 0.005, min: 0.005, max: 0.6, digits: 3, unit: "vh" },
      photonSize: { prop: "--lens-photon-size", step: 0.05, min: 0.1, max: 2, digits: 2 },
    };

    type Target = {
