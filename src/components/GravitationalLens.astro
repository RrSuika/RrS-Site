      rRing: { prop: "--lens-r-ring", step: 0.005, min: 0.005, max: 2.5, digits: 3, unit: "vh" },
      diskInnerW: { prop: "--lens-disk-inner-w", step: 0.005, min: 0.01, max: 2.5, digits: 3, unit: "vh" },
      diskInnerH: { prop: "--lens-disk-inner-h", step: 0.005, min: 0.01, max: 2.5, digits: 3, unit: "vh" },
      diskOuterW: { prop: "--lens-disk-outer-w", step: 0.005, min: 0.02, max: 2.5, digits: 3, unit: "vh" },
      diskOuterH: { prop: "--lens-disk-outer-h", step: 0.005, min: 0.02, max: 2.5, digits: 3, unit: "vh" },
      diskTilt: { prop: "--lens-disk-tilt", step: 1, min: -90, max: 90, digits: 1 },
      diskDx: { prop: "--lens-disk-dx", step: 0.005, min: -1, max: 1, digits: 3, unit: "vh" },
      diskDy: { prop: "--lens-disk-dy", step: 0.005, min: -1, max: 1, digits: 3, unit: "vh" },
      diskFeather: { prop: "--lens-disk-feather", step: 0.002, min: 0, max: 0.5, digits: 3, unit: "vh" },
      speedOuter: { prop: "--lens-speed-outer", step: 0.002, min: 0, max: 2, digits: 3 },
      speedMid: { prop: "--lens-speed-mid", step: 0.005, min: 0, max: 3, digits: 3 },
      innerEase: { prop: "--lens-inner-ease", step: 0.05, min: 0.2, max: 12, digits: 2 },
      bulge: { prop: "--lens-bulge", step: 0.002, min: -0.3, max: 0.6, digits: 3, unit: "vh" },
