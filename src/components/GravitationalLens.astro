    const STEPS = [0.1, 0.25, 0.5, 1, 2, 4];
    const SAVE_KEY = "rrsuika-lens-tune-v7"; // v7 = nudged knobs only (see saveTune):
    // defaults are viewport-fitted, so v6's full-state snapshots froze one
    // screen's tuned numbers on every other screen
    const POS_KEY = "rrsuika-lens-tune-pos"; // panel position

    let tuneEl: HTMLElement | null = null;
    let tuneOn = false;
    let showRings = true;
    let targetIdx = 0;
    let stepIdx = 3;
    let clampHudDrag: (() => void) | null = null; // assigned in buildHud()


    // Effective value a knob renders with (2a viewport fit applied), so the
    // HUD, COPY and nudge all operate on what is actually drawn.
    const currentVal = (prop: string) => effectiveVal(prop, FB_BY_PROP[prop] ?? 0);

    // Translation key for a target (its explicit id, else its knob / first axis).
    const targetKey = (t: Target) => t.id ?? (t.dual ? t.dual[0] : (t.knob ?? ""));

    function renderHud() {
      if (!tuneEl) return;
      const body = tuneEl.querySelector(".lt-body") as HTMLElement | null;
      const foot = tuneEl.querySelector(".lt-foot") as HTMLElement | null;
      if (!body) return;

      let html = "";
      let lastGroup = "";
      TARGETS.forEach((t, i) => {
        if (t.group !== lastGroup) {
          lastGroup = t.group;
          html += `<div class="lt-sep">${L10N.groups[t.group.toLowerCase()] ?? t.group}</div>`;
        }
        const sel = i === targetIdx ? " is-sel" : "";
        const key = i < 9 ? String(i + 1) : i === 9 ? "0" : "TAB";
        let val = "";
        let px = "";
        if (t.dual) {
          const vx = currentVal(KNOB[t.dual[0]].prop);
          const vy = currentVal(KNOB[t.dual[1]].prop);
          val = `${vx.toFixed(3)} / ${vy.toFixed(3)}`;
          px =
              t.dual[0] === "cx"
                ? `${Math.round(vx * W)} / ${Math.round(cfg.cyPx + vy * H)}`
                : t.dual[0] === "diskDx"
                  ? `${Math.round(vx * H)} / ${Math.round(vy * H)}`
                  : t.dual[0] === "diskInnerW" || t.dual[0] === "diskOuterW"
                    ? `${Math.round(vx * H)} × ${Math.round(vy * H)}`
                  : t.dual[0] === "photonBand"
                    ? `${Math.round(vx * H)} / ×${vy.toFixed(2)}`
                    : "";
        } else if (t.knob) {
          const k = KNOB[t.knob];
          const v = currentVal(k.prop);
          val = v.toFixed(k.digits);
          if (k.unit === "vh") {
            const rad = v * H;
            px = rad > farCorner ? `${Math.round(rad)} · ${L10N.off}` : `${Math.round(rad)}`;
          } else if (k.unit === "px") {
            px = `${Math.round(v)}`;
          }
        }
        html += `<div class="lt-row${sel}" data-i="${i}"><span class="lt-key">${key}</span><span class="lt-name">${L10N.labels[targetKey(t)] ?? t.label}</span><span class="lt-val">${val}</span><span class="lt-px">${px}</span></div>`;
      });
      body.innerHTML = html;

        const descEl = tuneEl.querySelector(".lt-desc") as HTMLElement | null;
        if (descEl) {
          const target = TARGETS[targetIdx];
          const keyLabel = targetIdx < 9 ? String(targetIdx + 1) : targetIdx === 9 ? "0" : "TAB";
          const keys = target.dual ? L10N.keysDual : L10N.keysSingle;
          descEl.innerHTML = `<b>[${L10N.keyPrefix} ${keyLabel}]</b> ${L10N.labels[targetKey(target)] ?? target.label} <span class="lt-desc-keys">${keys}</span><br>${L10N.desc[targetKey(target)] ?? target.desc}`; /* localized */
        }

      if (foot) {
        foot.innerHTML = running
          ? `${TARGETS[targetIdx].dual ? L10N.keysDual : L10N.keysSingle} · SHIFT ×10 · ALT ×0.1 · [ ] step <b>×${STEPS[stepIdx]}</b><br>${L10N.footer}`
          : `<span class="lt-warn">${L10N.inactive}</span><br>${L10N.escClose}`;
      }
    }

    function selectTarget(i: number) {
      const n = TARGETS.length;
      targetIdx = ((i % n) + n) % n;
      renderHud();
    }

    function nudge(k: Knob, delta: number) {
      const cur = currentVal(k.prop);
      const v = clamp(cur + delta * k.step, k.min, k.max);
      canvas.style.setProperty(k.prop, String(round4(v)));
      refresh();
      saveTune();
      renderHud();
    }

    function cssSnippet() {
      const seen = new Set<string>();
      const val = (key: string) => round4(currentVal(KNOB[key].prop));
      const px = (key: string) => Math.round(val(key) * H);
      const centreX = Math.round(val("cx") * W);
      const centreY = Math.round(currentVal("--lens-cy-px") + val("cyVh") * H);
      const fitted = Object.keys(SCALED).some((prop) =>
        isAutoFitted(prop, FB_BY_PROP[prop] ?? 0),
      );
      const lines = [
        `/* gravitational lens — tuned on ${W}×${H} viewport (dpr ${DPR}) */`,
        `/* px: centre ${centreX},${centreY} · ring ${px("rRing")} · disk ${px("diskInnerW")}×${px("diskInnerH")}–${px("diskOuterW")}×${px("diskOuterH")} · inner ${px("rInner")} · mid ${px("rMid")} · outer ${px("rOuter")} */`,
      ];
      if (fitted) {
        // Viewport-fitted defaults were inlined — a pasted block is a STATIC
        // snapshot of this viewport, so re-baselining must touch the code
        // tables too, not just the CSS.
        lines.push(
          "/* ⚠ viewport-fitted defaults inlined — a static freeze for this size.",
          "   To re-baseline, update §10 AND FALLBACK / SCALED in GravitationalLens.astro. */",
        );
      }
      lines.push("#lens-canvas {");
      for (const key of Object.keys(KNOB)) {
        const k = KNOB[key];
        if (seen.has(k.prop)) continue;
        seen.add(k.prop);
        lines.push(`  ${k.prop}: ${round4(currentVal(k.prop))};`);
      }
      lines.push("}");
      return lines.join("\n");
    }

    let footTimer = 0;
    function flashFoot(msg: string) {
      if (!tuneEl) return;
      const foot = tuneEl.querySelector(".lt-foot") as HTMLElement | null;
      if (!foot) return;
      const prev = foot.innerHTML;
      foot.innerHTML = `<span class="lt-ok">${msg}</span>`;
      window.clearTimeout(footTimer);
      footTimer = window.setTimeout(() => {
        foot.innerHTML = prev;
      }, 2600);
    }

    function copyCss() {
      const text = cssSnippet();
      console.log(`[lens-tune] paste into src/styles/global.css §10:\n${text}`);
      const done = () => flashFoot(L10N.copied);
      const failed = () => flashFoot(L10N.copyBlocked);
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(done, failed);
        return;
      }
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch (_) {
        ok = false;
      }
      ta.remove();
      if (ok) done();
      else failed();
    }

    function saveTune() {
      // Persist only knobs the tuner wrote inline. Defaults are
      // viewport-fitted, so a full-state snapshot would freeze this
      // screen's numbers on every other screen (the v6 bug this fixes).
      const data: Record<string, number> = {};
      for (const key of Object.keys(KNOB)) {
        const prop = KNOB[key].prop;
        const own = canvas.style.getPropertyValue(prop);
        if (own !== "") data[prop] = parseFloat(own);
      }
      try {
        if (Object.keys(data).length === 0) localStorage.removeItem(SAVE_KEY);
        else localStorage.setItem(SAVE_KEY, JSON.stringify(data));
      } catch (_) {
        /* storage unavailable — tuning still works for this session */
      }
    }

    function applySaved() {
      let raw: string | null = null;
      try {
        raw = localStorage.getItem(SAVE_KEY);
      } catch (_) {
        return;
      }
      if (!raw) return;
      try {
        const data = JSON.parse(raw) as Record<string, unknown>;
        for (const prop in data) {
          const v = data[prop];
          if (prop.indexOf("--lens-") === 0 && typeof v === "number" && Number.isFinite(v)) {
            canvas.style.setProperty(prop, String(v));
          }
        }
      } catch (_) {
        /* corrupt entry — ignore and fall back to the CSS defaults */
      }
    }

    function resetTune() {
      try {
        localStorage.removeItem(SAVE_KEY);
      } catch (_) {
        /* ignore */
      }
      for (const key of Object.keys(KNOB)) canvas.style.removeProperty(KNOB[key].prop);
      refresh();
      renderHud();
      flashFoot(L10N.reset);
    }

    function buildHud() {
      const el = document.createElement("div");
      el.id = "lens-tune";
      el.setAttribute("role", "dialog");
      el.setAttribute("aria-label", "Gravitational lens tuner");
      el.innerHTML = `
        <style>
          #lens-tune {
            position: fixed; left: 18px; bottom: 18px; z-index: 10000;
            width: 332px; box-sizing: border-box;
            background: rgba(14, 20, 32, 0.5);
            border: 1px solid rgba(150, 205, 255, 0.28);
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.14);
            color: #dcecff;
            font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            user-select: none;
            will-change: transform;
          }
          #lens-tune[hidden] { display: none !important; }
          #lens-tune .lt-head {
            display: flex; align-items: center; gap: 8px;
            padding: 9px 12px; border-bottom: 1px solid rgba(120,190,255,0.2);
            letter-spacing: 0.08em;
            cursor: grab; touch-action: none;
          }
          #lens-tune.is-drag .lt-head { cursor: grabbing; }
          #lens-tune .lt-head button { cursor: pointer; }
          #lens-tune .lt-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: #4dd0e1; box-shadow: 0 0 8px #4dd0e1;
          }
          #lens-tune .lt-title { flex: 1; color: #eaf6ff; font-weight: 700; }
          #lens-tune .lt-copy { background: rgba(120,190,255,0.16); border: 1px solid rgba(120,190,255,0.45); border-radius: 5px; color: #d8ecff; font: inherit; font-weight: 700; letter-spacing: 0.08em; padding: 3px 9px; cursor: pointer; }
          #lens-tune .lt-copy:hover { background: rgba(120,190,255,0.3); border-color: #4dd0e1; color: #fff; }
          #lens-tune .lt-x {
            background: none; border: 0; color: #8fb6d8;
            font: inherit; font-size: 15px; cursor: pointer; padding: 0 2px;
          }
          #lens-tune .lt-x:hover { color: #fff; }
          #lens-tune .lt-body {
            padding: 4px 0 6px; max-height: 44vh; overflow: auto;
            scrollbar-width: thin; scrollbar-color: rgba(120,190,255,0.4) transparent;
          }
          #lens-tune .lt-body::-webkit-scrollbar { width: 6px; height: 6px; }
          #lens-tune .lt-body::-webkit-scrollbar-track { background: transparent; }
          #lens-tune .lt-body::-webkit-scrollbar-thumb {
            background: rgba(120,190,255,0.35); border-radius: 3px;
          }
          #lens-tune .lt-body::-webkit-scrollbar-thumb:hover { background: rgba(120,190,255,0.6); }
          #lens-tune .lt-desc {
            padding: 8px 12px; border-top: 1px solid rgba(120,190,255,0.2);
            color: #a9c6e2; font-size: 10.5px; line-height: 1.55;
          }
          #lens-tune .lt-desc b { color: #ffd9a0; }
          #lens-tune .lt-desc .lt-desc-keys { color: #7dffa0; }
          #lens-tune .lt-sep {
            padding: 7px 12px 2px; color: #5d7794;
            font-size: 9.5px; letter-spacing: 0.16em;
          }
          #lens-tune .lt-row {
            display: flex; align-items: center; gap: 8px;
            padding: 4px 12px; cursor: pointer;
          }
          #lens-tune .lt-row:hover { background: rgba(120,190,255,0.08); }
          #lens-tune .lt-row.is-sel {
            background: rgba(120,190,255,0.16);
            box-shadow: inset 2px 0 0 #4dd0e1;
          }
          #lens-tune .lt-key { width: 26px; color: #6f8fb0; }
          #lens-tune .lt-name { flex: 1; color: #b9d4ee; }
          #lens-tune .lt-val {
            color: #ffd9a0; font-variant-numeric: tabular-nums;
          }
          #lens-tune .lt-px {
            width: 78px; text-align: right; color: #7f96ad;
            font-variant-numeric: tabular-nums;
          }
          #lens-tune .lt-foot {
            padding: 8px 12px; border-top: 1px solid rgba(120,190,255,0.2);
            color: #8fb6d8; font-size: 10px; line-height: 1.7;
          }
          #lens-tune .lt-foot b { color: #ffd9a0; }
          #lens-tune .lt-ok { color: #7dffa0; }
          #lens-tune .lt-warn { color: #ffb060; }
        </style>
        <div class="lt-head">
          <span class="lt-dot"></span>
          <span class="lt-title">${L10N.title}</span>
          <button class="lt-copy" type="button" title="${L10N.copy}">${L10N.copy}</button>
            <button class="lt-x" type="button" aria-label="Close tuner">×</button>
        </div>
        <div class="lt-body"></div>
        <div class="lt-desc"></div>
        <div class="lt-foot"></div>
      `;
      document.body.appendChild(el);

      const close = el.querySelector(".lt-x");
      close?.addEventListener("click", () => toggleTune(false));
      const copyBtn = el.querySelector(".lt-copy");
      copyBtn?.addEventListener("click", () => copyCss());
      const body = el.querySelector(".lt-body");
      body?.addEventListener("click", (event) => {
        const row = (event.target as HTMLElement).closest(".lt-row") as HTMLElement | null;
        if (row?.dataset.i) selectTarget(Number(row.dataset.i));
      });

      /* ── Drag the panel by its header (position persists) ── */
      const head = el.querySelector(".lt-head") as HTMLElement | null;
      let dragX = 0;
      let dragY = 0;
      const applyDrag = () => {
        el.style.transform = `translate(${dragX}px, ${dragY}px)`;
      };
      // Keep the whole panel inside the viewport. It is anchored bottom-left
      // (left: 18px / bottom: 18px), so dragX/dragY are offsets from there.
      const clampDrag = () => {
        const w = el.offsetWidth || 332;
        const h = el.offsetHeight || 320;
        const minX = -18;
        const maxX = Math.max(minX, window.innerWidth - 18 - w);
        const maxY = 18;
        const minY = Math.min(maxY, 18 + h - window.innerHeight);
        dragX = Math.max(minX, Math.min(maxX, dragX));
        dragY = Math.max(minY, Math.min(maxY, dragY));
        applyDrag();
      };
      clampHudDrag = clampDrag;
      try {
        const saved = JSON.parse(localStorage.getItem(POS_KEY) || "null") as {
          x?: number;
          y?: number;
        } | null;
        if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) {
          dragX = saved.x as number;
          dragY = saved.y as number;
          applyDrag();
        }
      } catch (_) {
        /* ignore bad stored position */
      }
      let dragging = false;
      let downX = 0;
      let downY = 0;
      let originX = 0;
      let originY = 0;
      head?.addEventListener("pointerdown", (event) => {
        if ((event.target as HTMLElement).closest("button")) return;
        dragging = true;
        downX = event.clientX;
        downY = event.clientY;
        originX = dragX;
        originY = dragY;
        el.classList.add("is-drag");
        event.preventDefault();
      });
      window.addEventListener("pointermove", (event) => {
        if (!dragging) return;
        dragX = originX + (event.clientX - downX);
        dragY = originY + (event.clientY - downY);
        clampDrag();
        /* both axes clamped together inside clampDrag() */
        applyDrag();
      });
      window.addEventListener("pointerup", () => {
        if (!dragging) return;
        dragging = false;
        el.classList.remove("is-drag");
        try {
          localStorage.setItem(POS_KEY, JSON.stringify({ x: dragX, y: dragY }));
        } catch (_) {
          /* ignore */
        }
      });
      window.addEventListener("pointercancel", () => {
        if (!dragging) return;
        dragging = false;
        el.classList.remove("is-drag");
      });
      return el;
    }

    function toggleTune(force?: boolean) {
      const want = force === undefined ? !tuneOn : force;
      if (want === tuneOn) return;
      tuneOn = want;
      if (tuneOn) {
        if (!tuneEl) tuneEl = buildHud();
        tuneEl.hidden = false;
        renderHud();
        clampHudDrag?.();
      } else if (tuneEl) {
        tuneEl.hidden = true;
      }
    }

    function onKey(event: KeyboardEvent) {
      const tag = (event.target as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;

      if (
        event.key === "`" ||
        (event.ctrlKey && event.altKey && (event.key === "g" || event.key === "G"))
      ) {
        event.preventDefault();
        toggleTune();
        return;
      }
      if (!tuneOn) return;

      if (event.key === "Escape") {
        event.preventDefault();
        toggleTune(false);
        return;
      }
      if (event.key === "Tab") {
        event.preventDefault();
        selectTarget(targetIdx + (event.shiftKey ? -1 : 1));
        return;
      }
      if (event.key === "[") {
        event.preventDefault();
        stepIdx = Math.max(0, stepIdx - 1);
        renderHud();
        return;
      }
      if (event.key === "]") {
        event.preventDefault();
        stepIdx = Math.min(STEPS.length - 1, stepIdx + 1);
        renderHud();
        return;
      }
      if (event.key === "h" || event.key === "H") {
        event.preventDefault();
        showRings = !showRings;
        renderHud();
        return;
      }
      if (event.key === "c" || event.key === "C") {
        event.preventDefault();
        copyCss();
        return;
      }
      if (event.key === "r" || event.key === "R") {
        event.preventDefault();
        resetTune();
        return;
      }

      const num = "1234567890".indexOf(event.key);
      if (num >= 0 && num < TARGETS.length) {
        event.preventDefault();
        selectTarget(num);
        return;
      }

      let dx = 0;
      let dy = 0;
      if (event.key === "ArrowLeft") dx = -1;
      else if (event.key === "ArrowRight") dx = 1;
      else if (event.key === "ArrowUp") dy = -1;
      else if (event.key === "ArrowDown") dy = 1;
      else return;

      event.preventDefault();
      const mul = STEPS[stepIdx] * (event.shiftKey ? 10 : event.altKey ? 0.1 : 1); /* SHIFT coarse / ALT fine */
      const target = TARGETS[targetIdx];
      if (target.dual) {
        if (dx) nudge(KNOB[target.dual[0]], dx * mul);
        if (dy) nudge(KNOB[target.dual[1]], dy * mul);
      } else if (target.knob) {
        nudge(KNOB[target.knob], (dx !== 0 ? dx : -dy) * mul);
      }
    }

    /* ══════════════════════════════════════════════════════════════
       10. WIRE UP
    ═══════════════════════════════════════════════════════════════ */
    applySaved();
    readCfg();
    sync();

    // Opened by the navbar tool icon (plus the ` and ?lens=tune shortcuts).
    (window as typeof window & { __lensTune?: () => void }).__lensTune = () =>
      toggleTune();

    window.addEventListener("resize", () => {
      if (running) {
        measure();
        reclamp();
      }
      if (tuneOn) renderHud();
      clampHudDrag?.();

    });
    DESKTOP.addEventListener("change", sync);
    REDUCED.addEventListener("change", sync);
    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window.addEventListener("keydown", onKey);

    // Deep link into the tuner: /?lens=tune or /#lens-tune
    const params = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace(/^#/, "");
    if (params.get("lens") === "tune" || hash === "lens-tune" || hash === "lens") {
      toggleTune(true);
    }
  })();
</script>
