---
import { getLanguageFromPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

/**
 * GRAVITATIONAL LENS — homepage starfield (dark mode + desktop only).
 *
 * Replaces the celestial #starfield-canvas on the three homepages while the
 * black-hole video is active. Stars form ONE continuous inward stream: each
 * star is born near the outer edge of the field and falls monotonically
 * toward the black hole, never stopping until it dies at the ring.
 *
 *   OUTER   rMid <= r < rOuter very slow radial drift
 *   MIDDLE  rInner <= r < rMid  faster drift (smoothstep ramp across rMid)
 *   INNER   rRing  <= r < rInner slows down the closer it gets to the ring
 *   BLACK   r < rRing            the star died at the ring and respawned;
 *                                nothing is drawn inside — the video's black
 *                                disc shows through as pure black
 *   DISK    diskInner ≤ rDraw < diskOuter  not drawn — the video's accretion
 *                                disk sits above the starfield and occludes
 *                                these stars; they keep falling invisibly and
 *                                reappear inside diskInner, briefly, before
 *                                fading out at the black-hole ring
 *   BAND    rRing < rDraw <= rRing + photonBand  circular band of tiny, bright
 *                                stars (the lensed background piling up just
 *                                outside the ring); these stay circular instead
 *                                of taking the tangential lens stretch
 *
 * Stars also spiral clockwise as they fall inward (--lens-swirl, scaled by
 * rRing/r so the rotation tightens towards the black hole). A screen-space
 * gravitational-lens approximation pushes stars outward and
 * stretches them tangentially as they approach the ring (except inside the
 * photon band, where they stay circular), then fades them out so they vanish
 * right at the black-hole outer ring.
 *
 * Because the inward flux is constant, steady-state density is ∝ 1/speed:
 * respawns sample a numeric CDF with that weight, so the field is at its
 * steady state from the first frame and there are no boundary seams.
 *
 * MANUAL TUNING
 *   All knobs are CSS custom properties on #lens-canvas (global.css §10).
 *   The seven video-anchored geometry knobs — cyVh, the three boundary
 *   radii, the disk-inner axes — are VIEWPORT-ADAPTIVE by default: while
 *   the §10 CSS sits at the shipped baseline, the component derives them
 *   from a two-point screen fit (section 2a) so the hole, the ring and the
 *   disk line up with the video on any screen, not only the one the
 *   profile was tuned on.
 *   Press ` (backtick) — or open a homepage with ?lens=tune — to show the
 *   keyboard tuner: 1–0 / TAB pick a target, arrows move it, C copies the
 *   tuned values back as CSS for global.css.
 */

const language = getLanguageFromPath(Astro.url.pathname);
const lensTune = getTranslations(language).lensTune;

---

<canvas id="lens-canvas" aria-hidden="true"></canvas>
<div id="lens-tune-l10n" data-json={JSON.stringify(lensTune)} hidden></div>

<script is:inline>
  // Synchronous gate: hide the celestial starfield before any module script
  // runs so it never paints underneath the lens for a frame.
  (() => {
    if (
      document.getElementById("lens-canvas") &&
      window.matchMedia("(min-width: 769px)").matches &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
      document.documentElement.getAttribute("data-theme") !== "light"
    ) {
      document.documentElement.setAttribute("data-lens", "on");
    }
  })();
</script>

<script>
  (() => {
    const canvasNode = document.getElementById(
      "lens-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvasNode) return;
    // Non-null aliases: TS narrows consts only up to the first function
    // declaration (they hoist), so everything below uses these plain types.
    const canvas = canvasNode;
    const ctxRaw = canvas.getContext("2d", { alpha: true });
    if (!ctxRaw) return;
    const ctx = ctxRaw;

    const root = document.documentElement;
    const DESKTOP = window.matchMedia("(min-width: 769px)");
    const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)");
    const TAU = Math.PI * 2;

    /* Tuner copy, localised per page language (emitted by the frontmatter
       into #lens-tune-l10n; falls back to English if that element is gone). */
    const L10N = (() => {
      try {
        const raw = document.getElementById("lens-tune-l10n")?.dataset.json;
        if (raw) return JSON.parse(raw) as Record<string, any>;
      } catch (_) {
        /* fall through */
      }
      return {
        title: "GRAVITATIONAL LENS // TUNE",
        groups: {},
        labels: {},
        desc: {},
        keysDual: "←→ first axis · ↑↓ second axis",
        keysSingle: "←→ / ↑↓ value",
        footer: "",
        inactive: "LENS INACTIVE",
        copy: "COPY",
        copied: "COPIED",
        copyBlocked: "COPY BLOCKED",
        reset: "RESET",
        keyPrefix: "KEY",
        escClose: "ESC close",
        debug: {
          outerEdge: "OUTER EDGE",
          outerMid: "OUTER / MIDDLE",
          midInner: "MIDDLE / INNER",
          ring: "BLACK-HOLE RING",
          diskInner: "DISK INNER",
          diskOuter: "DISK OUTER",
          photonBand: "PHOTON BAND",
        },
        off: "off",
      } as Record<string, any>;
    })();

    /* ══════════════════════════════════════════════════════════════
       1. SPECTRAL PALETTE — same families as the site starfield
    ═══════════════════════════════════════════════════════════════ */
    const COLORS = [
      "rgb(120, 160, 255)",
      "rgb(170, 200, 255)",
      "rgb(210, 220, 250)",
      "rgb(255, 255, 255)",
      "rgb(255, 230, 185)",
      "rgb(255, 210, 130)",
      "rgb(255, 160, 85)",
      "rgb(255, 110, 70)",
      "rgb(230, 70, 60)",
    ];
    const WEIGHTS = [12, 12, 8, 3, 8, 12, 14, 10, 5];
    const PALETTE: string[] = [];
    COLORS.forEach((color, i) => {
      const w = WEIGHTS[i] ?? 1;
      for (let k = 0; k < w; k++) PALETTE.push(color);
    });
    const RGB = new Map<string, [number, number, number]>();
    COLORS.forEach((color) => {
      const m = color.match(/\d+/g) ?? ["255", "255", "255"];
      RGB.set(color, [Number(m[0]), Number(m[1]), Number(m[2])]);
    });

    /* ══════════════════════════════════════════════════════════════
       2. CONFIG — every knob is a unitless CSS custom property.
       Seven video-anchored knobs are viewport-adaptive at the shipped
       baseline (see 2a); the rest are read verbatim.
    ═══════════════════════════════════════════════════════════════ */
    const FALLBACK = {
      cx: 0.7658, // lens centre X, fraction of viewport width
      cyPx: 122, // lens centre Y = this px offset…
      cyVh: 0.4358, // …plus this fraction of viewport height (mirrors --blackhole-y)
      rOuter: 1.7, // outer edge of the field, × viewport height
      rMid: 0.69, // outer / middle boundary
      rInner: 0.4, // middle / inner boundary
      rRing: 0.25, // black-hole outer ring — inside = pure black
      diskInnerW: 0.285, // inner ellipse half-width, × viewport height
      diskInnerH: 0.276, // inner ellipse half-height (independent of the outer)
      diskOuterW: 0.48, // outer ellipse half-width
      diskOuterH: 0.39, // outer ellipse half-height
      diskTilt: -15, // ellipse rotation in degrees (negative = right side up)
      diskDx: 0, // disk centre offset X, × viewport height
      diskDy: 0, // disk centre offset Y, × viewport height (negative = up)
      diskFeather: 0.03, // edge fade band, × viewport height
      speedOuter: 0.02, // viewport heights per second
      speedMid: 0.03,
      innerEase: 6, // how sharply the inner segment slows near the ring
      bulge: 0.01, // lensing push-out at the ring, × viewport height
      stretch: 3.4, // tangential stretch at the ring (1 = none)
      swirl: 0.08, // clockwise spiral drift at the ring, rad / s
      density: 1.5, // star-count multiplier
      gapBoost: 8, // brightness boost for the circular ring band
      photonBand: 0.025, // width of that band, × viewport height (keep it inside
      // the disk's inner ellipse so the band stays a circle)
      photonSize: 0.45, // star-size multiplier inside that band
    };
    type Cfg = typeof FALLBACK;
    let cfg: Cfg = { ...FALLBACK };

    const readNum = (cs: CSSStyleDeclaration, name: string, fb: number) => {
      const v = parseFloat(cs.getPropertyValue(name));
      return Number.isFinite(v) ? v : fb;
    };

    /* ── 2a. VIEWPORT-ADAPTIVE DEFAULTS ─────────────────────────────────
       The §10 values are ONE hand-tuned profile ("profile A", tuned on a
       2K desktop window, 1661×802). The video box is 125% + object-fit
       cover, so on any window with aspect ≥ 16:9 (width-bound — the normal
       desktop case) every video-anchored feature scales with viewport
       WIDTH. A second hand-tuned profile ("profile B", an FHD desktop
       window, 1234×562) relates to A by px = m·W + b per feature, so each
       SCALED knob below is derived from that two-point fit at the current
       viewport instead of the static baseline: the hole, the ring and the
       disk stay glued to the video on every screen, not only the one the
       profile was tuned on. cx / cyPx are identical in both profiles (real
       anchors); the remaining knobs are not video-anchored and stay
       static. Height-bound windows (aspect < 16:9) keep the raw baseline —
       there is no calibration data for them.

       Precedence: an inline tuner value always wins verbatim (provenance
       decides, not equality — nudging a knob back to its baseline number
       still counts as an explicit override); a hand-edited §10 block that
       differs from FALLBACK also wins verbatim (a deliberate freeze); only
       CSS sitting exactly at the shipped baseline gets viewport-fitted.
       Re-baselining the look = replace the §10 block AND the matching
       FALLBACK / SCALED values here together. */
    const round4 = (v: number) => Math.round(v * 1e4) / 1e4;
    const BOX_CY = 0.378; // vh coefficient of --blackhole-y (the video box centre line)
    const CAL_A = { W: 1661, H: 802 }; // viewport profile A was tuned on
    const CAL_B = { W: 1234, H: 562 }; // viewport profile B was tuned on
    // a = shipped baseline (= the matching FALLBACK entry, keep in sync),
    // b = measured FHD profile value
    const SCALED: Record<string, { a: number; b: number }> = {
      "--lens-cy-vh": { a: FALLBACK.cyVh, b: 0.4398 },
      "--lens-r-outer": { a: FALLBACK.rOuter, b: 1.81 },
      "--lens-r-mid": { a: FALLBACK.rMid, b: 0.75 },
      "--lens-r-inner": { a: FALLBACK.rInner, b: 0.44 },
      "--lens-r-ring": { a: FALLBACK.rRing, b: 0.265 },
      "--lens-disk-inner-w": { a: FALLBACK.diskInnerW, b: 0.3 },
      "--lens-disk-inner-h": { a: FALLBACK.diskInnerH, b: 0.296 },
    };
    // css property name → shipped baseline value, for every knob
    const FB_BY_PROP: Record<string, number> = {};
    for (const key of Object.keys(FALLBACK)) {
      const css = key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
      FB_BY_PROP[`--lens-${css}`] = FALLBACK[key as keyof Cfg];
    }

    // Has the tuner written this property inline? Inline always wins, even
    // at a value equal to the baseline (provenance over equality).
    const isInline = (prop: string) => canvas.style.getPropertyValue(prop) !== "";

    // Fitted unitless value (× viewport height) for a SCALED knob at the
    // current viewport: a px↔W two-point fit through the two profiles.
    // Returns null when there is no valid width-bound viewport yet.
    function fittedVal(prop: string, s: { a: number; b: number }): number | null {
      if (W <= 0 || H <= 0 || W / H < 16 / 9) return null;
      if (prop === "--lens-cy-vh") {
        // Centre Y = cyPx + cyVh·H with cyPx fixed (122 in both profiles):
        // cyVh encodes "video-box centre line (BOX_CY·H) plus an extra
        // screen offset δ that tracks the video width". Fit δ, not cyVh,
        // so the H part doesn't leak into the W fit.
        const dA = (s.a - BOX_CY) * CAL_A.H;
        const dB = (s.b - BOX_CY) * CAL_B.H;
        const m = (dA - dB) / (CAL_A.W - CAL_B.W);
        return round4(BOX_CY + (m * W + dB - m * CAL_B.W) / H);
      }
      const pA = s.a * CAL_A.H;
      const pB = s.b * CAL_B.H;
      const m = (pA - pB) / (CAL_A.W - CAL_B.W);
      return round4((m * W + pB - m * CAL_B.W) / H);
    }

    // The value a knob renders with at the current viewport — also what
    // the tuner HUD, COPY and nudge base themselves on. cs is an optional
    // computed-style snapshot (readCfg reuses one across all knobs).
    function effectiveVal(
      prop: string,
      fb: number,
      cs?: CSSStyleDeclaration,
    ): number {
      const raw = parseFloat((cs ?? getComputedStyle(canvas)).getPropertyValue(prop));
      const base = Number.isFinite(raw) ? raw : fb;
      if (isInline(prop)) return base;
      const s = SCALED[prop];
      if (!s || Math.abs(base - fb) > 1e-9) return base;
      return fittedVal(prop, s) ?? base;
    }

    // True when a SCALED knob currently renders the viewport fit rather
    // than a verbatim value (the COPY footer warns about such snapshots).
    function isAutoFitted(prop: string, fb: number): boolean {
      if (isInline(prop) || !SCALED[prop]) return false;
      const raw = parseFloat(getComputedStyle(canvas).getPropertyValue(prop));
      const base = Number.isFinite(raw) ? raw : fb;
      return Math.abs(base - fb) <= 1e-9 && fittedVal(prop, SCALED[prop]) !== null;
    }

    function readCfg() {
      const cs = getComputedStyle(canvas);
      const f = FALLBACK;
      cfg = {
        cx: readNum(cs, "--lens-cx", f.cx),
        cyPx: readNum(cs, "--lens-cy-px", f.cyPx),
        // scaled knobs: viewport fit while at the shipped baseline,
        // verbatim the moment an override (tuner or hand-edited CSS) exists
        cyVh: effectiveVal("--lens-cy-vh", f.cyVh, cs),
        rOuter: effectiveVal("--lens-r-outer", f.rOuter, cs),
        rMid: effectiveVal("--lens-r-mid", f.rMid, cs),
        rInner: effectiveVal("--lens-r-inner", f.rInner, cs),
        rRing: effectiveVal("--lens-r-ring", f.rRing, cs),
        diskInnerW: effectiveVal("--lens-disk-inner-w", f.diskInnerW, cs),
        diskInnerH: effectiveVal("--lens-disk-inner-h", f.diskInnerH, cs),
        diskOuterW: readNum(cs, "--lens-disk-outer-w", f.diskOuterW),
        diskOuterH: readNum(cs, "--lens-disk-outer-h", f.diskOuterH),
        diskTilt: readNum(cs, "--lens-disk-tilt", f.diskTilt),
        diskDx: readNum(cs, "--lens-disk-dx", f.diskDx),
        diskDy: readNum(cs, "--lens-disk-dy", f.diskDy),
        diskFeather: readNum(cs, "--lens-disk-feather", f.diskFeather),
        speedOuter: readNum(cs, "--lens-speed-outer", f.speedOuter),
        speedMid: readNum(cs, "--lens-speed-mid", f.speedMid),
        innerEase: readNum(cs, "--lens-inner-ease", f.innerEase),
        bulge: readNum(cs, "--lens-bulge", f.bulge),
        stretch: readNum(cs, "--lens-stretch", f.stretch),
        swirl: readNum(cs, "--lens-swirl", f.swirl),
        density: readNum(cs, "--lens-density", f.density),
        gapBoost: readNum(cs, "--lens-gap-boost", f.gapBoost),
        photonBand: readNum(cs, "--lens-photon-band", f.photonBand),
        photonSize: readNum(cs, "--lens-photon-size", f.photonSize),
      };
    }

    /* ══════════════════════════════════════════════════════════════
       3. GEOMETRY
    ═══════════════════════════════════════════════════════════════ */
    let W = 0;
    let H = 0;
    let DPR = 1;
    let cx = 0;
    let cy = 0;
    let rRing = 0;
    let rInner = 0;
    let rMid = 0;
    let rOuter = 0;
    let diskInnerW = 0;
    let diskInnerH = 0;
    let diskOuterW = 0;
    let diskOuterH = 0;
    let diskCos = 1;
    let diskSin = 0;
    let diskDx = 0; // disk centre offset from the lens centre, px
    let diskDy = 0;
    let diskFeather = 10;
    let photonOuter = 0; // rRing + photon-band width, px
    let farCorner = 0;

    // Boundary radii + fade bands + speed-ramp widths, filled by geometry().
    // Stars are one continuous stream (see the header comment): these are the
    // speed-segment boundaries along the way, not per-layer population loops.
    let fRing = 0; // fade-out band before the ring, px (alpha 1 → 0 at rRing)
    let fFar = 0; // fade-in band under the outer rim, px
    let rampW = 0; // smoothstep ramp width across the rMid speed change, px

    const clamp = (v: number, lo: number, hi: number) =>
      v < lo ? lo : v > hi ? hi : v;

    function geometry() {
      cx = cfg.cx * W;
      cy = cfg.cyPx + cfg.cyVh * H;
      const s = H;
      rRing = Math.max(2, cfg.rRing * s);
      rInner = Math.max(rRing + 4, cfg.rInner * s);
      rMid = Math.max(rInner + 4, cfg.rMid * s);
      rOuter = Math.max(rMid + 4, cfg.rOuter * s);
      // Accretion-disk annulus: a rotated ellipse. Each edge has its own
      // half-width and half-height, so the two rings are independent.
      diskInnerW = Math.max(rRing + 2, cfg.diskInnerW * s);
      diskInnerH = Math.max(2, cfg.diskInnerH * s);
      diskOuterW = Math.max(diskInnerW + 2, cfg.diskOuterW * s);
      diskOuterH = Math.max(diskInnerH + 2, cfg.diskOuterH * s);
      const tilt = (cfg.diskTilt * Math.PI) / 180;
      diskCos = Math.cos(tilt);
      diskSin = Math.sin(tilt);
      diskDx = cfg.diskDx * s;
      diskDy = cfg.diskDy * s;
      diskFeather = Math.max(1, cfg.diskFeather * s);
      // The band must stay a CIRCLE, so cap it at the disk's inner vertical
      // half-axis minus the disk offset (a circle of that radius always fits
      // inside the inner ellipse, whatever the tilt).
      const bandMax = diskInnerH - Math.hypot(diskDx, diskDy);
      photonOuter = Math.min(
        rRing + Math.max(2, cfg.photonBand * s),
        Math.max(rRing + 2, bandMax),
      );

      farCorner = Math.hypot(
        Math.max(cx, W - cx),
        Math.max(cy, H - cy),
      );

      const slowSpan = Math.max(1, rOuter - rMid);
      const midSpan = Math.max(1, rMid - rInner);
      const inSpan = Math.max(1, rInner - rRing);

      // One continuous stream: fade in just under the outer rim, fade out in
      // the last stretch before the ring, and ease the outer→middle speed
      // change across a smoothstep ramp instead of a hard line.
      fFar = clamp(slowSpan * 0.12, 24, 160);
      fRing = clamp(inSpan * 0.38, 10, 90);
      rampW = clamp(Math.min(slowSpan, midSpan) * 0.12, 12, 80);
      buildSpawn();
    }

    function measure() {
      W = window.innerWidth;
      H = window.innerHeight;
      DPR = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.max(1, Math.floor(W * DPR));
      canvas.height = Math.max(1, Math.floor(H * DPR));
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      // Re-read the knobs now that W/H are known: the 2a viewport fit is a
      // no-op while they are still 0, and this is also what re-fits after
      // the window is dragged onto a different screen (resize → measure).
      readCfg();
      geometry();
    }

    /* ══════════════════════════════════════════════════════════════
       4. STARS
    ═══════════════════════════════════════════════════════════════ */
    type Star = {
      r: number; // distance from the lens centre, px
      a: number; // angle around the centre, rad
      size: number;
      color: string;
      bright: boolean;
      tws: number;
      twp: number;
      base: number;
      birth: number;
    };
    let stars: Star[] = [];

    /* ── Radial spawn sampling ─────────────────────────────────────
       Every star falls monotonically from the outer rim to the ring, so the
       inward flux is constant and the steady-state density is ∝ 1/speed.
       Respawns sample a numeric CDF with that weight over
       [rRing + fRing, rOuter] (past the ring fade-out tail), which puts the
       field at its steady state from the first frame — no settling waves,
       no boundary seams. Built in geometry(); used by respawn(). */
    const SPAWN_N = 512;
    const cdfR: number[] = new Array(SPAWN_N + 1);
    const cdfC: number[] = new Array(SPAWN_N + 1);
    let spawnMin = 0;
    let spawnTotal = 0;

    function buildSpawn() {
      spawnMin = Math.max(1, rRing + fRing);
      const hi = Math.max(spawnMin + 1, rOuter);
      const dr = (hi - spawnMin) / SPAWN_N;
      let acc = 0;
      cdfR[0] = spawnMin;
      cdfC[0] = 0;
      for (let i = 0; i < SPAWN_N; i++) {
        const r = spawnMin + (i + 0.5) * dr;
        acc += dr / Math.max(speedAt(r), 1e-3); // density ∝ 1/v
        cdfR[i + 1] = spawnMin + (i + 1) * dr;
        cdfC[i + 1] = acc;
      }
      spawnTotal = acc;
    }

    function sampleR(): number {
      if (spawnTotal <= 0) return spawnMin;
      const u = Math.random() * spawnTotal;
      let lo = 0;
      let hi = SPAWN_N;
      while (hi - lo > 1) {
        const m = (lo + hi) >> 1;
        if (cdfC[m] < u) lo = m;
        else hi = m;
      }
      const t = (u - cdfC[lo]) / Math.max(cdfC[hi] - cdfC[lo], 1e-12);
      return cdfR[lo] + t * (cdfR[hi] - cdfR[lo]);
    }

    function starCount() {
      const area = W * H;
      const base = clamp(Math.floor(area / 1600), 180, 1400);
      return Math.max(60, Math.round(base * cfg.density));
    }

    function makeStar(): Star {
      const color = PALETTE[(Math.random() * PALETTE.length) | 0];
      const bright = Math.random() < 0.08;
      return {
        r: 0,
        a: Math.random() * TAU,
        size: bright ? 1.9 + Math.random() * 1.3 : 0.7 + Math.random() * 0.9,
        color,
        bright,
        tws: 0.35 + Math.random() * 2.0,
        twp: Math.random() * TAU,
        base: bright ? 0.95 : 0.5 + Math.random() * 0.3,
        birth: 0,
      };
    }

    // Spawn a star somewhere on its way in (steady-state density profile),
    // then let it drift. Respawned stars fade in over ~1.2 s so the recycle
    // never pops.
    function respawn(s: Star, initial = false) {
      s.r = sampleR();
      s.a = Math.random() * TAU;
      s.birth = initial ? 2 : 0;
    }

    function initStars() {
      const n = starCount();
      stars = [];
      for (let i = 0; i < n; i++) {
        const s = makeStar();
        respawn(s, true);
        stars.push(s);
      }
    }

    function reclamp() {
      // Rebuild when the density knob changes the target count; cheap and
      // predictable. Respawn anything a knob moved outside the field.
      if (Math.abs(stars.length - starCount()) > 4) {
        initStars();
        return;
      }
      for (const s of stars) {
        if (s.r > rOuter || s.r < rRing) respawn(s);
      }
    }

    /* ══════════════════════════════════════════════════════════════
       5. PHYSICS — radial speed in viewport heights / second.
       One profile for every star: speedOuter in the far field, blended to
       speedMid by a smoothstep ramp centred on rMid (half-width rampW on
       each side), then easing down toward 20 % at the ring.
    ═══════════════════════════════════════════════════════════════ */
    function speedAt(r: number) {
      if (r >= rMid + rampW) return cfg.speedOuter;
      if (r > rInner) {
        // Flat speedMid stretch below the ramp.
        if (r <= rMid - rampW) return cfg.speedMid;
        const b = clamp((r - (rMid - rampW)) / (2 * rampW), 0, 1);
        const e = b * b * (3 - 2 * b); // smoothstep across the ramp
        return cfg.speedMid + (cfg.speedOuter - cfg.speedMid) * e;
      }
      // Inner stretch: full speed at rInner (t = 1 → speedMid, continuous),
      // easing down to 20 % right at the ring.
      const span = Math.max(1, rInner - rRing);
      const t = clamp((r - rRing) / span, 0, 1);
      return cfg.speedMid * (0.2 + 0.8 * Math.pow(t, cfg.innerEase));
    }

    let time = 0;

    function update(dt: number) {
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        s.birth += dt;
        if (cfg.swirl !== 0) {
          s.a += cfg.swirl * (rRing / Math.max(s.r, rRing)) * dt;
        }
        s.r -= speedAt(s.r) * H * dt;
        if (s.r <= rRing) respawn(s);
      }
    }

    /* ══════════════════════════════════════════════════════════════
       6. RENDER
    ═══════════════════════════════════════════════════════════════ */
    const gradCache = new Map<string, CanvasGradient>();

    function gradFor(color: string) {
      let g = gradCache.get(color);
      if (g) return g;
      const rgb = RGB.get(color) ?? [255, 255, 255];
      const r = rgb[0];
      const gg = rgb[1];
      const b = rgb[2];
      g = ctx.createRadialGradient(0, 0, 0, 0, 0, 1);
      g.addColorStop(0, `rgba(${r},${gg},${b},1)`);
      g.addColorStop(0.14, `rgba(${r},${gg},${b},0.85)`);
      g.addColorStop(0.42, `rgba(${r},${gg},${b},0.24)`);
      g.addColorStop(0.72, `rgba(${r},${gg},${b},0.05)`);
      g.addColorStop(1, `rgba(${r},${gg},${b},0)`);
      gradCache.set(color, g);
      return g;
    }

    // Gravitational-lens profile: 1 at the black-hole ring, 0 at rInner.
    function lensProfile(r: number) {
      if (r >= rInner) return 0;
      const span = Math.max(1, rInner - rRing);
      const k = 1 - clamp((r - rRing) / span, 0, 1);
      return k * k;
    }

    // Accretion-disk mask. The video's disk is a rotated, squashed ellipse
    // annulus whose centre sits above the black hole, so its lower half is
    // smaller and stars survive longer there. Returns 1 for a star clear of
    // the disk, fading to 0 as it reaches the edge, and 0 inside the annulus.
    function diskMaskAlpha(sx: number, sy: number) {
      const dx = sx - (cx + diskDx);
      const dy = sy - (cy + diskDy);
      // Rotate the point into the ellipse's local frame.
      const lx = dx * diskCos + dy * diskSin;
      const ly = -dx * diskSin + dy * diskCos;

      const ox = lx / diskOuterW;
      const oy = ly / diskOuterH;
      const tOut = Math.sqrt(ox * ox + oy * oy);
      // Outside the outer ellipse: fade out as it approaches the edge.
      const dOut = (tOut - 1) * ((diskOuterW + diskOuterH) / 2);
      if (dOut >= 0) return clamp(dOut / diskFeather, 0, 1);

      const ix = lx / diskInnerW;
      const iy = ly / diskInnerH;
      const tIn = Math.sqrt(ix * ix + iy * iy);
      // Inside the inner ellipse: fade back in away from the inner edge.
      const dIn = (1 - tIn) * ((diskInnerW + diskInnerH) / 2);
      if (dIn > 0) return clamp(dIn / diskFeather, 0, 1);

      return 0; // inside the annulus → fully hidden
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);

      const bulgePx = cfg.bulge * H;
      const stretchMax = Math.max(1, cfg.stretch);

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        const r = s.r;

        // Lens: push outward + stretch tangentially near the ring.
        const p = lensProfile(r);
        const rDraw = r + bulgePx * p;
        // Hard floor: nothing may be drawn inside the black-hole ring, even if a
        // negative --lens-bulge pushes a star inward past it.
        if (rDraw <= rRing) continue;

        const ca = Math.cos(s.a);
        const sa = Math.sin(s.a);
        const sx = cx + rDraw * ca;
        const sy = cy + rDraw * sa;
        if (sx < -90 || sx > W + 90 || sy < -90 || sy > H + 90) continue;

        // The video's accretion disk sits above the starfield: fade a star out
        // at the disk edge rather than cutting it, and keep it hidden inside.
        const diskFade = diskMaskAlpha(sx, sy);
        if (diskFade <= 0.002) continue;

        // Alpha: fade in just under the outer rim, fade out before the ring,
        // plus respawn fade + twinkle + lens boost.
        let edge = (rOuter - r) / fFar;
        const ring = (r - rRing) / fRing;
        if (ring < edge) edge = ring;
        edge = clamp(edge, 0, 1);
        const birth = clamp(s.birth / 1.2, 0, 1);
        const tw = 0.68 + 0.32 * Math.sin(time * s.tws + s.twp);

        // The thin circular band just outside the black-hole ring is where the
        // lensed background piles up: draw those stars smaller + brighter so the
        // band reads as a dense ring of tiny circular stars.
        const inBand = rDraw <= photonOuter;
        const bandAlpha = inBand ? cfg.gapBoost : 1;
        const bandSize = inBand ? cfg.photonSize : 1;
        let alpha = s.base * tw * edge * birth * (1 + 0.9 * p) * diskFade * bandAlpha;
        if (alpha <= 0.004) continue;
        if (alpha > 1) alpha = 1;

        // Band stars stay circular (the user asked for a circular ring of tiny
        // stars, not the tangential smear the lensing applies further out).
        const stretch = inBand ? 1 : 1 + (stretchMax - 1) * p;
        const size = s.size * (1 + 0.45 * p) * bandSize;
        // Band stars are genuinely tiny: their glow shrinks with the band-size
        // multiplier (the ring-gap brightness boost keeps them readable).
        const glowR = Math.max(size * 3.0, 3.8 * bandSize);
        const coreR = Math.max(0.42, size * 0.8);

        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.translate(sx, sy);
        ctx.rotate(s.a);
        ctx.scale(1, stretch);

        // Soft glow (cached unit gradient, scaled).
        ctx.save();
        ctx.scale(glowR, glowR);
        ctx.fillStyle = gradFor(s.color);
        ctx.beginPath();
        ctx.arc(0, 0, 1, 0, TAU);
        ctx.fill();
        ctx.restore();

        // Bright core so stars stay point sources, not fuzzy discs.
        ctx.fillStyle = s.color;
        ctx.beginPath();
        ctx.arc(0, 0, coreR, 0, TAU);
        ctx.fill();

        ctx.restore();
      }

      if (tuneOn && showRings) drawDebug();
    }

    /* ══════════════════════════════════════════════════════════════
       7. DEBUG OVERLAY (only while tuning)
    ═══════════════════════════════════════════════════════════════ */
    function drawDebug() {
      const rings: [number, string, string][] = [
        [rOuter, "rgba(110, 190, 255, 0.55)", L10N.debug.outerEdge],
        [rMid, "rgba(255, 205, 110, 0.55)", L10N.debug.outerMid],
        [rInner, "rgba(255, 125, 195, 0.55)", L10N.debug.midInner],
        [rRing, "rgba(255, 80, 80, 0.9)", L10N.debug.ring],
      ];

      ctx.save();
      ctx.font = "11px ui-monospace, SFMono-Regular, Menlo, monospace";
      ctx.textBaseline = "middle";
      ctx.lineWidth = 1;

      // Faint fill of the hidden accretion-disk annulus (rotated ellipse).
      const dcx = cx + diskDx;
      const dcy = cy + diskDy;
      const dtilt = Math.atan2(diskSin, diskCos);
      ctx.fillStyle = "rgba(255, 150, 60, 0.06)";
      ctx.beginPath();
      ctx.ellipse(dcx, dcy, diskOuterW, diskOuterH, dtilt, 0, TAU);
      ctx.ellipse(dcx, dcy, diskInnerW, diskInnerH, dtilt, 0, TAU, true);
      ctx.fill();

      // Disk boundary ellipses + labels (rightmost point of each ellipse).
      ctx.strokeStyle = "rgba(255, 150, 60, 0.85)";
      ctx.fillStyle = "rgba(255, 150, 60, 0.85)";
      for (const [rw, rh, label] of [
        [diskInnerW, diskInnerH, L10N.debug.diskInner],
        [diskOuterW, diskOuterH, L10N.debug.diskOuter],
      ] as [number, number, string][]) {
        ctx.setLineDash([6, 7]);
        ctx.beginPath();
        ctx.ellipse(dcx, dcy, rw, rh, dtilt, 0, TAU);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillText(label, dcx + rw * diskCos + 8, dcy + rw * diskSin);
      }


      // Photon band: the circular outer edge of the tiny-star ring.
      if (photonOuter > rRing) {
        ctx.setLineDash([3, 5]);
        ctx.strokeStyle = "rgba(120, 255, 210, 0.75)";
        ctx.beginPath();
        ctx.arc(cx, cy, photonOuter, 0, TAU);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = "rgba(120, 255, 210, 0.85)";
        const bang = -Math.PI * 0.75;
        ctx.fillText(
          L10N.debug.photonBand,
          cx + photonOuter * Math.cos(bang) + 6,
          cy + photonOuter * Math.sin(bang),
        );
      }


      for (const [rad, color, label] of rings) {
        if (rad <= 0) continue;
        ctx.setLineDash([6, 7]);
        ctx.strokeStyle = color;
        ctx.beginPath();
        ctx.arc(cx, cy, rad, 0, TAU);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = color;
        ctx.fillText(label, cx + rad + 8, cy);
      }

      // Centre crosshair
      ctx.setLineDash([]);
      ctx.strokeStyle = "rgba(255, 255, 255, 0.9)";
      const L = 15;
      ctx.beginPath();
      ctx.moveTo(cx - L, cy);
      ctx.lineTo(cx + L, cy);
      ctx.moveTo(cx, cy - L);
      ctx.lineTo(cx, cy + L);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(cx, cy, 5, 0, TAU);
      ctx.stroke();
      ctx.restore();
    }

    /* ══════════════════════════════════════════════════════════════
       8. RUN / STOP
    ═══════════════════════════════════════════════════════════════ */
    let running = false;
    let rafId = 0;
    let lastT = 0;

    function loop(now: number) {
      if (!running) {
        rafId = 0;
        return;
      }
      rafId = requestAnimationFrame(loop);
      if (!lastT) lastT = now;
      let dt = (now - lastT) / 1000;
      lastT = now;
      if (!(dt > 0)) dt = 1 / 60;
      if (dt > 0.05) dt = 0.05;
      time += dt;
      update(dt);
      draw();
    }

    function shouldRun() {
      return (
        DESKTOP.matches &&
        !REDUCED.matches &&
        root.getAttribute("data-theme") !== "light"
      );
    }

    function start() {
      if (running) return;
      readCfg();
      running = true;
      root.setAttribute("data-lens", "on");
      measure();
      initStars();
      lastT = 0;
      rafId = requestAnimationFrame(loop);
      if (tuneOn) renderHud();
    }

    function stop() {
      const wasRunning = running;
      running = false;
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
      root.removeAttribute("data-lens");
      if (wasRunning) {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      if (tuneOn) renderHud();
    }

    function sync() {
      if (shouldRun()) start();
      else stop();
    }

    // Re-read the CSS knobs, then rebuild geometry and re-clamp the field.
    function refresh() {
      readCfg();
      if (!running) return;
      geometry();
      reclamp();
    }

    /* ══════════════════════════════════════════════════════════════
       9. KEYBOARD TUNER
       Press ` (backtick) or Ctrl+Alt+G, or load ?lens=tune.
       Everything it changes is written to inline custom properties and
       saved to localStorage, so tuning survives a reload. C copies the
       current values back as CSS for global.css §10.
    ═══════════════════════════════════════════════════════════════ */
    type Knob = {
      prop: string;
