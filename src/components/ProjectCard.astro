---
import { getImage } from "astro:assets";
import { getProjectImageMeta } from "../utils/images";
import { getLanguageFromPath, languageDateLocales } from "../utils/i18n";
import { buildEntryUrl } from "../utils/routes";
import { getTranslations } from "../utils/translations";

const { project } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

// project.id:
//
// 3d-printing-abs-material-test/en
// 3d-printing-abs-material-test/zh
//
// URL 只使用项目 slug
const slug = project.id.split("/")[0];

const coverMeta = project.data.cover
  ? getProjectImageMeta(slug, project.data.cover)
  : null;

const optimizedCover =
  coverMeta && typeof coverMeta !== "string"
    ? await getImage({
        src: coverMeta,
        width: 1200,
        format: "webp",
        quality: 90,
      })
    : null;

const image =
  optimizedCover?.src ?? (typeof coverMeta === "string" ? coverMeta : null);
const imageWidth = optimizedCover?.attributes.width as number | undefined;
const imageHeight = optimizedCover?.attributes.height as number | undefined;

const date = project.data.date.toLocaleDateString(
  languageDateLocales[language],
  {
    year: "numeric",
    month: "short",
  },
);

// URL 单一来源：utils/routes.ts 的 buildEntryUrl
// （历史教训：组件内自建路由映射曾产生 404）
const url = buildEntryUrl(project, project.data.lang);

const type = project.data.type.toUpperCase();
---

<a href={url} class="card">
  <div class="corner"></div>

  <div class="card-header">
    <span>
      {t.card.projectNode}
      {type}
    </span>

    <span class:list={["status", { wip: project.data.wip }]}>
      {project.data.wip ? t.card.wip : t.card.online}
    </span>
  </div>

  {
    image && (
      <div class="image-wrapper">
        <div class="image-label">{t.card.imageStream}</div>

        {
          project.data.collaboration && project.data.collaboration.length > 0 && (
            <div class="collab-badge">
              {t.card.team}
            </div>
          )
        }

        <img class="cover" src={image} alt={project.data.title} width={imageWidth} height={imageHeight} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="content">
    <h2>
      {project.data.title}
    </h2>

    <p class="description">
      {project.data.description}
    </p>

    {
      project.data.tags?.length && (
        <div class="tags">
          {project.data.tags.map((tag: string) => (
            <span>#{tag}</span>
          ))}
        </div>
      )
    }

    <div class="footer">
      <span>
        {t.card.category}
        {type}
      </span>

      <span>
        {t.card.archive}
        {date}
      </span>
    </div>
  </div>
</a>

<style>
  .card {
    display: block;

    position: relative;

    background-color: rgba(15, 17, 28, 0.55);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.055'/%3E%3C/svg%3E");
    background-size: 240px 240px;

    border: 1px solid rgba(255, 255, 255, 0.1);

    border-radius: 18px;

    color: var(--text-bright);

    text-decoration: none;

    overflow: hidden;

    min-height: 430px;

    font-family: var(--font-mono);

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);

    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:active {
    transform: scale(0.97);
    transition: transform 0.15s ease-out;
  }

  /* ── Left accent stripe (kept per site identity) ── */
  .card::before {
    content: "";

    position: absolute;

    left: 0;

    top: 0;

    height: 100%;

    width: 5px;

    background: var(--stripe-teal);
  }

  .corner {
    position: absolute;

    right: 0;

    top: 0;

    width: 40px;

    height: 40px;

    background: var(--accent);

    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    background-color: rgba(20, 22, 35, 0.58);
    box-shadow:
      0 24px 64px rgba(3, 7, 18, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(2, 6, 16, 0.3);
  }

  /* ── Hover gloss sweep ── */
  /* ── Very subtle sheen sweep (intentionally faint) ── */
  .card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 255, 255, 0.012) 40%,
      rgba(255, 255, 255, 0.028) 50%,
      rgba(255, 255, 255, 0.012) 60%,
      transparent 100%
    );
    transform: translateX(-120%);
    transition: transform 0.9s ease-out;
    pointer-events: none;
  }

  .card:hover::after {
    transform: translateX(120%);
  }

  .card-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 8px;

    padding: 16px 20px;

    border-bottom: 1px solid var(--border);

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-label);

    color: var(--text-dim);
  }

  .status {
    color: var(--terminal-green);

    font-weight: bold;
  }

  .status.wip {
    color: #e0b34c;
  }

  .image-wrapper {
    height: 220px;

    background: var(--bg);

    position: relative;

    overflow: hidden;

    border-bottom: 1px solid var(--border);
  }

  .image-label {
    position: absolute;

    top: 10px;

    left: 12px;

    z-index: 2;

    font-size: var(--text-scale-4xs);

    background: #000;

    border: 1px solid var(--accent);

    padding: 4px 8px;

    color: var(--accent);
  }

  :root[data-theme="light"] .image-label {
    background: var(--paper);
  }

  .collab-badge {
    position: absolute;

    top: 10px;

    right: 12px;

    z-index: 3;

    /* Typography */
    font-family: var(--font-mono);

    font-size: var(--text-scale-4xs);

    font-weight: 700;

    letter-spacing: var(--tracking-label);

    /* Shape — angular industrial tag */
    padding: 4px 10px;

    clip-path: polygon(
      6px 0,
      100% 0,
      calc(100% - 6px) 100%,
      0 100%
    );

    /* Background */
    background: rgba(8, 8, 11, 0.94);

    /* Text color — warm off-white */
    color: rgba(230, 220, 200, 0.9);

    /* Tri-color bottom border only */
    border-bottom: 1.5px solid transparent;

    border-image: linear-gradient(
      90deg,
      var(--stripe-red),
      var(--stripe-yellow),
      var(--stripe-teal)
    ) 1;

    /* Subtle text glow sweep */
    overflow: hidden;
  }

  /* ---- Tri-color accent glow sweep ---- */
  .collab-badge::before {
    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 100%;

    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255, 255, 255, 0.04) 45%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.04) 55%,
      transparent 100%
    );

    transform: translateX(-100%);

    animation: collabSweep 5s ease-in-out infinite;

    pointer-events: none;
  }

  @keyframes collabSweep {
    0% {
      transform: translateX(-100%);
    }

    35%,
    65% {
      transform: translateX(100%);
    }

    100% {
      transform: translateX(100%);
    }
  }

  /* ---- Corner notch — tri-color filled ---- */
  .collab-badge::after {
    content: "";

    position: absolute;

    bottom: 0;

    left: 0;

    width: 7px;

    height: 7px;

    background: linear-gradient(
      135deg,
      var(--stripe-red) 0%,
      var(--stripe-yellow) 100%
    );

    clip-path: polygon(0 100%, 100% 100%, 0 0);

    opacity: 0.6;
  }


  .cover {
    width: 100%;

    height: 100%;

    object-fit: cover;

    transition: transform 0.5s var(--spring-gentle);
  }

  .card:hover .cover {
    transform: scale(1.05);
  }

  .content {
    padding: 25px;
  }

  h2 {
    font-size: var(--text-scale-card);

    font-weight: 900;

    line-height: 1.1;

    margin-bottom: 15px;

    letter-spacing: var(--tracking-slight);
  }

  .description {
    font-size: var(--text-scale-xs);

    color: #aaa;

    line-height: 1.7;

    margin-bottom: 25px;
  }

  .tags {
    display: flex;

    gap: 8px;

    flex-wrap: wrap;

    margin-bottom: 30px;
  }

  .tags span {
    font-size: var(--text-scale-3xs);

    padding: 5px 10px;

    border: 1px solid var(--border-divider);

    background: #111;
  }

  .tags span:nth-child(3n + 1) {
    border-color: var(--stripe-red);

    color: var(--stripe-red-soft);
  }

  .tags span:nth-child(3n + 2) {
    border-color: var(--stripe-yellow);

    color: var(--stripe-yellow-soft);
  }

  .tags span:nth-child(3n) {
    border-color: var(--stripe-teal);

    color: var(--stripe-teal-soft);
  }

  .footer {
    display: flex;

    justify-content: space-between;

    border-top: 1px dashed var(--border-divider);

    padding-top: 15px;

    font-size: var(--text-scale-4xs);

    color: var(--text-dim);
  }
</style>
