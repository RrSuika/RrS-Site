---
/**
 * FanCta — the ART page's one link OUT of the site.
 *
 * ⚠️ It is a component and not a block repeated in three pages because the three
 * `/art` pages are separate files with separate `<style>` blocks: the same markup
 * pasted three times would mean the same CSS pasted three times, and the art
 * pages are the one area of this repo where a silent drift between the three
 * languages is hardest to notice.
 *
 * ⚠️ **It is an EASTER EGG, not a call to action** (visitor: 「把整个方框和里面
 * 内容做的很小很小，几乎难以看见，因为他是一个彩蛋按钮」). It used to be a full
 * 11px bordered pill with a dot, a glow and an ↗; it is now a speck at 6px and
 * 14% opacity in the corner of the hero, and it only becomes legible under the
 * pointer or the keyboard's focus ring. The hit area is genuinely small, which is
 * the point — but `:focus-visible` still brings it back to full opacity, so it
 * stays reachable without a mouse.
 *
 * ⚠️ Deliberately NOT the site's amber accent: this is the only control on the
 * page that leaves the site, and it wears the destination's own pink.
 */
import { getLanguageFromPath, getLocalizedPath } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
---

<a
  class="fan-cta"
  href={getLocalizedPath("/fan", language)}
  target="_blank"
  rel="noopener"
>
  <span class="fan-cta-dot" aria-hidden="true"></span>
  <span class="fan-cta-text">{t.fan.cta}</span>
</a>

<style>
  /* ⚠️ `isolation: isolate` is what keeps the `z-index: -1` fill behind the
     label instead of behind the page — the same trap the tag chips hit. */
  .fan-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 10px;
    padding: 2px 5px;

    font-family: var(--font-mono);
    font-size: 6px;
    font-weight: 700;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    text-decoration: none;

    color: #ff6fa8;
    border: 1px solid rgba(255, 111, 168, 0.35);
    border-radius: 2px;
    background: rgba(255, 111, 168, 0.06);

    /* the easter egg itself: faint enough to miss, present enough to find */
    opacity: 0.14;

    transition:
      opacity 0.35s var(--ease-out),
      color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }

  .fan-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #f5308a;
    transform: translateY(101%);
    transition: transform 0.4s var(--ease-out);
    pointer-events: none;
  }

  .fan-cta:hover,
  .fan-cta:focus-visible {
    opacity: 1;
    color: #fff;
    border-color: #f5308a;
  }

  .fan-cta:hover::before,
  .fan-cta:focus-visible::before {
    transform: translateY(0);
  }

  .fan-cta-dot {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }
</style>
