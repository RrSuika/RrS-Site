---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
const projectsPath = getLocalizedPath("/projects", language);
---

<section class="hero">
  <!-- ── Decorative background ── -->
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-cross cross-tl"></div>
    <div class="grid-cross cross-tr"></div>
    <div class="grid-cross cross-bl"></div>
    <div class="grid-cross cross-br"></div>
    <div class="coords coord-top">LAT 51°55′N // LON 004°28′E</div>
    <div class="coords coord-bot">SIGMA-09 // TELEMETRY ACTIVE</div>
  </div>

  <div class="hero-left">
    <div class="data-tag type-line">
      <span class="tag-dot"></span>
      RrSuika_STUDIO // DESIGN_SYSTEM_v1.0
    </div>

    <div class="title-wrapper">
      <div class="tri-bar">
        <div></div><div></div><div></div>
      </div>
      <h1>
        <span class="type-line">{t.hero.title.line1}</span>
        <br />
        <span class="type-line accent">{t.hero.title.line2}</span>
      </h1>
    </div>

    <div class="cassette">
      <div class="barcode"></div>
      <span class="type-line">{t.hero.cassette}</span>
    </div>

    <p class="description type-line">
      {t.hero.description.line1}
      {t.hero.description.line2 && (
        <>
          <br />
          {t.hero.description.line2}
        </>
      )}
    </p>

    <a href={projectsPath} class="button type-line">
      <span class="btn-icon">&#9654;</span>
      {t.hero.button}
    </a>
  </div>

  <div class="terminal">
    <div class="telemetry-strip" aria-hidden="true">
      <span>SYS.ONLINE</span>
      <span class="tel-sep">//</span>
      <span>LINK:ESTABLISHED</span>
      <span class="tel-sep">//</span>
      <span>SIGNAL:97%</span>
    </div>
    <div class="terminal-header">
      SYS.BOOT // KERNEL_CORE_v5.5<br />
      DATA_DECK: <span>[MAGNETIC_TAPE_OPTIMIZED]</span>
    </div>
    <div class="terminal-content" id="terminal-log"></div>
    <div class="crt-fade-top"></div>
    <div class="crt-fade-bot"></div>
  </div>
</section>

<script>
  // ── Terminal boot lines ──
  const bootLines = [
    { text: "CRISP_FONT_RENDERING...", result: "STABILIZED." },
    { text: "RADAR_GRID_VECTOR_DENSITY...", result: "MAXIMIZED." },
    { text: "CONTRAST_RATIO_CORRECTION...", result: "COMPLETED." },
    { text: "", result: "" },
    { text: "COLD_BOOT:", result: "OPERATIONAL." },
    { text: "INGESTING_ROTTERDAM_FAB_DATA...", result: "ONLINE." },
    { text: "CONTRAST_ENHANCEMENT:", result: "RE-ENGAGED." },
    { text: "LOGS:", result: "ALL_CORE_STYLES_COMPILED." },
  ];

  const termEl = document.getElementById("terminal-log");
  const leftLines = Array.from(document.querySelectorAll<HTMLElement>(".type-line")).filter((el) => !el.classList.contains("button"));

  // Hide left-side text initially
  leftLines.forEach((el) => {
    el.dataset.original = el.innerHTML;
    el.innerHTML = "";
    el.style.visibility = "visible";
    el.style.opacity = "1";
  });

  // ── Typewriter engine ──
  function typeElement(
    el: HTMLElement,
    html: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      const temp = document.createElement("div");
      temp.innerHTML = html;
      const text = temp.textContent || "";
      let i = 0;
      el.innerHTML = "";
      el.classList.add("typing");

      const timer = setInterval(() => {
        if (i < text.length) {
          el.textContent = text.slice(0, i + 1);
          i++;
        } else {
          el.innerHTML = html;
          el.classList.remove("typing");
          el.classList.add("typed");
          clearInterval(timer);
          resolve();
        }
      }, speed);
    });
  }

  function typeTerminalLine(
    parent: HTMLElement,
    label: string,
    result: string,
    speed: number,
  ): Promise<void> {
    return new Promise((resolve) => {
      if (!label) {
        const br = document.createElement("br");
        parent.appendChild(br);
        resolve();
        return;
      }
      const div = document.createElement("div");
      div.innerHTML = `&gt; ${label} `;
      parent.appendChild(div);

      const span = document.createElement("span");
      div.appendChild(span);

      const text = `> ${label} `;
      let i = 0;
      const timer = setInterval(() => {
        if (i < text.length) {
          div.innerHTML = "";
          const typed = text.slice(0, i + 1);
          div.appendChild(document.createTextNode(typed));
          div.appendChild(span);
          i++;
        } else {
          clearInterval(timer);
          setTimeout(() => {
            span.textContent = result;
            span.style.color = "var(--terminal-green)";
            resolve();
          }, 120);
        }
      }, speed);
    });
  }

  const liveLogs = [
    { text: "ACQUIRING_PARTICLE_SIGNAL...", result: "LOCKED." },
    { text: "NEURAL_MESH_DENSITY:", result: "0.847" },
    { text: "RENDER_PIPELINE_FLUSH...", result: "OK." },
    { text: "MEMORY_HEAP_FRAGMENTATION:", result: "12%" },
    { text: "KERNEL_TIMER_SYNC...", result: "CALIBRATED." },
    { text: "BACKBUFFER_SWAP_CHAIN:", result: "VSYNC_ON." },
    { text: "THERMAL_THROTTLE_STATUS:", result: "NOMINAL." },
    { text: "FRAME_PACING_DELTA:", result: "2.1ms" },
    { text: "GPU_COMMAND_BUFFER...", result: "FLUSHED." },
    { text: "AUDIO_DSP_LATENCY_CHECK...", result: "PASSED." },
    { text: "NETWORK_SOCKET_POOL:", result: "HEALTHY." },
    { text: "SHADER_CACHE_REBUILD...", result: "DONE." },
    { text: "PHYSICS_TICK_RATE:", result: "60Hz" },
    { text: "ASSET_STREAMING_QUEUE...", result: "EMPTY." },
    { text: "INPUT_LAG_MEASUREMENT:", result: "0.8ms" },
    { text: "RAY_TRACING_BVH_UPDATE...", result: "READY." },
  ];

  async function typeTerminalSequence() {
    if (!termEl) return;
    for (const line of bootLines) {
      await typeTerminalLine(termEl, line.text, line.result, 8);
    }
    const cursor = document.createElement("span");
    cursor.className = "cursor";
    cursor.textContent = " _";
    termEl.appendChild(cursor);

    let logIndex = 0;
    function addLiveLine() {
      const line = liveLogs[logIndex % liveLogs.length];
      cursor.remove();
      if (!termEl) return;
      typeTerminalLine(termEl, line.text, line.result, 6).then(() => {
        if (!termEl) return;
        termEl.appendChild(cursor);
        termEl.scrollTop = termEl.scrollHeight;
      });
      while (termEl.children.length > 20) {
        termEl.firstChild?.remove();
      }
      logIndex++;
    }

    setInterval(addLiveLine, 1200 + Math.random() * 800);
    setTimeout(addLiveLine, 600);
  }

  async function typeLeftSequence() {
    const lines = Array.from(leftLines);
    await new Promise((r) => setTimeout(r, 300));
    for (const line of lines) {
      await typeElement(line, line.dataset.original || "", 10);
      await new Promise((r) => setTimeout(r, 40));
    }
    // Draw the button frame only after its text (the last line) is typed
    document
      .querySelector<HTMLElement>(".button.type-line")
      ?.classList.add("frame-in");
  }

  typeTerminalSequence();
  typeLeftSequence();
</script>

<style>
  .hero {
    max-width: var(--container-wide);
    margin: auto;
    min-height: calc(100vh - 75px);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 100px;
    padding: 15px 40px 140px;
    position: relative;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════
     DECORATIVE BACKGROUND — Cassette / NASA-punk
     ═══════════════════════════════════════════ */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Coordinate cross markers */
  .grid-cross {
    position: absolute;
    width: 24px;
    height: 24px;
    opacity: 0.3;
  }
  .grid-cross::before,
  .grid-cross::after {
    content: "";
    position: absolute;
    background: var(--accent);
  }
  .grid-cross::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-0.5px);
  }
  .grid-cross::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-0.5px);
  }
  .cross-tl {
    top: 90px;
    left: 30px;
  }
  .cross-tr {
    top: 90px;
    right: 30px;
  }
  .cross-bl {
    bottom: 0;
    left: 30px;
  }
  .cross-br {
    bottom: 0;
    right: 30px;
  }

  /* Coordinate labels */
  .coords {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--text-scale-5xs);
    letter-spacing: var(--tracking-wider);
    color: rgba(232, 160, 64, 0.4);
  }
  .coord-top {
    top: 10px;
    right: 40px;
  }
  .coord-bot {
    bottom: 0;
    left: 40px;
  }

  /* ═══════════════════════════════════════════
     LEFT COLUMN
     ═══════════════════════════════════════════ */
  .hero-left {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .data-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-scale-4xs);
    font-weight: 900;
    letter-spacing: var(--tracking-tag);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 8px 14px;
    margin-bottom: 35px;
    animation: tagIn 0.5s ease-out both;
    animation-delay: 0.15s;
    background: rgba(232, 120, 53, 0.04);
  }
  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: dotBlink 2s infinite;
  }
  @keyframes dotBlink {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 4px var(--accent);
    }
    50% {
      opacity: 0.3;
      box-shadow: 0 0 1px var(--accent);
    }
  }
  @keyframes tagIn {
    from {
      opacity: 0;
      box-shadow: 0 0 0px var(--accent);
    }
    to {
      opacity: 1;
      box-shadow: 0 0 12px rgba(232, 120, 53, 0.25);
    }
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .tri-bar {
    width: 12px;
    height: 190px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    /* Fixed height: the old grow-from-0 container animation made the
       top bar (red) shift while drawing — each bar now draws top-down
       inside a settled layout. */
    animation: triFade 0.5s ease-out both;
    animation-delay: 0.1s;
  }
  @keyframes triFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .tri-bar div {
    flex: 1;
    /* clip-path avoids nested transform compositing issues —
       <main> has a pageIn animation with translateY which
       creates a compositing layer; using clip-path here keeps
       the bars on the paint layer so they don't vanish */
  }
  .tri-bar div:nth-child(1) {
    background: var(--stripe-red);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.15s;
  }
  .tri-bar div:nth-child(2) {
    background: var(--stripe-yellow);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.4s;
  }
  .tri-bar div:nth-child(3) {
    background: var(--stripe-teal);
    animation: barGrow 0.5s ease-out both;
    animation-delay: 0.65s;
  }
  @keyframes barGrow {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-scale-hero);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -2px; /* user request: slightly wider than the old -6px */
    min-height: 1.8em;
  }
  h1 .accent {
    color: var(--accent);
  }

  /* Typewriter cursor */
  .type-line.typing::after {
    content: "_";
    color: var(--terminal-green);
    animation: blink 0.7s infinite;
    font-weight: 400;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .cassette {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 45px;
    font-family: var(--font-mono);
    font-size: var(--text-scale-2xs);
    color: var(--accent);
  }

  .barcode {
    /* Bars use the same warm ink as the FUNCTIONAL headline (body --text)
       instead of pure #fff, which read colder/greyer next to it. */
    --barcode-ink: var(--text);

    width: 140px;
    height: 35px;
    background: repeating-linear-gradient(
      90deg,
      var(--barcode-ink) 0px,
      var(--barcode-ink) 1px,
      transparent 1px,
      transparent 4px,
      var(--barcode-ink) 4px,
      var(--barcode-ink) 7px,
      transparent 7px,
      transparent 8px,
      var(--barcode-ink) 8px,
      var(--barcode-ink) 9px,
      transparent 9px,
      transparent 12px,
      var(--barcode-ink) 12px,
      var(--barcode-ink) 15px,
      transparent 15px,
      transparent 17px,
      var(--barcode-ink) 17px,
      var(--barcode-ink) 18px,
      transparent 18px,
      transparent 23px,
      var(--barcode-ink) 23px,
      var(--barcode-ink) 26px,
      transparent 26px,
      transparent 28px,
      var(--barcode-ink) 28px,
      var(--barcode-ink) 30px,
      transparent 30px,
      transparent 35px,
      var(--barcode-ink) 35px,
      var(--barcode-ink) 36px,
      transparent 36px,
      transparent 38px,
      var(--barcode-ink) 38px,
      var(--barcode-ink) 42px,
      transparent 42px,
      transparent 43px,
      var(--barcode-ink) 43px,
      var(--barcode-ink) 46px,
      transparent 46px,
      transparent 50px,
      var(--barcode-ink) 50px,
      var(--barcode-ink) 52px,
      transparent 52px,
      transparent 54px,
      var(--barcode-ink) 54px,
      var(--barcode-ink) 58px,
      transparent 58px,
      transparent 60px
    );
    opacity: 0;
    animation: barcodeIn 0.6s ease-out forwards;
    animation-delay: 0.4s;
  }

  /* Light theme: the headline switches to --text-bright, so match that. */
  :root[data-theme="light"] .barcode {
    --barcode-ink: var(--text-bright);
  }

  @keyframes barcodeIn {
    from {
      opacity: 0;
      width: 0;
    }
    to {
      opacity: 0.8;
      width: 140px;
    }
  }

  .description {
    margin-top: 35px;
    max-width: 620px;
    font-size: var(--text-scale-body);
    line-height: 1.8;
    color: var(--text-soft);
    padding-left: 20px;
    min-height: 3.6em;
    position: relative;
  }

  /* Orange signal bar — draws in top→bottom when the typewriter
     starts typing this block (.typing is added by the JS engine) */
  .description::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s var(--ease-out);
  }
  /* .typing = bar draws in while the typewriter types;
     .typed   = keeps it drawn after typing completes */
  .description.typing::before,
  .description.typed::before {
    transform: scaleY(1);
  }

  .button {
    margin-top: 40px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 34px;
    border: 1px solid rgba(232, 148, 58, 0.35);
    border-radius: 14px;
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: var(--tracking-label);
    background: linear-gradient(
      145deg,
      rgba(36, 36, 58, 0.95),
      rgba(16, 16, 28, 0.92)
    );
    box-shadow:
      10px 10px 22px rgba(0, 0, 0, 0.72),
      -8px -8px 16px rgba(255, 255, 255, 0.055),
      inset 2px 2px 4px rgba(255, 255, 255, 0.12),
      inset -3px -3px 6px rgba(0, 0, 0, 0.58);
    transition:
      background 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      transform 0.2s var(--spring-snappy),
      border-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
    opacity: 0;
    animation: btnReveal 0.9s var(--ease-out) forwards;
    animation-delay: 0.7s;
    position: relative; isolation: isolate;
    overflow: hidden;
  }

  /* Light theme button — warm paper neumorphism, not black */
  :global(:root[data-theme="light"]) .button {
    border-color: rgba(176, 112, 32, 0.45);
    background: linear-gradient(
      145deg,
      rgba(248, 244, 236, 0.96),
      rgba(226, 218, 201, 0.93)
    );
    box-shadow:
      8px 8px 16px rgba(120, 100, 70, 0.22),
      -6px -6px 12px rgba(255, 255, 255, 0.75),
      inset 1px 1px 2px rgba(255, 255, 255, 0.8),
      inset -2px -2px 4px rgba(120, 100, 70, 0.14);
  }
  :global(:root[data-theme="light"]) .button:active {
    box-shadow:
      inset 4px 4px 10px rgba(120, 100, 70, 0.25),
      inset -3px -3px 6px rgba(255, 255, 255, 0.6);
  }

  /* Frame draws in only after the typewriter finishes the button text
     (JS adds .frame-in once the last line is typed) */
  .button.frame-in {
    border-color: var(--accent);
  }

  .button:active {
    transform: scale(0.96);
    box-shadow:
      inset 4px 4px 10px rgba(0, 0, 0, 0.55),
      inset -3px -3px 6px rgba(255, 255, 255, 0.05);
    transition: transform 0.08s var(--spring-snappy);
  }
  .button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      145deg,
      var(--accent-glow),
      var(--accent) 45%,
      var(--accent-deep)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
    transform: translateY(100%);
    transition: transform 0.45s var(--ease-out);
    pointer-events: none;
  }
  .button:hover::before {
    transform: translateY(0);
  }

  .btn-icon {
    font-size: var(--text-scale-4xs);
    color: var(--accent);
  }
  @keyframes btnReveal {
    from {
      opacity: 0;
      filter: brightness(1.65) saturate(0.6);
      box-shadow:
        0 8px 16px rgba(0, 0, 0, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }
    to {
      opacity: 1;
      filter: brightness(1) saturate(1);
    }
  }
  .button:hover {
    transform: translateY(-2px);
    border-color: var(--accent-glow);
    color: var(--on-accent);
    box-shadow:
      0 10px 26px rgba(232, 148, 58, 0.22),
      8px 8px 16px rgba(0, 0, 0, 0.55),
      -6px -6px 12px rgba(255, 255, 255, 0.05);
  }
  .button:hover .btn-icon {
    color: var(--on-accent);
  }

    /* ── 2K+ large-desktop hero scale ──
       The base token is clamp(80px, 10vw, 110px), so a 1920px
       (1080p) and a 2560px (2K) viewport both get the same 110px
       headline — on 2K the opening block reads one zoom step too
       small. This step ramps the hero text linearly from its
       current size at 2328 CSS px to the 110%-zoom equivalent at
       2560 CSS px. At 2K@110% the viewport is ~2327 CSS px, so
       the block stays off and that already-correct setting is
       preserved; at 1080p@100% (1920px) it is also untouched. */
    @media (min-width: 2328px) {
      .hero {
        --text-scale-hero: clamp(110px, 4.7266vw, 121px);
        --text-scale-2xs: clamp(12px, 0.5156vw, 13px);
        --text-scale-body: clamp(18px, 0.7734vw, 20px);
        --text-scale-4xs: clamp(10px, 0.4297vw, 11px);
      }

      .button {
        font-size: clamp(16px, 0.6875vw, 18px);
      }
    }

  /* ═══════════════════════════════════════════
     TERMINAL HUD
     ═══════════════════════════════════════════ */
  .terminal {
    width: 430px;
    flex-shrink: 0;
    margin-top: 70px;
    padding: 32px;
    background: var(--surface-night);
    border: 1px solid var(--accent);
    box-shadow:
      0 0 30px rgba(255, 95, 31, 0.12),
      inset 0 0 80px rgba(232, 120, 53, 0.02);
    font-family: var(--font-mono);
    font-size: var(--text-scale-xs);
    position: relative;
    z-index: 1;
    opacity: 0;
    animation: termPowerOn 0.5s ease-out forwards;
    animation-delay: 0.5s;
  }
  @keyframes termPowerOn {
    from {
      opacity: 0;
      box-shadow: 0 0 0px rgba(255, 95, 31, 0);
    }
    40% {
      opacity: 1;
      box-shadow: 0 0 60px rgba(255, 95, 31, 0.3);
    }
    to {
      opacity: 1;
      box-shadow: 0 0 30px rgba(255, 95, 31, 0.12);
    }
  }
  .terminal::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 60px;
    height: 3px;
    background: var(--accent);
  }
  .terminal::after {
    content: "";
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 40px;
    height: 2px;
    background: rgba(232, 160, 64, 0.5);
  }

  /* Telemetry strip above terminal header */
  .telemetry-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(255, 95, 31, 0.15);
    font-size: var(--text-scale-5xs);
