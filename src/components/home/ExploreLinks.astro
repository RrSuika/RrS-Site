---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const projectsPath = getLocalizedPath("/projects", language);
const labPath = getLocalizedPath("/lab", language);
const artPath = getLocalizedPath("/art", language);
const notesPath = getLocalizedPath("/notes", language);
---

<div class="explore-grid">
  <!-- =========================
       MODULE 01 // PROJECTS
  ========================== -->

  <a href={projectsPath} class="explore-card">
    <div class="header">
      {t.explore.projects.header}
    </div>

    <span class="number">01</span>

    <h3>
      {t.explore.projects.title}
    </h3>

    <p>
      {t.explore.projects.description}
    </p>

    <div class="access">
      {t.explore.projects.access}
    </div>

    <div class="stripe">
      <div></div>
      <div></div>
      <div></div>
    </div>
  </a>

  <!-- =========================
       MODULE 02 // LAB
  ========================== -->

  <a href={labPath} class="explore-card">
    <div class="header">
      {t.explore.lab.header}
    </div>

    <span class="number">02</span>

    <h3>
      {t.explore.lab.title}
    </h3>

    <p>
      {t.explore.lab.description}
    </p>

    <div class="access">
      {t.explore.lab.access}
    </div>

    <div class="stripe">
      <div></div>
      <div></div>
      <div></div>
    </div>
  </a>

  <!-- =========================
       MODULE 03 // ART
  ========================== -->

  <a href={artPath} class="explore-card">
    <div class="header">
      {t.explore.art.header}
    </div>

    <span class="number">03</span>

    <h3>
      {t.explore.art.title}
    </h3>

    <p>
      {t.explore.art.description}
    </p>

    <div class="access">
      {t.explore.art.access}
    </div>

    <div class="stripe">
      <div></div>
      <div></div>
      <div></div>
    </div>
  </a>

  <!-- =========================
       MODULE 04 // NOTES
  ========================== -->

  <a href={notesPath} class="explore-card">
    <div class="header">
      {t.explore.notes.header}
    </div>

    <span class="number">04</span>

    <h3>
      {t.explore.notes.title}
    </h3>

    <p>
      {t.explore.notes.description}
    </p>

    <div class="access">
      {t.explore.notes.access}
    </div>

    <div class="stripe">
      <div></div>
      <div></div>
      <div></div>
    </div>
  </a>
</div>

<style>
  .explore-grid {
    max-width: var(--container-wide);

    margin: 40px auto var(--section-gap);

    padding: 0 40px;

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: var(--grid-gap-tight);
  }

  .explore-card {
    position: relative;

    min-height: 260px;

    padding: 25px;

    background: linear-gradient(
      135deg,
      rgba(10, 10, 16, 0.9) 0%,
      rgba(14, 14, 20, 0.9) 100%
    );

    border: 1px solid var(--border);

    font-family: var(--font-mono);

    overflow: hidden;

    transition:
      transform 0.4s var(--spring-bounce),
      border-color 0.45s var(--ease-warmup),
      box-shadow 0.45s var(--ease-warmup);

    /* Industrial panel texture */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.02),
      0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .explore-card:active {
    transform: scale(0.97);
    transition: transform 0.1s var(--spring-snappy);
  }

  .explore-card::before {
    content: "";

    position: absolute;

    right: 0;

    top: 0;

    width: 45px;

    height: 45px;

    background: var(--accent);

    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }

  .header {
    font-size: var(--text-scale-4xs);

    letter-spacing: var(--tracking-tag);

    color: var(--text-dim);

    border-bottom: 1px dashed var(--border);

    padding-bottom: 12px;
  }

  .number {
    display: block;

    margin-top: 35px;

    font-size: var(--text-scale-2xs);

    font-weight: bold;

    color: var(--accent);
  }

  h3 {
    margin-top: 15px;

    font-size: var(--text-scale-h3);

    font-weight: 900;

    color: var(--text-bright);

    letter-spacing: var(--tracking-slight);
  }

  p {
    margin-top: 8px;

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-label);

    color: #aaa;
  }

  .access {
    position: absolute;

    bottom: 55px;

    left: 25px;

    font-size: var(--text-scale-3xs);

    font-weight: bold;

    color: var(--terminal-green);
  }

  .stripe {
    position: absolute;

    bottom: 25px;

    left: 25px;

    height: 5px;

    width: 90px;

    display: flex;
  }

  .stripe div {
    flex: 1;
  }

  .stripe div:nth-child(1) {
    background: var(--stripe-red);
  }

  .stripe div:nth-child(2) {
    background: var(--stripe-yellow);
  }

  .stripe div:nth-child(3) {
    background: var(--stripe-teal);
  }

  .explore-card:hover {
    transform: translateY(var(--hover-lift-card));

    border-color: var(--accent);

    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.6),
      0 0 25px rgba(var(--accent-rgb), 0.1);
  }

  .explore-card:hover .access {
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .explore-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .explore-grid {
      grid-template-columns: 1fr;

      padding: 0 20px;
    }
  }
</style>
