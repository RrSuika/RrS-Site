---
import { getLanguageFromPath, getLocalizedPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const aboutPath = getLocalizedPath("/about", language);
---

<section class="about-preview">
  <div class="panel">
    <div class="header">
      {t.aboutPreview.header}
    </div>

    <div class="content">
      <div class="id-block">
        <div class="label">
          {t.aboutPreview.operator}
        </div>

        <h2>RrSuika Studio</h2>

        <div class="status">
          {t.aboutPreview.status}
        </div>
      </div>

      <a class="access" href={aboutPath}>
        {t.aboutPreview.access}
      </a>
    </div>

    <div class="footer">
      <div class="meta">
        <span>
          {t.aboutPreview.location}
        </span>

        <span>
          {t.aboutPreview.field}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-preview {
    margin: 0 auto var(--section-gap);

    font-family: var(--font-mono);
  }

  .panel {
    max-width: var(--container-main);

    width: calc(100% - 80px);

    margin: 0 auto;

    /* 与 SYS.LOG（LatestUpdates 的 .panel）保持同一半透明效果：
       复用该处已有的 rgba(8, 8, 12, 0.9)，不是新颜色。
       亮色主题由下方 :root[data-theme="light"] 覆盖成 var(--paper)，
       两个区块在亮色下本来就一致。 */
    background: rgba(8, 8, 12, 0.9);

    border: 1px solid var(--border);

    border-radius: var(--radius-md);

    position: relative;

    overflow: hidden;
  }

  @media (max-width: 800px) {
    .panel { max-width: none; margin: 0 16px; }
  }

  .header {
    padding: 18px 25px;

    border-bottom: 1px dashed var(--border);

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-tag);

    color: var(--accent);
  }

  .content {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 40px;

    padding: 50px;
  }

  .access {
    color: var(--terminal-green);

    font-size: clamp(19px, 4.5vw, var(--text-scale-article-h2));

    font-weight: 900;

    letter-spacing: var(--tracking-tight);

    white-space: nowrap;

    text-align: right;

    transition:
      color 0.2s var(--ease-out),
      transform 0.2s var(--spring-snappy);
  }

  .label {
    font-size: var(--text-scale-3xs);

    color: #9a9a9a;

    margin-bottom: 15px;
  }

  h2 {
    font-size: var(--text-scale-h2);

    line-height: 1;

    font-weight: 900;

    color: var(--text-bright);

    margin-bottom: 20px;

    letter-spacing: var(--tracking-tight);
  }

  .status {
    font-size: var(--text-scale-3xs);

    color: var(--terminal-green);

    font-weight: bold;
  }

  .footer {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    padding: 20px 25px;

    border-top: 1px solid var(--border);

    font-size: var(--text-scale-3xs);

    color: #9a9a9a;
  }

  .footer .meta {
    display: flex;

    flex-wrap: wrap;

    gap: 8px 24px;
  }

  .access:hover {
    color: var(--accent);
  }

  .access:active {
    transform: scale(0.93);
    transition: transform 0.08s var(--spring-snappy);
  }

  @media (max-width: 900px) {
    .content {
      flex-direction: column;

      align-items: flex-start;

      gap: 25px;

      padding: 35px;
    }

    .access {
      align-self: flex-end;
    }

    .footer {
      flex-direction: column;

      align-items: flex-start;

      gap: 15px;
    }

    h2 {
      font-size: 38px;
    }
  }

  :root[data-theme="light"] .about-preview .panel {
    background: var(--paper);
    box-shadow: var(--shadow-paper);
  }
  :root[data-theme="light"] .about-preview .header { color: #333; }
  :root[data-theme="light"] .about-preview h2 { color: var(--text-bright); }
  :root[data-theme="light"] .about-preview .label { color: var(--text-dim); }
  :root[data-theme="light"] .about-preview .status { color: #00703c; }
  :root[data-theme="light"] .about-preview .access { color: #00703c; }
  :root[data-theme="light"] .about-preview .footer { color: var(--text-soft); }
</style>
