---
import { getLanguageFromPath, languageDateLocales } from "../../utils/i18n";
import type { CollectionEntry } from "astro:content";
import { getTranslations } from "../../utils/translations";
import { buildEntryUrl } from "../../utils/routes";

const { entries = [] as CollectionEntry<"entries">[] } = Astro.props as { entries?: CollectionEntry<"entries">[] };

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
---

<section class="latest">
  <div class="panel">
    <div class="header">
      {t.latest.header}
    </div>

    <div class="logs" data-reveal-group=".log" data-reveal-step="40">
      {
        entries.map((entry, index) => {
          const date = entry.data.dateLabel ?? entry.data.date.toLocaleDateString(
            languageDateLocales[language],
            {
              year: "numeric",
              month: "short",
            },
          );

          return (
            <a href={buildEntryUrl(entry, language)} class="log">
              <div class="log-left">
                <div class="entry">
                  ENTRY_{String(index + 1).padStart(3, "0")}
                </div>

                <h3>{entry.data.title}</h3>

                <p>{entry.data.description}</p>
              </div>

              <div class="meta">
                <span>
                  {t.latest.type}
                  {entry.data.type.toUpperCase()}
                </span>

                <span>{date}</span>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="footer">
      &gt; DATABASE_STATUS:

      <span>
        {t.latest.updated}
      </span>
    </div>
  </div>
</section>

<style>
  .latest {
    margin: 0 auto var(--section-gap);

    font-family: var(--font-mono);
  }

  .panel {
    max-width: var(--container-main);

    width: calc(100% - 80px);

    margin: 0 auto;

    background: rgba(8, 8, 12, 0.9);

    border: 1px solid var(--border);

    border-radius: var(--radius-md);
  }

  @media (max-width: 800px) {
    .panel { max-width: none; margin: 0 16px; }
  }

  .header {
    padding: 18px 25px;

    border-bottom: 1px dashed var(--border);

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-tag);

    color: var(--accent);
  }

  .logs {
    display: flex;

    flex-direction: column;
  }

  .log {
    display: flex;

    justify-content: space-between;

    gap: 40px;

    padding: 25px;

    border-bottom: 1px solid var(--border);

    text-decoration: none;

    color: var(--text-bright);

    transition:
      background 0.3s var(--ease-out),
      transform 0.2s var(--spring-snappy);

    position: relative;
  }

  .log::before {
    content: "";

    position: absolute;

    left: 0;

    top: 0;

    height: 100%;

    width: 4px;

    background: transparent;

    transition: background 0.3s var(--ease-out);
  }

  .log:active {
    transform: scale(0.99);
  }

  .log:hover {
    background: var(--hover-bg);
  }

  .log:hover::before {
    background: var(--accent);
  }

  .entry {
    font-size: var(--text-scale-4xs);

    color: var(--terminal-green);

    letter-spacing: var(--tracking-tag);

    margin-bottom: 10px;
  }

  .log h3 {
    font-size: 22px;

    margin-bottom: 8px;

    font-weight: 900;
  }

  .log p {
    font-size: var(--text-scale-2xs);

    color: var(--text-tertiary);

    max-width: 700px;

    line-height: 1.7;
  }

  .meta {
    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-end;

    gap: 10px;

    font-size: var(--text-scale-3xs);

    color: var(--text-dim);

    white-space: nowrap;
  }

  .footer {
    padding: 18px 25px;

    font-size: var(--text-scale-3xs);

    color: var(--text-dim);
  }

  .footer span {
    color: var(--terminal-green);

    font-weight: bold;
  }

  @media (max-width: 800px) {
    .latest {
      padding: 0 20px;
    }

    .log {
      flex-direction: column;

      gap: 20px;
    }

    .meta {
      align-items: flex-start;
    }
  }

  :root[data-theme="light"] .latest .panel {
    background: var(--paper);
    box-shadow: var(--shadow-paper);
  }
  :root[data-theme="light"] .latest .header { color: var(--text-soft); }
  :root[data-theme="light"] .latest .log h3 { color: var(--text-bright); }
  :root[data-theme="light"] .latest .log .entry { color: var(--text-dim); }
  :root[data-theme="light"] .latest .log p { color: var(--text-dim); }
  :root[data-theme="light"] .latest .meta { color: #777; }
  :root[data-theme="light"] .latest .log { border-bottom-color: #ddd; color: var(--text-bright); }
  :root[data-theme="light"] .latest .log:hover { background: var(--hover-bg); }
  :root[data-theme="light"] .latest .footer { color: var(--text-dim); }
  :root[data-theme="light"] .latest .footer span { color: #00703c; }
</style>
