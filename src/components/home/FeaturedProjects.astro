---
import ProjectCard from "../ProjectCard.astro";
import type { CollectionEntry } from "astro:content";
import { getLanguageFromPath } from "../../utils/i18n";
import { getTranslations } from "../../utils/translations";

const { projects = [] as CollectionEntry<"entries">[], totalCount = 0 } = Astro.props as { projects?: CollectionEntry<"entries">[]; totalCount?: number };

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);
---

<section class="featured">
  <div class="section-header">
    <div class="data-tag">
      {t.featured.tag}
    </div>

    <h2>
      {t.featured.title}
    </h2>

    <p>
      {t.featured.description}
    </p>
  </div>

  <div class="project-count">
    <span>
      {t.featured.total}
    </span>

    <strong>
      {totalCount}
    </strong>

    <span>
      // {t.featured.active}
    </span>
  </div>

  <div class="grid">
    {
      projects.map((project, index) => (
        <div class="project-wrapper">
          <div class="number">0{index + 1}</div>

          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .featured {
    max-width: var(--container-wide);

    /* 顶部留白:把本区块与上方 hero 段(SIGMA-09 收尾处)分开,
       让 Selected Projects 读成新的一段 */
    margin: 20px auto var(--section-gap);

    padding: 0 40px;

    font-family: var(--font-mono);
  }

  .section-header {
    margin-bottom: 45px;
  }

  .data-tag {
    display: inline-block;

    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-tag);

    padding: 8px 15px;

    border: 1px solid var(--accent);

    color: var(--accent);

    margin-bottom: 12px;
  }
  h2 {
    font-size: var(--text-scale-display);

    font-weight: 900;

    letter-spacing: 1.5px;
    word-spacing: 1px;
    font-feature-settings: "kern" 0;

    margin-bottom: 15px;

    text-transform: uppercase;
  }

  .section-header p {
    color: var(--text-dim);

    font-size: var(--text-scale-2xs);

    letter-spacing: var(--tracking-label);
  }

  .project-count {
    display: flex;

    gap: 10px;

    align-items: center;

    margin-bottom: 35px;

    font-size: var(--text-scale-2xs);

    color: var(--text-dim);

    border-bottom: 1px dashed var(--border-divider);

    padding-bottom: 15px;
  }

  .project-count strong {
    color: var(--terminal-green);
  }

  .grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: var(--grid-gap-wide);
  }

  .project-wrapper {
    position: relative;
  }

  .number {
    position: absolute;

    top: -18px;

    left: 18px;

    z-index: 5;

    font-size: 42px;

    font-weight: 900;

    color: rgba(255, 255, 255, 0.08);

    pointer-events: none;

    transition: transform 0.4s var(--spring-bounce);
  }

  .project-wrapper:has(.card:hover) .number {
    transform: translateY(-8px);
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 800px) {
    .featured {
      padding: 0 20px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
