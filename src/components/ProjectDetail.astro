---
import { getImage } from "astro:assets";
import { getProjectImageMeta } from "../utils/images";
import { getLanguageFromPath, languageDateLocales } from "../utils/i18n";
import { getTranslations } from "../utils/translations";

interface Props {
  project: any;
  projectId: string;
  Content: any;
  translation?: any;
}

const { project, projectId, Content, translation } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(language);

const coverMeta = project.data.cover
  ? getProjectImageMeta(projectId, project.data.cover)
  : null;

const optimizedCover =
  coverMeta && typeof coverMeta !== "string"
    ? await getImage({
        src: coverMeta,
        width: 1600,
        format: "webp",
        quality: 90,
      })
    : null;

const cover =
  optimizedCover?.src ?? (typeof coverMeta === "string" ? coverMeta : null);
const coverWidth = optimizedCover?.attributes.width as number | undefined;
const coverHeight = optimizedCover?.attributes.height as number | undefined;

const date = project.data.date.toLocaleDateString(
  languageDateLocales[language],
  {
    year: "numeric",
    month: "long",
  },
);

const translationAvailable = !!translation;
---

<main class="project">
  <section class="hero">
    <div class="cover">
      {cover && <img src={cover} alt={project.data.title} width={coverWidth} height={coverHeight} loading="lazy" decoding="async" />}
    </div>

    <div class="hero-text">
      <h1>
        {project.data.title}
      </h1>

      {
        project.data.description && (
          <p class="description">{project.data.description}</p>
        )
      }
    </div>
  </section>

  <section class="info">
    <div>
      <h3>{t.common.year}</h3>

      <p>
        {date}
      </p>
    </div>

    <div>
      <h3>{t.common.type}</h3>

      <p>
        {project.data.type}
      </p>
    </div>

    <div>
      <h3>{t.common.category}</h3>

      <p>
        {project.data.category}
      </p>
    </div>

    <div>
      <h3>{t.common.tools}</h3>

      <p>
        {project.data.tools?.join(" · ")}
      </p>
    </div>
  </section>

  {
    project.data.wip && (
      <section class="wip-notice">
        <div class="notice-code">SYS_STATUS // {t.card.wip}</div>

        <div class="notice-title">{t.detail.wip}</div>
      </section>
    )
  }

  <div class="tags">
    {project.data.tags?.map((tag: string) => <span class="tag">#{tag}</span>)}
  </div>

  <hr />

  {
    !translationAvailable && (
      <section class="translation-notice">
        <div class="notice-code">{t.language.code}</div>

        <div class="notice-title">{t.language.unavailable}</div>

        <div class="notice-subtitle">{t.language.description}</div>
      </section>
    )
  }

  <div class="content-layout">
    <aside class="toc">
      <h3>{t.common.contents}</h3>

      <nav
        id="toc-list"
        class="toc-list"
        data-toc-level={project.data.type === "note" ? "h2" : "h1"}
      >
      </nav>
    </aside>

    <article>
      <Content />
    </article>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Image click → fullscreen overlay (with click-vs-drag discrimination) ──
    const openOverlay = (src: string) => {
      const overlay = document.createElement("div");
      overlay.style.cssText = "position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;cursor:zoom-out;";
      const clone = document.createElement("img");
      clone.src = src;
      clone.style.cssText = "max-width:92vw;max-height:92vh;object-fit:contain;";
      overlay.appendChild(clone);
      overlay.addEventListener("click", () => overlay.remove());
      document.body.appendChild(overlay);
    };
    document.querySelectorAll<HTMLImageElement>("article img").forEach(img => {
      if (img.closest(".drawer-stack")) return; // drawer stacks have their own interaction
      let pressX = 0, pressY = 0;
      img.addEventListener("mousedown", (e) => { pressX = e.clientX; pressY = e.clientY; });
      img.addEventListener("click", (e) => {
        // only zoom on a real click, not the end of a drag (e.g. process track)
        const dx = Math.abs(e.clientX - pressX), dy = Math.abs(e.clientY - pressY);
        if (dx < 4 && dy < 4) openOverlay(img.src);
      });
      img.style.cursor = "zoom-in";
    });
    // ── Drawer stacks: hover pulls a card out (CSS); on touch, tap toggles, tap again zooms ──
    document.querySelectorAll<HTMLElement>(".drawer-card").forEach(card => {
      card.addEventListener("click", () => {
        const img = card.querySelector<HTMLImageElement>("img");
        if (window.matchMedia("(hover: hover)").matches) {
          if (img) openOverlay(img.src);
        } else {
          if (card.classList.contains("open")) {
            if (img) openOverlay(img.src);
            card.classList.remove("open");
          } else {
            card.classList.add("open");
          }
        }
      });
    });
    // ── Info tabs: hover/click a title on the left → show its panel on the right ──
    document.querySelectorAll<HTMLElement>(".info-tabs").forEach(tabs => {
      const items = Array.from(tabs.querySelectorAll<HTMLElement>(".tab-item"));
      const panels = Array.from(tabs.querySelectorAll<HTMLElement>(".tab-panel"));
      const activate = (idx: number) => {
        items.forEach((it, i) => it.classList.toggle("active", i === idx));
        panels.forEach((p, i) => p.classList.toggle("active", i === idx));
      };
      items.forEach((item, i) => {
        item.addEventListener("mouseenter", () => {
          if (window.matchMedia("(hover: hover)").matches) activate(i);
        });
        item.addEventListener("click", () => activate(i));
      });
      activate(0);
    });
    // ── Process scroll auto-advance ──
    const sc = document.getElementById("process-scroll");
    const track = document.getElementById("process-track") as HTMLElement | null;
    if (sc && track) {
      let pos = 0, speed = 0.4, dragging = false, hovering = false;
      let dragX = 0, dragStart = 0;
      const copies = Number(track.dataset.copies) || 2;

      sc.addEventListener("mouseenter", () => { hovering = true; });
      sc.addEventListener("mouseleave", () => { hovering = false; dragging = false; sc.style.cursor = "grab"; });
      sc.addEventListener("mousedown", (e) => {
        dragging = true; dragX = e.clientX; dragStart = pos; sc.style.cursor = "grabbing"; e.preventDefault();
      });
      window.addEventListener("mousemove", (e) => {
        if (!dragging) return;
        pos = dragStart + (dragX - e.clientX) * 1.5;
      });
      window.addEventListener("mouseup", () => { dragging = false; });
      sc.addEventListener("touchstart", (e) => {
        dragging = true; dragX = e.touches[0].clientX; dragStart = pos;
      });
      sc.addEventListener("touchmove", (e) => {
        if (!dragging) return;
        pos = dragStart + (dragX - e.touches[0].clientX) * 1.5;
      });
      sc.addEventListener("touchend", () => { dragging = false; });

      const anim = () => {
        if (!dragging && !hovering) pos += speed;
        const setWidth = track.scrollWidth / copies;
        pos = ((pos % setWidth) + setWidth) % setWidth;
        track.style.transform = `translateX(${-pos}px)`;
        requestAnimationFrame(anim);
      };
      requestAnimationFrame(anim);
    }
    const article = document.querySelector("article");
    const toc = document.querySelector<HTMLElement>("#toc-list");

    if (!article || !toc) return;

    const headings = article.querySelectorAll<HTMLElement>(toc.dataset.tocLevel || "h1");

    headings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id = "section-" + index;
      }

      const link = document.createElement("a");

      link.href = "#" + heading.id;

      // Tag heading level for CSS (h2 → major section divider)
      const level = heading.tagName.toLowerCase();
      link.classList.add("toc-" + level);

      const title = heading.innerText.replace(/^\d+(\.\d+)*[\.\s-]*/, "");

      link.textContent = title;

      toc.appendChild(link);
    });
  });
</script>

<style>
  .project {
    max-width: var(--container-content);

    margin: auto;

    padding: 0 40px;
  }

  .hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    gap: 60px;

    align-items: center;

    margin-top: 48px;

    margin-bottom: 80px;

    max-width: var(--container-narrow);
  }

  .cover {
    width: 100%;

    aspect-ratio: 4 / 3;

    overflow: hidden;

    border-radius: var(--radius-cover);

    border: 1px solid var(--border);
  }

  .cover :global(img) {
    width: 100%;

    height: 100%;

    object-fit: contain;

    display: block;

    background: var(--bg);
  }

  .hero-text h1 {
    font-size: var(--text-scale-h1-detail);

    line-height: 1.15;

    margin-bottom: 25px;

    white-space: pre-line;
  }

  .description {
    font-size: 22px;

    line-height: 1.5;

    color: #666;
  }

  .info {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: var(--grid-gap);

    margin-bottom: 40px;
  }

  .info h3 {
    font-size: var(--text-scale-xs);

    text-transform: uppercase;

    color: #777;

    margin-bottom: 8px;

    letter-spacing: var(--tracking-label);
  }

  .info p {
    font-size: var(--text-scale-body);
  }

  .tags {
    display: flex;

    gap: 10px;

    flex-wrap: wrap;

    margin-bottom: 60px;
  }

  .tag {
    background: rgba(255, 255, 255, 0.08);

    color: var(--text-soft);

    border: 1px solid var(--border-strong);

    padding: 6px 14px;

    border-radius: var(--radius-pill);

    font-size: var(--text-scale-xs);

    letter-spacing: var(--tracking-micro);
  }

  :root[data-theme="light"] .tag {
    background: rgba(0, 0, 0, 0.06);
    color: var(--text-soft);
    border-color: var(--border-strong);
  }

  hr {
    border: none;

    border-top: 1px solid var(--border);

    margin-bottom: 60px;
  }

  /*
  ========================
  WIP NOTICE
  ========================
  */

  .wip-notice {
    border: 1px dashed #e0b34c;

    background: rgba(224, 179, 76, 0.06);

    padding: 22px 28px;

    margin-bottom: 40px;

    font-family: var(--font-mono);
  }

  .wip-notice .notice-code {
    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-wide);

    color: #e0b34c;

    margin-bottom: 8px;
  }

  .wip-notice .notice-title {
    font-size: var(--text-scale-body);

    font-weight: 700;

    color: #e0b34c;

    letter-spacing: var(--tracking-label);
  }

  /*
  ========================
  TRANSLATION NOTICE
  ========================
  */

  .translation-notice {
    min-height: 55vh;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    font-family: var(--font-mono);

    padding: 80px 20px;
  }

  .notice-code {
    font-size: var(--text-scale-xs);

    letter-spacing: var(--tracking-wide);

    color: var(--accent);

    margin-bottom: 25px;

    opacity: 0.8;
  }

  .notice-title {
    font-size: 48px;

    font-weight: 900;

    line-height: 1.2;

    color: white;

    margin-bottom: 18px;
  }

  .notice-subtitle {
    font-size: 16px;

    letter-spacing: var(--tracking-label);

    color: #777;
  }

  /*
  ========================
  CONTENT + TOC
  ========================
  */

  .content-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--grid-gap);
    max-width: var(--container-article);
    margin: 0 auto;
  }

  .toc {
    position: sticky;
    top: 100px;
    align-self: start;
    height: fit-content;

    box-sizing: border-box;

    border-left: none;

    padding-left: 0;

    font-family: var(--font-mono);
  }

  .toc h3 {
    font-size: var(--text-scale-3xs);

    letter-spacing: var(--tracking-wide);

    text-transform: uppercase;

    margin-bottom: 20px;

    color: var(--accent);

    font-weight: 900;

    padding-left: 12px;
    border-left: 2px solid var(--accent);
  }

  .content-layout article {
    max-width: var(--container-text);

    margin: 0 auto;
  }

  .toc-list {
    display: flex;

    flex-direction: column;

    gap: 0;
  }

  /*
  ══════════════════════════════════════
  TOC items — each separated by a
  visible horizontal divider line
  ══════════════════════════════════════
  */

  .toc-list a {
    display: block;

    width: 100%;

    font-size: 11.5px;

    line-height: 1.45;

    color: var(--text-tertiary);

    text-decoration: none;

    padding: 13px 8px;

    /* ═══ Strong visible divider ═══ */
    border-bottom: 1px solid rgba(255, 255, 255, 0.30);

    transition:
      color 0.15s var(--ease-out),
      background 0.15s var(--ease-out);
  }

  .toc-list a:last-child {
    border-bottom: none;
  }

  /* H2 — section headers */
  .toc-list a.toc-h2 {
    font-weight: 700;
    font-size: var(--text-scale-2xs);
    color: var(--text-soft);
    border-bottom: 1px solid rgba(255, 255, 255, 0.40);
    padding: 15px 8px 13px;
  }

  /* H3 — sub-items */
  .toc-list a.toc-h3 {
    padding-left: 18px;
    font-size: var(--text-scale-3xs);
    color: #888;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  /* Hover — dark mode: solid light-gray block for clear visibility */
  .toc-list a:hover {
    color: #fff !important;
    background: rgba(255, 255, 255, 0.20);
    border-radius: var(--radius-sm);
  }

  .toc-list a.toc-h2:hover {
    color: #fff !important;
    background: rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-sm);
  }

  .toc-list a.toc-h3:hover {
    color: #ddd !important;
    background: rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-sm);
  }

  .toc .sub {
    padding-left: 15px;

    font-size: var(--text-scale-2xs);
  }

  /*
  ========================
  ARTICLE
  ========================
  */

  article {
    font-size: var(--text-scale-body);

    line-height: 1.8;
  }

  :global(article h1) {
    scroll-margin-top: 82px;
    margin-top: 50px;

    margin-bottom: 25px;

    font-size: var(--text-scale-article-h1);

    line-height: 1.2;

    color: var(--retro-red) !important;

    font-weight: 900;
  }

  :global(article h2) {
    scroll-margin-top: 82px;
    margin-top: 60px;

    margin-bottom: 20px;

    font-size: var(--text-scale-article-h2);

    line-height: 1.3;

    color: var(--retro-yellow) !important;

    font-weight: 800;

    /* Section divider above h2 */
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 30px;
  }

  :global(article h2:first-of-type) {
    border-top: none;
    padding-top: 0;
  }

  :root[data-theme="light"] :global(article h2) {
    border-top-color: rgba(0, 0, 0, 0.1);
  }

  :global(article h3) {
    margin-top: 40px;

    margin-bottom: 15px;

    font-size: var(--text-scale-article-h3);

    line-height: 1.4;

    color: var(--retro-cyan) !important;

    font-weight: 700;

    /* Section divider above h3 */
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 22px;
  }

  :global(article h3:first-of-type) {
    border-top: none;
    padding-top: 0;
  }

  :root[data-theme="light"] :global(article h3) {
    border-top-color: rgba(0, 0, 0, 0.05);
  }

  :global(article h2),
  :global(article h3) {
    position: relative;

    padding-left: 18px;
  }

  /* Accent bars — sized to the text line (em), not the element (%), so
     every heading gets an identical bar aligned to its first line. */
  :global(article h2)::before {
    content: "";

    position: absolute;

    left: 0;

    top: 30px;

    width: 5px;

    height: 1.2em;

    background: var(--retro-yellow);
  }

  :global(article h2:first-of-type)::before {
    top: 0;
  }

  :global(article h3)::before {
    content: "";

    position: absolute;

    left: 0;

    top: 22px;

    width: 4px;

    height: 1.2em;

    background: var(--retro-cyan);
  }

  :global(article h3:first-of-type)::before {
    top: 0;
  }

  article p {
    margin-bottom: 20px;
  }

  article ul,
  article ol {
    padding-left: 30px;

    margin-bottom: 20px;
  }

  article li {
    margin-bottom: 8px;
  }

  article :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 30px 0;
    font-size: 15px;
  }

  article :global(th) {
    text-align: left;
    padding: 12px 20px;
    border-bottom: 2px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-scale-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  article :global(td) {
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    vertical-align: top;
    line-height: 1.6;
  }

  article :global(tr:last-child td) {
    border-bottom: none;
  }

  article :global(tr td) {
    transition: background 0.2s var(--ease-out);
  }

  article :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.03);
  }


  article pre {
    background: var(--code-bg);

    border: 1px solid var(--border);

    padding: 20px;

    border-radius: var(--radius-lg);

    overflow-x: auto;
  }

  /*
  ========================
  MOBILE
  ========================
  */

  @media (max-width: 1100px) {
    .content-layout {
      grid-template-columns: 1fr;
    }

    .toc {
      position: relative;
      top: auto;
      max-height: none;
      overflow-y: visible;
      order: -1;
      margin-bottom: 40px;
      padding: 20px;
      border-left: none;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: var(--radius-lg);
    }

    .hero {
      grid-template-columns: 1fr;
    }

    .hero-text h1 {
      font-size: 40px;
    }

    .info {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .project {
      padding: 0 20px;
    }

    .info {
      grid-template-columns: 1fr;
    }

    .description {
      font-size: var(--text-scale-body);
    }

    article {
      font-size: 16px;
    }

    .translation-notice {
      min-height: 60vh;
    }

    .notice-title {
      font-size: 32px;
    }

    .notice-code {
      font-size: var(--text-scale-3xs);
    }

    .notice-subtitle {
      font-size: 14px;
    }
  }
</style>

<style is:global>
  /* --- Article image defaults (1080p-friendly) --- */
  article img {
    width: auto; height: auto;
    max-width: 850px; max-height: 550px;
    object-fit: contain;
    display: block; margin: 40px auto;
    border-radius: var(--radius-xl);
  }

  /* --- Layers cross-section layout --- */
  .layers-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
    margin: 40px 0;
  }
  .layers-image img {
    width: 100% !important;
    max-width: 420px !important;
    object-fit: contain;
    border-radius: var(--radius-lg);
    position: sticky;
    top: 100px;
    margin: 0 !important;
  }
  .layers-desc h3 {
    margin-top: 8px;
    color: var(--retro-cyan);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .layers-desc h3:first-child { margin-top: 0; }
  .layers-desc p { font-size: var(--text-scale-xs); color: var(--text-dim); line-height: 1.4; margin-bottom: 0; }
  :root[data-theme="light"] .layers-desc p { color: var(--text-dim); }

  /* --- Side-by-side comparison --- */
  .side-by-side { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 30px 0 10px; align-items: start; }
  .side-by-side img {
    width: 100% !important;
    height: auto !important;
    max-height: 420px !important;
    object-fit: contain;
    border-radius: 10px;
    margin: 0 !important;
  }
  .side-by-side p { text-align: center; font-size: var(--text-scale-2xs); color: #888; margin-top: 6px; font-family: var(--font-mono); }

  /* --- Drawer stack: overlapping files on the left, hover pulls one out to the right --- */
  .drawer-stack {
    float: left;
    width: 280px;
    margin: 8px 56px 48px 0;
  }
  .drawer-card {
    position: relative;
    width: 280px;
    height: 170px;
    cursor: pointer;
    z-index: 1;
    transition: transform 0.5s var(--spring-bounce);
  }
  /* cards overlap: only the top strip of each underlying card stays visible */
  .drawer-card:not(:first-child) { margin-top: -108px; }
  .drawer-card:nth-child(odd) { rotate: -0.5deg; }
  .drawer-card:nth-child(even) { rotate: 0.5deg; }
  .drawer-card img {
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    margin: 0 !important;
    display: block;
    background: var(--panel);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  :root[data-theme="light"] .drawer-card img { box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18); }
  /* pulled out to the right of the stack */
  .drawer-card:hover,
  .drawer-card.open {
    transform: translateX(calc(100% + 28px));
    z-index: 30;
  }
  .drawer-card .card-caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 26px 12px 9px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), transparent);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    color: #ddd;
    font-family: var(--font-mono);
    font-size: var(--text-scale-2xs);
